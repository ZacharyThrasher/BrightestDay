    creature: (
        charge_knockback: 16.0,
        breath_damage: 4.0,
        stomp_damage: 10.0,
        stomp_damage_kaiju: 18.0,
        stomp_knockback: 14.0,
        stomp_knockback_kaiju: 20.0,
        tail_knockback: 20.0,
        swarm_unit_damage: 3.0,
    ),
    willpower: (
        base_held: 12.0,
        base_worn: 15.0,
        base_structure: 10.0,
        base_object: 14.0,
        base_creature: 25.0,
        base_kaiju: 60.0,
        autonomous_pricing: true,
        autonomous_base: 25.0,
        autonomous_upkeep: 1.5,
        per_mechanic: 0.15,
        mechanic_cost: [],
        form_cost: [
            (
                form: Gun,
                mult: 2.6,
            ),
            (
                form: Staff,
                mult: 2.0,
            ),
        ],
        size_exp: 1.3,
        size_min: 0.5,
        size_max: 3.0,
        count_exp: 0.6,
        swarm_count_exp: 0.4,
        stale_window: 30.0,
        stale_per_use: 0.3,
        regen_per_sec: 3.0,
        regen_pause: 1.5,
        upkeep_held_worn: 0.6,
        upkeep_structure: 0.3,
        upkeep_object: 0.0,
        upkeep_creature: 1.5,
        upkeep_kaiju: 4.0,
        upkeep_pilot: 1.5,
        upkeep_pilot_colossal: 4.0,
        graft_cost_fraction: 0.5,
        dismiss_refund: 0.25,
        starved_decay: 0.35,
        oath_voice_slack: 2.0,
        // SPARKS: a cast costs whole sparks by the presence tier players see and hear
        // [Tiny, Normal, Big, Titan, Signature]; a famous held icon = legendary; +1 each for a crowd / swarm
        // (count >= crowd_count), piloted, an autonomous non-creature, a portal; nothing below Signature
        // above `cap`, nothing above the whole bar; +stale per repeat of the phrase in the window.
        sparks: (
            tier: (1, 2, 3, 5, 6),
            legendary: 6,
            crowd: 1,
            crowd_count: 3,
            piloted: 1,
            autonomous: 1,
            utility: 1,
            cap: 6,
            stale: 1,
        ),
    ),
    construct: (
        integrity_base: 20.0,
        integrity_per_cost: 4.0,
    ),
    snowball: (
        respawn_willpower_frac: 1.0,
        shutdown_streak: 3,
        shutdown_bonus: 1,
    ),
    // Hold-to-charge (anime power-up): willpower/s at full ramp (on top of passive regen), quadratic ramp
    // seconds, re-charge delay after a hit, and movement while holding (ground speed / air control / jump).
    charge: (
        rate_per_sec: 4.5,
        ramp_secs: 0.8,
        stagger_secs: 0.6,
        ground_speed_mult: 0.2,
        air_control_mult: 0.3,
        jump_mult: 0.5,
    ),
    // Blast zones (bd_sim world/bounds.rs, COMBAT.md §1a / §3): an attached tether anchored in the arena
    // holds you past the side / bottom zones (up to tether_hold_depth m; the top star KO always applies);
    // constructs that leave the map (bottom = recall_below_void m under the void) blink back next to their
    // summoner, at most recall_max times per recall_window s (anti-loop valve).
    bounds: (
        tether_saves: true,
        tether_hold_depth: 40.0,
        recall: true,
        recall_below_void: 6.0,
        recall_max: 3,
        recall_window: 10.0,
        recall_ahead: 2.5,
        recall_up: 1.0,
    ),
    // Summons (world/bounds.rs): visible placement (distance = clamp(fit_k * radius, near_min, fit_max),
    // crosshair surface used up to snap_max m; huge ones further out and to the side) + lifetimes (s).
    summon: (
        visible: true,
        fit_k: 2.4,
        near_min: 3.0,
        fit_max: 26.0,
        snap_max: 40.0,
        huge_radius: 3.5,
        huge_k: 3.0,
        huge_max: 80.0,
        huge_side_deg: 16.0,
        view_half_deg: 40.0,
        ground_drop: 12.0,
        life_creature: 20.0,
        life_kaiju: 24.0,
        life_structure: 30.0,
        life_object: 10.0,
        life_dome: 3.0,
        life_piloted_min: 30.0,
        object_rest_linger: 4.0,
        object_landed_linger: 4.0,
    ),
    // Melee lunge + hook-and-strike (bd_sim melee_assist.rs / hook.rs, COMBAT.md "Melee lunge",
    // "Hook-and-strike"). Defaults = the Rust defaults (tests/assist.rs checks parity).
    assist: (
        // Destiny-sword lunge: a melee swing that starts with an enemy inside range (eye to hull) and the
        // cone (clear sight) dashes at them. range = clamp(reach + extra * form * weight / long, min, max),
        // reach = item length + reach_pad; long weapons (> long_len m) dash shorter and slower.
        lunge: (
            enabled: true,
            reach_pad: 0.9,
            // CONNECT pass (owner: "I don't even feel the lunge"): sword ~6 m (was 4.6), cone 32 (was 20).
            extra: 4.0,
            range_min: 2.5,
            range_max: 6.5,
            long_len: 1.4,
            long_penalty: 0.6,
            long_slow: 0.25,
            cone_deg: 32.0,
            // The dash: speed toward the target (a faster approach keeps its own), longest dash, the
            // committed stop (speed kept on arrival), sideways/vertical velocity kept per tick.
            dash_speed: 30.0,
            dash_max_secs: 0.2,
            exit_speed: 5.0,
            lateral_keep: 0.3,
            // Stop at reach * stop_frac from the target's centre (clamped), max vertical slope, cooldown
            // (cleared when the lunge swing connects: hit_resets_cooldown).
            stop_frac: 0.7,
            stop_min: 1.2,
            stop_max: 2.2,
            max_up: 0.75,
            cooldown: 0.5,
            hit_resets_cooldown: true,
            heavy_mult: 0.8,
            heavy_speed: 0.8,
            fast_mult: 1.15,
            forms: [
                (form: Sword, mult: 1.0),
                (form: Spear, mult: 1.0),
                (form: Axe, mult: 0.9),
                (form: Hammer, mult: 0.8),
                (form: Gauntlet, mult: 0.95),
                (form: Shield, mult: 0.7),
            ],
            // A lunge swing that connects: juice weight x (hit-stop, shake), Heavy x on top, knockback x;
            // the momentum bonus keeps the closing speed from before the dash.
            connect_impact: 1.4,
            connect_heavy_impact: 1.25,
            connect_knockback: 1.0,
            keep_closing_speed: true,
            // Hitbox aim nudge (never the camera): max degrees, ease-in seconds, hold seconds, release angle.
            aim_max_deg: 15.0,
            aim_ramp_secs: 0.1,
            aim_hold_secs: 0.45,
            aim_release_deg: 45.0,
        ),
        // Tethers hook players (match rule tether_hooks_players). Players' hook boxes = hull + radius; the
        // rope breaks past max_range, after los_grace s out of sight, when the victim boosts / fires a
        // tether / cuts it (blade within cut_margin); arriving within arrive_dist holding a melee weapon
        // lets go and makes the next swing (within slam_window s) a slam: knockback x, lift, juice x.
        hook: (
            radius: 0.3,
            max_range: 40.0,
            los_grace: 0.25,
            cut_margin: 0.3,
            breaks_on_boost: true,
            breaks_on_tether: true,
            arrive_dist: 3.0,
            slam_window: 1.0,
            slam_knockback: 1.5,
            slam_lift: 0.45,
            slam_impact: 1.6,
            // Bots with a melee weapon try it at this rate (1/s) on a visible target in [min, max] m.
            bot_rate: 0.35,
            bot_min_dist: 8.0,
            bot_max_dist: 30.0,
            bot_cooldown: 6.0,
        ),
        // CONNECT (bd_sim aim_assist.rs): invisible, host-side, never through walls; tests/connect.rs reports
        // hit rates before/after. Melee: swing capsule radius x melee_radius (per-form rows override), x (1 +
        // melee_weight * (swing weight - 1)), extra capped at melee_extra_max m (the extra needs a clear line
        // blade -> body). Projectiles (ring blast, bolts, arrows, discs): the enemy nearest the crosshair in
        // proj_cone_deg / proj_range at release; turn proj_turn_deg deg/s at release falling to 0 over
        // proj_decay_secs, let go past proj_release_deg; x per kind; explosive rounds x proj_explosive.
        // Thrown constructs: thrown_*. Hitscan: a ray missing a body by <= deg (per gun; beams
        // hitscan_beam_deg) within hitscan_range m bends onto it if the bent ray is clear.
        aim: (
            melee_radius: 1.5,
            melee_forms: [
                (form: Whip, mult: 1.15),
                (form: Shield, mult: 1.25),
            ],
            melee_weight: 0.3,
            melee_extra_max: 0.45,
            proj_cone_deg: 12.0,
            proj_range: 80.0,
            proj_turn_deg: 220.0,
            proj_decay_secs: 0.3,
            proj_release_deg: 35.0,
            proj_kinds: [
                (kind: RingBlast, mult: 1.0),
                (kind: Bolt, mult: 1.0),
                (kind: Arrow, mult: 0.8),
                (kind: CannonBall, mult: 0.5),
                (kind: Disc, mult: 0.8),
            ],
            proj_explosive: 0.0,
            thrown_cone_deg: 14.0,
            thrown_range: 45.0,
            thrown_turn_deg: 160.0,
            thrown_decay_secs: 0.5,
            thrown_release_deg: 45.0,
            hitscan: [
                (arch: HandCannon, deg: 1.6),
                (arch: Minigun, deg: 0.9),
                (arch: SuperShotgun, deg: 0.0),
                (arch: Railgun, deg: 0.5),
            ],
            hitscan_beam_deg: 0.5,
            hitscan_range: 90.0,
        ),
    ),
    // Signature casts (bd_sim::signature, COMBAT.md §5j): "domain expansion ...", "kamehameha", "bankai" —
    // an amplifier over existing mechanics. Domain = Dome + Barrier + Trap of the phrase's element,
    // radius domain_radius + domain_radius_shout x shout power (0..1), lives domain_life s. Summon /
    // Transformation scale x (scale_mult + scale_mult_shout x power), capped at form max x scale_cap_mult and
    // max_scale. Beam = railgun at caliber beam_caliber. Forming >= windup s (readable, the caster keeps
    // moving); held / worn ultimates expire after held_life s. Cost = the existing cast cost x cost_mult,
    // never more than a full bar (unaffordable -> the plain phrase is cast). Spawns costing >= alert_cost or
    // >= alert_scale m (or colossal) get the cut-in DANGER alert. Bots with >= bot_willpower shout one at
    // bot_chance per cast.
    signature: (
        domain_radius: 16.0,
        domain_radius_shout: 4.0,
        domain_life: 9.0,
        scale_mult: 2.0,
        scale_mult_shout: 0.6,
        scale_cap_mult: 2.5,
        max_scale: 30.0,
        beam_caliber: 2.5,
        windup: 0.6,
        held_life: 10.0,
        cost_mult: 1.35,
        alert_cost: 45.0,
        alert_scale: 12.0,
        bot_willpower: 85.0,
        bot_chance: 0.2,
        // Orbital strikes (bd_sim::signature::orbital): an emitter (Shoots / Beam / Breath) that Flies and is
        // placed with DropFromSky ("satellite death beam") hovers altitude m above the aim point (clamped to
        // [altitude_min, altitude_max] and ceiling_margin under the map top; nudged to within view_elev_deg of
        // the caster's eye), shows a ground marker for telegraph s, then the beam comes down for strike_secs,
        // tracking at <= slew m/s (Homing: the nearest enemy within track_radius; else the caster's
        // crosshair); cooldown s, repeat. Pulses every pulse s: damage / knockback (x Heavy 1.5 / Fast 0.8),
        // a carve of carve_radius every carve_every s (Earth x2; Fire / Atomic ignite). Attract = abduction:
        // lift at abduct_accel m/s^2 up to abduct_max m/s, no damage. Breath = beam_radius x2. Cost = the
        // existing cast cost x cost_mult, never more than a full bar.
        orbital: (
            altitude: 30.0,
            altitude_min: 22.0,
            altitude_max: 40.0,
            ceiling_margin: 6.0,
            view_elev_deg: 32.0,
            telegraph: 0.7,
            strike_secs: 2.5,
            cooldown: 3.0,
            slew: 6.5,
            track_radius: 12.0,
            beam_radius: 1.4,
            pulse: 0.1,
            damage: 3.0,
            knockback: 5.0,
            carve_every: 0.3,
            carve_radius: 1.2,
            abduct_accel: 40.0,
            abduct_max: 8.0,
            cost_mult: 1.25,
        ),
        // Erasing orbs (bd_sim::signature::orb): a Beam signature whose phrase Pierces and is fired / thrown
        // (HOLLOW PURPLE). A Ball of diameter (+ diameter_shout x shout power, x (1 + full_bar_bonus) from a full
        // bar) forms in the hand for the windup, then flies straight at speed m/s for range m, ignoring
        // everything: a carve of radius x carve_radius_mult (min 1 m) every carve_spacing m at carve_power, every
        // touched construct (not the caster's) takes construct_damage, every touched player is hit once for
        // damage % with base knockback (Smash formula). Released, it drags a suction wake (Attract, wake_radius / wake_strength).
        orb: (
            diameter: 3.5,
            diameter_shout: 0.6,
            full_bar_bonus: 0.15,
            speed: 50.0,
            range: 120.0,
            carve_radius_mult: 1.0,
            carve_spacing: 1.2,
            carve_power: 3.0,
            damage: 28.0,
            knockback: 36.0,
            construct_damage: 100000.0,
            wake_radius: 7.0,
            wake_strength: 22.0,
            // Every ball of ENERGY (rasengan, spirit bomb, fireball, Hollow Purple…): after forming, hold
            // PRIMARY to grow it (grow_rate x/s up to grow_max x, grow_cost willpower/s per metre of
            // diameter); release throws; no press within grace (or hold_max) throws the base size. A hit of
            // knock_pct % while holding knocks it loose (it bursts in the hands). Thrown at throw_speed /
            // (1 + speed_size x (d - 1)), >= min_speed. Explosive ones burst on contact (radius d x blast_mult
            // + 1.5, damage / knockback x sqrt(d)); non-explosive ones >= plough_diameter plough terrain. In a
            // palm-beam struggle a ball pushes push_per_m per metre; pushed back push_back m it bursts.
            grace: 0.3,
            hold_max: 8.0,
            grow_rate: 0.7,
            grow_max: 3.0,
            grow_cost: 4.0,
            knock_pct: 4.0,
            throw_speed: 55.0,
            speed_size: 0.12,
            min_speed: 12.0,
            plough_diameter: 3.0,
            blast_mult: 1.3,
            blast_damage: 16.0,
            blast_knockback: 24.0,
            push_per_m: 0.55,
            push_back: 18.0,
        ),
        // Palm beams (Form::Hands: kamehameha, final flash…): a sustained, physical beam. Head at speed m/s
        // to range m; width / life / steering (deg/s) from plain to ultimate caliber; +secs_charge_bonus at
        // full charge. Every pulse s it hits what's along it (the shot's damage x pulse_damage, knockback x
        // pulse_knockback; constructs x construct_mult); Barrier / Guard stop it; terrain stops the head and
        // it bores (a carve at the tip every carve_every_* s). Clash: push = (push_base + charge) x (1 +
        // caliber) (+ hold_push while pouring willpower at hold_cost/s); the point drifts clash_drift m/s per
        // push difference (<= clash_drift_max); at a caster (clash_reach) or after clash_max s it detonates
        // (blast_*; the loser takes blast_loser x, the winner blast_winner x). Bots counter-beam at bot_chance.
        palm: (
            speed: 150.0,
            range: 160.0,
            radius_plain: 0.35,
            radius_ult: 1.5,
            secs_plain: 0.6,
            secs_ult: 1.5,
            secs_charge_bonus: 0.2,
            turn_plain: 70.0,
            turn_ult: 32.0,
            pulse: 0.1,
            pulse_damage: 0.22,
            pulse_knockback: 0.3,
            construct_mult: 2.5,
            carve_every_plain: 0.2,
            carve_every_ult: 0.03,
            carve_radius_mult: 1.15,
            carve_power_plain: 1.0,
            carve_power_ult: 3.0,
            push_base: 0.6,
            hold_push: 1.0,
            hold_cost: 20.0,
            clash_drift: 5.0,
            clash_drift_max: 14.0,
            clash_max: 4.0,
            clash_reach: 2.5,
            blast_radius: 6.0,
            blast_damage: 26.0,
            blast_knockback: 34.0,
            blast_loser: 1.5,
            blast_winner: 0.4,
            orb_push: 1.8,
            bot_chance: 0.4,
            bot_willpower: 35.0,
            bot_cost: 25.0,
            max_beams: 12,
            block_damage: 0.05,
        ),
        // Domain expansions (bd_sim::signature::domain; life = domain_life above). The barrier closes over
        // expand_secs (nothing blocks yet: dash out), then seals: a sphere that blocks movement /
        // projectiles / beams both ways, with hp. Inside, the caster's aim assist is maxed (sure_* cone deg,
        // turn deg/s, magnet deg, range m) and their casts cost x cast_cost_mult. Every pulse_every s each
        // enemy inside gets a marker (pulse_telegraph s, pulse_radius m) and the domain's element strikes it
        // (pulse_damage / pulse_knockback x the look's weight; statuses status_secs; blade cuts cut_count x
        // cut_radius; electric chains chain_range; water current_speed, wind gust_speed, earth spike_speed).
        // After it ends: burnout s without casting. Clash: push = sparks spent / push_per_spark (+ hold_push
        // pouring hold_cost/s); the weaker shrinks clash_rate m/s per push, shattering under clash_min_radius.
        // A simple domain (a Guard dome) is immune to the pulses for guard_secs.
        domain: (
            expand_secs: 1.5,
            hp: 900.0,
            burnout: 3.0,
            cast_cost_mult: 0.5,
            pulse_every: 1.4,
            pulse_telegraph: 0.45,
            pulse_radius: 2.4,
            pulse_damage: 7.0,
            pulse_knockback: 6.0,
            status_secs: 1.6,
            cut_radius: 0.55,
            cut_count: 4,
            chain_range: 9.0,
            current_speed: 9.0,
            gust_speed: 14.0,
            spike_speed: 13.0,
            sure_cone_deg: 75.0,
            sure_turn_deg: 1200.0,
            sure_magnet_deg: 20.0,
            sure_range: 60.0,
            push_per_spark: 25.0,
            hold_push: 1.0,
            hold_cost: 15.0,
            clash_rate: 3.0,
            clash_min_radius: 5.0,
            guard_secs: 3.0,
        ),
    ),
    // FREEDOM (bd_sim::freedom / bd_sim::legendary; hidden, never shown to players). A full shout (typed
    // CAPS / "!!!" or a real yell, equal) adds energy_max_bonus scale / intensity. "make it bigger" resizes
    // by resize_min..resize_max (and the rules' scale range). An unaffordable cast sputters down to
    // sputter_floor of the asked scale (or the form minimum) and drains what's left. Legendary: chance =
    // fresh x personal x (base + (cap - base) x richness); fresh = 0 once anyone cast the phrase this match
    // (else fresh_floor..1 by unseen concept words), richness points / rich_full, personal = 1/(1+uses)^2
    // over personal_window s. A legendary construct: scale x scale, intensity + intensity, integrity x integrity.
    freedom: (
        energy_max_bonus: 0.15,
        resize_min: 0.5,
        resize_max: 2.0,
        sputter_floor: 0.35,
        legendary: (
            base: 0.01,
            cap: 0.12,
            fresh_floor: 0.35,
            rich_full: 5.0,
            personal_window: 45.0,
            scale: 1.2,
            intensity: 0.2,
            integrity: 1.3,
        ),
    ),
    // CASINO (bd_sim::world::interactables; High Roller's slot machines + roulette house spin; hidden,
    // never shown to players). A lever pull (hit it or tether it) costs stake willpower (can't pay =
    // a clunk, nothing lost) and locks that machine for cooldown s; the reels spin spin_secs, then:
    // p_jackpot = willpower refill + next fresh cast legendary, p_bust = harmless comedy (confetti /
    // pie / a bust_hop m/s hop), otherwise a random common graft-only party effect for effect_secs.
    // melee_reach: hand-to-knob reach of swings. House spin: first after house_first s, then every
    // house_every s the lights sweep house_sweep s and light pockets +-house_half_width for house_lit s;
    // standing in them regains house_bonus_per_sec willpower/s.
    casino: (
        stake: 12.0,
        cooldown: 3.0,
        spin_secs: 1.5,
        effect_secs: 20.0,
        p_jackpot: 0.06,
        p_bust: 0.24,
        bust_hop: 7.5,
        melee_reach: 2.6,
        house_first: 20.0,
        house_every: 45.0,
        house_sweep: 3.0,
        house_lit: 10.0,
        house_half_width: 2,
        house_bonus_per_sec: 6.0,
    ),
    // Juggle protection (bd_sim::juggle, COMBAT.md §1a): a hit with knockback >= chain_min_kb m/s (before decay)
    // is a chain hit (all hits a victim takes in one tick = one step). Later hits within window s of the last
    // chain hit: knockback x kb_decay (2nd, 3rd, ...; the last entry repeats), damage x dmg_decay. After max_hits
    // chain hits the victim is guarded for immune_secs s: no knockback / launch, damage x immune_dmg (white
    // hard-light shimmer). Standing on the ground out of tumble, hanging on your own tether or a tech resets it.
    // splats: wall splats are chain hits too (their knockback grows with %; no splat ping-pong).
    juggle: (
        enabled: true,
        chain_min_kb: 14.0,
        window: 1.0,
        kb_decay: [0.6, 0.35],
        dmg_decay: 0.75,
        max_hits: 3,
        immune_secs: 0.7,
        immune_dmg: 0.5,
        splats: true,
    ),
    // WILLPOWER = LAUNCH (bd_sim::launch; host rule MatchRules.willpower_launch, off by default). Knockback of
    // every hit x curve(attacker's bar at hit time): empty_mult at 0 -> mid_mult at mid_frac (linear) -> full_mult
    // at a full bar (shaped by top_exp). Damage % untouched. Passive regen x regen_mult, charging x charge_mult,
    // oath refills x oath_mult. Anti-camp: above leak_above of the bar, leak_per_sec/s after leak_after_secs s
    // without a cast / move (not while charging / reciting), down to that line.
    launch: (
        empty_mult: 0.55,
        mid_mult: 1.0,
        full_mult: 1.35,
        mid_frac: 0.5,
        top_exp: 1.4,
        regen_mult: 0.4,
        charge_mult: 2.2,
        oath_mult: 1.25,
        leak_above: 0.8,
        leak_after_secs: 5.0,
        leak_per_sec: 2.5,
    ),
    giants: (
        enabled: true,
        min_height: 6.0,
        weak_nape: 3.0,
        weak_core: 2.0,
        weak_eye: 2.5,
        blunt_frac: 0.5,
        topple_weak: 1.5,
        weak_pool: 0.5,
        weak_cd: 0.3,
        weak_radius: 0.12,
        stagger_secs: 0.9,
        stagger_immune: 2.0,
        stagger_min: 4.0,
        arm_hp: 0.16,
        leg_hp: 0.22,
        tail_hp: 0.2,
        wing_hp: 0.14,
        limb_margin: 0.08,
        limp_slow: 0.55,
        topple_fall: 0.55,
        topple_down: 2.5,
        topple_rise: 0.8,
        topple_angle: 78.0,
        topple_immune: 6.0,
        leg_recover: 0.5,
        warn_melee: 0.3,
        warn_stomp: 0.4,
        warn_tail: 0.4,
        warn_other: 0.15,
        swipe_arc: 150.0,
        shock_speed: 15.0,
        shock_reach: 1.2,
        shock_band: 1.5,
        shock_height: 0.9,
        foot_radius: 0.12,
        command_hold: 0.25,
        command_cone: 4.0,
        command_range: 160.0,
        focus_secs: 10.0,
        hijack: true,
        hijack_secs: 2.5,
        hijack_reach: 1.5,
        titan_speed: 1.2,
        titan_accel: 0.2,
        titan_stop: 0.12,
        titan_dash: 2.6,
        titan_dash_secs: 0.28,
        titan_charges: 2.0,
        titan_recharge: 5.0,
        titan_torso_lag: 0.12,
    ),
    // POWER-UPS (MatchRules::powerups, bd_sim::pickups; off by default). With the mode on, the gated
    // things need a pickup from the map (without one the phrase comes out small; with one, FULL size
    // and the pickup is spent). One shared timer: a beacon `telegraph` s, then it lies there
    // `ground_life` s; carried `held_life` s (drops on KO). Spots are derived on every map (open
    // ground between the spawns, `spawn_clear` m from them, `spot_spacing` apart) unless `spots` lists
    // points for the map id: spots: [("arena", [(0.0, 12.0, 0.0), ...])].
    pickups: (
        every: 50.0,
        first_after: 20.0,
        telegraph: 5.0,
        ground_life: 40.0,
        held_life: 45.0,
        max_live: 2,
        touch: 1.6,
        weights: [(Giant, 1), (Awakening, 1), (Ultimate, 1)],
        // Giant = kaiju / colossal / creatures `giant_height`+ m tall (a thumping heart);
        // Awakening = a power's transformation and tiers `awakening_min_tier`+ (a swirling orb);
        // Ultimate = signature kinds in `ultimates`, orbital strikes, sky drops `drop_scale`+ m (a star).
        gates: [Giant, Awakening, Ultimate],
        awakening_min_tier: 2,
        ultimates: [Domain, Beam],
        drop_scale: 4.0,
        giant_height: 8.0,
        giant_weak_scale: 1.8,
        spawn_clear: 10.0,
        spot_spacing: 6.0,
        spots: [],
    ),
    // WUKONG (constructs/extend.rs): telescoping weapons (Mechanic::Extends: Ruyi Jingu Bang, power pole,
    // extending sword, stretchy fist). Combos twirl; charged release = thrust (or a falling pillar when aimed
    // down / in the air); RMB into a surface = pole vault (predicted: host-synced), into open air = a jab.
    extend: (
        swing_reach: 1.3,        // m the pole grows at the peak of each combo swing
        combo_kb: 1.15,
        combo_impact: 1.35,
        finisher_dmg: 1.35,      // 3rd hit (overhead windmill) is a heavy hit
        finisher_kb: 1.5,
        thrust_min: 14.0,        // m at the shortest charge
        thrust_max: 34.0,        // m at full charge
        thrust_speed: 300.0,     // tip speed m/s
        thrust_hold: 0.12,
        thrust_retract: 0.16,
        thrust_dmg: 1.9,         // x form damage
        thrust_kb: 34.0,
        thrust_radius: 0.5,
        thrust_impact: 2.2,
        thrust_pierce_mass: 400.0, // constructs lighter than this (kg) are punched through
        thrust_construct_dmg: 45.0,
        pillar_look_y: -0.3,     // aim this far down to slam (grounded)
        pillar_air_look_y: -0.1, // ... in the air
        pillar_len: 24.0,
        pillar_girth: 7.0,
        pillar_rise: 0.3,
        pillar_fall: 0.18,
        pillar_recover: 0.45,
        pillar_width: 2.4,
        pillar_dmg: 2.2,
        pillar_knockup: 30.0,
        pillar_impact: 2.6,
        pillar_shock: 1.9,
        pillar_crater: 1.7,
        pillar_crater_step: 2.8,
        pillar_crater_power: 1.0,
        vault_reach: 7.5,
        vault_speed: 26.0,       // m/s added along the aim mirrored off the surface (never removes speed)
        vault_min_up: 0.5,
        vault_cd: 0.8,
        jab_range: 9.0,
        jab_dmg: 0.8,
        jab_kb: 16.0,
        jab_cd: 0.55,
        creature_radius: 0.7,
        creature_dmg: 1.2,
        creature_kb: 22.0,
    ),
    // LEGENDARY: generic legendary move rules keyed off mechanic / element / form combinations
    // (bd_sim constructs/legend.rs, docs/COMBAT.md §5l). Host-synced: recall flight + the leap are predicted.
    legendary: (
        // ---- recall (Returning melee) ----
        recall_speed: 52.0,      // m/s back to the hand after a tap of RMB
        lodge_secs: 3.0,         // a lodged item comes back by itself after this (s)
        thor_delay: 0.15,        // RMB held this long = recall flight (s)
        thor_drain: 14.0,        // willpower /s while flying
        // ---- call the storm (element != Light, Returning or Heavy) ----
        storm_hold: 1.0,         // LMB held (s) to raise it
        storm_range: 70.0,
        storm_delay: 0.5,        // telegraph before the strike (s)
        storm_cd: 3.5,
        storm_radius: 3.5,
        storm_dmg: 1.6,          // x the form's damage
        storm_kb: 26.0,
        storm_impact: 2.4,
        storm_construct_dmg: 40.0,
        bolt_arcs: 2,            // lightning arcs on to this many more enemies
        bolt_arc_range: 7.0,
        rain_count: 5,           // meteors / icicles
        rain_spread: 4.0,
        rain_interval: 0.11,
        rain_dmg: 0.7,
        linger_secs: 1.6,        // tornado / maw / miasma
        linger_pull: 16.0,
        linger_tick: 0.35,
        linger_dmg: 0.25,
        // ---- ricochet chain (Returning + Ricochet) ----
        chain_max: 3,
        chain_range: 24.0,
        chain_speed: 42.0,
        // ---- deflect (Guard, the sword parry, Blade + Fast swings) ----
        deflect_window: 0.15,
        deflect_cd: 0.6,
        reflect_to_aim: true,    // parried rounds fly along the parrier's aim (else back at the shooter)
        reflect_hitscan_cap: 25.0,
        // ---- blade wave (Blade melee) ----
        wave_min_k: 0.85,        // heavy fraction a released blade heavy needs to fire a crescent
        wave_speed: 48.0,
        wave_range: 36.0,
        wave_half_width: 1.3,
        wave_thick: 0.45,
        wave_dmg: 1.0,
        wave_kb: 16.0,
        wave_impact: 1.6,
        wave_cd: 0.6,
        wave_carve: 0.6,
        wave_carve_step: 2.0,
        wave_carves: 8,
        wave_construct_dmg: 25.0,
        heavy_wave_size: 1.7,
        heavy_wave_speed: 0.7,
        shoot_wave_size: 0.6,    // Blade + Shoots: a small crescent on every swing
        shoot_wave_dmg: 0.45,
        shoot_wave_cd: 0.45,
        // ---- heavy blade (Blade + Heavy) ----
        armor_kb: 0.45,          // knockback kept while armored (never immune)
        leap_hold: 0.45,         // LMB held (s) for the leap and cleave
        leap_up: 13.0,
        leap_fwd: 10.0,
        leap_rise: 0.38,
        leap_dive: 32.0,
        leap_max: 2.5,
        leap_cd: 1.4,
        leap_radius: 5.5,
        leap_dmg: 1.8,
        leap_kb: 26.0,
        leap_impact: 2.6,
        leap_crater: 1.9,
        combo_kb_step: 0.2,
        // ---- chain blades (Whip + Blade, + Pull) ----
        sweep_radius: 9.0,
        sweep_height: 2.5,
        sweep_dmg: 1.2,
        sweep_kb: 15.0,
        sweep_impact: 1.7,
        pull_range: 15.0,
        pull_cone_deg: 14.0,
        pull_speed: 26.0,
        pull_victim: 9.0,
        pull_cd: 0.9,
        // ---- guns ----
        one_shot_dmg: 70.0,      // curated / golden gun with nothing but Shoots
        one_shot_kb: 38.0,
        one_shot_reload: 2.4,
        one_shot_pierce: 1,
        one_shot_chip: 0.9,
        needle_cadence: 0.11,    // rounds whose payload is Homing + Sticky
        needle_speed: 62.0,
        needle_dmg: 2.5,
        needle_turn_deg: 260.0,
        needle_cone_deg: 30.0,
        needle_range: 60.0,
        needle_count: 6,         // needles in one victim = supercombine
        needle_secs: 2.5,
        super_radius: 3.5,
        super_dmg: 30.0,
        super_kb: 30.0,
        grav_range: 24.0,        // Gun + Grab
        grav_cone_deg: 8.0,
        grav_hold: 2.2,
        grav_mass_max: 3000.0,
        grav_player_secs: 0.35,  // a caught player is punted within a beat (never longer than 0.35 s)
        grav_construct_secs: 5.0,
        punt_speed: 40.0,
        punt_blast_range: 7.0,
        punt_blast_cone_deg: 30.0,
        punt_blast_kb: 22.0,
        grav_cd: 0.45,
        stream_range: 28.0,      // Gun + Beam + Pull
        stream_tick: 0.1,
        stream_dmg: 1.4,
        stream_reel: 3.0,
        stream_pull: 70.0,
        stream_secs: 1.3,
        stream_fling: 0.9,
        charge_min: 0.2,         // cannons: tap = pellet, hold = charged blast
        charge_full: 1.2,
        charge_dmg_max: 1.7,
        charge_size_max: 2.4,
        charge_tap_dmg: 0.3,
        bfg_spinup: 0.5,         // Cannon whose payload is Beam + Explodes
        bfg_speed: 18.0,
        bfg_radius: 0.9,
        bfg_life: 4.0,
        bfg_zap_range: 9.0,
        bfg_zap_period: 0.2,
        bfg_zap_dmg: 3.0,
        bfg_blast_radius: 6.0,
        bfg_dmg: 45.0,
        bfg_kb: 30.0,
        bfg_carve: 2.6,
        bfg_cd: 2.2,
    ),
    // TRANSFORMER COMBAT (bd_sim constructs/brawl.rs, docs/COMBAT.md §5d-quater): Devastation-style robot
    // strings, transform attacks, perfect-dodge counters; ARCHETYPES derived from the alt mode's data.
    // Host-synced. Archetype rows omit fields that keep the built-in default (the "car" numbers).
    transformer: (
        combat_transform_secs: 0.3, // a mid-combo transform (s; the full sequence is 0.9)
        combo_window: 0.7,          // after a string hit, Transform = a transform attack (s)
        finisher_secs: 0.4,
        perfect_window: 0.15,       // a hit this early into a boost-step is a perfect dodge (s)
        counter_secs: 1.0,          // the counter window it opens (s): next attack = staggering heavy
        counter_mult: 1.6,
        counter_stun: 0.4,
        dodge_cd: 0.45,
        air_float: 4.0,             // m/s up per air-string hit
        air_hits: 3,                // air hits before the air slam
        launch_stun: 0.25,
        ai_string_gap: 0.9,         // AI followers: pause between strings (s)
        ai_dodge_rate: 0.6,         // AI followers: boost-steps per second when someone is close
        // Ordered: the first rule that matches picks the archetype ("any" lists need one hit; 0 = no bound).
        rules: [
            (to: "helicopter", features_any: [Rotor]),
            (to: "jet", features_any: [Jet]),
            (to: "jet", mechanics_all: [Flies, Thrust]),
            (to: "dino", forms: [Kaiju, Quadruped, Serpent], mechanics_any: [ArticulatedTail, Breath]),
            (to: "colossus", forms: [Kaiju], features_any: [CraneArm, Plow, Drill, Saw]),
