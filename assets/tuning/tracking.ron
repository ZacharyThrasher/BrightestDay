// Tracking + melee/hook presentation (bd_game present/tracking.rs). Hot-reloaded. Missing fields use defaults.
// Defaults = the Rust defaults (a bd_game unit test checks parity). Never shown to players.
(
    // Ring compass: while the nearest enemy (or whoever hit you in the last compass_attacker_secs) is off screen
    // or hidden, the ring fires a sonar dart every dart_period (close..far m -> near..far values) that flies
    // dart_len m toward them and pops into sparks; a tiny needle on the ring's rim faces them. Comfort: constant
    // speed, no sparks. Both off while they're on screen + in sight.
    compass: true,
    compass_attacker_secs: 5.0,
    compass_near: 10.0,
    compass_far: 70.0,
    compass_screen_margin: 0.8,
    compass_fade_rate: 6.0,
    compass_min_forward: 0.35,
    dart_period_near: 1.2,
    dart_period_far: 1.6,
    dart_attacker_period: 0.85,
    dart_secs_near: 0.26,
    dart_secs_far: 0.48,
    dart_attacker_speed: 0.85,
    dart_len: 2.5,
    dart_head: 0.07,
    dart_head_width: 0.04,
    dart_thick: 0.008,
    dart_streak: 0.45,
    dart_emissive_near: 5.0,
    dart_emissive_far: 1.8,
    dart_attacker_boost: 1.3,
    dart_sparks: 5,
    dart_spark_speed: 1.6,
    dart_spark_life: 0.16,
    dart_spark_size: 0.018,
    ring_needle: true,
    ring_radius: 0.02,
    ring_needle_len: 0.016,
    ring_needle_thick: 0.004,
    ring_needle_emissive: 4.5,
    ring_from_light: (0.0, 0.06, 0.02),
    // Lantern beacons: faint pillars on players beyond min_dist (fully in by + fade_dist, out toward max_dist).
    beacon: true,
    beacon_min_dist: 60.0,
    beacon_fade_dist: 20.0,
    beacon_max_dist: 450.0,
    beacon_height: 28.0,
    beacon_px: 0.0026,
    beacon_emissive: 1.4,
    beacon_pieces: 4,
    // Loud-action reveal pings (guns, big summons, charging, heavy hits), drawn through walls.
    reveal: true,
    reveal_secs: 0.6,
    reveal_r0: 0.5,
    reveal_r1: 2.6,
    reveal_thick: 0.05,
    reveal_px: 0.0022,
    reveal_emissive: 1.3,
    reveal_near: 1.2,
    reveal_segments: 24,
    reveal_cooldown: 0.5,
    reveal_min_dist: 4.0,
    reveal_max_dist: 160.0,
    reveal_summon_scale: 3.0,
    reveal_heavy_kb: 18.0,
    reveal_charge_every: 1.2,
    // Speed trails (comfort preset: comfort_secs long, comfort_scale width/brightness).
    trails: true,
    trail_speed: 12.0,
    trail_full_speed: 28.0,
    trail_secs: 0.35,
    trail_thick: 0.09,
    trail_emissive: 2.2,
    trail_comfort_secs: 0.18,
    trail_comfort_scale: 0.6,
    trail_max_segments: 160,
    trail_samples_per_sec: 60.0,
    // Held melee weapon glow while a swing would lunge-connect.
    glow: true,
    glow_flash: 0.22,
    glow_rate: 14.0,
    glow_shimmer: 0.15,
    glow_shimmer_hz: 5.0,
    // Hook-and-strike rope, wraps on the victim, the victim's screen-edge tug arc.
    hook_rope_thick: 0.03,
    hook_rope_emissive: 3.2,
    hook_wrap_radius: 0.55,
    hook_wrap_emissive: 2.6,
    hook_wrap_spin: 2.5,
    tug: true,
    tug_dist: 0.6,
    tug_len: 0.08,
    tug_thick: 0.0045,
    tug_emissive: 2.2,
    tug_edge: 0.85,
    tug_hz: 2.5,
    link_timeout: 12.0,
)
