// Tracking + melee/hook presentation (bd_game present/tracking.rs). Hot-reloaded. Missing fields use defaults.
// Defaults = the Rust defaults (a bd_game unit test checks parity). Never shown to players.
(
    // Enemy compass strip (top of the screen): one pip per enemy at their bearing (+-strip_span_deg, further round
    // clamps to the ends), bigger/brighter when close (pip_far..pip_near m), brighter for your attacker / last target,
    // swelling on their loud actions (not in comfort mode). Shown only while some enemy is off screen or hidden.
    compass: true,
    compass_attacker_secs: 5.0,
    compass_screen_margin: 0.8,
    compass_fade_secs: 0.3,
    strip_width_pct: 33.0,
    strip_top_px: 14.0,
    strip_span_deg: 90.0,
    strip_line_px: 1.0,
    strip_line_alpha: 0.22,
    strip_tick_px: 5.0,
    pip_near: 10.0,
    pip_far: 90.0,
    pip_min_px: 4.0,
    pip_max_px: 10.0,
    pip_alpha_min: 0.35,
    pip_alpha_max: 0.85,
    pip_focus_alpha: 0.15,
    pip_focus_px: 2.0,
    pip_pulse_secs: 0.5,
    pip_pulse_scale: 0.6,
    // Lantern beacons: faint pillars on players beyond min_dist (fully in by + fade_dist, out toward max_dist).
    beacon: true,
    beacon_min_dist: 60.0,
    beacon_fade_dist: 20.0,
    beacon_max_dist: 450.0,
    beacon_height: 28.0,
    beacon_px: 0.0026,
    beacon_emissive: 1.4,
    beacon_pieces: 4,
    // Loud-action reveal pings (guns, big summons, charge start, heavy hits): brief, expanding, thinning rings in the
    // corps colour, drawn through walls and only for players you can't see.
    reveal: true,
    reveal_secs: 0.5,
    reveal_r0: 0.5,
    reveal_r1: 1.8,
    reveal_thick: 0.04,
    reveal_px: 0.0022,
    reveal_emissive: 2.0,
    reveal_near: 1.2,
    reveal_segments: 24,
    reveal_cooldown: 0.5,
    reveal_min_dist: 4.0,
    reveal_max_dist: 160.0,
    reveal_summon_scale: 3.0,
    reveal_heavy_kb: 18.0,
    reveal_charge_every: 0.0,
    reveal_only_hidden: true,
    // Speed trails (comfort preset: comfort_secs long, comfort_scale width/brightness).
    trails: true,
    trail_speed: 12.0,
    trail_full_speed: 28.0,
    trail_secs: 0.35,
    trail_thick: 0.09,
    trail_emissive: 2.2,
    trail_comfort_secs: 0.18,
    trail_comfort_scale: 0.6,
    trail_max_segments: 160,
    trail_samples_per_sec: 60.0,
    // Held melee weapon glow while a swing would lunge-connect.
    glow: true,
    glow_flash: 0.22,
    glow_rate: 14.0,
    glow_shimmer: 0.15,
    glow_shimmer_hz: 5.0,
    // Hook-and-strike rope, wraps on the victim, the victim's screen-edge tug arc.
    hook_rope_thick: 0.03,
    hook_rope_emissive: 3.2,
    hook_wrap_radius: 0.55,
    hook_wrap_emissive: 2.6,
    hook_wrap_spin: 2.5,
    tug: true,
    tug_dist: 0.6,
    tug_len: 0.08,
    tug_thick: 0.0045,
    tug_emissive: 2.2,
    tug_edge: 0.85,
    tug_hz: 2.5,
    link_timeout: 12.0,
)
