// MOVE PRESENTATION GRAMMAR (bd_game present/powers/movefx; docs/toolbox/PRESENTATION.md).
// Hot-reloaded. A move says `fx: "<key>"` (or its power / kit does); the key names a STYLE here.
// A style = a `body` (the closed set of SHAPES in code: Energy Rubber Rigid Smoke Bolt Streak Liquid
// Grain Flame Shard Gust Glitch Paper Halo Void) + colours (sRGB 0..1; `color: None` = the move's own
// colour: juice.color → element → power → corps) + numbers + sounds. Add a key = add a style; no code.
// Sounds are `("manifest name", pitch, gain)`; "" = none. The op's own verb sound (`sounds:`) plays
// under the style's.
(
    beats: (
        gather_secs: 0.12, trace_secs: 0.28, dash_secs: 0.45, ghost_every: 0.05, ghost_life: 0.28,
        shove_secs: 0.16, limb_out: 0.09, limb_hold: 0.06, limb_back: 0.16, reel_secs: 1.1, reel_arrive: 2.2,
        slam_wait: 3.0, motes: 22.0, own_scale: 0.55, max_beats: 96,
    ),
    sounds: (
        blink_depart: ("mv_blink_implode", 1.0, 0.8),
        blink_arrive: ("mv_blink_pop", 1.0, 0.9),
        dash: ("mv_air_tear", 1.0, 0.9),
        skid: ("mv_skid", 1.0, 0.8),
        reel: ("tether_fire", 0.8, 0.9),
        reel_anchor: ("tether_attach", 0.9, 1.0),
        shove: ("mv_shove_wave", 1.0, 1.0),
        crack: ("mv_ground_crack", 1.0, 0.9),
        slam_dread: ("mv_slam_dread", 1.0, 0.8),
        slam_land: ("leap_slam", 1.0, 1.0),
        field: ("mv_field_bloom", 1.0, 0.7),
        cross: ("mv_field_cross", 1.0, 0.6),
        swap: ("mv_swap_clap", 1.0, 0.9),
        time: ("mv_time_tick", 1.0, 0.9),
        explode: ("explosion_small", 1.0, 0.8),
        carve: ("blade_wave", 1.0, 0.9),
        cast: ("presence_shing", 1.0, 0.6),
        beam: ("hook_fire", 0.9, 0.8),
        pulse: ("charge_full", 1.2, 0.5),
    ),
    styles: {
        // ------------------------------------------------------------ hard light (the default)
        "energy": (body: Energy, color: None, core: (1.0, 1.0, 1.0), glow: 3.0, glyph: 0,
            sound: (release: ("presence_shing", 1.1, 0.5))),
        "hardlight": (body: Energy, color: None, core: (0.85, 1.0, 1.0), glow: 3.4, speed: 0.85, size: 0.9, glyph: 1,
            sound: (release: ("mv_hardlight", 1.0, 0.8), impact: ("break_hardlight", 1.2, 0.5))),
        // ------------------------------------------------------------ the two stretches
        // Gum-Gum: elastic from the shoulder, thins as it stretches, wobbles, band-snaps back — boing.
        "rubber": (word: "boing", body: Rubber, color: None, core: (1.0, 0.86, 0.8), dark: (0.55, 0.12, 0.12), glow: 1.6, wobble: 0.24,
            speed: 1.15, glyph: 0,
            sound: (stretch: ("mv_rubber_stretch", 1.0, 1.0), exit: ("mv_rubber_snap", 1.0, 1.0), impact: ("hit_medium", 0.9, 0.7))),
        // Ruyi Jingu Bang: iron shaft, gold bands, telescopes in segments, dead straight — metallic ring.
        "rigid": (word: "clash", body: Rigid, color: Some((1.0, 0.72, 0.18)), core: (1.0, 0.95, 0.7), dark: (0.075, 0.07, 0.08), glow: 2.6,
            speed: 0.8, glyph: 2,
            sound: (stretch: ("mv_rigid_extend", 1.0, 1.0), exit: ("mv_rigid_collapse", 1.0, 0.8), impact: ("mv_rigid_ring", 1.0, 0.9))),
        // Jake the Dog (TV & CARTOONS): soft dog-putty — slow, fat, very floppy, and it SWELLS toward
        // the far end (a car-sized fist); a low doughy stretch, a sloppy flop back. Not rubber, not a pole.
        "putty": (word: "boing", body: Rubber, color: Some((1.0, 0.7, 0.25)), core: (1.0, 0.88, 0.55), dark: (0.45, 0.28, 0.1), glow: 1.0,
            wobble: 0.45, speed: 0.7, size: 1.8, glyph: 0,
            sound: (stretch: ("mv_rubber_stretch", 0.72, 1.0), exit: ("mv_rubber_snap", 0.65, 0.9), impact: ("hit_medium", 0.7, 1.0))),
        // ------------------------------------------------------------ movers
        // Nightcrawler BAMF: purple-black sulphur puff where you were and where you are, a crack.
        "smoke": (word: "bamf", body: Smoke, color: Some((0.35, 0.12, 0.45)), core: (1.0, 0.62, 0.3), dark: (0.12, 0.07, 0.14), glow: 2.0,
            density: 1.2, rise: 0.3, linger: 1.5, glyph: 4,
            sound: (release: ("mv_bamf", 1.0, 1.0), impact: ("mv_bamf", 1.12, 0.8))),
        "speedforce": (word: "zip", body: Streak, color: Some((1.0, 0.82, 0.18)), core: (1.0, 1.0, 0.9), glow: 4.0, jitter: 0.3,
            afterimages: 5, speed: 0.6, linger: 0.7, glyph: 11,
            sound: (release: ("mv_speed_zip", 1.0, 1.0), impact: ("storm_arc", 1.4, 0.4))),
        "lightning": (word: "electric", body: Bolt, color: Some((0.62, 0.78, 1.0)), core: (1.0, 1.0, 1.0), glow: 4.5, jitter: 0.25, speed: 0.7, glyph: 11,
            sound: (release: ("mv_bolt_crack", 1.0, 1.0), impact: ("storm_arc", 1.1, 0.6))),
        "wind": (word: "none", body: Gust, color: Some((0.75, 0.95, 0.85)), core: (1.0, 1.0, 1.0), glow: 1.6, density: 1.2, glyph: 12,
            sound: (release: ("mv_gust", 1.0, 1.0), impact: ("mv_gust", 1.25, 0.6))),
        // ------------------------------------------------------------ dark
        "shadow": (word: "vwump", body: Smoke, color: Some((0.25, 0.1, 0.35)), core: (0.62, 0.32, 0.92), dark: (0.02, 0.01, 0.03), glow: 1.5,
            rise: -0.1, linger: 1.2, glyph: 6,
            sound: (release: ("mv_shadow", 1.0, 1.0), impact: ("mv_shadow", 0.8, 0.8))),
        "ink": (word: "water", body: Liquid, color: Some((0.05, 0.05, 0.08)), core: (0.35, 0.35, 0.45), dark: (0.0, 0.0, 0.0), glow: 0.8,
            wobble: 0.1, glyph: 10,
            sound: (release: ("mv_splash", 0.7, 1.0), impact: ("mv_splash", 0.6, 0.8))),
        "void": (word: "vwump", body: Void, color: Some((0.55, 0.25, 1.0)), core: (0.92, 0.82, 1.0), dark: (0.02, 0.0, 0.04), glow: 3.5, glyph: 12,
            sound: (release: ("final_blow_suck", 1.1, 0.8), impact: ("mv_void_thump", 1.0, 1.0))),
        "cursed": (word: "vwump", body: Flame, color: Some((0.2, 0.25, 0.75)), core: (0.95, 0.2, 0.25), dark: (0.02, 0.02, 0.06), glow: 2.6,
            jitter: 0.15, rise: 0.4, glyph: 6,
            sound: (release: ("mv_cursed", 1.0, 1.0), impact: ("mv_void_thump", 1.2, 0.8))),
        "blood": (word: "water", body: Liquid, color: Some((0.72, 0.02, 0.05)), core: (1.0, 0.3, 0.3), dark: (0.2, 0.0, 0.02), glow: 1.2, glyph: 10,
            sound: (release: ("mv_splash", 0.9, 1.0), impact: ("mv_splash", 0.8, 0.8))),
        // ------------------------------------------------------------ light
        "holy": (word: "shing", body: Halo, color: Some((1.0, 0.9, 0.55)), core: (1.0, 1.0, 0.95), glow: 4.0, rise: 0.5, glyph: 3,
            sound: (release: ("mv_holy", 1.0, 1.0), impact: ("mv_holy", 1.2, 0.7))),
        "chi": (body: Halo, color: Some((0.45, 0.9, 1.0)), core: (1.0, 1.0, 1.0), glow: 3.2, speed: 0.9, glyph: 12,
            sound: (release: ("mv_chi", 1.0, 1.0), impact: ("hit_medium", 1.1, 0.6))),
        "psychic": (body: Halo, color: Some((0.95, 0.4, 0.9)), core: (1.0, 0.9, 1.0), glow: 3.0, glyph: 12,
            sound: (release: ("presence_hum_psychic", 1.4, 0.8), impact: ("reveal_pulse", 1.2, 0.6))),
        // ------------------------------------------------------------ elements
        "fire": (word: "fire", body: Flame, color: Some((1.0, 0.45, 0.1)), core: (1.0, 0.9, 0.5), dark: (0.15, 0.1, 0.08), glow: 3.0, rise: 1.0, glyph: 5,
            sound: (release: ("mv_fire_whoomp", 1.0, 1.0), impact: ("mv_fire_whoomp", 0.8, 0.8))),
        "ice": (word: "ice", body: Shard, color: Some((0.6, 0.85, 1.0)), core: (1.0, 1.0, 1.0), glow: 2.5, glyph: 1,
            sound: (release: ("mv_ice", 1.0, 1.0), impact: ("break_crystal", 1.0, 0.7))),
        "crystal": (word: "crystal", body: Shard, color: Some((0.85, 0.55, 1.0)), core: (1.0, 1.0, 1.0), glow: 3.0, glyph: 1,
            sound: (release: ("mv_crystal", 1.0, 1.0), impact: ("break_crystal", 1.2, 0.7))),
        "water": (word: "water", body: Liquid, color: Some((0.3, 0.6, 1.0)), core: (0.85, 0.95, 1.0), glow: 1.5, glyph: 10,
            sound: (release: ("mv_splash", 1.0, 1.0), impact: ("mv_splash", 1.15, 0.8))),
        "steam": (word: "none", body: Smoke, color: Some((0.95, 0.95, 0.97)), core: (1.0, 1.0, 1.0), dark: (0.8, 0.8, 0.82), glow: 1.0,
            rise: 1.5, linger: 1.1, glyph: 4,
            sound: (release: ("mv_steam", 1.0, 1.0), impact: ("mv_steam", 1.2, 0.6))),
        "sand": (word: "sand", body: Grain, color: Some((0.85, 0.7, 0.45)), core: (1.0, 0.95, 0.8), dark: (0.5, 0.4, 0.25), glow: 0.6,
            density: 1.5, rise: -0.5, glyph: 8,
            sound: (release: ("mv_sand", 1.0, 1.0), impact: ("break_dirt", 1.0, 0.7))),
        "earth": (word: "stone", body: Grain, color: Some((0.55, 0.42, 0.3)), core: (0.9, 0.8, 0.65), dark: (0.3, 0.22, 0.15), glow: 0.5,
            size: 1.4, glyph: 4,
            sound: (release: ("mv_ground_crack", 0.8, 1.0), impact: ("break_stone", 0.9, 0.9))),
        "poison": (word: "none", body: Smoke, color: Some((0.4, 0.85, 0.2)), core: (0.8, 1.0, 0.5), dark: (0.1, 0.2, 0.05), glow: 1.8, rise: 0.2, glyph: 10,
            sound: (release: ("mv_steam", 0.7, 0.9), impact: ("presence_hum_poison", 1.3, 0.6))),
        "atomic": (body: Energy, color: Some((0.3, 1.0, 0.4)), core: (0.9, 1.0, 0.9), glow: 4.2, glyph: 11,
            sound: (release: ("presence_hum_atomic", 1.5, 0.8), impact: ("mv_bolt_crack", 0.7, 0.6))),
        // ------------------------------------------------------------ odd bodies
        "glitch": (word: "none", body: Glitch, color: Some((0.2, 1.0, 0.8)), core: (1.0, 0.2, 0.8), glow: 3.0, density: 1.3, glyph: 7,
            sound: (release: ("mv_glitch", 1.0, 1.0), impact: ("mv_glitch", 1.3, 0.7))),
        "paper": (word: "none", body: Paper, color: Some((0.95, 0.93, 0.85)), core: (1.0, 1.0, 1.0), dark: (0.6, 0.55, 0.5), glow: 0.4,
            density: 1.2, linger: 1.3, glyph: 1,
            sound: (release: ("mv_paper", 1.0, 1.0), impact: ("mv_paper", 1.2, 0.7))),
        "spirit": (word: "none", body: Smoke, color: Some((0.6, 0.95, 1.0)), core: (1.0, 1.0, 1.0), dark: (0.4, 0.7, 0.8), glow: 2.2, rise: 0.8, glyph: 6,
            sound: (release: ("mv_shadow", 1.4, 0.8), impact: ("reveal_pulse", 1.3, 0.5))),
    },
    aliases: {
        "tech": "hardlight", "hard light": "hardlight", "construct": "hardlight", "digital": "glitch", "pixel": "glitch",
        "gum": "rubber", "elastic": "rubber", "stretchy": "rubber", "stretch": "rubber",
        "staff": "rigid", "pole": "rigid", "metal": "rigid", "iron": "rigid", "telescope": "rigid",
        "bamf": "smoke", "sulfur": "smoke", "sulphur": "smoke",
        "speed": "speedforce", "flash": "speedforce",
        "electric": "lightning", "thunder": "lightning", "bolt": "lightning", "electricity": "lightning",
        "dark": "shadow", "darkness": "shadow", "shade": "shadow",
        "light": "holy", "divine": "holy", "radiant": "holy", "angel": "holy",
        "gravity": "void", "black hole": "void", "cosmic": "void",
        "curse": "cursed", "demon": "cursed",
        "flame": "fire", "magma": "fire", "lava": "fire", "ember": "fire",
        "frost": "ice", "snow": "ice", "cold": "ice",
        "air": "wind", "gust": "wind", "storm": "wind",
        "ki": "chi", "aura": "chi", "spirit energy": "chi", "chakra": "chi",
        "stone": "earth", "rock": "earth", "dust": "sand", "ash": "sand",
        "toxic": "poison", "acid": "poison",
        "psionic": "psychic", "mind": "psychic", "telekinesis": "psychic",
        "radiation": "atomic", "nuclear": "atomic",
        "ghost": "spirit", "soul": "spirit",
        "cards": "paper", "petal": "paper", "petals": "paper", "gem": "crystal",
        "liquid": "water", "ocean": "water", "vapor": "steam", "mist": "steam",
    },
    elements: [
        (Fire, "fire"), (Electric, "lightning"), (Ice, "ice"), (Water, "water"), (Wind, "wind"), (Earth, "earth"),
        (Poison, "poison"), (Psychic, "psychic"), (Shadow, "shadow"), (Atomic, "atomic"),
    ],
)
