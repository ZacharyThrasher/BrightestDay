// WEAPON FEEL — weapon classes (docs/COMBAT.md §4f, bd_sim `constructs/weapon_class.rs`).
//
// Every held weapon has a class derived from its data (form, size vs the form's default,
// weight_of, mechanics — never its name): light / medium / heavy / reach / flexible / shield /
// light_gun / heavy_gun. Hot-reloaded with combat.ron.
//
// `classes`: SIM numbers (host-authoritative: the host's copy rides the combat-tuning sync to every
//            client, like combat.ron). Medium is neutral = what every weapon did before classes.
// `feel`:    PRESENTATION only (bd_game `present/weapon_feel.rs`): sounds, trails, camera, body.
//            Never read by the sim; each client uses its own file.
(
    classes: (
        // Knives, daggers, rapiers, fists: fast flicks, a 3-hit string whose last hit crits,
        // jump / dodge / boost cancels the recovery, low knockback, small hit-stop.
        light: (
            speed: 1.2, damage: 0.75, knockback: 0.6, lift: 0.0, impact: 0.6,
            combo: 3, finisher_crit: 1.35, cancel: 0.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Sword, katana, mace, hammer, axe: the form's own moveset, unchanged.
        medium: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Greatswords, warhammers, great axes, anchors: overhead chop <-> wide sweep with a long,
        // readable wind-up; ground speed braked at the start, the strike carries you forward; super
        // armor while winding up / swinging; big launching knockback; whiffs crack the ground; a full
        // charge breaks it (shockwave); heavy to carry.
        heavy: (
            speed: 1.0, damage: 1.1, knockback: 1.4, lift: 0.35, impact: 1.6,
            combo: 2, finisher_crit: 1.0, cancel: 1.0,
            armor: 0.55, brake: 0.45, step: 5.0, step_cap: 11.0,
            carry_speed: 0.88, carry_air: 0.7,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 1.3,
            slam_charge: 0.95, slam_radius: 4.5, slam_damage: 0.8, slam_knockback: 1.3,
            ground_recoil: 1.0,
        ),
        // Spears, quarterstaffs, glaives: thrust, twisting thrust, wide sweep; the tip is the sweet spot.
        // (Telescoping poles — the Ruyi staff — keep their own moveset.)
        reach: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 3, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.34, tip_damage: 1.3, tip_knockback: 1.3, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Whips, chains, nunchaku: the tip cracks.
        flexible: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.25, tip_damage: 1.5, tip_knockback: 1.2, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Shields: the bash steps you in.
        shield: (
            speed: 1.0, damage: 1.0, knockback: 1.15, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 4.0, step_cap: 10.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Pistols, SMGs, shotguns, bows, casting staffs.
        light_gun: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Miniguns, LMGs, rocket launchers, railguns, cannons: heavy to carry, and the recoil
        // shoves you back on the ground too.
        heavy_gun: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0,
            carry_speed: 0.9, carry_air: 0.8,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.8,
        ),
    ),
    feel: (
        light: (
            swish: "swing_swish_light", swish_gain: 0.8, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "hit_crit", whiff: "",
            trail_width: 0.035, trail_secs: 0.09, trail_glow: 7.0,
            cam_drag: 0.0, cam_dip: 0.4, shake: 0.0, fov_punch: 0.0,
            vm_drop: 0.0, vm_tilt: 0.0, two_hand: false, lean: 0.12,
        ),
        medium: (
            swish: "swing_whoosh_medium", swish_gain: 0.75, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "hit_crit", whiff: "",
            trail_width: 0.07, trail_secs: 0.13, trail_glow: 4.0,
            cam_drag: 0.6, cam_dip: 0.8, shake: 0.05, fov_punch: 0.0,
            vm_drop: 0.0, vm_tilt: 0.0, two_hand: false, lean: 0.2,
        ),
        heavy: (
