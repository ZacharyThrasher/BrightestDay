// WEAPON FEEL — weapon classes (docs/COMBAT.md §4f, bd_sim `constructs/weapon_class.rs`).
//
// Every held weapon has a class derived from its data (form, size vs the form's default,
// weight_of, mechanics — never its name): light / medium / heavy / reach / flexible / shield /
// light_gun / heavy_gun. Hot-reloaded with combat.ron.
//
// `classes`: SIM numbers (host-authoritative: the host's copy rides the combat-tuning sync to every
//            client, like combat.ron). Medium is neutral = what every weapon did before classes.
// `feel`:    PRESENTATION only (bd_game `present/weapon_feel.rs`): sounds, trails, camera, body.
//            Never read by the sim; each client uses its own file.
(
    classes: (
        // Knives, daggers, rapiers, fists: fast flicks, a 3-hit string whose last hit crits,
        // jump / dodge / boost cancels the recovery, low knockback, small hit-stop.
        light: (
            speed: 1.2, damage: 0.75, knockback: 0.6, lift: 0.0, impact: 0.6,
            combo: 3, finisher_crit: 1.35, cancel: 0.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0, charge_speed: 1.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Sword, katana, mace, hammer, axe: the form's own moveset, unchanged.
        medium: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0, charge_speed: 1.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Greatswords, warhammers, great axes, anchors: overhead chop <-> wide sweep with a long,
        // readable wind-up; pressing attack plants your feet, holding it slows you, letting go throws you
        // into the strike (all predicted: movement from your input); super
        // armor while winding up / swinging; big launching knockback; whiffs crack the ground; a full
        // charge breaks it (shockwave); heavy to carry.
        heavy: (
            speed: 1.0, damage: 1.1, knockback: 1.4, lift: 0.35, impact: 1.6,
            combo: 2, finisher_crit: 1.0, cancel: 1.0,
            armor: 0.55, brake: 0.45, step: 5.0, step_cap: 11.0, charge_speed: 0.65,
            carry_speed: 0.88, carry_air: 0.7,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 1.3,
            slam_charge: 0.95, slam_radius: 4.5, slam_damage: 0.8, slam_knockback: 1.3,
            ground_recoil: 1.0,
        ),
        // Spears, quarterstaffs, glaives: thrust, twisting thrust, wide sweep; the tip is the sweet spot.
        // (Telescoping poles — the Ruyi staff — keep their own moveset.)
        reach: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 3, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0, charge_speed: 1.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.34, tip_damage: 1.3, tip_knockback: 1.3, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Whips, chains, nunchaku: the tip cracks.
        flexible: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0, charge_speed: 1.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.25, tip_damage: 1.5, tip_knockback: 1.2, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Shields: the bash steps you in.
        shield: (
            speed: 1.0, damage: 1.0, knockback: 1.15, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 4.0, step_cap: 10.0, charge_speed: 1.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Pistols, SMGs, shotguns, bows, casting staffs.
        light_gun: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0, charge_speed: 1.0,
            carry_speed: 1.0, carry_air: 1.0,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.0,
        ),
        // Miniguns, LMGs, rocket launchers, railguns, cannons: heavy to carry, and the recoil
        // shoves you back on the ground too.
        heavy_gun: (
            speed: 1.0, damage: 1.0, knockback: 1.0, lift: 0.0, impact: 1.0,
            combo: 0, finisher_crit: 1.0, cancel: 1.0,
            armor: 1.0, brake: 1.0, step: 0.0, step_cap: 0.0, charge_speed: 1.0,
            carry_speed: 0.9, carry_air: 0.8,
            tip: 0.0, tip_damage: 1.0, tip_knockback: 1.0, crater: 0.0,
            slam_charge: 1.0, slam_radius: 0.0, slam_damage: 0.0, slam_knockback: 0.0,
            ground_recoil: 1.8,
        ),
    ),
    feel: (
        // Knives, daggers, rapiers, fists: a thin high swish, one bright short streak, a crit chime on
        // the string's finisher; barely any camera.
        light: (
            swish: "swing_swish_light", swish_gain: 0.85, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "hit_crit", whiff: "",
            trail_width: 0.035, trail_secs: 0.09, trail_glow: 7.0, trail_lines: 1,
            windup_zoom: 0.0, strike_punch: 0.0, strike_shake: 0.0, hit_shake: 0.02, whiff_shake: 0.0,
            two_hand: false, lean: 0.0, kick: 1.0,
        ),
        medium: (
            swish: "swing_whoosh_medium", swish_gain: 0.8, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "", whiff: "",
            trail_width: 0.07, trail_secs: 0.12, trail_glow: 4.0, trail_lines: 2,
            windup_zoom: 0.0, strike_punch: 0.4, strike_shake: 0.0, hit_shake: 0.05, whiff_shake: 0.1,
            two_hand: false, lean: 0.15, kick: 1.0,
        ),
        // Greatswords, warhammers, great axes, anchors: you hear the weight heave, the view pulls in
        // while you coil and lurches as it comes down, a bone-deep crunch on a connect, the floor
        // cracks on a whiff; a thick long smear; both hands on it; the body throws itself into it.
        heavy: (
            swish: "swing_whoosh_heavy", swish_gain: 1.0, swish_pitch: 1.0,
            hit: "heavy_crunch", hit_gain: 1.0, crit: "", whiff: "ground_crack",
            trail_width: 0.16, trail_secs: 0.2, trail_glow: 2.5, trail_lines: 4,
            windup_zoom: 2.0, strike_punch: 3.0, strike_shake: 0.22, hit_shake: 0.2, whiff_shake: 0.3,
            two_hand: true, lean: 0.45, kick: 1.0,
        ),
        // Spears, quarterstaffs, glaives: an air-dart thrust, a bright ding on a tip hit.
        reach: (
            swish: "swing_thrust", swish_gain: 0.9, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "ricochet_ding", whiff: "",
            trail_width: 0.045, trail_secs: 0.12, trail_glow: 4.5, trail_lines: 1,
            windup_zoom: 0.0, strike_punch: 0.5, strike_shake: 0.0, hit_shake: 0.05, whiff_shake: 0.1,
            two_hand: true, lean: 0.25, kick: 1.0,
        ),
        // Whips, chains: a higher whoosh, a long thin lash, the tip CRACKS on a sweet-spot hit.
        flexible: (
            swish: "swing_whoosh_medium", swish_gain: 0.55, swish_pitch: 1.3,
            hit: "", hit_gain: 0.0, crit: "whip_crack", whiff: "",
            trail_width: 0.03, trail_secs: 0.16, trail_glow: 6.0, trail_lines: 1,
            windup_zoom: 0.0, strike_punch: 0.0, strike_shake: 0.0, hit_shake: 0.04, whiff_shake: 0.0,
            two_hand: false, lean: 0.1, kick: 1.0,
        ),
        shield: (
            swish: "swing_whoosh_medium", swish_gain: 0.6, swish_pitch: 0.8,
            hit: "shield_bash", hit_gain: 0.9, crit: "", whiff: "",
            trail_width: 0.0, trail_secs: 0.0, trail_glow: 0.0, trail_lines: 1,
            windup_zoom: 0.0, strike_punch: 1.2, strike_shake: 0.06, hit_shake: 0.1, whiff_shake: 0.0,
            two_hand: false, lean: 0.3, kick: 1.0,
        ),
        // Pistols, SMGs: a snappy small kick.
        light_gun: (
            swish: "", swish_gain: 0.0, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "", whiff: "",
            trail_width: 0.0, trail_secs: 0.0, trail_glow: 0.0, trail_lines: 1,
            windup_zoom: 0.0, strike_punch: 0.0, strike_shake: 0.0, hit_shake: 0.0, whiff_shake: 0.0,
            two_hand: false, lean: 0.0, kick: 0.8,
        ),
        // Miniguns, LMGs, rockets, railguns: a big shove of a kick, both hands on it.
        heavy_gun: (
            swish: "", swish_gain: 0.0, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "", whiff: "",
            trail_width: 0.0, trail_secs: 0.0, trail_glow: 0.0, trail_lines: 1,
            windup_zoom: 0.0, strike_punch: 0.0, strike_shake: 0.0, hit_shake: 0.0, whiff_shake: 0.0,
            two_hand: true, lean: 0.0, kick: 1.4,
        ),
    ),
)
