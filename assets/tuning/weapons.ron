            trail_width: 0.16, trail_secs: 0.2, trail_glow: 2.5,
            cam_drag: 2.6, cam_dip: 3.2, shake: 0.28, fov_punch: 3.0,
            vm_drop: 0.05, vm_tilt: 0.28, two_hand: true, lean: 0.45,
        ),
        reach: (
            swish: "swing_thrust", swish_gain: 0.8, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "ricochet_ding", whiff: "",
            trail_width: 0.05, trail_secs: 0.12, trail_glow: 4.5,
            cam_drag: 0.3, cam_dip: 0.5, shake: 0.04, fov_punch: 0.0,
            vm_drop: 0.0, vm_tilt: 0.0, two_hand: true, lean: 0.25,
        ),
        flexible: (
            swish: "swing_whoosh_medium", swish_gain: 0.55, swish_pitch: 1.25,
            hit: "", hit_gain: 0.0, crit: "whip_crack", whiff: "",
            trail_width: 0.03, trail_secs: 0.16, trail_glow: 6.0,
            cam_drag: 0.3, cam_dip: 0.4, shake: 0.03, fov_punch: 0.0,
            vm_drop: 0.0, vm_tilt: 0.0, two_hand: false, lean: 0.15,
        ),
        shield: (
            swish: "swing_whoosh_medium", swish_gain: 0.6, swish_pitch: 0.8,
            hit: "shield_bash", hit_gain: 0.9, crit: "hit_crit", whiff: "",
            trail_width: 0.0, trail_secs: 0.0, trail_glow: 0.0,
            cam_drag: 0.4, cam_dip: 1.2, shake: 0.08, fov_punch: 1.0,
            vm_drop: 0.0, vm_tilt: 0.0, two_hand: false, lean: 0.3,
        ),
        light_gun: (
            swish: "", swish_gain: 0.0, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "", whiff: "",
            trail_width: 0.0, trail_secs: 0.0, trail_glow: 0.0,
            cam_drag: 0.0, cam_dip: 0.0, shake: 0.0, fov_punch: 0.0,
            vm_drop: 0.0, vm_tilt: 0.0, two_hand: false, lean: 0.0,
            kick: 0.85, kick_snap: 1.35, shove: 0.0,
        ),
        heavy_gun: (
            swish: "", swish_gain: 0.0, swish_pitch: 1.0,
            hit: "", hit_gain: 0.0, crit: "", whiff: "",
            trail_width: 0.0, trail_secs: 0.0, trail_glow: 0.0,
