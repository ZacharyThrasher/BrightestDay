// IMPACT FRAMES (docs/impact/API.md; bd_game present/impact_frames). Hot-reloaded.
// The anime freeze-frame on the hits that matter: 2-5 frames of a stylised full-screen treatment
// (attacker + victim) or a world-anchored bubble (bystanders), then a snap back with a zoom punch.
// Colours are sRGB 0..1. A new style is data only: add a key under `styles` and reference it from
// `trigger_styles`, `crit_styles`, `element_styles`, a move's `juice: (impact_frame: Some("key"))`,
// or an `ImpactFrameRequest`.
(
    rules: (
        // Flash cap: never more than 3 frames in any second (clamped in code too: WCAG 2.3.1),
        // at least `min_gap` s apart, one per attacker per `same_attacker_gap` s (KO blows excepted).
        max_per_sec: 3,
        min_gap: 0.34,
        same_attacker_gap: 0.8,
        // Reduce flashes = Reduced: at most one per this many seconds.
        reduced_gap: 1.0,
        // Weight 0 -> 2 frames, weight 1 -> 5 frames (of `frame_secs`; 30 fps anime timing).
        hold_frames: (2.0, 5.0),
        frame_secs: 0.0333,
        release_secs: 0.14,
        reduced_release_secs: 0.4,
        reduced_fade_in: 0.1,
        reduced_strength: 0.55,
        reduced_contrast: 0.45,
        bubble_range: 45.0,
        bubble_radius: 4.5,
        bubble_strength: 0.9,
        // Bodies are flashed to emissive ~7 while a frame holds; above this (pre-tonemap) = burned in.
        hot_luma: 5.0,
        release_fov: -4.0,
        move_window: 1.2,
        heavy_melee_min_strength: 0.9,
        ko_min_weight: 0.35,
        trigger_styles: (
            move: "ink",
            crit: "ink",
            ko: "ink",
            signature: "holy",
            counter: "comic",
            heavy_weapon: "ink",
            beam_clash: "glitch",
            domain: "void",
            custom: "ink",
        ),
        crit_styles: {
            "BlackFlash": "black_flash",
            "Spark": "comic",
        },
        // Signature-tier hits by the construct's element (Hollow Purple is Psychic).
        element_styles: {
            Psychic: "void",
            Shadow: "void",
            Light: "holy",
            Fire: "holy",
            Electric: "glitch",
            Atomic: "glitch",
            Water: "ink",
            Ice: "ink",
            Wind: "ink",
            Earth: "ink",
            Poison: "void",
        },
    ),
    styles: {
        // Black Flash: the world goes negative, blood-red paper, black silhouettes, black lightning
        // with red glow bent through distorted space; the sound sucks in, then cracks.
        "black_flash": (
            ink: (0.01, 0.0, 0.0),
            paper: (1.0, 0.16, 0.12),
            accent: (1.0, 0.03, 0.06),
            invert: true,
            threshold: 0.4,
            softness: 0.02,
            levels: 2.0,
            edges: 0.7,
            lines: 0.7,
            line_density: 0.4,
            lightning: 1.0,
            lightning_ink_core: true,
            crack: 0.35,
            chroma: 0.012,
            zoom: 0.08,
            vignette: 0.55,
            exposure: 1.2,
            hold_mult: 1.3,
            hitstop: 0.14,
            sfx_in: [("final_blow_suck", 1.0, 0.7), ("mv_void_thump", 0.8, 0.6)],
            sfx_out: [("mv_bolt_crack", 1.1, 0.8), ("hit_crit", 1.0, 0.7), ("explosion_small", 0.7, 0.55)],
            zaps: 0,
        ),
        // Holy: a white-gold glory with dark-gold silhouettes (the light is so bright the figures
        // go dark against it), soft rays.
        "holy": (
            ink: (0.3, 0.17, 0.02),
            paper: (1.0, 0.96, 0.8),
            accent: (1.0, 0.78, 0.25),
            invert: true,
            threshold: 0.45,
            softness: 0.05,
            levels: 2.0,
            edges: 0.4,
            lines: 0.6,
            line_density: 0.55,
            lightning: 0.0,
            chroma: 0.004,
            zoom: 0.05,
            vignette: 0.0,
            exposure: 1.35,
            hold_mult: 1.1,
            hitstop: 0.08,
            sfx_in: [("mv_holy", 1.0, 1.0)],
            sfx_out: [("hit_heavy", 0.9, 0.8)],
            zaps: 0,
        ),
        // Void: purple negative (Hollow Purple, domains): violet paper, black ink, cyan-magenta split.
        "void": (
            ink: (0.03, 0.0, 0.07),
            paper: (0.72, 0.45, 1.0),
            accent: (0.85, 0.35, 1.0),
            invert: true,
            threshold: 0.42,
            softness: 0.05,
            levels: 2.0,
            edges: 0.6,
            lines: 0.6,
            line_density: 0.35,
            lightning: 0.35,
            lightning_ink_core: false,
            crack: 0.6,
            chroma: 0.016,
            zoom: 0.07,
            vignette: 0.6,
            exposure: 1.15,
            hold_mult: 1.2,
            hitstop: 0.1,
            sfx_in: [("mv_void_thump", 1.0, 0.8), ("mv_air_tear", 0.7, 0.7)],
            sfx_out: [("explosion_big", 0.6, 0.7)],
            zaps: 0,
        ),
        // Ink: sumi brush — washes of grey, wobbling brush edges, splats, paper grain.
        "ink": (
            ink: (0.02, 0.02, 0.03),
            paper: (0.93, 0.9, 0.82),
            accent: (0.75, 0.08, 0.08),
            invert: false,
            threshold: 0.36,
            softness: 0.04,
            levels: 3.0,
            edges: 0.85,
            lines: 0.85,
            line_density: 0.5,
            brush: 1.0,
            chroma: 0.005,
            zoom: 0.06,
            vignette: 0.45,
            exposure: 1.2,
            hold_mult: 1.0,
            hitstop: 0.06,
            sfx_in: [("mv_paper", 0.7, 0.8)],
            sfx_out: [("hit_heavy", 1.0, 0.75)],
            zaps: 0,
        ),
        // Comic: halftone dots, a jagged POW panel, a word.
        "comic": (
            ink: (0.03, 0.03, 0.08),
            paper: (1.0, 0.93, 0.35),
            accent: (1.0, 0.25, 0.15),
            invert: false,
            threshold: 0.3,
            softness: 0.02,
            levels: 2.0,
            edges: 0.8,
            lines: 0.5,
            line_density: 0.4,
            halftone: 0.9,
            panel: 1.0,
            chroma: 0.004,
            zoom: 0.05,
            vignette: 0.2,
            exposure: 1.25,
            hold_mult: 1.0,
            hitstop: 0.05,
            sfx_in: [("hit_heavy", 1.0, 1.1)],
            sfx_out: [("shield_block", 0.7, 1.4)],
            word: Some("hit_light"),
            zaps: 0,
        ),
        // Glitch: torn scanlines, RGB split, cyan/magenta duotone (beam clashes, electric).
        "glitch": (
            ink: (0.0, 0.03, 0.08),
            paper: (0.35, 1.0, 0.95),
            accent: (1.0, 0.1, 0.75),
            invert: false,
            threshold: 0.4,
            softness: 0.03,
            levels: 2.0,
            edges: 0.5,
            lines: 0.35,
            line_density: 0.3,
            glitch: 1.0,
            lightning: 0.4,
            lightning_ink_core: false,
            chroma: 0.03,
            zoom: 0.04,
            vignette: 0.3,
            exposure: 1.2,
            hold_mult: 1.0,
            hitstop: 0.06,
            sfx_in: [("mv_glitch", 1.0, 1.0)],
            sfx_out: [("bfg_zap", 0.7, 1.2)],
            zaps: 4,
        ),
    },
)
