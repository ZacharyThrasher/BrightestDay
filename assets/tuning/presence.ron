// PRESENCE GRAMMAR tuning (bd_game present::presence) — hot-reloaded (save the file in-game).
// Every construct gets the same six beats (GATHER → MANIFEST → MATERIAL → PRESENCE → IMPACT → EXIT),
// scaled by its TIER (a pure function of the recipe: see `tier`) and styled by its ELEMENT.
// CONTRAST is the point: if everything is maxed nothing feels big — keep Tiny/Normal restrained.
// The unit test `shipped_file_parses_and_matches_defaults` keeps this file equal to the Rust defaults.
(
    enabled: true,

    // ---- the tier function ----------------------------------------------------------------------
    // score = cost_weight·log2(cost/cost_ref) + size_weight·log2(scale·∛count / size_ref)
    //       + mechanic bumps + category bias;  < tiny_below Tiny, ≥ big_at Big, ≥ titan_at Titan.
    // Overrides: held/worn capped at held_cap; kaiju / colossal / spectacle ⇒ ≥ Titan;
    // legendary ⇒ ≥ Titan; a spectacle that is a domain / orbital / costs ≥ signature_cost ⇒ Signature.
    tier: (
        cost_ref: 14.0,
        cost_weight: 0.4,
        size_ref: 1.5,
        size_weight: 0.6,
        heavy: 0.6,
        explodes: 0.6,
        drop_from_sky: 1.0,
        heavy_drop: 1.2,
        stomp: 0.4,
        ranged_held: -0.3, // held guns / beams: the shots carry the weight
        structure: -0.4,
        worn: -1.0,
        held: 0.0,
        tiny_below: -0.4,
        big_at: 1.0,
        titan_at: 2.8,
        held_cap: Big,
        signature_cost: 80.0,
    ),

    // ---- per tier: [Tiny, Normal, Big, Titan, Signature] ------------------------------------------
    // gather_*: motes/s drawn in, shell radius (m, × √size ≤ ×4: a few m for a sword → across the map;
    // wide gathers sample the surroundings: leaves / droplets / embers / grit / sky light), travel time
    // of the farthest motes (s), window before the manifest (s), swell sfx.
    // surge: element emissive spike on the construct (0..1) + decay (s). ring: shockwave particles.
    // fov_punch / caster_shake: caster only. flash_light: lumens at the manifest (comfort: flashes).
    // material: element surface strength. idle_rate: motes/s. light: standing element light (lm).
    // hum_gain: idle hum. feel_radius / feel_trauma: bystanders feel it. travel_rumble: trauma/s moving.
    // exit_motes: what it dissolves into. impact_mult: hit juice ×. priority: pools (lights / hums).
    tiers: (
        ( // Tiny: guns, gauntlets, discs, bugs — a flick of motes, no extra sound
            gather_rate: 60.0, gather_radius: 1.2, gather_life: 0.12, gather_secs: 0.1, gather_sfx: "", gather_gain: 0.0,
            surge: 0.35, surge_secs: 0.08, ring: 0, ring_speed: 0.0, burst: 0.0,
            manifest_sfx: "", manifest_gain: 0.0, fov_punch: 0.0, caster_shake: 0.0,
            flash_light: 0.0, flash_range: 0.0, material: 0.35,
            idle_rate: 0.0, light: 0.0, light_range: 0.0, hum_gain: 0.0,
            feel_radius: 0.0, feel_trauma: 0.0, travel_rumble: 0.0,
            exit_motes: 6, impact_mult: 1.0, priority: 1.0,
        ),
        ( // Normal: swords, shields, walls, spears — a crisp gather + "shing"
            gather_rate: 110.0, gather_radius: 2.5, gather_life: 0.2, gather_secs: 0.15, gather_sfx: "", gather_gain: 0.0,
            surge: 0.6, surge_secs: 0.12, ring: 14, ring_speed: 6.0, burst: 0.0,
            manifest_sfx: "presence_shing", manifest_gain: 0.8, fov_punch: 0.0, caster_shake: 0.0,
            flash_light: 0.0, flash_range: 0.0, material: 0.55,
            idle_rate: 1.5, light: 0.0, light_range: 0.0, hum_gain: 0.35,
            feel_radius: 0.0, feel_trauma: 0.0, travel_rumble: 0.0,
            exit_motes: 14, impact_mult: 1.0, priority: 2.0,
        ),
        ( // Big: dragons, big hammers, vehicles — the world notices
            gather_rate: 220.0, gather_radius: 8.0, gather_life: 0.45, gather_secs: 0.45, gather_sfx: "presence_gather_big", gather_gain: 0.9,
            surge: 0.9, surge_secs: 0.2, ring: 32, ring_speed: 12.0, burst: 0.9,
            manifest_sfx: "presence_manifest_big", manifest_gain: 1.0, fov_punch: 1.5, caster_shake: 0.08,
            flash_light: 400000.0, flash_range: 14.0, material: 0.8,
            idle_rate: 6.0, light: 60000.0, light_range: 9.0, hum_gain: 0.6,
            feel_radius: 25.0, feel_trauma: 0.1, travel_rumble: 0.0,
            exit_motes: 36, impact_mult: 1.15, priority: 4.0,
        ),
        ( // Titan: kaiju, giant mechs, meteors, anvils from the sky, legendaries — near Hollow Purple
            gather_rate: 420.0, gather_radius: 22.0, gather_life: 0.9, gather_secs: 1.0, gather_sfx: "presence_gather_titan", gather_gain: 1.0,
            surge: 1.0, surge_secs: 0.3, ring: 64, ring_speed: 22.0, burst: 1.6,
            manifest_sfx: "presence_manifest_titan", manifest_gain: 1.0, fov_punch: 3.5, caster_shake: 0.18,
            flash_light: 1500000.0, flash_range: 30.0, material: 1.0,
            idle_rate: 16.0, light: 200000.0, light_range: 18.0, hum_gain: 0.9,
            feel_radius: 55.0, feel_trauma: 0.28, travel_rumble: 0.35,
            exit_motes: 80, impact_mult: 1.3, priority: 8.0,
        ),
        ( // Signature: domains, orbital strikes, big signature casts (Hollow Purple keeps its own look)
            gather_rate: 520.0, gather_radius: 32.0, gather_life: 1.1, gather_secs: 1.2, gather_sfx: "presence_gather_titan", gather_gain: 1.0,
            surge: 1.0, surge_secs: 0.3, ring: 80, ring_speed: 26.0, burst: 2.0,
            manifest_sfx: "presence_manifest_titan", manifest_gain: 1.0, fov_punch: 4.0, caster_shake: 0.2,
            flash_light: 1500000.0, flash_range: 30.0, material: 1.15,
            idle_rate: 20.0, light: 260000.0, light_range: 22.0, hum_gain: 1.0,
            feel_radius: 70.0, feel_trauma: 0.32, travel_rumble: 0.45,
            exit_motes: 100, impact_mult: 1.4, priority: 10.0,
        ),
    ),

    // ---- per element --------------------------------------------------------------------------
    // color: mote / light colour override (linear rgb, None = the element's grade colour; Light = the
    // caster's corps, gold when legendary). motes / material / light: multipliers. hum: loop cue.
    elements: [
        (Light, (color: None, motes: 1.0, material: 0.8, hum: "presence_hum_light", light: 1.0)),
        (Fire, (color: None, motes: 1.2, material: 1.0, hum: "presence_hum_fire", light: 1.3)),
        (Electric, (color: None, motes: 1.0, material: 1.0, hum: "presence_hum_electric", light: 1.2)),
        (Ice, (color: None, motes: 0.9, material: 1.0, hum: "presence_hum_ice", light: 0.8)),
        (Water, (color: None, motes: 1.0, material: 1.0, hum: "presence_hum_water", light: 0.8)),
        (Wind, (color: None, motes: 1.3, material: 0.9, hum: "presence_hum_wind", light: 0.6)),
        (Earth, (color: None, motes: 1.0, material: 1.0, hum: "presence_hum_earth", light: 0.7)),
        (Poison, (color: None, motes: 1.0, material: 1.0, hum: "presence_hum_poison", light: 0.8)),
        (Psychic, (color: None, motes: 1.0, material: 1.0, hum: "presence_hum_psychic", light: 1.0)),
        (Shadow, (color: None, motes: 0.9, material: 1.0, hum: "presence_hum_shadow", light: 0.5)),
        (Atomic, (color: None, motes: 1.0, material: 1.0, hum: "presence_hum_atomic", light: 1.3)),
    ],

    // ---- motion signatures by mechanic -----------------------------------------------------------
    motion: (
        heavy_land_speed: 6.0, // Heavy: landing faster than this (m/s) cracks the ground
        fast_speed: 12.0, // Fast: speed streaks above this (m/s)
        fast_rate: 40.0,
        downdraft_height: 5.0, // Flies: downdraft dust within this of the ground (m, × √size)
        downdraft_rate: 24.0,
        spin_rate: 30.0, // Spin: air-distortion streaks /s
        unstable_hz: (1.5, 9.0), // Explodes: pulse rate at spawn → end of life
        unstable_surge: 0.6,
    ),

    // ---- continuous gathers (hold-to-grow energy: rasengan, spirit bomb; GatherFx each frame) -------
    // radius = clamp(radius_per_m · size, min, max) · (0.5 + 0.5 · charge);
    // motes/s = min(rate_base + rate_per_m · size, rate_max) · (0.3 + 0.7 · charge).
    hold: (
        radius_per_m: 6.0,
        radius_min: 2.0,
        radius_max: 60.0,
        rate_base: 40.0,
        rate_per_m: 45.0,
        rate_max: 360.0,
        max_streams: 8,
    ),

    // ---- budget (8 players × many constructs) ---------------------------------------------------
    budget: (
        max_lights: 4, // pooled, shadowless (the pool is allocated at startup: max 8)
        max_flash_lights: 2, // (max 4)
        max_hums: 6,
        max_motes_per_frame: 700,
        lod_full: 22.0, // material + idle motes full within this (m, × √size) …
        lod_zero: 70.0, // … gone beyond this
        hum_range: 40.0,
        max_rays_per_frame: 24, // surroundings sampling for wide gathers (all of them together)
        surround_samples: 32,
    ),
)
