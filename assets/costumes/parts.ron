// Generic costume parts for mix-and-match phrases ("gojo with a straw hat", "donatello with a cape",
// "goku wearing sunglasses"). Schema: crates/bd_shapes/src/costume/grammar.rs (`PartDef`).
// `slot` decides what a part replaces: Hair / Headwear (hat + helmet) / Face (mask, eyewear, facial
// hair) / Top / Bottom (legs + feet) / Back (capes, wings, back weapons) / Accessory (hip, arms, …).
// `hair` parts keep the wearer's hair colour; `look` is a patch like a character variant.
[
    // ---------------------------------------------------------------- headwear
    (names: ["straw hat", "strawhat"], slot: Headwear, look: (hat: Straw("e9c75c", "c8202a"))),
    (names: ["cap", "baseball cap", "ball cap"], slot: Headwear, look: (hat: Cap("d02a2a", None))),
    (names: ["cowboy hat", "stetson"], slot: Headwear, look: (hat: Cowboy("8a5a30"))),
    (names: ["wizard hat", "witch hat"], slot: Headwear, look: (hat: Wizard("3a2a8a", "e8c040"))),
    (names: ["top hat", "tophat"], slot: Headwear, look: (hat: TopHat("16161a", "c8202a"))),
    (names: ["fedora"], slot: Headwear, look: (hat: Fedora("5a4030", "2a1a10"))),
    (names: ["crown"], slot: Headwear, look: (hat: Crown("e8c040"))),
    (names: ["tiara"], slot: Headwear, look: (hat: Tiara("e8c040"))),
    (names: ["beanie", "toque"], slot: Headwear, look: (hat: Beanie("3a50a0"))),
    (names: ["headband", "forehead protector", "leaf headband"], slot: Headwear, look: (hat: Headband("22305e", Some("c3c9d2")))),
    (names: ["bandana", "bandanna", "do-rag"], slot: Headwear, look: (hat: Bandana("c8202a"))),
    (names: ["horns", "devil horns"], slot: Headwear, look: (hat: Horns("c8202a"))),
    (names: ["halo"], slot: Headwear, look: (hat: Halo("f8e070"))),
    (names: ["cat ears", "kitty ears", "neko ears"], slot: Headwear, look: (hat: CatEars("f0a0b8"))),
    (names: ["elf ears", "pointy ears"], slot: Headwear, look: (hat: Ears("f2cfb0"))),
    (names: ["hood", "hoodie hood", "cowl hood"], slot: Headwear, look: (hat: Hood("3a3a44"))),
    (names: ["pirate hat", "tricorn", "tricorne"], slot: Headwear, look: (hat: Tricorn("1a1a1e", "e8c040"))),
    (names: ["viking helmet", "horned helmet"], slot: Headwear, look: (helmet: Horned("8a8f99", "f0e8d0"))),
    (names: ["knight helmet", "helm", "great helm"], slot: Headwear, look: (helmet: Knight("a8acb4", Some("c8202a")))),
    (names: ["space helmet", "astronaut helmet", "fishbowl helmet"], slot: Headwear, look: (helmet: Space("f2f2f2", "3a3a50"))),
    (names: ["helmet"], slot: Headwear, look: (helmet: Knight("a8acb4", None))),
    (names: ["winged helmet"], slot: Headwear, look: (hat: Winged("c8cfd8", "f2f2f2"))),
    (names: ["beret"], slot: Headwear, look: (hat: Beret("c8202a"))),
    (names: ["bowler", "bowler hat", "derby"], slot: Headwear, look: (hat: Bowler("16161a"))),
    (names: ["bucket hat"], slot: Headwear, look: (hat: Bucket("d8c890"))),
