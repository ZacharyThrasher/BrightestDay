        "sCs": "r8 o4 {e g+ c+}8 r8 {e g+ c+}8 |", "sGs7": "r8 o4 {d+ f+ g+ b+}8 r8 {d+ f+ g+ b+}8 |", "sFs": "r8 o4 {f+ a c+}8 r8 {f+ a c+}8 |",
