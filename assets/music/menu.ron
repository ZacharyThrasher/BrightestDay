// Main menu — bright and inviting. Our chip arrangement built on the opening of Mozart's
// Eine kleine Nachtmusik (the "Mannheim rocket"), with original Mozart-style answers, a lilting
// second subject in D, and a minor-key development of the rocket motif.
(
    title: "Nachtmusik",
    composer: "Wolfgang Amadeus Mozart (1756-1791)",
    work: "Serenade No. 13 in G major, K. 525 \"Eine kleine Nachtmusik\", I. Allegro (1787)",
    source: "Opening theme from the public-domain score (written from memory of the score); every other bar and the whole arrangement are original to Brightest Day.",
    role: "Main menu",
    key: "G",
    time: (4, 4),
    bpm: 132.0,
    gain_db: -4.0,
    layers: (lead: 0.15, drive: 0.55, base_floor: 0.8),
    channels: [
        (name: "mel", inst: "lead25", stem: Lead, pan: -0.12),
        (name: "hl", inst: "hardlight", stem: Lead, pan: 0.12, echo: (ticks: 72, vol: 0.28)),
        (name: "harm", inst: "harm50", stem: Base, pan: 0.3),
        (name: "arp", inst: "arp", stem: Drive, pan: -0.3),
        (name: "bass", inst: "bass", stem: Base, vol: 0.9),
        (name: "drums", drums: true, stem: Drive),
        (name: "hats", drums: true, stem: Drive, pan: 0.25, vol: 0.8),
    ],
    patterns: {
        // --- melody ---
        "rocket": "o4 g4 r8 d8 g4 r8 d8 | o4 g8 d8 g8 b8 o5 d4 r4 | o5 c4 r8 o4 a8 o5 c4 r8 o4 a8 | o5 c8 o4 a8 f8 a8 d4 r4 |",
        "answer": "o5 d4. c16 o4 b16 o5 c8 o4 b8 a8 g8 | o5 e4. f16 g16 o6 c8 o5 b8 a8 g8 | o5 f8 a8 d8 f8 a8 o6 c8 o5 b8 a8 | o5 g4 b4 g4 r4 |",
        "answer_d": "o5 d4. c16 o4 b16 o5 c8 o4 b8 a8 g8 | o5 e4. f16 g16 o6 c8 o5 b8 a8 g8 | o5 e8 g8 c+8 e8 g8 b8 a8 g8 | o5 f4 a4 f4 r4 |",
        "bmel6": "o5 a4. f16 g16 a8 f8 d8 f8 | o5 g4. e16 f16 g8 e8 c8 e8 | o5 f8 d8 f8 a8 o6 d4 o5 a4 |
                  o5 g8 f8 e8 d8 c4 o4 a4 | o5 b4. a16 g16 g8 f8 e8 d8 | o5 f4 a4 d4 f4 |",
        "bend1": "o5 e8 g+8 b8 o6 d8 c+8 o5 b8 a8 g+8 | o5 a4 e4 c4 o4 a4 |",
        "bend2": "o5 d+8 f+8 a8 o6 c=8 o5 b8 a8 g=8 f+8 | o5 d+4 b4 o4 b4 r4 |",
        "cmel6": "o4 e4 r8 o3 b8 o4 e4 r8 o3 b8 | o4 e8 o3 b8 o4 e8 g8 b4 r4 | o4 a4 r8 e8 a4 r8 e8 |
                  o4 a8 e8 a8 o5 c8 e4 r4 | o5 c4 r8 o4 g8 o5 c4 r8 o4 g8 | o5 c8 o4 g8 o5 c8 e8 g4 r4 |",
        "cmel": "$cmel6 o5 f+8 a8 o6 c8 o5 a8 f+8 d8 c8 o4 a8 | o4 f+8 a8 o5 d8 f+8 a4 r4 |",
        "crun": "o5 d8 e8 f+8 g8 a8 b8 o6 c8 d8 | o6 c8 o5 a8 f+8 d8 c8 o4 a8 f+8 d8 |",
        // --- chord progressions (used by the remixes) ---
        "ch_a": "G | G | D7/F# | D | G | C | D7 | G |",
        "ch_a2": "G | G | D7/F# | D | G | C | A7 | D |",
        "ch_b": "D | A7 | D | A7 | G | D | E7 | A |",
        "ch_b2": "D | A7 | D | A7 | G | D | B7 | B7 |",
        "ch_c": "Em | Em | Am | Am | C | C | D7 | D7 |",
        "ch_c2": "Em | Em | Am | Am | C | C | D7 | D7 |",
        // --- off-beat chord arps ---
        "aG": "[r8 o4 {g b d}8]4 |",
        "aC": "[r8 o4 {c e g}8]4 |",
        "aD": "[r8 o4 {d f+ a}8]4 |",
        "aD7": "[r8 o4 {d f+ a c=}8]4 |",
        "aA7": "[r8 o4 {a c+ e g}8]4 |",
        "aA": "[r8 o4 {a c+ e}8]4 |",
        "aE7": "[r8 o4 {e g+ b d}8]4 |",
        "aEm": "[r8 o4 {e g b}8]4 |",
        "aAm": "[r8 o4 {a c= e}8]4 |",
        "aB7": "[r8 o4 {b d+ f+ a}8]4 |",
        // --- Alberti figures ---
        "alD": "o4 d8 a8 f+8 a8 d8 a8 f+8 a8 |",
        "alA7": "o4 c+8 g8 e8 g8 c+8 g8 e8 g8 |",
        "alG": "o4 b8 o5 g8 d8 g8 o4 b8 o5 g8 d8 g8 |",
        "alB7": "o4 d+8 a8 f+8 a8 d+8 a8 f+8 a8 |",
        // --- octave "drum bass" ---
        "bG": "[o2 g8 o3 g8]4 |",
        "bC": "[o2 c8 o3 c8]4 |",
        "bD": "[o2 d8 o3 d8]4 |",
        "bFs": "[o2 f+8 o3 f+8]4 |",
        "bA": "[o2 a8 o3 a8]4 |",
        "bE": "[o2 e8 o3 e8]4 |",
        "bB": "[o2 b8 o3 b8]4 |",
        // --- drums ---
        "dA": "k4 s4 k8 k8 s4 |",
        "dB": "k8 r8 s8 k8 r8 k8 s4 |",
        "dC": "k8 k8 s4 k8 k8 s8 s8 |",
        "dFill": "k8 s16 s16 s8 s8 m8 m8 t8 t8 |",
        "hh": "[h8]8 |",
        "hh16": "[h16 h16 h8]4 |",
    },
    sections: [
        (name: "intro", bars: 2, parts: {
            "harm": "@arpsoft o4 {g b d}1 | o4 {d f+ a c=}1 |",
            "bass": "$bG $bD",
            "hats": "[$hh]2",
        }),
        (name: "a", bars: 8, parts: {
            "mel": "$rocket $answer",
            "harm": "k-12 $rocket k0 o4 b1 | o5 c1 | o4 a2 o5 c2 | o4 b2 r2 |",
            "arp": "$aG $aG $aD7 $aD $aG $aC $aD7 $aG",
            "bass": "$bG $bG $bFs $bD $bG $bC $bD o2 g8 o3 g8 o2 g8 o3 g8 o2 g4 r4 |",
            "drums": "[$dA]3 $dFill [$dA]3 $dFill",
            "hats": "[$hh]8",
        }),
        (name: "a2", bars: 8, parts: {
            "hl": "$rocket $answer_d",
            "mel": "@lead12 v9 o5 b2 o6 d2 | o6 d2 o5 b2 | o5 a2 o6 c2 | o6 c2 o5 a2 | o5 b1 | o6 c1 | o5 a2 g2 | o5 f2 r2 |",
            "harm": "k-12 $rocket k0 o4 b1 | o5 c1 | o4 a2 o5 c+2 | o4 a2 r2 |",
            "arp": "$aG $aG $aD7 $aD $aG $aC $aA7 $aD",
            "bass": "$bG $bG $bFs $bD $bG $bC $bA $bD",
            "drums": "[$dA]3 $dFill [$dA]3 $dFill",
            "hats": "[$hh]8",
        }),
        (name: "b", bars: 8, key: "D", parts: {
            "mel": "$bmel6 $bend1",
            "harm": "o4 f1 | e1 | f2 a2 | e2 c2 | d1 | d2 f2 | d2 g+2 | c1 |",
            "arp": "$aD $aA7 $aD $aA7 $aG $aD $aE7 $aA",
            "bass": "$bD $bA $bD $bA $bG $bD $bE $bA",
            "drums": "[$dB]7 $dFill",
            "hats": "[$hh]8",
        }),
        (name: "b2", bars: 8, key: "D", parts: {
            "hl": "$bmel6 $bend2",
            "harm": "o4 f1 | e1 | f2 a2 | e2 c2 | d1 | d2 f2 | f+1 | d+2 f+2 |",
            "arp": "@pluck12 $alD $alA7 $alD $alA7 $alG $alD $alB7 $alB7",
            "bass": "$bD $bA $bD $bA $bG $bD $bB $bB",
            "drums": "[$dB]6 $dA $dFill",
            "hats": "[$hh]8",
        }),
        (name: "c", bars: 8, key: "Em", parts: {
            "hl": "$cmel",
            "harm": "o4 g1 | g1 | e1 | e1 | e1 | e1 | c1 | c1 |",
            "arp": "$aEm $aEm $aAm $aAm $aC $aC $aD7 $aD7",
            "bass": "$bE $bE $bA $bA $bC $bC $bD $bD",
            "drums": "[$dC]3 $dFill [$dC]3 $dFill",
            "hats": "[$hh16]8",
        }),
        (name: "c2", bars: 8, key: "Em", parts: {
            "hl": "$cmel6 $crun",
            "mel": "k12 v9 $cmel6 k0 r1 | r1 |",
            "harm": "o4 g1 | g1 | e1 | e1 | e1 | e1 | o4 c1 | o4 c2 o3 a2 |",
            "arp": "$aEm $aEm $aAm $aAm $aC $aC $aD7 $aD7",
            "bass": "$bE $bE $bA $bA $bC $bC $bD $bD",
            "drums": "[$dC]6 $dFill $dFill",
            "hats": "[$hh16]8",
        }),
        (name: "a3", bars: 8, parts: {
            "mel": "$rocket $answer",
            "hl": "k-12 $rocket $answer k0",
            "harm": "o4 d1 | d1 | o4 c1 | c1 | o4 b1 | o5 c1 | o4 a2 o5 c2 | o4 b2 r2 |",
            "arp": "$aG $aG $aD7 $aD $aG $aC $aD7 $aG",
            "bass": "$bG $bG $bFs $bD $bG $bC $bD o2 g8 o3 g8 o2 g8 o3 g8 o2 g4 r4 |",
            "drums": "c4 s4 k8 k8 s4 | [$dA]2 $dFill [$dA]3 $dFill",
            "hats": "[$hh16]8",
        }),
        (name: "end", bars: 2, parts: {
            "mel": "o5 g8 f+8 g8 a8 b8 a8 b8 o6 c8 | o6 d4 o5 g4 g2 |",
            "hl": "k-12 o5 g8 f+8 g8 a8 b8 a8 b8 o6 c8 | o6 d4 o5 g4 g2 |",
            "harm": "o4 a1 | o4 b4 g4 g2 |",
            "arp": "$aD7 o4 {g b d}4 r4 {g b d}2 |",
            "bass": "$bD o2 g4 o3 g4 o2 g2 |",
            "drums": "k8 s8 k8 s8 k8 s16 s16 s8 s8 | c4 k4 c2 |",
            "hats": "$hh r1 |",
        }),
    ],
    order: ["intro", "a", "a2", "b", "b2", "c", "c2", "a3"],
    loop_to: "a",
    ending: "end",
)
