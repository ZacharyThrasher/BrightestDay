// Lobby / waiting room — a chip lullaby. Satie's Gymnopédie No. 1: the swaying Gmaj7 / Dmaj7
// accompaniment and the opening melody, a music-box restatement, and an original Satie-style
// middle section in E dorian.
(
    title: "Gymnopedie",
    composer: "Erik Satie (1866-1925)",
    work: "Trois Gymnopédies, No. 1 \"Lent et douloureux\" (1888)",
    source: "Accompaniment figure and opening melody from the public-domain score (written from memory); the middle section, counter-lines and arrangement are original to Brightest Day.",
    role: "Lobby / waiting",
    key: "D",
    time: (3, 4),
    bpm: 76.0,
    gain_db: -1.8,
    layers: (lead: 0.15, drive: 0.6, base_floor: 0.85),
    channels: [
        (name: "mel", inst: "flute", stem: Lead, pan: -0.1),
        (name: "hl", inst: "hl_bell", stem: Lead, pan: 0.2, echo: (ticks: 144, vol: 0.35)),
        (name: "harm", inst: "arpsoft", stem: Base, pan: 0.15),
        (name: "arp", inst: "pluck12", stem: Drive, pan: -0.3, vol: 0.8),
        (name: "bass", inst: "bass", stem: Base),
        (name: "drums", drums: true, stem: Drive, vol: 0.55),
        (name: "hats", drums: true, stem: Drive, pan: 0.3, vol: 0.45),
    ],
    patterns: {
        // chord progressions (remixes)
        "ch_A": "[Gmaj7 | Dmaj7 |]7 Gmaj7 | D |",
        "ch_B": "[Em7 | Bm7 | Em7 | Bm7 | Gmaj7 | F#m7 | Em7 | A7 |]2",
        "bG": "o2 g2. |", "bD": "o2 d2. |", "bE": "o2 e2. |", "bB": "o2 b2. |", "bFs": "o2 f+2. |", "bA": "o2 a2. |",
        "cG": "r4 o3 {b d f+}2 |", "cD": "r4 o3 {a c+ f+}2 |", "cEm": "r4 o3 {g b d}2 |", "cBm": "r4 o3 {a d f+}2 |",
        "cFm": "r4 o3 {a c+ e}2 |", "cA": "r4 o3 {g c+ e}2 |",
        "xG": "o4 g8 b8 o5 d8 f+8 d8 o4 b8 |", "xD": "o4 f+8 a8 o5 c+8 e8 c+8 o4 a8 |",
        "xEm": "o4 e8 g8 b8 o5 d8 o4 b8 g8 |", "xBm": "o4 f+8 a8 b8 o5 d8 o4 b8 a8 |",
        "xFm": "o4 f+8 a8 o5 c+8 e8 c+8 o4 a8 |", "xA": "o4 e8 g8 a8 o5 c+8 o4 a8 g8 |",
        "dk": "k4 r2 |", "hh": "r4 h4 h4 |",
        // melody
        "m1": "r4 o5 f+4 a4 | o5 g4 f+4 c+4 | o4 b4 o5 c+4 d4 | o4 a2. | o4 f+2.^2. | r2. | r2. |",
        "m2": "r4 o5 f+4 a4 | o5 g4 f+4 c+4 | o4 b4 o5 c+4 d4 | o4 a2. | o5 c+2. | o5 f+2. | o5 e2. | o5 d2. |",
        "mb": "r4 o5 e4 f+4 | o5 d4 c+4 o4 b4 | o4 a4 b4 o5 c+4 | o4 f+2. | r4 o5 d4 e4 | o5 c+4 o4 b4 a4 | o4 g4 a4 b4 | o4 e2. |",
        "mb2": "r4 o5 e4 f+4 | o5 d4 c+4 o4 b4 | o4 a4 b4 o5 c+4 | o4 f+2. | r4 o5 d4 e4 | o5 c+4 o4 b4 a4 | o4 g4 a4 b4 | o5 c+2. |",
        "bells": "r2. | r4 r4 o6 f+4 | r2. | r4 r4 o6 a4 | r2. | r4 r4 o6 e4 | r2. | r4 r4 o6 c+4 |",
        // accompaniment by section
        "accA": "[$cG $cD]7 $cG r4 o3 {a d f+}2 |", "bassA": "[$bG $bD]8", "boxA": "[$xG $xD]8",
        "accB": "[$cEm $cBm $cEm $cBm $cG $cFm $cEm $cA]2",
        "bassB": "[$bE $bB $bE $bB $bG $bFs $bE $bA]2",
        "boxB": "[$xEm $xBm $xEm $xBm $xG $xFm $xEm $xA]2",
    },
    sections: [
        (name: "intro", bars: 4, parts: {
            "harm": "$cG $cD $cG $cD",
            "bass": "$bG $bD $bG $bD",
            "hats": "[$hh]4",
        }),
        (name: "a", bars: 16, parts: {
            "mel": "$m1 $m2",
            "harm": "$accA",
            "bass": "$bassA",
            "arp": "$boxA",
            "drums": "[$dk]16",
            "hats": "[$hh]16",
        }),
        (name: "b", bars: 16, parts: {
            "mel": "$mb $mb2",
            "hl": "[$bells]2",
            "harm": "$accB",
            "bass": "$bassB",
            "arp": "$boxB",
            "drums": "[$dk]16",
            "hats": "[$hh]16",
        }),
        (name: "a2", bars: 16, parts: {
            "hl": "k12 $m1 $m2 k0",
            "mel": "v8 $m1 $m2",
            "harm": "$accA",
            "bass": "$bassA",
            "arp": "$boxA",
            "drums": "[$dk]16",
            "hats": "[$hh]16",
        }),
        (name: "end", bars: 4, parts: {
            "mel": "r4 o5 f+4 a4 | o5 g4 f+4 c+4 | o5 d2.^2. |",
            "hl": "r2. | r2. | o6 d2. | r2. |",
            "harm": "$cG $cD r4 o3 {a d f+}2 | o3 {a d f+}2. |",
            "bass": "$bG $bD o2 d2.^2. |",
        }),
    ],
    order: ["intro", "a", "b", "a2"],
    loop_to: "a",
    ending: "end",
)
