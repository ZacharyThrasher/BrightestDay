            "drums": "c4 s4 k8 s8 | [k8 k8 s4 k8 s8 |]6 k8 s8 s8 s16 s16 m8 t8 | $dA", "hats": "[h16 h16 h8 h16 h16 h8 h8 h8 |]16",
        }),
        (name: "end", bars: 2, parts: {
