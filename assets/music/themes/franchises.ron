    (name: "space", title: "Space opera (laser-sword knights, armoured hunters)", theme: "distant_stars_march",
     ids: ["kit_jedi", "kit_sith", "kit_mandalorian"]),
    (name: "critters", title: "Pocket creatures and their trainers", theme: "tall_grass_trek",
     ids: ["ssb_pikachu", "*_pokemon", "dk_ash_ketchum", "dk_ash_s_pikachu", "dk_abra_kadabra", "dk_aerodactyl", "dk_alakazam",
           "dk_arcanine", "dk_articuno", "dk_beedrill", "dk_blastoise", "dk_blaziken", "dk_butterfree", "dk_charmander",
           "dk_clefairy", "dk_cubone", "dk_ditto", "dk_dragonite", "dk_electrode", "dk_espeon", "dk_flareon", "dk_garchomp",
