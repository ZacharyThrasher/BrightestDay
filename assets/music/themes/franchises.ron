           "dk_infernape", "dk_jolteon", "dk_koffing", "dk_lapras", "dk_leafeon", "dk_lucario", "dk_lugia", "dk_machamp",
           "dk_meowth", "dk_mew", "dk_mimikyu", "dk_moltres", "dk_mr_mime", "dk_nidoking", "dk_ninetales", "dk_pichu",
           "dk_pidgeot", "dk_psyduck", "dk_raichu", "dk_rayquaza", "dk_sceptile", "dk_scyther", "dk_slowpoke", "dk_starmie",
           "dk_sylveon", "dk_tauros", "dk_tentacruel"]),
