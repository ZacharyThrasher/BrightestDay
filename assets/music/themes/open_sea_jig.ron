// Open Sea Jig — franchise theme for the pirate-adventure powers (devil fruits, straw-hat crew
// kits, haki). ORIGINAL composition for Brightest Day, written from scratch. Genre cues only: a
// swashbuckling shanty jig in 12/8 (the 6/8 lilt, two bars to the line), brassy square and
// hard-light brass leads, an accordion-ish organ, oom-pah-pah chip harmony and a stamping deck beat.
// No melody, hook, bassline or lyric of any existing theme is quoted or paraphrased.
// Structure: sting (horn call) | a (jig verse) b (anthem) c (storm, B minor) b2 (full crew) | end.
(
    title: "Open Sea Jig",
    composer: "Brightest Day (original)",
    work: "Franchise theme: pirate adventure",
    source: "Original composition: melody, harmony, bass, drums and arrangement written for Brightest Day. Genre cues only (12/8 shanty lilt, brass chip leads).",
    role: "Franchise theme: pirate-adventure powers and kits",
    key: "D",
    time: (12, 8),
    bpm: 156.0,
    gain_db: -4.8,
    layers: (lead: 0.15, drive: 0.55, base_floor: 0.8),
    channels: [
        (name: "lead", inst: "lead50", stem: Lead, pan: -0.12),
        (name: "brass", inst: "hl_brass", stem: Lead, pan: 0.18, vol: 0.8, echo: (ticks: 144, vol: 0.18)),
        (name: "organ", inst: "hl_organ", stem: Base, pan: 0.25, vol: 0.35),
        (name: "harm", inst: "arp30", stem: Base, pan: -0.2, gen: "o4 [r8 X8 X8]4 |"),
        (name: "bass", inst: "bass", stem: Base, gen: "o2 u4 R4. F4. R4. F4. |"),
        (name: "drums", drums: true, stem: Drive, vol: 1.1, gen: "k4. s4. k4 k8 s4. |"),
        (name: "hats", drums: true, stem: Drive, pan: 0.25, vol: 0.55, gen: "[h8 h8 o8]4 |"),
    ],
    patterns: {
        "chA": "D | D | G | A | D | Bm | G A | D |",
        "chB": "G | D | A | Bm | G | D | Em A | D |",
        "chC": "Bm | G | D | A | Bm | G | Em | A |",
        // ---- tunes (all original) ----
        "mA": "o5 d8 f8 a8 a4 f8 g8 a8 b8 a4. | o5 a8 f8 d8 e8 f8 g8 f4. e4. | o5 d8 g8 b8 b4 a8 g8 a8 b8 o6 d4. |
               o6 c4 o5 b8 a4 g8 f4. e4. | o5 d8 f8 a8 o6 d4 c8 o5 b8 a8 f8 a4. | o5 b8 a8 f8 d4 f8 e8 f8 b8 b4. |
               o5 g8 a8 b8 a4 g8 a8 b8 o6 c8 e4. | o6 d4. o5 a4. o6 d4 r8 r4. |",
        "mB": "o5 b4. o6 d4. d4 c8 o5 b4. | o5 a2. f4 a8 d4. | o5 e4. a4. o6 c4 d8 e4. | o6 f2. d4. o5 b4. |
               o5 b4. o6 d4. g4 f8 e4. | o6 f4. d4. o5 a4. f4. | o5 g4. b4. a4. o6 c4. | o6 d2. r2. |",
        "mC": "o4 b8 b8 b8 o5 d4 f8 b4. a4. | o5 g4. d4. e8 f8 g8 a4. | o5 f4. a4. o6 d4 c8 o5 a4. | o5 e2. r2. |
               o5 b8 b8 b8 o6 d4 c8 o5 b4. f4. | o5 g4. b4. o6 d4 e8 d4. | o5 e4. g4. b4 a8 g4. | o5 a2. o6 c4. e4. |",
        // low brass answers in the storm
        "cC": "o4 f2. f4. d4. | o4 d2. b4. g4. | o4 a2. f4. a4. | o4 c2. e4. a4. |
               o4 f2. f4. d4. | o4 d2. b4. g4. | o4 g2. e4. g4. | o4 e2. c4. e4. |",
    },
    sections: [
        // The sting: a two-bar horn call over a drum roll.
        (name: "sting", bars: 2, chords: "A | A |", parts: {
            "lead": "o5 a4. o6 d4. f4. a4. | o6 a2. r4. o5 a8 b8 o6 c8 |",
            "brass": "o5 e4. a4. o6 d4. e4. | o6 e2. r2. |",
            "drums": "t8 t8 t8 m8 m8 m8 s8 s8 s8 [s16]6 | c4. r4. r4. s8 s8 s8 |",
        }),
        (name: "a", bars: 8, chords: "$chA", mute: ["organ"], parts: { "lead": "$mA", "hats": "[h8 r8 h8]32 |" }),
        (name: "b", bars: 8, chords: "$chB", parts: { "lead": "$mB", "brass": "k-12 $mB k0", "organ": "o4 [Y2. Y2. |]8" }),
        (name: "c", bars: 8, chords: "$chC", parts: {
            "brass": "$mC", "lead": "@lead25 $cC",
            "drums": "[t4. t4. k4 k8 s4. |]7 t8 t8 t8 m8 m8 m8 s8 s8 s8 s8 s8 s8 |",
        }),
        (name: "b2", bars: 8, chords: "$chB", parts: { "lead": "$mB", "brass": "$mB", "organ": "o4 [Y2. Y2. |]8",
            "drums": "c4. s4. k4 k8 s4. | [k4. s4. k4 k8 s4. |]6 k4. s4. s8 s8 s8 [s16]6 |" }),
        (name: "end", bars: 2, chords: "D | D |", mute: ["hats"], parts: {
            "lead": "o6 d4. o5 a4. f4. a4. | o6 d2. r2. |",
            "brass": "o5 f4. d4. o4 a4. o5 d4. | o5 a2. r2. |",
            "drums": "k4. s4. k4. s4. | c2. r2. |",
        }),
    ],
    order: ["sting", "a", "b", "c", "b2"],
    loop_to: "a",
    ending: "end",
)
