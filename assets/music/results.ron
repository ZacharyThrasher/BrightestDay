// Results / podium — Ode to Joy as a set of chip variations: first alone on the triangle (as the
// basses first sing it), then with a hard-light counter-line, then as a full march, and finally
// lifted a step to E on hard-light brass before turning home to D.
(
    title: "Ode to Joy",
    composer: "Ludwig van Beethoven (1770-1827)",
    work: "Symphony No. 9 in D minor, Op. 125, IV. — \"Freude, schöner Götterfunken\" (Ode to Joy) theme (1824)",
    source: "Theme (all 16 bars) from the public-domain score (written from memory); counter-lines, harmony, variations and arrangement original to Brightest Day.",
    role: "Results / podium",
    key: "D",
    time: (4, 4),
    bpm: 120.0,
    gain_db: -4.0,
    layers: (lead: 0.15, drive: 0.5, base_floor: 0.85),
    channels: [
        (name: "mel", inst: "lead25", stem: Lead, pan: -0.1),
        (name: "hl", inst: "hardlight", stem: Lead, pan: 0.15, echo: (ticks: 72, vol: 0.25)),
        (name: "harm", inst: "arpsoft", stem: Base, pan: 0.25),
        (name: "arp", inst: "pluck12", stem: Drive, pan: -0.3, vol: 0.75),
        (name: "bass", inst: "bass", stem: Base),
        (name: "drums", drums: true, stem: Drive),
        (name: "hats", drums: true, stem: Drive, pan: 0.25, vol: 0.7),
    ],
    patterns: {
        // chord progressions (remixes)
        "ch_ode": "D G | A | D | A | D G | A | D | A D | A D | D | A | D A | D G | A | D | A D |",
        "odeA": "o5 f+4 f+4 g4 a4 | a4 g4 f+4 e4 | d4 d4 e4 f+4 | f+4. e8 e2 |",
        "odeA2": "o5 f+4 f+4 g4 a4 | a4 g4 f+4 e4 | d4 d4 e4 f+4 | e4. d8 d2 |",
        "odeB": "o5 e4 e4 f+4 d4 | e4 f+8 g8 f+4 d4 | e4 f+8 g8 f+4 e4 | d4 e4 o4 a2 |",
        "ode": "$odeA $odeA2 $odeB $odeA2",
        "ode15": "$odeA $odeA2 $odeB o5 f+4 f+4 g4 a4 | a4 g4 f+4 e4 | d4 d4 e4 f+4 |",
        "cA": "o4 a2 o5 d2 | o5 c+2 o4 a2 | o4 f+2 a2 | o4 a2 o5 c+2 |",
        "cA2": "o4 a2 o5 d2 | o5 c+2 o4 a2 | o4 f+2 a2 | o4 g2 f+2 |",
        "cB": "o4 c+2 e2 | o4 d2 f+2 | o4 e2 c+2 | o4 f+2 e2 |",
        "counter": "$cA $cA2 $cB $cA2",
        "pD": "o4 {d f+ a}1 |", "pA": "o4 {c+ e a}1 |", "pA7": "o4 {c+ e g a}1 |", "pAD": "o4 {c+ e g a}2 {d f+ a}2 |", "pDA": "o4 {d f+ a}2 {c+ e a}2 |",
        "bD": "o2 d4 a4 d4 a4 |", "bA": "o2 a4 o3 e4 o2 a4 o3 e4 |", "bAD": "o2 a4 o3 e4 o2 d4 a4 |", "bDA": "o2 d4 a4 a4 o3 e4 |",
        "aD": "[o5 d8 f+8 a8 f+8]2 |", "aA": "[o5 c+8 e8 a8 e8]2 |", "aA7": "[o5 c+8 e8 g8 e8]2 |", "aAD": "o5 c+8 e8 g8 e8 d8 f+8 a8 f+8 |",
        "aDA": "o5 d8 f+8 a8 f+8 c+8 e8 a8 e8 |",
        "P15": "$pD $pA $pD $pA $pD $pA $pD $pAD o4 {c+ e a}2 {d f+ a}2 | $pD $pA $pDA $pD $pA $pD",
        "B15": "$bD $bA $bD $bA $bD $bA $bD $bAD $bAD $bD $bA $bDA $bD $bA $bD",
        "A15": "$aD $aA $aD $aA $aD $aA $aD $aAD $aAD $aD $aA $aDA $aD $aA $aD",
        "march": "[k4 s4 k4 s4 |]7 k8 k8 s8 s8 t8 t8 m8 m8 |",
        "hh": "[[h8]8 |]8",
    },
    sections: [
        (name: "intro", bars: 2, parts: {
            "harm": "o4 {d f+ a}1 | o4 {c+ e g a}1 |",
            "bass": "o2 d1 | o2 a1 |",
            "hl": "@hl_bell o6 d4 a4 f+4 d4 | o5 a4 e4 c+4 o4 a4 |",
        }),
        (name: "v1", bars: 16, parts: {
            "bass": "@flute k-24 $ode k0",
            "harm": "v7 $P15 $pAD",
        }),
        (name: "v2", bars: 16, parts: {
            "mel": "$ode", "hl": "$counter",
            "harm": "$P15 $pAD", "bass": "$B15 $bAD",
            "hats": "[r4 h4 r4 h4 |]16",
        }),
        (name: "v3", bars: 16, parts: {
            "hl": "$ode", "mel": "@lead12 v8 k12 $counter k0",
            "harm": "$P15 $pAD", "bass": "$B15 $bAD", "arp": "$A15 $aAD",
            "drums": "c4 s4 k4 s4 | [k4 s4 k4 s4 |]6 k8 k8 s8 s8 t8 t8 m8 m8 | $march", "hats": "$hh $hh",
        }),
        (name: "v4", bars: 16, parts: {
            "hl": "@hl_brass k2 $ode15 k0 o5 f+4. e8 e2 |", "mel": "k2 $cA $cA2 $cB o4 a2 o5 d2 | o5 c+2 o4 a2 | o4 f+2 a2 | k0 o4 g2 a2 |",
            "harm": "k2 $P15 k0 $pA7", "bass": "k2 $B15 k0 $bA", "arp": "k2 $A15 k0 $aA7",
            "drums": "c4 s4 k4 s4 | [k4 s4 k4 s4 |]6 k8 k8 s8 s8 t8 t8 m8 m8 | [k4 s4 k4 s4 |]7 s16 s16 s16 s16 s8 s8 t8 t8 m8 m8 |",
            "hats": "[[h16 h16 h8]4 |]16",
        }),
        (name: "end", bars: 2, parts: {
            "hl": "o5 e4. d8 d2 | o5 d1 |",
            "mel": "o4 g2 f+2 | o4 f+1 |",
            "harm": "$pAD o4 {d f+ a}1 |",
            "bass": "$bAD o2 d1 |",
            "arp": "$aAD o5 d4 a4 o6 d2 |",
            "drums": "k8 k8 s8 s8 t8 t8 m8 m8 | c1 |",
        }),
    ],
    order: ["intro", "v1", "v2", "v3", "v4"],
    loop_to: "v2",
    ending: "end",
)
