            "arp": "k12 @pluck12 [r8 o4 e8]4 | [r8 o4 e8]4 | [r8 o4 e8]4 | [r8 o4 f8]4 | [r8 o4 e8]4 | [r8 o4 e8]4 | [r8 o4 e8]4 | [r8 o4 f8]4 |",
            "drums": "[k4 r4 k4 r4 |]7 k4 s4 k8 s8 s8 s8 |",
