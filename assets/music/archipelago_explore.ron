        "hR": "[h8]8 | [h8]8 | [h8]8 | [h8]4 o4 h8 h8 |",
        // birds
        "birds": "o6 e2. r4 | o5 b2. r4 | o6 d2. r4 | o6 e2 r2 | o6 c2. r4 | o5 a2 b2 | o6 d2 f2 | o6 e1 |",
        "chirps": "r2 o6 b16 g16 b16 g16 e8 r8 | r2 o6 g16 e16 g16 e16 o5 b8 r8 | r2 o6 a16 f16 a16 f16 d8 r8 | r2 o6 b16 g16 e16 g16 b8 r8 |
                   r2 o6 a16 e16 c16 e16 a8 r8 | r2 o6 c16 o5 a16 o6 d16 o5 b16 o6 d8 r8 | r2 o6 f16 d16 a16 f16 b8 r8 | r2 o6 g16 b16 o7 e8 r4 |",
        "birdH": "@glass o4 b1 | g1 | a1 | g1 | a1 | a2 b2 | a1 | g1 |",
