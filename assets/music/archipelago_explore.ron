// Archipelago (exploration) — Vivaldi's Spring, first movement: the ritornello, then original
// chip episodes in the spirit of the sonnet it paints: birdsong (trilled pulse + hard-light
// chirps), murmuring brooks (16th-note arpeggios), and a thunderstorm in C# minor.
(
    title: "Spring",
    composer: "Antonio Vivaldi (1678-1741)",
    work: "The Four Seasons, Violin Concerto in E major RV 269 \"La primavera\", I. Allegro (1725)",
    source: "Ritornello opening from the public-domain score (written from memory); episodes, harmony and arrangement original to Brightest Day.",
    role: "Archipelago map — exploration",
    key: "E",
    time: (4, 4),
    bpm: 104.0,
    gain_db: -4.8,
    layers: (lead: 0.15, drive: 0.55, base_floor: 0.8),
    instruments: {
        // Whole-tone trill (a chip arp macro) for the birds.
        "trill": (wave: Pulse, duty: 0.125, attack: 0.004, decay: 0.5, sustain: 0.55, release: 0.1, vol: 0.62,
                  arp: [0, 2], arp_rate: 16.0, lp_hz: 6000.0),
    },
    channels: [
        (name: "mel", inst: "lead25", stem: Lead, vol: 1.15, pan: -0.12),
        (name: "hl", inst: "hardlight", stem: Lead, vol: 1.15, pan: 0.14, echo: (ticks: 72, vol: 0.25)),
        (name: "harm", inst: "arp30", stem: Base, pan: 0.25),
        (name: "arp", inst: "pluck12", stem: Drive, pan: -0.3, vol: 0.8),
        (name: "bass", inst: "bass", stem: Base, vol: 0.9),
        (name: "drums", drums: true, stem: Drive, vol: 0.9),
        (name: "hats", drums: true, stem: Drive, pan: 0.25, vol: 0.75),
    ],
    patterns: {
        "rit": "o5 g8 g8 g8 f16 e16 b4. b16 a16 | o5 g8 g8 g8 f16 e16 b4. b16 a16 |
                o5 g8 a16 b16 a8 g8 f4 d8 o4 b8 | o5 g8 a16 b16 a8 g8 f8 d8 e4 |",
        "rit_lo": "o5 e8 e8 e8 d16 c16 g4. g16 f16 | o5 e8 e8 e8 d16 c16 g4. g16 f16 |
                   o5 e8 f16 g16 f8 e8 d4 o4 b8 g8 | o5 e8 f16 g16 f8 e8 d8 o4 b8 g4 |",
        "ritH": "o4 {g b e}1 | o4 {g b e}1 | o4 {g b e}2 {d f a b}2 | o4 {g b e}2 {d f a b}4 {g b e}4 |",
        "ritB": "[o2 e8]8 | [o2 e8]8 | [o2 e8]4 [o2 b8]4 | [o2 e8]4 o2 b8 b8 e8 e8 |",
        "ritX": "[o4 e16 g16 b16 g16]4 | [o4 e16 g16 b16 g16]4 | [o4 e16 g16 b16 g16]2 [o4 d16 f16 a16 f16]2 |
