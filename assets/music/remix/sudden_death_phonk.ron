// Mountain King — phonk. The theme on a pitched FM cowbell over distorted sliding 808s, accelerating
// from 118 to a 138 loop; the troll chase gets the saw.
(
    title: "Mountain King (Phonk)",
    base: "sudden_death",
    style: "phonk",
    bpm: 138.0,
    gain_db: -4.4,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.55, base_floor: 0.85),
    pump: (depth_db: 4.0, release: 0.15, stems: [Base]),
    adaptive: (explore_cutoff: 800.0, build_bars: 1),
    channels: [
        (name: "lead", inst: "rx_cowbell", stem: Lead, echo: (ticks: 48, vol: 0.25)),
        (name: "lead2", inst: "rx_saw", stem: Drive, vol: 0.5),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "$trap_pad"),
        (name: "808", inst: "rx_808", stem: Base, gen: "$phonk_808"),
        (name: "kick", drums: true, stem: Drive, gen: "$phonk_kick"),
        (name: "clap", drums: true, stem: Drive, gen: "$phonk_clap"),
        (name: "hats", drums: true, stem: Drive, gen: "$phonk_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, bpm: 118.0, chords: "Bm | Bm | F# | F# |", mute: ["kick", "clap"]),
        (name: "creep", bars: 8, bpm: 118.0, accel_to: 128.0, chords: "$ch_thA $ch_thA", mute: ["clap"],
         parts: { "lead": "k12 $thA $thA k0" }),
        (name: "rise", bars: 8, bpm: 128.0, accel_to: 138.0, chords: "$ch_thA $ch_thB", parts: { "lead": "k12 $thA k0 $thB" }),
        (name: "a", bars: 8, chords: "$ch_thA $ch_thB", parts: { "lead": "k12 $thA k0 $thB", "lead2": "$thA k-12 $thB k0" }),
        (name: "b", bars: 8, chords: "$ch_troll", parts: { "lead": "k-12 $troll k0", "lead2": "$troll" }),
        (name: "a2", bars: 8, chords: "$ch_thA $ch_thB", parts: { "lead": "k12 $thA k0 $thB", "lead2": "$thA k-12 $thB k0" }),
        (name: "end", bars: 2, chords: "Bm | Bm |", mute: ["hats", "clap"],
         parts: { "lead": "o5 b4 r4 o4 b4 r4 | r1 |", "kick": "K4 r2. | r1 |", "808": "o1 u4 R1 | r1 |" }),
    ],
    order: ["intro", "creep", "rise", "a", "b", "a2"],
    loop_to: "a",
    ending: "end",
)
