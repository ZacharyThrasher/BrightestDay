// Gymnopédie — synthwave. Night-drive tempo, dual-saw lead with echo, gated snare, octave-pumping
// saw bass and a 16th pluck arpeggio; the Satie sevenths become neon pads.
(
    title: "Gymnopedie (Synthwave)",
    base: "lobby",
    style: "synthwave",
    bpm: 100.0,
    gain_db: -0.9,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    pump: (depth_db: 3.0, release: 0.22, stems: [Base]),
    adaptive: (explore_cutoff: 900.0, build_bars: 2),
    channels: [
        (name: "lead", inst: "rx_dualsaw", stem: Lead, echo: (ticks: 72, vol: 0.3)),
        (name: "bell", inst: "hl_bell", stem: Lead, pan: 0.35, vol: 0.5),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "o3 X1 |"),
        (name: "bass", inst: "rx_synthbass", stem: Base, gen: "$sw_bass"),
        (name: "arp", inst: "rx_pluck", stem: Drive, pan: -0.3, gen: "$sw_arp"),
        (name: "kick", drums: true, stem: Drive, gen: "$sw_kick"),
        (name: "snare", drums: true, stem: Drive, gen: "$sw_snare"),
        (name: "hats", drums: true, stem: Drive, gen: "$sw_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "Gmaj7 | Dmaj7 | Gmaj7 | Dmaj7 |", mute: ["snare", "arp"],
         auto: [(target: "base", from: 400.0, to: 5000.0)]),
        (name: "a", bars: 16, chords: "$ch_A", remeter: ["lead"], parts: { "lead": "$m1 $m2" }),
        (name: "b", bars: 16, chords: "$ch_B", remeter: ["lead", "bell"], parts: { "lead": "k-12 $mb $mb2 k0", "bell": "[$bells]2" }),
        (name: "end", bars: 2, chords: "Dmaj7 | Dmaj7 |", mute: ["hats", "arp"],
         parts: { "lead": "o5 d1 | r1 |", "snare": "r2 G2 | r1 |" }),
    ],
    order: ["intro", "a", "b"],
    loop_to: "a",
    ending: "end",
)
