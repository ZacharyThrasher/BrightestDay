// Nachtmusik — house. Four-on-the-floor, offbeat saw bass, supersaw stabs pumping under the kick,
// the Mannheim rocket on a filtered saw lead; the development is an 8-bar filter build into the recap.
(
    title: "Nachtmusik (House)",
    base: "menu",
    style: "house",
    bpm: 124.0,
    gain_db: 0.5,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    pump: (depth_db: 6.0, release: 0.2, stems: [Base]),
    adaptive: (explore_cutoff: 700.0, build_bars: 2),
    channels: [
        (name: "lead", inst: "rx_saw", stem: Lead, pan: -0.05, echo: (ticks: 72, vol: 0.22)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.7),
        (name: "chords", inst: "rx_stab", stem: Base, gen: "$house_stab"),
        (name: "bass", inst: "rx_housebass", stem: Base, gen: "$house_bass"),
        (name: "kick", drums: true, stem: Drive, gen: "$house_kick"),
        (name: "clap", drums: true, stem: Drive, gen: "$house_clap", pan: 0.1),
        (name: "hats", drums: true, stem: Drive, gen: "$house_hats", pan: -0.2, vol: 0.8),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "G | Em | C | D7 |", mute: ["clap"],
         auto: [(target: "base", from: 500.0, to: 6000.0)]),
        (name: "a", bars: 8, chords: "$ch_a", parts: { "lead": "$rocket $answer" }),
        (name: "a2", bars: 8, chords: "$ch_a2", parts: { "lead": "$rocket $answer_d", "lead2": "k-12 $rocket $answer_d" }),
        (name: "b", bars: 8, key: "D", chords: "$ch_b", parts: { "lead": "$bmel6 $bend1" }),
        (name: "b2", bars: 8, key: "D", chords: "$ch_b2", parts: { "lead": "$bmel6 $bend2", "lead2": "k-12 $bmel6 $bend2" }),
        (name: "c", bars: 8, key: "Em", chords: "$ch_c", mute: ["kick", "hats"],
         auto: [(target: "all", from: 350.0, to: 12000.0), (target: "all", param: Res, from: 0.6, to: 0.2)],
         parts: { "lead": "$cmel", "clap": "[r4 X4 r4 X4 |]6 [X8]8 | [X16]16 |" }),
        (name: "a3", bars: 8, chords: "$ch_a", parts: { "lead": "$rocket $answer", "lead2": "$rocket $answer",
                                                     "clap": "C4 X4 r4 X4 | [r4 X4 r4 X4 |]7" }),
        (name: "end", bars: 2, chords: "G | G |", mute: ["hats", "clap", "chords"],
         parts: { "lead": "o5 g4 d4 o4 g2 | r1 |", "kick": "K4 r2. | r1 |", "bass": "o2 g2 r2 | r1 |" }),
    ],
    order: ["intro", "a", "a2", "b", "b2", "c", "a3"],
    loop_to: "a",
    ending: "end",
)
