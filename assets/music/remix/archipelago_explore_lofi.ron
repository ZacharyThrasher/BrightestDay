// Spring — lo-fi. The ritornello, the brook and the birds, swung and dusty, for wandering the islands.
(
    title: "Spring (Lo-fi)",
    base: "archipelago_explore",
    style: "lofi",
    bpm: 90.0,
    gain_db: -2.0,
    swing: 0.28,
    swing_unit: 8,
    hpf_hz: 45.0,
    lofi: (bits: 11.0, crackle: 0.45, wow: 8.0, wow_rate: 0.6),
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    adaptive: (explore_cutoff: 1300.0, explore_res: 0.1, explore_drive: 0.6, build_bars: 1, build_cutoff: 3000.0,
               build_res: 0.2, riser: false, roll: false, impact: false),
    channels: [
        (name: "lead", inst: "rx_mellow", stem: Lead, echo: (ticks: 144, vol: 0.25)),
        (name: "bell", inst: "hl_bell", stem: Lead, pan: 0.3, vol: 0.5),
        (name: "keys", inst: "rx_keys", stem: Base, pan: -0.15, gen: "o4 Y2 Y4 Y4 |"),
        (name: "bass", inst: "rx_upright", stem: Base, gen: "$lofi_bass"),
        (name: "kick", drums: true, stem: Drive, gen: "$lofi_kick"),
        (name: "snare", drums: true, stem: Drive, gen: "$lofi_snare"),
        (name: "hats", drums: true, stem: Drive, gen: "$lofi_hats", pan: -0.25, vol: 0.55),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "E | C#m | A | B7 |", mute: ["kick", "snare"]),
        (name: "a", bars: 8, chords: "$ch_rit $ch_rit", parts: { "lead": "$rit $rit_lo" }),
        (name: "brook", bars: 8, chords: "$ch_brook", parts: { "lead": "$brookmel" }),
        (name: "birds", bars: 8, chords: "$ch_birds", parts: { "lead": "k-12 $birds k0", "bell": "$chirps" }),
        (name: "a2", bars: 8, chords: "$ch_rit $ch_rit", parts: { "lead": "$rit $rit" }),
        (name: "end", bars: 2, chords: "E | E |", mute: ["hats", "snare"],
         parts: { "lead": "o5 e2 g+4 b4 | o5 e1 |", "kick": "K4 r2. | r1 |" }),
    ],
    order: ["intro", "a", "brook", "birds", "a2"],
    loop_to: "a",
    ending: "end",
)
