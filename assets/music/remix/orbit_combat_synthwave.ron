// Valkyries — synthwave. The ride as a night drive: the galloping motif on a dual saw over octave
// saw bass, gated snare and 16th plucks; the hammer blows on a wide supersaw.
(
    title: "Valkyries (Synthwave)",
    base: "orbit_combat",
    style: "synthwave",
    bpm: 110.0,
    gain_db: -1.7,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    pump: (depth_db: 3.0, release: 0.2, stems: [Base]),
    adaptive: (explore_cutoff: 850.0, build_bars: 2),
    channels: [
        (name: "lead", inst: "rx_dualsaw", stem: Lead, echo: (ticks: 72, vol: 0.28)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.55),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "$sw_pad"),
        (name: "bass", inst: "rx_synthbass", stem: Base, gen: "$sw_bass"),
        (name: "arp", inst: "rx_pluck", stem: Drive, pan: -0.3, gen: "$sw_arp"),
        (name: "kick", drums: true, stem: Drive, gen: "$sw_kick"),
        (name: "snare", drums: true, stem: Drive, gen: "$sw_snare"),
        (name: "hats", drums: true, stem: Drive, gen: "$sw_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "Bm | G | Em | F# |", mute: ["snare", "arp"]),
        (name: "a", bars: 16, chords: "$ch_ride", parts: { "lead": "$ride44" }),
        (name: "b", bars: 8, chords: "$ch_hammer", parts: { "lead": "@hl_brass $hammer44", "lead2": "k-12 $hammer44 k0" }),
        (name: "a2", bars: 16, chords: "$ch_ride", parts: { "lead": "$ride44", "lead2": "k-12 $ride44 k0" }),
        (name: "end", bars: 2, chords: "Bm | Bm |", mute: ["hats", "arp"],
         parts: { "lead": "o5 b1 | r1 |", "snare": "r2 G2 | r1 |" }),
    ],
    order: ["intro", "a", "b", "a2"],
    loop_to: "a",
    ending: "end",
)
