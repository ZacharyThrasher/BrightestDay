// Mountain King — drum & bass. Accelerates from 150 to a 174 loop: the theme on a saw lead over a
// two-step break and reese bass, the troll chase on hard light, a half-time trap-door and back.
(
    title: "Mountain King (DnB)",
    base: "sudden_death",
    style: "dnb",
    bpm: 174.0,
    gain_db: -2.4,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.55, base_floor: 0.85),
    adaptive: (explore_cutoff: 900.0, build_bars: 1),
    channels: [
        (name: "lead", inst: "rx_saw", stem: Lead, echo: (ticks: 48, vol: 0.2)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.5),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "$dnb_pad"),
        (name: "bass", inst: "rx_reese", stem: Base, gen: "$dnb_reese"),
        (name: "kick", drums: true, stem: Drive, gen: "$dnb_kick"),
        (name: "snare", drums: true, stem: Drive, gen: "$dnb_snare"),
        (name: "hats", drums: true, stem: Drive, gen: "$dnb_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, bpm: 150.0, chords: "Bm | Bm | F# | F# |", mute: ["kick", "snare"]),
        (name: "rise", bars: 8, bpm: 150.0, accel_to: 174.0, chords: "$ch_thA $ch_thA", parts: { "lead": "k12 $thA $thA k0" }),
        (name: "a", bars: 8, chords: "$ch_thA $ch_thB", parts: { "lead": "k12 $thA k0 $thB" }),
        (name: "b", bars: 8, chords: "$ch_troll", parts: { "lead": "@hardlight $troll", "lead2": "k-12 $troll k0" }),
        (name: "a2", bars: 8, chords: "$ch_thA $ch_thB", parts: { "lead": "k12 $thA k0 $thB", "lead2": "$thA k-12 $thB k0" }),
        (name: "half", bars: 8, chords: "$ch_thA $ch_thB", mute: ["hats"],
         auto: [(target: "all", from: 450.0, to: 12000.0), (target: "all", param: Res, from: 0.6, to: 0.2)],
         parts: { "lead": "k12 $thA k0 $thB", "kick": "[K4 r4 r2 |]8", "snare": "[r2 S2 |]7 [S16]16 |" }),
        (name: "end", bars: 2, chords: "Bm | Bm |", mute: ["hats", "snare"],
         parts: { "lead": "o5 b4 r4 o4 b4 r4 | r1 |", "kick": "K4 r2. | r1 |" }),
    ],
    order: ["intro", "rise", "a", "b", "a2", "half"],
    loop_to: "a",
    ending: "end",
)
