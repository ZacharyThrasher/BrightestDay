// Summer Storm — trap. Half-time at 140: 808s sliding under the storm's scale runs, rolled and
// pitched hats, clap on three; the brass theme on hard-light brass over dark pads.
(
    title: "Summer Storm (Trap)",
    base: "archipelago_combat",
    style: "trap",
    bpm: 140.0,
    gain_db: -5.2,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    adaptive: (explore_cutoff: 800.0, build_bars: 2),
    channels: [
        (name: "lead", inst: "rx_square", stem: Lead, echo: (ticks: 48, vol: 0.2)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.55),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "$trap_pad"),
        (name: "808", inst: "rx_808", stem: Base, gen: "$trap_808"),
        (name: "kick", drums: true, stem: Drive, gen: "$trap_kick"),
        (name: "clap", drums: true, stem: Drive, gen: "$trap_clap"),
        (name: "hats", drums: true, stem: Drive, gen: "$trap_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "Gm | Eb | Cm | D |", mute: ["kick", "clap"]),
        (name: "a", bars: 16, chords: "$ch_A", remeter: ["lead"], parts: { "lead": "$runA $runB" }),
        (name: "b", bars: 16, chords: "$ch_brass", remeter: ["lead"], parts: { "lead": "@hl_brass $brass" }),
        (name: "a2", bars: 16, chords: "$ch_A", remeter: ["lead", "lead2"],
         parts: { "lead": "$runA $runB", "lead2": "k-12 $runA $runB k0" }),
        (name: "end", bars: 2, chords: "Gm | Gm |", mute: ["hats", "clap"],
         parts: { "lead": "o5 g4 d4 o4 g2 | r1 |", "kick": "K4 r2. | r1 |", "808": "o1 u4 R1 | r1 |" }),
    ],
    order: ["intro", "a", "b", "a2"],
    loop_to: "a",
    ending: "end",
)
