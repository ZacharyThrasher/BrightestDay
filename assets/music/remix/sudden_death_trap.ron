// Mountain King — trap. The troll theme creeps in at 110 and accelerates to 140 (the loop), with
// sliding 808s, pitched hat rolls and a clap on three; the game's tempo multiplier pushes it further.
(
    title: "Mountain King (Trap)",
    base: "sudden_death",
    style: "trap",
    bpm: 140.0,
    gain_db: -4.1,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.55, base_floor: 0.85),
    adaptive: (explore_cutoff: 800.0, build_bars: 1),
    channels: [
        (name: "lead", inst: "rx_saw", stem: Lead, echo: (ticks: 48, vol: 0.2)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.5),
        (name: "bells", inst: "hl_bell", stem: Base, pan: 0.3, vol: 0.4, gen: "$trap_bells"),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "$trap_pad"),
        (name: "808", inst: "rx_808", stem: Base, gen: "$trap_808"),
        (name: "kick", drums: true, stem: Drive, gen: "$trap_kick"),
        (name: "clap", drums: true, stem: Drive, gen: "$trap_clap"),
        (name: "hats", drums: true, stem: Drive, gen: "$trap_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, bpm: 110.0, chords: "Bm | Bm | F# | F# |", mute: ["kick", "clap", "bells"]),
        (name: "creep", bars: 8, bpm: 110.0, accel_to: 125.0, chords: "$ch_thA $ch_thA", mute: ["clap"],
         parts: { "lead": "@pizz k12 $thA $thA k0" }),
        (name: "rise", bars: 8, bpm: 125.0, accel_to: 140.0, chords: "$ch_thA $ch_thB",
         parts: { "lead": "k12 $thA k0 $thB" }),
        (name: "a", bars: 8, chords: "$ch_thA $ch_thB", parts: { "lead": "k12 $thA k0 $thB", "lead2": "$thA k-12 $thB k0" }),
        (name: "b", bars: 8, chords: "$ch_troll", parts: { "lead": "$troll" }),
        (name: "a2", bars: 8, chords: "$ch_thA $ch_thB",
         parts: { "lead": "k12 $thA k0 $thB", "lead2": "$thA k-12 $thB k0",
                  "hats": "[[H16]8 [H32]16 |]2 [[H16]12 p0 H32 p2 H32 p4 H32 p6 H32 p8 H32 p10 H32 p12 H32 p14 H32 p0 |]2 [[H16]8 [H32]16 |]4" }),
        (name: "b2", bars: 8, chords: "$ch_troll", parts: { "lead": "$troll", "lead2": "k-12 $troll k0" }),
        (name: "end", bars: 2, chords: "Bm | Bm |", mute: ["hats", "clap", "bells"],
         parts: { "lead": "o5 b4 r4 o4 b4 r4 | r1 |", "kick": "K4 r2. | r1 |", "808": "o1 u4 R1 | r1 |" }),
    ],
    order: ["intro", "creep", "rise", "a", "b", "a2", "b2"],
    loop_to: "a",
    ending: "end",
)
