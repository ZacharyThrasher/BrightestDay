// Valkyries — drum & bass. 174 bpm through the void: the ride on a saw lead over a two-step break
// and a reese bass, supersaw hammer blows, and a half-time breakdown before the last charge.
(
    title: "Valkyries (DnB)",
    base: "orbit_combat",
    style: "dnb",
    bpm: 174.0,
    gain_db: -2.5,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    adaptive: (explore_cutoff: 900.0, build_bars: 2),
    channels: [
        (name: "lead", inst: "rx_saw", stem: Lead, echo: (ticks: 72, vol: 0.2)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.55),
        (name: "pad", inst: "rx_pad", stem: Base, gen: "$dnb_pad"),
        (name: "bass", inst: "rx_reese", stem: Base, gen: "$dnb_reese"),
        (name: "kick", drums: true, stem: Drive, gen: "$dnb_kick"),
        (name: "snare", drums: true, stem: Drive, gen: "$dnb_snare"),
        (name: "hats", drums: true, stem: Drive, gen: "$dnb_hats", pan: 0.2, vol: 0.6),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "Bm | G | Em | F# |", mute: ["kick", "snare"]),
        (name: "a", bars: 16, chords: "$ch_ride", parts: { "lead": "$ride44" }),
        (name: "b", bars: 8, chords: "$ch_hammer", parts: { "lead": "@hardlight $hammer44", "lead2": "k-12 $hammer44 k0" }),
        (name: "a2", bars: 16, chords: "$ch_ride", parts: { "lead": "$ride44", "lead2": "k-12 $ride44 k0" }),
        (name: "half", bars: 8, chords: "$ch_hammer", mute: ["hats"],
         auto: [(target: "all", from: 500.0, to: 12000.0), (target: "all", param: Res, from: 0.6, to: 0.2)],
         parts: { "lead": "@hl_brass $hammer44", "kick": "[K4 r4 r2 |]8", "snare": "[r2 S2 |]7 [S16]16 |" }),
        (name: "end", bars: 2, chords: "Bm | Bm |", mute: ["hats", "snare"],
         parts: { "lead": "o5 b1 | r1 |", "kick": "K4 r2. | r1 |" }),
    ],
    order: ["intro", "a", "b", "a2", "half"],
    loop_to: "a",
    ending: "end",
)
