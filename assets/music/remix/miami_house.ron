// Alla Turca — house. The Turkish march over a four-on-the-floor with offbeat bass and open hats,
// supersaw stabs pumping under the kick, the refrain in A major as a hands-up section.
(
    title: "Alla Turca (House)",
    base: "miami",
    style: "house",
    time: (2, 4),
    bpm: 126.0,
    gain_db: -0.2,
    sub_bass: true,
    layers: (lead: 0.1, drive: 0.6, base_floor: 0.85),
    pump: (depth_db: 6.0, release: 0.2, stems: [Base]),
    adaptive: (explore_cutoff: 750.0, build_bars: 4),
    channels: [
        (name: "lead", inst: "rx_saw", stem: Lead, echo: (ticks: 72, vol: 0.22)),
        (name: "lead2", inst: "rx_supersaw", stem: Drive, vol: 0.6),
        (name: "chords", inst: "rx_stab", stem: Base, gen: "$house_stab"),
        (name: "bass", inst: "rx_housebass", stem: Base, gen: "$house_bass"),
        (name: "kick", drums: true, stem: Drive, gen: "$house_kick"),
        (name: "clap", drums: true, stem: Drive, gen: "$house_clap", pan: 0.1),
        (name: "hats", drums: true, stem: Drive, gen: "$house_hats", pan: -0.2, vol: 0.8),
    ],
    sections: [
        (name: "intro", bars: 4, chords: "Am | Am | E | E |", mute: ["clap"],
         parts: { "lead": "r2 | r2 | r2 | r4 o4 b16 a16 g+16 a16 |" }),
        (name: "a", bars: 16, chords: "$ch_th", parts: { "lead": "$p1 $p2_7 $endEF" }),
        (name: "c", bars: 16, chords: "$ch_c", parts: { "lead": "$C8 $p2_7 $endR" }),
        (name: "r", bars: 16, chords: "$ch_r", parts: { "lead": "$R7 $rEnd $R7 $rEndP", "lead2": "k-12 $R7 $rEnd $R7 $rEndP k0" }),
        (name: "a2", bars: 16, chords: "$ch_th", parts: { "lead": "$p1 $p2_7 $endP", "lead2": "k-12 $p1 $p2_7 $endP k0" }),
        (name: "end", bars: 2, chords: "Am | Am |", mute: ["hats", "clap", "chords"],
         parts: { "lead": "o5 a8 r8 o4 a8 r8 | r2 |", "kick": "K4 r4 | r2 |" }),
    ],
    order: ["intro", "a", "c", "r", "a2"],
    loop_to: "a",
    ending: "end",
)
