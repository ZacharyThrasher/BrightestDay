// Shared chip instrument bank for every track (a song's own `instruments` override these by name).
// Times in seconds; vib_depth in cents; duty 0.125 / 0.25 / 0.5; fm_* = the "hard light" FM voice.
// Every field is optional (defaults: pulse 25 %, attack 4 ms, decay 0.25, sustain 0.7, release 80 ms).
{
    // ---- pulse leads ----
    "lead25": (wave: Pulse, duty: 0.25, attack: 0.004, decay: 0.3, sustain: 0.62, release: 0.07, vol: 0.9,
               vib_depth: 14.0, vib_rate: 5.6, vib_delay: 0.22),
    "lead12": (wave: Pulse, duty: 0.125, attack: 0.003, decay: 0.25, sustain: 0.6, release: 0.06, vol: 0.95,
               vib_depth: 12.0, vib_rate: 5.8, vib_delay: 0.2),
    "lead50": (wave: Pulse, duty: 0.5, attack: 0.006, decay: 0.3, sustain: 0.6, release: 0.08, vol: 0.75,
               vib_depth: 12.0, vib_rate: 5.4, vib_delay: 0.25, lp_hz: 5000.0),
    // Classic duty sweep 12.5 % -> 50 % over each note.
    "sweep": (wave: Pulse, duty: 0.125, duty_end: 0.5, duty_time: 0.35, attack: 0.004, decay: 0.4, sustain: 0.6,
              release: 0.08, vol: 0.85, vib_depth: 10.0, vib_delay: 0.3),
    // Short, bright staccato for fast runs.
    "run12": (wave: Pulse, duty: 0.125, attack: 0.002, decay: 0.09, sustain: 0.45, release: 0.03, vol: 0.85, gate: 0.85),
    "run25": (wave: Pulse, duty: 0.25, attack: 0.002, decay: 0.1, sustain: 0.5, release: 0.03, vol: 0.8, gate: 0.85),

    // ---- pulse harmony / accompaniment ----
    "harm50": (wave: Pulse, duty: 0.5, attack: 0.012, decay: 0.35, sustain: 0.55, release: 0.12, vol: 0.45, lp_hz: 3200.0),
    "harm25": (wave: Pulse, duty: 0.25, attack: 0.008, decay: 0.3, sustain: 0.5, release: 0.1, vol: 0.5, lp_hz: 4200.0),
    "pluck12": (wave: Pulse, duty: 0.125, attack: 0.002, decay: 0.12, sustain: 0.18, release: 0.05, vol: 0.55, lp_hz: 5200.0),
    "pluck25": (wave: Pulse, duty: 0.25, attack: 0.002, decay: 0.14, sustain: 0.2, release: 0.05, vol: 0.55, lp_hz: 4500.0),
    "stab": (wave: Pulse, duty: 0.25, attack: 0.002, decay: 0.07, sustain: 0.15, release: 0.04, vol: 0.6, gate: 0.6, lp_hz: 4800.0),
    // Chords written as {ceg} cycle at 60 Hz (the classic chip arpeggio) or 30 Hz (softer).
    "arp": (wave: Pulse, duty: 0.125, attack: 0.003, decay: 0.3, sustain: 0.45, release: 0.06, vol: 0.34, arp_rate: 60.0,
            lp_hz: 5500.0),
    "arp30": (wave: Pulse, duty: 0.25, attack: 0.006, decay: 0.5, sustain: 0.4, release: 0.1, vol: 0.34, arp_rate: 30.0,
              lp_hz: 4000.0),
    "arpsoft": (wave: Pulse, duty: 0.5, attack: 0.02, decay: 0.6, sustain: 0.45, release: 0.2, vol: 0.36, arp_rate: 24.0,
                lp_hz: 2600.0),

    // ---- bass ----
    "bass": (wave: Triangle, attack: 0.002, decay: 0.3, sustain: 0.85, release: 0.04, vol: 0.78, gate: 0.9),
    "bass_pluck": (wave: Triangle, attack: 0.002, decay: 0.16, sustain: 0.35, release: 0.04, vol: 0.8, gate: 0.8),
    "pizz": (wave: Triangle, attack: 0.002, decay: 0.12, sustain: 0.0, release: 0.05, vol: 0.88, gate: 0.6),
    // Synthwave: band-limited saw through a plucked low-pass (Miami).
    "synthbass": (wave: Saw, attack: 0.002, decay: 0.2, sustain: 0.55, release: 0.05, vol: 0.62, gate: 0.8,
                  lp_hz: 380.0, lp_env: 5.0, lp_time: 0.07),
    // Reedy low pulse (the bassoon of the Mountain King).
    "reed": (wave: Pulse, duty: 0.25, attack: 0.004, decay: 0.2, sustain: 0.6, release: 0.05, vol: 0.62, gate: 0.7, lp_hz: 1400.0),

    // ---- hard light (2-op FM) — Brightest Day's signature voice ----
    "hardlight": (wave: Fm, fm_ratio: 1.0, fm_index: 2.4, fm_index_end: 0.9, fm_decay: 0.3, fm_detune: 7.0,
                  attack: 0.008, decay: 0.5, sustain: 0.72, release: 0.16, vol: 0.9,
                  vib_depth: 16.0, vib_rate: 5.2, vib_delay: 0.25),
    "hl_bell": (wave: Fm, fm_ratio: 3.5, fm_index: 2.6, fm_index_end: 0.2, fm_decay: 0.25, fm_detune: 4.0,
                attack: 0.002, decay: 1.1, sustain: 0.0, release: 0.5, vol: 0.62, gate: 1.0),
    "hl_brass": (wave: Fm, fm_ratio: 1.0, fm_index: 0.8, fm_index_end: 2.6, fm_decay: 0.07, fm_feedback: 0.25,
                 fm_detune: 5.0, attack: 0.03, decay: 0.4, sustain: 0.8, release: 0.1, vol: 0.85,
                 vib_depth: 10.0, vib_rate: 5.5, vib_delay: 0.3),
    "hl_organ": (wave: Fm, fm_ratio: 2.0, fm_index: 1.3, fm_index_end: 1.1, fm_decay: 0.2, fm_detune: 3.0,
                 attack: 0.012, decay: 0.2, sustain: 0.95, release: 0.12, vol: 0.8, gate: 0.97),
    "hl_pluck": (wave: Fm, fm_ratio: 2.0, fm_index: 3.0, fm_index_end: 0.3, fm_decay: 0.08, fm_detune: 5.0, pitch_drop: 1.5, pitch_time: 0.012,
                 attack: 0.002, decay: 0.3, sustain: 0.1, release: 0.08, vol: 0.75, gate: 0.9),
    "hl_sad": (wave: Fm, fm_ratio: 1.0, fm_index: 1.0, fm_index_end: 2.2, fm_decay: 0.1, fm_feedback: 0.3,
               attack: 0.03, decay: 0.3, sustain: 0.85, release: 0.25, vol: 0.9,
               vib_depth: 55.0, vib_rate: 6.0, vib_delay: 0.12, glide: 0.08),

    // ---- soft pads ----
    "glass": (wave: Sine, attack: 0.06, decay: 0.8, sustain: 0.7, release: 0.5, vol: 0.62, vib_depth: 7.0, vib_rate: 4.5,
              vib_delay: 0.4),
    "flute": (wave: Triangle, attack: 0.03, decay: 0.4, sustain: 0.8, release: 0.15, vol: 0.8,
              vib_depth: 14.0, vib_rate: 5.0, vib_delay: 0.2),
}
