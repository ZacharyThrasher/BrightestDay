// MOVIES & COMICS — character kits (kind: Kit) for Marvel (comics, MCU, X-Men films), DC (comics +
// films), Star Wars, Harry Potter, Lord of the Rings / Hobbit, The Matrix, Ghostbusters, Men in Black,
// Pirates of the Caribbean, Kung Fu Panda, Karate Kid, Kill Bill, John Wick, Terminator, Predator,
// Alien, Jurassic Park, Godzilla / Kong, Back to the Future, Indiana Jones, Shrek, Disney / Pixar
// (Frozen, The Incredibles, Moana, Encanto, Tangled) and Spider-Verse. Owner: CONTENT: MOVIES & COMICS.
//
// A kit never grants anything and its bare name stays the costume summon: "<kit name> <move word>"
// fires that move ("nightcrawler teleport", "hulk ult", "thor's bifrost"); a kit's `shouts` are
// whole phrases that ANYONE can yell to borrow that move ("bamf", "expelliarmus", "force push").
// Every headline move does the thing it is famous for (docs/toolbox/BRIEF.md) and is designed for
// chains: note how each one ENDS (airborne, grounded, target lifted, target marked…).
// Generic ops used here: docs/toolbox/OPS.md (BlinkCarry, Afflict, DelayedHit, BounceBeam, Barrage and
// Disarm were built for this file). No quotes beyond move / character names; family-friendly Disney.
[
    // ================================================================ X-MEN
    // NIGHTCRAWLER — the owner's example chain starts here ("nightcrawler teleport"). BAMF: a crack,
    // a purple-black brimstone puff where you were and where you land (Shadow smoke: a vision
    // vignette on anyone in it), a 0.45 s cooldown so blinks CHAIN. "bamf drop" takes whoever you're
    // touching 16 m up and lets go; the flurry vanishes around them between every strike.
    (
        id: "kit_nightcrawler",
        name: "Nightcrawler",
        kind: Kit,
        fx: "smoke",
        names: ["nightcrawler", "night crawler", "nite crawler", "knight crawler", "nightcrawlers", "kurt wagner",
                "the incredible nightcrawler", "night crawlers", "nightcrawler x men", "kurt wagner's"],
        shouts: [("bamf", 0), ("bamph", 0), ("bamff", 0), ("bamf teleport", 0), ("bam f", 0),
                 ("bamf drop", 1), ("teleport drop", 1), ("bamf and drop", 1), ("bamf them up", 1),
                 ("bamf flurry", 2), ("bamf bamf bamf", 2), ("bamf strike", 2), ("teleport flurry", 2), ("bamf barrage", 2),
                 ("brimstone cloud", 4), ("sulfur cloud", 4), ("sulphur cloud", 4), ("brimstone smoke", 4),
                 ("bamf sky drop", 6), ("teleport sky drop", 6)],
        moves: [
            // Crack — puff — gone — puff. Keep the pitch: aim up and you arrive airborne (an aerial
            // move next), aim along the floor and you arrive running.
            (name: "teleport", cooldown: 0.45, cost: 3.0, tags: [Movement], ops: [
                Explode(radius: 2.2, damage: 0.0, knockback: 3.0, element: Shadow),
                Blink(dist: 15.0, afterimage: true),
                Explode(radius: 1.8, damage: 0.0, knockback: 2.5, element: Shadow),
            ], juice: Some((ripple: 1.6, punch: 1.5, color: Some((0.35, 0.1, 0.45))))),
            // Touch them, BAMF, you're both 16 m up: they fall, you hang a beat. Over the void it's a KO.
            (name: "bamf drop", cooldown: 3.5, cost: 7.0, tags: [Combo], ops: [
                Explode(radius: 2.4, damage: 0.0, knockback: 0.0, element: Shadow),
                BlinkCarry(dist: 5.0, up: 16.0, grab: 2.6),
                Explode(radius: 2.4, damage: 0.0, knockback: 0.0, element: Shadow),
            ], juice: Some((title: Some("BAMF!"), ripple: 2.5, punch: 2.5, color: Some((0.35, 0.1, 0.45))))),
            // The White House scene: vanish and reappear on a new side of them with every strike.
            (name: "bamf flurry", cooldown: 4.0, cost: 7.0, tags: [Combo], ops: [
                Barrage(hits: 6, interval: 0.17, range: 3.0, angle: 70.0, damage: 3.5, knockback: 5.0, finish: 18.0, up: 0.2,
                        blink: true, element: Shadow),
            ], juice: Some((title: Some("BAMF BAMF BAMF"), punch: 1.5, color: Some((0.35, 0.1, 0.45))))),
            // The prehensile tail: a wide low sweep that pops them up (a launcher for the flurry).
            (name: "tail whip", cooldown: 0.8, cost: 2.0, tags: [Primary], ops: [
                Shove(range: 3.6, angle: 110.0, damage: 7.0, knockback: 10.0, up: 0.6),
            ], juice: Some((punch: 1.0, color: Some((0.2, 0.15, 0.4))))),
            // A thick cloud of brimstone and a short hop out of it: everyone inside sees purple-black.
            (name: "brimstone cloud", cooldown: 5.0, cost: 4.0, tags: [Defense], ops: [
                Explode(radius: 5.5, damage: 0.0, knockback: 4.0, element: Shadow),
                Blink(dist: 6.0, afterimage: true),
            ], juice: Some((ripple: 5.0, color: Some((0.3, 0.05, 0.4))))),
            // Circus acrobat: a backflip out of trouble, hanging at the top.
            (name: "circus flip", cooldown: 1.6, cost: 2.0, tags: [Movement, Defense], ops: [
                Impulse(fwd: -9.0, up: 11.0),
                SelfStatus(status: Float, secs: 0.35),
            ]),
            // The ultimate: take them 26 m up and leave them there.
            (name: "sky drop", cooldown: 12.0, cost: 12.0, tags: [Ultimate], ops: [
                Explode(radius: 3.0, damage: 0.0, knockback: 0.0, element: Shadow),
                BlinkCarry(dist: 8.0, up: 26.0, grab: 3.0),
                Explode(radius: 3.0, damage: 0.0, knockback: 0.0, element: Shadow),
            ], juice: Some((title: Some("BAMF"), ripple: 4.0, punch: 4.0, boom: true, color: Some((0.35, 0.1, 0.45))))),
        ],
    ),
    // WOLVERINE — the claws are a real held weapon (Blade + Fast: the legendary deflect window);
