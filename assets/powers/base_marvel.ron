// Marvel + X-Men origins.
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
[
    // ================================================================ ORIGINS (kind: Origin, COMBAT.md §5h)
    // Superhero origin kits: casting the origin's name makes a small themed pickup (`pickup`) anyone can
    // grab; it drops where its holder is KO'd. No devil-fruit rules (no Water drain, seastone or void
    // sinking; a second origin replaces the first). An authored `weak` still drains (kryptonite = Poison).
    // Never-list checked: no invisibility / time stop / mind control / instant kills / player healing /
    // long stuns; every flight cap (thrust_max) <= 17 m/s.
    // ---------------------------------------------------------------- Marvel + X-Men
    // ================================================================ MARVEL — origins
    (
        id: "spider_bite",
        name: "Radioactive Spider",
        kind: Origin,
        pickup: Some((name: "radioactive spider", form: Blob0, element: Poison, scale: 0.35)),
        names: ["radioactive spider", "radioactive spider bite", "bitten by a radioactive spider", "spider bite",
                "spider powers", "spider-sense powers", "proportional strength of a spider"],
        // Agile: bigger jumps, air control and snappier acceleration (wall-cling isn't a MoveModifier).
        body: (moves: (jump: 1.25, air_control: 1.35, accel: 1.1)),
        // "thwip <anything>": it comes out webbed — sticks and yanks back to you.
        incantations: ["thwip"],
        delivery: (add: [Sticky, Pull], from_fist: true),
        shouts: [],
        moves: [
            // A web line to whatever you aim at, reeling you in: a third tether-like swing.
            (name: "web swing", cooldown: 0.9, cost: 3.0, ops: [Reel(range: 45.0, speed: 30.0)]),
            // Spider-sense: an instant backflip out of danger, hanging in the air a beat.
            // Spider-sense: a perfect-dodge window (the world slows a beat when it saves you) + a backflip.
            (name: "spider-sense", cooldown: 3.5, cost: 4.0, ops: [
                Evade(secs: 0.8, slow: 1.0, speed: 2.0),
                Impulse(fwd: -8.0, up: 8.0),
            ], juice: Some((title: Some("SPIDER-SENSE"), color: Some((0.9, 0.2, 0.2))))),
        ],
    ),
    (
        id: "gamma",
        name: "Gamma Radiation",
        kind: Origin,
        pickup: Some((name: "gamma canister", form: Ball, element: Atomic, scale: 0.5)),
        names: ["gamma radiation", "gamma bomb", "gamma rays", "gamma ray", "gamma blast", "gamma exposure",
                "gamma radiation exposure"],
        body: (immune: [Atomic]),
        // "hulk smash <anything>": comes out huge, heavy and blunt.
        incantations: ["hulk smash"],
        delivery: (add: [Heavy, Blunt], scale_mult: 1.6),
        shouts: [("hulk out", 1), ("hulk", 1)],
        moves: [
            // Leap and crater where you land (the terrain gives way: punch-through energy).
            (name: "hulk smash", cooldown: 2.8, cost: 8.0, ops: [
                Impulse(fwd: 10.0, up: 15.0),
                SlamOnLand(radius: 5.0, damage: 20.0, knockback: 24.0, carve: 3.2),
            ]),
            (name: "hulk out", cooldown: 1.5, ops: [Transform]),
        ],
        // Jade giant: big leaps, falls heavy, every cast Heavy + Blunt (bigger launches, craters).
        transform: Some((ascend: Some((color: Some((0.35, 1.00, 0.30)), intensity: 1.6, stable: false, skin_tint: Some((0.35, 0.8, 0.3)), eye_glow: Some((0.4, 1.0, 0.3)))), 
            costume: "savage hulk",
            body: (immune: [Atomic], moves: (jump: 1.45, gravity: 1.1, speed: 0.95)),
            graft: Some((mechanics: [Heavy, Blunt])),
        )),
    ),
    (
        id: "super_soldier",
        name: "Super Soldier Serum",
        kind: Origin,
        pickup: Some((name: "super soldier serum", form: Ball, element: Light, scale: 0.4)),
        names: ["super soldier serum", "supersoldier serum", "vita rays", "project rebirth",
