    // ================================================================ MY HERO ACADEMIA — One For All
    // The stockpile: say a percentage and every smash scales with it. The smashes themselves don't
    // change — you do (PowerMult); 100% hits like a truck and breaks your arms (your own damage %).
    // Detroit = the straight punch, Delaware = the finger-flick air cannon, St. Louis = the arcing
    // kick, Manchester = the flip-axe-kick from above.
    (
        id: "one_for_all",
        name: "One For All",
        kind: Technique,
        names: ["one for all", "ofa", "one for all quirk", "wan fo oru", "one for al", "won for all", "one-for-all", "the one for all"],
        effects: [PowerMult(damage: 1.05, knockback: 1.1)],
        ascend: Some((color: Some((0.35, 1.0, 0.45)), intensity: 0.8, title: Some("ONE FOR ALL"), stable: false)),
        shouts: [("detroit smash", 0), ("one for all detroit smash", 0), ("detroyt smash", 0), ("detroit smaash", 0), ("detroit smashed", 0), ("the troit smash", 0),
                 ("delaware smash", 1), ("delaware flick", 1), ("delaware smash air force", 1), ("delawear smash", 1),
                 ("st louis smash", 2), ("saint louis smash", 2), ("shoot style", 2), ("st louie smash", 2),
                 ("manchester smash", 3), ("manchester axe kick", 3)],
        moves: [
            // The straight punch: step in, one enormous fist of wind that blows them away. -> ends grounded, target far.
            (name: "detroit smash", cooldown: 1.2, cost: 5.0, ops: [
                Impulse(fwd: 10.0, up: 0.0),
                Shove(range: 3.6, angle: 45.0, damage: 14.0, knockback: 22.0),
                Explode(radius: 2.5, damage: 0.0, knockback: 14.0, at: Front, dist: 5.0),
            ], juice: Some((title: Some("DETROIT SMASH"), boom: true, punch: 4.0, shake: 0.2, ripple: 4.0, at: Front, dist: 4.0, debris: 14.0,
                            color: Some((0.35, 1.0, 0.45))))),
            // The flick: a compressed air bullet from a fingertip — ranged, pushes, barely hurts. -> you don't move.
            (name: "delaware smash", cooldown: 0.8, cost: 3.0, ops: [
                Cast(recipe: (name: "air bullet", form: Ball, mech: [Fast, Repel, Pierce], element: Wind, scale: 0.5, mass: 5.0)),
            ], juice: Some((title: Some("DELAWARE SMASH"), punch: 1.5, color: Some((0.6, 1.0, 0.7))))),
            // The kick: a rising arc that punts them skyward. -> they end above you (chain into Manchester).
            (name: "st louis smash", cooldown: 1.2, cost: 4.0, ops: [
                Impulse(fwd: 6.0, up: 6.0),
                Shove(range: 3.8, angle: 80.0, damage: 12.0, knockback: 18.0, up: 1.6),
            ], juice: Some((title: Some("ST. LOUIS SMASH"), punch: 3.0, color: Some((0.35, 1.0, 0.45))))),
            // Flip up and bring the heel down: an axe kick that craters where you land. -> ends grounded, crater.
            (name: "manchester smash", cooldown: 2.0, cost: 5.0, ops: [
                Impulse(fwd: 8.0, up: 12.0),
                SlamOnLand(radius: 4.5, damage: 16.0, knockback: 20.0, carve: 1.8),
            ], juice: Some((title: Some("MANCHESTER SMASH"), punch: 3.0, color: Some((0.35, 1.0, 0.45))))),
        ],
        tiers: [
            (name: "Full Cowl",
             names: ["full cowl", "full cowling", "one for all full cowl", "full cowl 5 percent", "full cowl five percent", "five percent",
                     "5 percent", "one for all 5 percent", "full cowel", "full cow"],
             effects: [PowerMult(damage: 1.15, speed: 1.2, knockback: 1.15)],
