// MODERN ANIME (CONTENT: MODERN ANIME worker, docs/toolbox/BRIEF.md): Demon Slayer, My Hero Academia,
// Mob Psycho 100, Fullmetal Alchemist, Attack on Titan, Solo Leveling, Fairy Tail, Gurren Lagann,
// Kill la Kill, Sailor Moon, Chainsaw Man, Frieren, Dandadan, Evangelion, Black Clover, Yu Yu Hakusho,
// Inuyasha, One Punch Man, Blue Lock, Haikyuu!!, Cowboy Bebop, Death Note.
// (JJK / HxH existing entries live in base_techniques.ron.) Names only — no quotes, no incantations.
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
//
// Design rule for this file: a famous move does the thing it is famous for. Every headline move has
// its own control feel + the mechanic it's known for + title/colour + a chain ending (noted as
// "-> ends ..." so chains read well: a dash that ends airborne sets up an aerial, a launcher ends
// with them above you, a slam ends grounded).
[
    // ================================================================ DEMON SLAYER — breathing styles
    // Total Concentration Breathing: say a style ("water breathing", "thunder breathing"...) and your
    // blade moves in its forms. Each style is a TIER with its own form set, colour and rhythm — Water
    // flows (curving cuts that keep you moving), Thunder is one straight flash, Flame commits forward,
    // Sun dances in circles, Beast is feral twin blades, Insect stings with poison, Mist vanishes,
    // Sound explodes, Moon fills the air with crescents, Wind is whirlwinds, Stone is a flail, Love a
    // whip-sword, Serpent winds around cover. "first form" etc. fire the CURRENT style's form.
    (
        id: "breathing",
        name: "Total Concentration Breathing",
        kind: Technique,
        names: ["total concentration breathing", "total concentration", "zenshuchu", "zenshu chu no kokyu", "zenshuchu no kokyu",
                "total concentration constant", "demon slayer breathing", "breathing styles", "breathing techniques",
                "nichirin blade", "nichirin sword", "total concentration breath"],
        effects: [PowerMult(speed: 1.06, damage: 1.05)],
        body: (moves: (accel: 1.15, jump: 1.05)),
        ascend: Some((color: Some((0.85, 0.92, 1.0)), intensity: 0.7, title: Some("TOTAL CONCENTRATION"), style: Calm, linger: false)),
        shouts: [("nichirin slash", 0), ("total concentration slash", 0), ("iai draw", 1), ("quick draw slash", 1), ("nichirin draw", 1),
                 ("demon slayer mark", 2), ("slayer mark", 2), ("the mark", 2), ("awaken the mark", 2)],
        moves: [
            (name: "nichirin slash", cooldown: 0.6, cost: 2.0, ops: [
                Impulse(fwd: 8.0, up: 0.0),
                Shove(range: 3.4, angle: 70.0, damage: 8.0, knockback: 8.0),
            ], juice: Some((punch: 1.5))),
            // A sheathed-blade draw from a standstill: you're past them before the steel shows. -> ends past them.
            (name: "iai draw", cooldown: 1.4, cost: 3.0, ops: [
                Blink(dist: 8.0, afterimage: true),
                Shove(range: 3.0, angle: 179.0, damage: 10.0, knockback: 8.0),
            ], juice: Some((punch: 2.0, ripple: 2.0))),
            // The Demon Slayer Mark: the body runs hotter than it should — for a while every form hits
            // harder and you're harder to move (it costs you, and it ends).
            (name: "demon slayer mark", cooldown: 30.0, cost: 20.0, tags: [Ultimate], ops: [
                Empower(secs: 8.0, damage: 1.3, armor: 0.8),
                Explode(radius: 3.0, damage: 0.0, knockback: 10.0, element: Fire),
            ], juice: Some((title: Some("DEMON SLAYER MARK"), boom: true, ripple: 4.0, color: Some((1.0, 0.35, 0.15))))),
        ],
        tiers: [
            (name: "Water Breathing",
