    // ---------------------------------------------------------------- Todoroki: Half-Cold Half-Hot
    // The right side freezes (a glacier that races along the ground and pins what it passes), the
    // left burns (a wall of flame). Flashfire Fist is the fire focused into a heat-fist.
    (
        id: "todoroki_kit",
        name: "Shoto Todoroki",
        kind: Kit,
        names: ["todoroki", "shoto todoroki", "shoto", "shouto", "todoroki shoto", "shouto todoroki", "todoroki's",
                "todo roki"],
        fx: "ice",
        shouts: [("todoroki ice wall", 0), ("todoroki ice wave", 0), ("todoroki glacier", 0), ("todoroki ice", 0), ("flashfire", 1), ("flashfire fist", 1),
                 ("heaven piercing ice wall", 2), ("flashfreeze heatwave", 3), ("ice slide", 4), ("todoroki fire", 5), ("left side fire", 5)],
        moves: [
            // The glacier: a ridge of ice races along the ground from your right foot and stays there —
            // anyone standing on its path is thrown up and chilled. -> you stand at its root; it's cover now.
            (name: "ice wave", cooldown: 2.4, cost: 8.0, tags: [Primary], ops: [
                Erupt(length: 18.0, width: 2.0, height: 2.5, element: Ice, damage: 8.0, launch: 14.0),
                Zone(radius: 3.0, secs: 1.5, status: Some(Chill), at: Front, dist: 8.0),
            ], juice: Some((ripple: 3.0, at: Front, dist: 3.0, color: Some((0.7, 0.9, 1.0))))),
            // Flashfire Fist: all the left side's heat in one punch.
            (name: "flashfire fist", cooldown: 3.0, cost: 10.0, tags: [], fx: "fire", ops: [
                Impulse(fwd: 14.0, up: 0.0),
                Shove(range: 3.6, angle: 40.0, damage: 16.0, knockback: 20.0, element: Fire),
            ], juice: Some((title: Some("FLASHFIRE FIST"), boom: true, punch: 4.0, color: Some((1.0, 0.4, 0.1))))),
            // Heaven-Piercing Ice Wall: a skyscraper of ice rises in front of you.
            (name: "heaven piercing ice wall", cooldown: 16.0, cost: 40.0, tags: [Ultimate], ops: [
                Erupt(length: 30.0, width: 5.0, height: 9.0, element: Ice, damage: 14.0, launch: 24.0),
                Zone(radius: 10.0, secs: 3.0, status: Some(Chill), slow: 0.4, at: Front, dist: 12.0),
            ], juice: Some((title: Some("HEAVEN-PIERCING ICE WALL"), boom: true, shake: 0.35, punch: 5.0))),
