        names: ["alchemy", "transmutation", "alchemic transmutation", "equivalent exchange", "state alchemist",
                "transmutation circle", "alchemist"],
        ascend: Some((color: Some((0.4, 0.75, 1.0)), intensity: 0.8, title: Some("TRANSMUTATION"), linger: false)),
        fx: "earth",
        shouts: [("hand clap", 0), ("transmute", 0), ("clap transmute", 0), ("alchemy clap", 0), ("clap and transmute", 0),
                 ("earth wall", 1), ("transmute wall", 1),
                 ("earth spikes", 2), ("stone spikes", 2), ("transmute spikes", 2),
                 ("earth cannon", 3), ("transmute cannon", 3), ("stone cannon", 3)],
        moves: [
            // Clap, palms to the ground: a pillar punches up under whoever you look at. -> they end in the air.
            (name: "hand clap", cooldown: 1.6, cost: 8.0, tags: [Primary], ops: [
                Erupt(length: 1.0, width: 1.6, height: 5.0, shape: Pillar, at: Aim, damage: 9.0, launch: 18.0),
            ], juice: Some((title: Some("TRANSMUTE!"), ripple: 2.5, at: Aim, color: Some((0.4, 0.75, 1.0))))),
            // A wall of the ground itself rises across your front. -> you're behind cover.
            (name: "earth wall", cooldown: 3.0, cost: 8.0, tags: [Defense], ops: [
                Erupt(length: 8.0, width: 1.0, height: 3.5, shape: Wall, dist: 3.0),
            ], juice: Some((ripple: 3.0, at: Front, dist: 3.0, color: Some((0.4, 0.75, 1.0))))),
            // A row of stone spears races out of the ground along your aim.
            (name: "earth spikes", cooldown: 2.0, cost: 8.0, ops: [
                Erupt(length: 16.0, width: 1.2, height: 3.0, count: 7, damage: 10.0, launch: 14.0),
            ], juice: Some((ripple: 3.0, at: Front, dist: 6.0, color: Some((0.4, 0.75, 1.0))))),
            (name: "earth cannon", cooldown: 4.0, cost: 6.0, ops: [
                Cast(recipe: (name: "stone cannon", form: Cannon, mech: [Shoots, Heavy], element: Earth, scale: 1.4,
                              payload: Some((name: "stone shot", form: Boulder, mech: [Heavy, Blunt], element: Earth, scale: 0.6)))),
            ], juice: Some((title: Some("TRANSMUTE: CANNON"), color: Some((0.4, 0.75, 1.0))))),
        ],
        tiers: [
            (name: "Fullmetal Alchemist",
             names: ["fullmetal alchemy", "full metal alchemy", "the fullmetal alchemist's alchemy", "edward elric's alchemy", "fullmetal transmutation"],
             effects: [PowerMult(damage: 1.1, speed: 1.08)],
             ascend: Some((color: Some((0.4, 0.75, 1.0)), intensity: 1.1, title: Some("FULLMETAL ALCHEMIST"))),
             shouts: [("automail blade", 0), ("arm blade", 0), ("transmute blade", 0), ("transmute cage", 2), ("alchemy prison", 2)],
             moves: [
                 // Clap and turn your automail forearm into a blade.
                 (name: "automail blade", cooldown: 1.0, cost: 3.0, ops: [
                     Cast(recipe: (name: "automail blade", form: Sword, mech: [Blade, Fast], element: Light, scale: 1.0)),
                 ], juice: Some((title: Some("TRANSMUTE!"), color: Some((0.4, 0.75, 1.0))))),
                 (name: "earth wall", cooldown: 2.5, cost: 8.0, ops: [
                     Erupt(length: 8.0, width: 1.0, height: 3.5, shape: Wall, dist: 3.0),
                 ], juice: Some((ripple: 3.0, at: Front, dist: 3.0, color: Some((0.4, 0.75, 1.0))))),
                 // A ring of stone around whoever you look at: a cage.
                 (name: "stone cage", cooldown: 8.0, cost: 12.0, ops: [
                     Erupt(length: 6.0, width: 1.0, height: 4.0, shape: Ring, at: Aim),
                 ], juice: Some((title: Some("TRANSMUTE!"), ripple: 4.0, at: Aim))),
                 (name: "earth cannon", cooldown: 3.5, cost: 6.0, ops: [
                     Cast(recipe: (name: "stone cannon", form: Cannon, mech: [Shoots, Heavy], element: Earth, scale: 1.4,
                                   payload: Some((name: "stone shot", form: Boulder, mech: [Heavy, Blunt], element: Earth, scale: 0.6)))),
                 ], juice: Some((title: Some("TRANSMUTE: CANNON")))),
             ]),
            (name: "Flame Alchemist",
             names: ["flame alchemist", "the flame alchemist", "flame alchemy", "roy mustang's alchemy", "mustang's gloves", "ignition gloves"],
             effects: [PowerMult(damage: 1.2)],
             graft: Some((element: Some(Fire))),
             ascend: Some((color: Some((1.0, 0.45, 0.12)), intensity: 1.2, title: Some("FLAME ALCHEMIST"))),
             shouts: [("snap", 0), ("finger snap", 0), ("snap fire", 0), ("flame snap", 0),
                      ("flame wall", 1), ("mustang fire wall", 1),
                      ("flame lance", 2), ("mustang fire lance", 2),
                      ("inferno snap", 3), ("flame alchemy inferno", 3)],
             moves: [
                 // Snap: the spark rides the air to where you look and the air explodes. No projectile to dodge — just look away.
                 (name: "snap", cooldown: 1.6, cost: 5.0, ops: [
                     Explode(radius: 3.2, damage: 12.0, knockback: 14.0, element: Fire, at: Aim),
