             ]),
            (name: "Strong Arm Alchemist",
             names: ["strong arm alchemist", "the strong arm alchemist", "armstrong alchemy", "armstrong's alchemy", "strongarm alchemist"],
             effects: [PowerMult(damage: 1.3, knockback: 1.3)],
             ascend: Some((color: Some((1.0, 0.8, 0.9)), intensity: 1.3, title: Some("STRONG ARM ALCHEMIST"))),
             shouts: [("stone missile", 0), ("armstrong cannon", 1), ("armstrong volley", 1)],
             moves: [
                 // Punch the ground and a block of it flies off as a missile.
                 (name: "stone missile", cooldown: 1.4, cost: 5.0, ops: [
                     Shove(range: 3.0, angle: 45.0, damage: 10.0, knockback: 14.0, element: Earth),
                     Cast(recipe: (name: "stone missile", form: Boulder, mech: [Fast, Heavy, Blunt], element: Earth, scale: 1.0, mass: 200.0)),
                 ], juice: Some((title: Some("ARMSTRONG ALCHEMY"), punch: 3.0))),
                 (name: "armstrong cannon", cooldown: 5.0, cost: 8.0, ops: [
                     Cast(recipe: (name: "stone volley", form: Boulder, mech: [Fast, Heavy, Swarm], element: Earth, scale: 0.6, count: 5)),
                 ], juice: Some((title: Some("ARMSTRONG CANNON"), boom: true))),
             ]),
            (name: "Crimson Alchemist",
             names: ["crimson alchemist", "the crimson alchemist", "crimson lotus alchemist", "kimblee's alchemy", "bomb alchemy"],
             effects: [PowerMult(damage: 1.2, knockback: 1.25)],
             graft: Some((mechanics: [Explodes])),
             ascend: Some((color: Some((1.0, 0.2, 0.2)), intensity: 1.2, title: Some("CRIMSON ALCHEMIST"))),
             shouts: [("crimson explosion", 0), ("detonate touch", 0), ("crimson lotus", 1)],
