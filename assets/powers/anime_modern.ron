    // ================================================================================================
    // KITS (kind: Kit): "<character> <move word>" fires that character's move ("gojo blue", "sukuna
    // dismantle", "deku smash", "bakugo ultimate"); the bare character name stays the costume summon.
    // Each move's famous name is also a shout anyone can borrow. `cost` = presence weight (≥ 8 Normal,
    // ≥ 20 Big, ≥ 40 Titan). `fx` = the move's body (assets/tuning/move_fx.ron).
    // ================================================================================================

    // ================================================================ JUJUTSU KAISEN
    // ---------------------------------------------------------------- Gojo: the strongest
    // Blue PULLS (a point of attraction that tears the ground up into itself), Red REPELS (a burst at
    // arm's length that throws everything away), Purple ERASES (Blue and Red at either hand, merged —
    // the Hollow Purple windup). Infinity: for a beat, nothing reaches you. Unlimited Void: everyone
    // inside the domain is slowed and can't use a single power.
    (
        id: "gojo_kit",
        name: "Satoru Gojo",
        kind: Kit,
        names: ["gojo", "satoru gojo", "gojo satoru", "satoru", "gojo sensei", "gojou", "go jo", "gojo-sensei"],
        fx: "cursed",
        shouts: [("maximum output blue", 0), ("max blue", 0), ("maximum blue", 0),
                 ("maximum output red", 1), ("max red", 1),
                 ("imaginary purple", 2), ("hollow technique purple", 2),
                 ("gojo infinity", 3), ("mugen barrier", 3),
                 ("domain expansion unlimited void", 4), ("ryoiki tenkai muryokusho", 4), ("muryokusho", 4), ("infinite void domain", 4), ("domain extension unlimited void", 4), ("domain expansion infinite void", 4)],
        moves: [
            // A point of blue attraction at the crosshair: bodies, loose things and torn-up ground are
            // dragged into it and crushed together, then it pops. -> ends with them clumped where you looked.
            (name: "blue", cooldown: 3.0, cost: 12.0, tags: [Primary], ops: [
                Singularity(dist: 14.0, rise: 1.5, secs: 1.4, radius: 8.0, strength: 42.0, capture: 1.8, chunks: 5, damage: 8.0, knockback: 12.0),
            ], juice: Some((title: Some("BLUE"), ripple: 8.0, at: Aim, punch: 2.0, debris: -14.0, color: Some((0.25, 0.5, 1.0))))),
            // Red: a burst of repulsion at arm's length — everything in front is hurled away. -> you stay planted.
            (name: "red", cooldown: 3.5, cost: 12.0, tags: [Combo], ops: [
                Explode(radius: 4.5, damage: 11.0, knockback: 34.0, element: Psychic, at: Front, dist: 4.5),
                Field(strength: -70.0, radius: 7.0, secs: 0.35, at: Front, dist: 4.5),
            ], juice: Some((title: Some("RED"), boom: true, ripple: 7.0, at: Front, dist: 4.5, punch: 4.0, shake: 0.2, debris: 20.0,
                            color: Some((1.0, 0.15, 0.15))))),
            // Blue in one hand, Red in the other, pressed together: the erasing orb.
            (name: "hollow purple", cooldown: 18.0, cost: 40.0, tags: [Ultimate], ops: [
                Cast(recipe: (name: "hollow purple", form: Cannon, mech: [Pierce, Explodes, Heavy], element: Psychic, scale: 2.0),
                     signature: Some(Beam), merge: Some((Water, Fire))),
            ], juice: Some((title: Some("HOLLOW PURPLE"), boom: true, punch: 6.0, color: Some((0.62, 0.3, 1.0))))),
            // Infinity: for a moment everything coming at you slows to nothing and stops short. -> you're untouched.
            (name: "infinity", cooldown: 8.0, cost: 8.0, tags: [Defense], ops: [Counter(secs: 1.4)],
             juice: Some((title: Some("INFINITY"), ripple: 3.0, color: Some((0.55, 0.8, 1.0))))),
            // Domain Expansion: Unlimited Void. Everyone inside is flooded with infinite information —
            // slowed, and no powers at all while it lasts (their bodies still move: never a freeze).
            (name: "unlimited void", cooldown: 30.0, cost: 40.0, tags: [], ops: [
                Cast(recipe: (name: "unlimited void", form: Dome, mech: [Barrier, Trap], element: Psychic, scale: 2.0), signature: Some(Domain)),
                Zone(radius: 14.0, secs: 3.0, slow: 0.55, lockout: true),
            ], juice: Some((title: Some("DOMAIN EXPANSION: UNLIMITED VOID"), boom: true, ripple: 14.0, punch: 5.0, shake: 0.2,
                            color: Some((0.3, 0.45, 1.0))))),
            // A short teleport folding space with Blue. -> ends where you looked, grounded or not.
            (name: "gojo teleport", cooldown: 1.5, cost: 4.0, tags: [Movement], ops: [Blink(dist: 18.0, afterimage: false)],
             juice: Some((ripple: 2.5, color: Some((0.25, 0.5, 1.0))))),
        ],
    ),
    // ---------------------------------------------------------------- Sukuna: the King of Curses
    // Dismantle: invisible slashes that carve straight through terrain. Cleave: a close cut that
    // measures you and bites deeper. Fuga: the fire arrow — the whole area it lands on burns.
    // Malevolent Shrine: a domain where slashes fall on everyone inside.
    (
        id: "sukuna_kit",
        name: "Ryomen Sukuna",
        kind: Kit,
        names: ["sukuna", "ryomen sukuna", "sukuna ryomen", "king of curses", "sukuna's", "su kuna", "sukona", "ryoumen sukuna"],
        fx: "cursed",
        shouts: [("sukuna dismantle", 0),
                 ("sukuna cleave", 1),
                 ("fuga open", 2), ("flame arrow", 2), ("fuuga", 2), ("furnace open", 2),
                 ("world cutting slash", 3), ("world slash", 3), ("dismantle that cuts the world", 3),
                 ("domain expansion malevolent shrine", 4), ("fukuma mizushi", 4), ("domain extension malevolent shrine", 4),
                 ("dismantle barrage", 5), ("dismantle flurry", 5)],
        moves: [
            // An invisible slash along your aim: a hairline trench, and whoever stood in it. -> you don't move.
            (name: "dismantle", cooldown: 0.8, cost: 6.0, tags: [Primary], ops: [Carve(length: 26.0, radius: 0.35, damage: 11.0)],
             juice: Some((punch: 1.5, color: Some((1.0, 0.2, 0.25))))),
            // Cleave: it adjusts itself to its target — cold it's a heavy cut, but on someone you've just
            // Dismantled it bites far deeper (the combo crit). -> you stay in their face.
            (name: "cleave", cooldown: 1.6, cost: 8.0, tags: [Combo], ops: [
                Finisher(lunge: 6.0, range: 3.8, angle: 60.0, damage: 12.0, knockback: 10.0, window: 1.5, mult: 1.9),
                Carve(length: 5.0, radius: 0.9, damage: 0.0),
            ], juice: Some((title: Some("CLEAVE"), punch: 3.0, shake: 0.15, color: Some((1.0, 0.2, 0.25))))),
            // Fuga: "Open" — a bow of flame drawn and loosed; where it lands keeps burning.
            (name: "fuga", cooldown: 12.0, cost: 20.0, tags: [], fx: "fire", ops: [
                Cast(recipe: (name: "fuga", form: Spear, mech: [Fast, Pierce, Explodes], element: Fire, scale: 1.4)),
                Zone(radius: 6.0, secs: 4.0, status: Some(Burn), dps: 4.0, at: Aim),
            ], juice: Some((title: Some("FUGA"), boom: true, punch: 4.0, color: Some((1.0, 0.45, 0.1))))),
            // The slash that cuts space itself: one enormous line across the arena. -> ends planted.
            (name: "world cutting slash", cooldown: 24.0, cost: 40.0, tags: [Ultimate], fx: "void", ops: [
                Wave(length: 45.0, speed: 60.0, width: 9.0, carve: 0.9, damage: 26.0, knockback: 14.0, thin: true),
            ], juice: Some((title: Some("WORLD CUTTING SLASH"), boom: true, punch: 6.0, shake: 0.35, debris: 18.0, color: Some((1.0, 0.1, 0.15)),
                            impact_frame: Some("void")))),
            // Malevolent Shrine: the shrine rises around you and slashes rain on everyone near it.
            (name: "malevolent shrine", cooldown: 30.0, cost: 40.0, tags: [], ops: [
                Cast(recipe: (name: "malevolent shrine", form: Dome, mech: [Barrier, Trap, Blade], element: Shadow, scale: 2.0), signature: Some(Domain)),
                Salvo(count: 14, delay: 0.35, interval: 0.1, radius: 2.2, damage: 6.0, knockback: 6.0, spread: 11.0, seek: true),
            ], juice: Some((title: Some("DOMAIN EXPANSION: MALEVOLENT SHRINE"), boom: true, ripple: 14.0, punch: 5.0, shake: 0.25,
                            color: Some((0.8, 0.05, 0.1))))),
            // A storm of invisible cuts in front of you.
            (name: "dismantle barrage", cooldown: 3.0, cost: 10.0, tags: [], ops: [
                Barrage(hits: 7, interval: 0.07, range: 7.0, angle: 45.0, damage: 4.0, knockback: 2.0, finish: 14.0),
            ], juice: Some((punch: 2.0, shake: 0.15, color: Some((1.0, 0.2, 0.25))))),
            // He's simply there: a lunge at whoever you look at.
            (name: "sukuna lunge", cooldown: 1.8, cost: 5.0, tags: [Movement], ops: [
                Pounce(range: 22.0, speed: 42.0, cone: 12.0, damage: 9.0, knockback: 12.0),
            ], juice: Some((punch: 2.0))),
        ],
    ),
    // ---------------------------------------------------------------- Yuji Itadori: the vessel
    // Divergent Fist: the punch lands, then its cursed energy lands a heartbeat later — two impacts
    // from one swing. Manji Kick: the counter-kick when they come in close.
    (
        id: "itadori_kit",
        name: "Yuji Itadori",
        kind: Kit,
        names: ["itadori", "yuji", "yuji itadori", "itadori yuji", "itadori's", "yuuji", "yuji's", "itadori kun"],
        fx: "cursed",
        shouts: [("divergent fist", 0), ("divergent punch", 0), ("delayed punch", 0),
                 ("manji kick", 2), ("manji", 2),
                 ("cursed energy rush", 3), ("itadori rush", 3)],
        moves: [
            // The fist hits; the cursed energy arrives a beat late and hits again. -> you stay close.
            (name: "divergent fist", cooldown: 0.8, cost: 5.0, tags: [Primary], ops: [
                Shove(range: 3.2, angle: 40.0, damage: 8.0, knockback: 6.0),
                DelayedHit(range: 4.5, cone: 12.0, secs: 0.3, damage: 7.0, knockback: 14.0),
            ], juice: Some((punch: 2.5, color: Some((0.3, 0.55, 1.0))))),
            // Black Flash: see the black_flash technique; this is Yuji's committed version.
            (name: "black flash", cooldown: 1.2, cost: 8.0, tags: [Ultimate], ops: [
                Impulse(fwd: 16.0, up: 0.5),
                Shove(range: 3.4, angle: 40.0, damage: 14.0, knockback: 20.0, element: Shadow),
            ], juice: Some((title: Some("BLACK FLASH"), punch: 4.0, shake: 0.2, color: Some((0.85, 0.08, 0.1))))),
            // Manji Kick: brace — the next one who hits you eats a spinning kick. -> ends in counter position.
            (name: "manji kick", cooldown: 4.0, cost: 6.0, tags: [Counter], ops: [
                Counter(secs: 0.7, damage: 12.0, knockback: 18.0, up: 0.8),
            ], juice: Some((title: Some("MANJI KICK")))),
            // Fists everywhere, driving forward.
            (name: "cursed energy rush", cooldown: 2.5, cost: 8.0, tags: [Combo], ops: [
                Barrage(hits: 6, interval: 0.09, range: 3.2, angle: 50.0, damage: 4.0, knockback: 2.0, finish: 16.0, advance: 3.0),
            ], juice: Some((punch: 2.0))),
            // A sprinting close of distance (the vessel is monstrously fast).
            (name: "itadori dash", cooldown: 1.2, cost: 3.0, tags: [Movement], ops: [
                Pounce(range: 18.0, speed: 36.0, cone: 10.0, damage: 6.0, knockback: 8.0),
            ]),
        ],
    ),
    // ---------------------------------------------------------------- Megumi Fushiguro: Ten Shadows
    // Every shikigami does one thing: the dogs hunt, Nue shocks from above, the Toad's tongue drags,
    // Max Elephant floods, the rabbits hide you, Mahoraga adapts.
    (
        id: "megumi_kit",
        name: "Megumi Fushiguro",
        kind: Kit,
        names: ["megumi", "megumi fushiguro", "fushiguro", "fushiguro megumi", "megumi's", "fushiguro's"],
        fx: "shadow",
        shouts: [("nue", 1), ("nue owl", 1), ("toad tongue", 2), ("gama", 2), ("max elephant", 3), ("manga elephant", 3),
                 ("rabbit escape", 4), ("dattoto", 4), ("shadow dive", 5), ("sink into the shadow", 5),
                 ("chimera shadow garden", 6), ("domain expansion chimera shadow garden", 6), ("kan'en shotei", 6)],
        moves: [
            (name: "divine dogs", cooldown: 5.0, cost: 10.0, tags: [Primary], ops: [
                Cast(recipe: (name: "divine dog", form: Quadruped, mech: [Walks, Blade, Fast], element: Shadow, scale: 1.1, count: 2,
                              temperament: Aggressive, intensity: 0.8)),
            ], juice: Some((ripple: 3.0, color: Some((0.2, 0.2, 0.3))))),
            // Nue: a masked bird that dives from above crackling with lightning.
            (name: "nue", cooldown: 5.0, cost: 10.0, tags: [], fx: "lightning", ops: [
                Cast(recipe: (name: "nue", form: Bird, mech: [Flies, Charge, Fast], element: Electric, scale: 1.4, temperament: Aggressive, intensity: 0.9)),
            ], juice: Some((title: Some("NUE"), color: Some((0.7, 0.8, 1.0))))),
            // Toad: a tongue snaps out and hauls them in.
            (name: "toad", cooldown: 4.0, cost: 8.0, tags: [], ops: [Hook(range: 22.0, speed: 55.0, pull: 20.0, damage: 3.0)],
             juice: Some((title: Some("TOAD")))),
            // Max Elephant: an elephant pours a flood that sweeps everything ahead.
            (name: "max elephant", cooldown: 10.0, cost: 20.0, tags: [], fx: "water", ops: [
                Surge(width: 7.0, dist: 22.0, speed: 16.0, push: 22.0, damage: 6.0, element: Water),
            ], juice: Some((title: Some("MAX ELEPHANT"), boom: true, shake: 0.2, color: Some((0.3, 0.6, 1.0))))),
            // Rabbit Escape: a flood of shadow rabbits covers you; you're gone out the back of it.
            (name: "rabbit escape", cooldown: 8.0, cost: 8.0, tags: [Defense], ops: [
                Cast(recipe: (name: "shadow rabbits", form: Quadruped, mech: [Swarm, Fast, Walks], element: Shadow, scale: 0.4, count: 12,
                              temperament: Playful, intensity: 1.0)),
                Impulse(fwd: -14.0, up: 5.0),
            ], juice: Some((title: Some("RABBIT ESCAPE")))),
            // Sink into your own shadow and rise from it further along.
            (name: "shadow dive", cooldown: 3.0, cost: 6.0, tags: [Movement], ops: [
                Phase(secs: 0.8),
                Blink(dist: 14.0, afterimage: false),
            ], juice: Some((ripple: 2.0, color: Some((0.1, 0.1, 0.15))))),
            // Domain Expansion: the ground becomes a lake of shadow full of shikigami.
            (name: "chimera shadow garden", cooldown: 30.0, cost: 40.0, tags: [], ops: [
                Cast(recipe: (name: "chimera shadow garden", form: Dome, mech: [Barrier, Trap], element: Shadow, scale: 2.0), signature: Some(Domain)),
