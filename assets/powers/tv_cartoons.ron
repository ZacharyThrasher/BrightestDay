    // ================================================================ TRANSFORMERS (G1 / films / Prime / Animated)
    // On-foot kits: YOU fight as the bot ("optimus prime combo", "starscream null ray", "laserbeak eject").
    // Their feel follows the piloted brawler archetypes (assets/tuning/combat.ron `transformer`): a TRUCK
    // (Optimus, Ironhide) hits in heavy 4-hit strings that end in an axe and rams that pin you to walls;
    // a CAR (Bumblebee, Jazz) is quick light strings, a drift ram and short bursts; a JET (Starscream)
    // launches and fights in the air, fly-bys and a dive kick; a TANK (Megatron) is the ranged heavy.
    // The bare name ("optimus prime") still summons the bot you can pilot; "roll out" / "transform and
    // roll out" / "combine" stay the lexicon's commands for your piloted bots — no kit uses those words.
    (
        id: "kit_optimus_prime",
        name: "Optimus Prime",
        kind: Kit,
        names: ["optimus prime", "optimus", "optimus primes", "optimus prime's", "orion pax", "optimus prim", "optimist prime",
                "optimus prine", "opimus prime", "optimus pryme"],
        fx: "energy",
        shouts: [("optimus energon axe", 0), ("ion blaster", 2), ("shoot the ion blaster", 2), ("ion blaster gun", 2), ("Matrix Of Leadership", 7), ("optimus axe slam", 4)],
        moves: [
            // THE COMBO: the piloted truck's string on foot — three heavy slashes 0.3 s apart, each
            // driving a step in, and the energon-axe finisher that sends them across the map (the
            // same rhythm as a piloted Optimus: LMB, LMB, LMB, axe).
            (name: "combo", tags: [Combo, Primary], cooldown: 2.4, cost: 5.0, ops: [
                Barrage(hits: 4, interval: 0.3, range: 3.4, angle: 70.0, damage: 7.5, knockback: 11.0, finish: 32.0, advance: 3.0,
                        up: 0.25, blink: false, element: Light),
            ], juice: Some((title: Some("ENERGON AXE"), punch: 3.0, shake: 0.14, color: Some((0.35, 0.75, 1.0)),
                            impact_frame: Some("comic")))),
            // The truck's armoured heavy: plant, soak what's coming, and bring the fist round.
            (name: "heavy", cooldown: 3.0, cost: 4.0, ops: [
                Empower(secs: 0.7, damage: 1.0, armor: 0.4, contact: 0.0, contact_kb: 0.0, contact_cd: 0.0, element: Light),
                Shove(range: 3.2, angle: 60.0, damage: 16.0, knockback: 26.0, up: 0.3),
            ], juice: Some((shake: 0.14, punch: 2.5))),
            // Ion blaster: a three-round burst from the rifle.
            (name: "ion blaster", cooldown: 0.9, cost: 2.0, ops: [
                Cast(recipe: (name: "ion blaster", form: Ball, mech: [Fast, Swarm], element: Electric, scale: 0.3, mass: 2.0, count: 3)),
            ], juice: Some((punch: 1.2, color: Some((0.5, 0.8, 1.0))))),
            // Freight-train charge: scoop the first bot you meet onto your bumper and drive them into a wall.
            (name: "charge", tags: [Movement], cooldown: 4.0, cost: 5.0, ops: [
                Ram(speed: 22.0, secs: 1.0, damage: 15.0, knockback: 30.0, up: 0.2, pin: true, through: false, wall: 18.0,
                    pitch: 0.0, steer: 50.0, keep: 0.2, element: Light),
            ], juice: Some((shake: 0.16, punch: 2.0))),
            // Leap and bring the axe down: a crater and a shockwave.
            (name: "axe slam", cooldown: 4.0, cost: 5.0, ops: [
                Impulse(fwd: 7.0, up: 11.0),
                SlamOnLand(radius: 6.0, damage: 14.0, knockback: 24.0, carve: 1.4),
            ], juice: Some((shake: 0.2, debris: 14.0, color: Some((0.35, 0.75, 1.0))))),
            // The arm shield comes up: the first hit breaks on it and he answers with the blade.
            (name: "shield", tags: [Defense, Counter], cooldown: 5.0, cost: 4.0, ops: [
                Counter(secs: 1.2, damage: 12.0, knockback: 24.0, up: 0.25, element: Light),
            ]),
            // Grapple hook into the wall and swing in.
            (name: "grapple", tags: [Movement], cooldown: 1.6, cost: 3.0, ops: [Reel(range: 36.0, speed: 32.0)]),
            // The Matrix of Leadership opens: light floods out of his chest.
            (name: "matrix of leadership", tags: [Ultimate], cooldown: 20.0, cost: 14.0, ops: [
                Explode(radius: 11.0, damage: 14.0, knockback: 34.0, carve: 1.0, element: Light),
                Field(strength: -50.0, radius: 13.0, secs: 0.4),
            ], juice: Some((title: Some("MATRIX OF LEADERSHIP"), ripple: 13.0, boom: true, punch: 6.0, shake: 0.3, debris: 20.0,
                            color: Some((0.55, 0.85, 1.0)), impact_frame: Some("holy")))),
        ],
    ),
    (
        id: "kit_megatron",
