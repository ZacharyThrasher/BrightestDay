    (
        id: "kit_starscream",
        name: "Starscream",
        kind: Kit,
        names: ["starscream", "star scream", "starscream's", "stars cream", "starscreem"],
        fx: "speed",
        shouts: [("null ray", 0), ("null rays", 0), ("starscream missiles", 1)],
        moves: [
            // Null ray: the shot scrambles their systems — damage, and their power moves go dead.
            (name: "null ray", tags: [Primary], cooldown: 5.0, cost: 4.0, ops: [
                Afflict(range: 30.0, cone: 4.0, status: None, secs: 0.0, damage: 8.0, knockback: 6.0, up: 0.0, element: Electric),
                Lockout(range: 30.0, secs: 1.5),
            ], juice: Some((title: Some("NULL RAY"), color: Some((0.8, 0.3, 0.9))))),
            // Missile lock: sweep the crosshair over them, then a missile for everyone locked.
            (name: "missiles", tags: [Ultimate], cooldown: 12.0, cost: 8.0, ops: [
                LockOn(secs: 1.6, range: 45.0, damage: 14.0, knockback: 18.0, angle: 28.0),
            ], juice: Some((title: Some("MISSILE LOCK")))),
