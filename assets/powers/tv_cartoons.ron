// TV & CARTOONS (TOOLBOX content worker): Avatar / Korra bending, Transformers, TMNT, Ben 10, Power
// Rangers, Invincible, Stranger Things, The Boys, Teen Titans, Rick and Morty, Doctor Who, Adventure
// Time, Gravity Falls, Steven Universe, Danny Phantom, Kim Possible, Miraculous, Samurai Jack, Dexter's
// Lab, SpongeBob, Looney Tunes, Scooby-Doo, Arcane, Castlevania, The Witcher, Buffy, Supernatural,
// Voltron, He-Man / She-Ra, ThunderCats, Ninjago, Phineas and Ferb.
// Schema + authoring rules: assets/powers/README.md (docs/toolbox/BRIEF.md for the why). A plain RON
// list; files load in filename order. Kits ("<name> <move>") never grant and never steal the bare
// name from the costume summon; techniques (the bending arts) are said to be learned.
// Every headline move is the thing it is famous for, done the way it is famous for doing it, and
// ends in a state the next link of a chain can use (airborne / grounded / them launched / them close).
[
    // ================================================================ AVATAR: THE LAST AIRBENDER / THE LEGEND OF KORRA
    // Bending is the headline. The four arts are TECHNIQUES (say "earthbending": you ARE an earthbender
    // until KO — body, graft and a full move set on G + shouts; their sub-arts are tiers: metalbending,
    // lavabending, seismic sense, bloodbending under the full moon, blue fire, lightning, combustion).
    // The characters are KITS ("toph seismic sense", "azula lightning", "aang avatar state").
    // Every art moves differently: AIR never plants (floaty, evasive, knockback not damage), WATER
    // flows and binds (lashes, soaks, ice that holds), EARTH is rooted and bends the REAL ground
    // (walls and spikes rise out of the actual terrain via Erupt), FIRE is breath and fists (jabs,
    // kicks, jets, and lightning that must be caught or it hurts).
    (
        id: "airbending",
        name: "Airbending",
        kind: Technique,
        names: ["airbending", "air bending", "airbender", "air bender", "airbend", "air bend", "air nomad", "air nomads",
                "air nomad style", "airbending style", "air-bending", "aerbending", "air bening", "air bendin", "air benders"],
        // Air nomads barely touch the ground: floaty jumps, a glide, one extra air jump.
        body: (moves: (jump: 1.3, gravity: 0.85, air_control: 1.5, glide: 0.35)),
        graft: Some((element: Some(Wind))),
        effects: [AirJumps(extra: 1), PowerMult(speed: 1.08, damage: 0.9, knockback: 1.2)],
        ascend: Some((color: Some((0.82, 0.93, 1.0)), intensity: 0.9, title: Some("AIRBENDING"), style: Calm, linger: false,
                      eye_glow: Some((0.85, 0.95, 1.0)))),
        fx: "air",
        shouts: [("air blast", 0), ("air push", 0), ("air scooter", 1), ("air scooter ride", 1),
                 ("airbending tornado", 2), ("air tornado", 2), ("air ball", 3), ("air marble", 3), ("air marbles", 3),
                 ("air spout", 4), ("air shield", 5), ("air cushion", 5), ("air sphere", 5), ("air slam", 6),
                 ("air dive", 6), ("air swipe", 7), ("air blade", 7), ("air slice", 7)],
        moves: [
            // A palm-thrust gust: tiny damage, huge push (airbending is evasive). Ends grounded, them far.
            (name: "air blast", tags: [Primary], cooldown: 0.8, cost: 3.0, ops: [
                Shove(range: 8.0, angle: 28.0, damage: 4.0, knockback: 28.0, element: Wind, up: 0.35),
                Field(strength: -45.0, radius: 3.5, secs: 0.25, at: Front, dist: 5.0),
            ], juice: Some((ripple: 3.0, at: Front, dist: 4.0, punch: 1.5, color: Some((0.85, 0.95, 1.0)), debris: 12.0))),
            // Ride a whirling ball of air: steer it with the crosshair, bat anyone you pass off it, hop
            // off still carrying the speed (ends moving fast, low: set up a tornado or a slam).
            (name: "air scooter", tags: [Movement], cooldown: 2.4, cost: 4.0, ops: [
                Ram(speed: 21.0, secs: 1.8, damage: 3.0, knockback: 20.0, up: 0.45, pin: false, through: true, wall: 0.0,
                    pitch: 0.0, steer: 160.0, keep: 0.8, element: Wind),
            ], juice: Some((punch: 1.0, color: Some((0.85, 0.95, 1.0))))),
            // A tornado that wanders after them, drags them in and throws them up.
            (name: "airbending tornado", tags: [Ultimate], cooldown: 10.0, cost: 10.0, ops: [
                Cast(recipe: (name: "airbending tornado", form: Pillar, mech: [Spin, Flies, Homing, Attract, Launch], element: Wind, scale: 6.0)),
            ], juice: Some((impact_frame: Some("ink"), title: Some("TORNADO"), shake: 0.15, boom: true, debris: -12.0, color: Some((0.8, 0.9, 1.0))))),
            // Aang's marble: a whirling sphere that ricochets around the arena shoving whoever it touches.
            (name: "air ball", cooldown: 3.0, cost: 4.0, ops: [
                Cast(recipe: (name: "air ball", form: Ball, mech: [Ricochet, Bounce, Repel, Fast, Spin], element: Wind, scale: 1.2, mass: 4.0)),
            ], juice: Some((punch: 1.2))),
            // A column of air lifts you high and holds you there a beat: ends ABOVE them (dive next).
            (name: "air spout", tags: [Movement], cooldown: 3.0, cost: 3.0, ops: [
                Impulse(fwd: 2.0, up: 21.0),
                SelfStatus(status: Float, secs: 1.4),
            ], juice: Some((ripple: 2.0, color: Some((0.85, 0.95, 1.0))))),
            // Spin the air into a sphere: shots that touch it are turned round, anyone close is pushed off.
            (name: "air shield", tags: [Defense], cooldown: 5.0, cost: 4.0, ops: [
                Deflect(secs: 1.1, angle: 180.0),
                Field(strength: -35.0, radius: 4.0, secs: 1.0),
            ], juice: Some((ripple: 4.0, color: Some((0.85, 0.95, 1.0))))),
            // Drop out of the sky on a column of wind: a ring blast where you land (chain after the spout).
            (name: "air slam", tags: [Combo], cooldown: 2.5, cost: 4.0, ops: [
                Impulse(fwd: 4.0, up: -30.0),
                SlamOnLand(radius: 6.5, damage: 7.0, knockback: 30.0, carve: 0.0),
            ], juice: Some((shake: 0.12, debris: 18.0))),
            // A staff swing throws a thin crescent of air that slices along your aim.
            (name: "air swipe", cooldown: 1.4, cost: 3.0, ops: [
                Wave(length: 20.0, speed: 42.0, width: 3.0, carve: 0.0, damage: 7.0, knockback: 18.0, up: 0.2, element: Wind, thin: false),
            ], juice: Some((ripple: 1.5, at: Front, dist: 6.0))),
        ],
        tiers: [
            // Zaheer let go of every earthly tether: true flight.
            (name: "Airbender Flight",
             names: ["airbender flight", "airbending flight", "zaheer's flight", "zaheer flight", "let go of earthly tethers"],
             body: Some((moves: (thrust: 26.0, thrust_max: 16.0, gravity: 0.55, air_control: 1.8, glide: 0.6))),
             effects: [AirJumps(extra: 2), PowerMult(speed: 1.15, damage: 0.95, knockback: 1.3), SelfDrain(willpower_per_s: 0.6)],
             ascend: Some((color: Some((0.9, 0.95, 1.0)), intensity: 1.4, title: Some("TRUE FLIGHT"), style: Calm, quiet: true))),
        ],
    ),
    (
        id: "waterbending",
