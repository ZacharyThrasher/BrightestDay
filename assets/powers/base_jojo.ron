        kind: Stand,
        names: ["star platinum", "jotaro's stand"],
        companion: Some((recipe: (name: "Star Platinum", form: Biped, mech: [Flies, Blunt, Fast], scale: 2.0, mass: 80.0), rush_damage: 3.0, rush_knockback: 4.0)),
