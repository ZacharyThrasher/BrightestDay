                 ("star platinum ora", 2), ("star platinum rush", 2)],
        moves: [
            // The stand's finger shoots out and pierces.
            (name: "star finger", tags: [Primary], cooldown: 1.5, cost: 5.0, ops: [Shove(range: 6.0, angle: 10.0, damage: 12.0, knockback: 14.0)],
             juice: Some((title: Some("STAR FINGER")))),
            // Never a freeze: the world greys and you alone move fast for a beat.
