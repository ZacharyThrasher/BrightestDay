                 ("gomu gomu no balloon", 5), ("Gum Gum Balloon", 5), ("gomu gomu no fusen", 5), ("Gum-Gum Balloon", 5), ("gomu gomu no fuusen", 5),
                 ("gomu gomu no red hawk", 6), ("gum gum red hawk", 6), ("red hawk", 6), ("gomu gomu no redo hoku", 6), ("gum-gum red hawk", 6),
                 ("gomu gomu no axe", 7), ("Gum Gum Axe", 7), ("gomu gomu no ono", 7), ("Gum-Gum Axe", 7)],
