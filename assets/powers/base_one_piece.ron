        // fx "rubber") — never the rigid telescoping pole of the Ruyi staff (Extends).
        shouts: [("gomu gomu no pistol", 0), ("Gum Gum Pistol", 0), ("Gum-Gum Pistol", 0), ("gomu gomu pistol", 0), ("gomu gomu no pisutoru", 0),
                 ("gum gum no pistol", 0), ("gumgum pistol", 0), ("gomu gomu no pistoru", 0),
                 ("gomu gomu no rocket", 1), ("Gum Gum Rocket", 1), ("Gum-Gum Rocket", 1), ("gomu gomu no roketto", 1), ("gumgum rocket", 1),
