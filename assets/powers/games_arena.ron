    // ================================================================ STREET FIGHTER
    // Fighting-game specials are READS: a fireball zones, an uppercut beats a jump-in (invincible
    // startup = a guard window that opens BEFORE the hit), a command grab beats a block and loses to a
    // jump, a dash punch is punishable if it's blocked. The "-> ends" notes are the combo routes.
    // ---------------------------------------------------------------- Ryu: the wandering warrior
    (
        id: "sf_ryu",
        name: "Ryu",
        kind: Kit,
        names: ["ryu", "ryu street fighter", "ryu sf", "ryus", "ryu's", "rio street fighter"],
        fx: "chi",
        shouts: [("Hadouken", 0), ("Hadoken", 0), ("Hadooken", 0), ("Ha Do Ken", 0), ("hadou ken", 0), ("hadoukan", 0), ("hadoooken", 0),
                 ("Shoryuken", 1), ("shoryukan", 1), ("sho ryu ken", 1), ("show you can", 1), ("shoryu ken", 1), ("Dragon Punch", 1),
                 ("tatsumaki senpukyaku", 2), ("hurricane kick", 2), ("Tatsu", 2), ("tatsumaki senpuukyaku", 2),
                 ("shinku hadouken", 3), ("shinku hadoken", 3), ("shin shoryuken", 4), ("joudan sokutou geri", 5), ("joudan", 5),
                 ("denjin hadouken", 6),
                 ("ryu fireball", 0), ("ryu uppercut", 1)],
        moves: [
            // HADOUKEN: both palms thrust forward, a ball of blue chi rolls out at a steady clip — the
            // zoning tool. (POLISH: an energy ball — it gathers between the palms, holding grows it, two
            // fireballs burst on each other; Electric = blue + the hit-stun that lets it combo into a
            // shoryuken. Was a slow Light block that dropped short of them.) -> ends in place, hands forward (a jump-in over it eats a shoryuken).
            (name: "hadouken", cooldown: 0.9, cost: 3.0, tags: [Primary], ops: [
                Cast(recipe: (name: "hadouken", form: Ball, mech: [Blunt, Fast], element: Electric, scale: 0.8, mass: 12.0)),
            ], juice: Some((title: Some("HADOUKEN"), punch: 2.0, color: Some((0.35, 0.7, 1.0))))),
            // SHORYUKEN: the rising dragon punch — invincible for the first instant (it beats whatever you
            // were about to eat), then an uppercut that carries you both up. -> ends high above them (air tatsu).
            (name: "shoryuken", cooldown: 1.5, cost: 4.0, tags: [Counter], ops: [
                Counter(secs: 0.18),
                Impulse(fwd: 4.0, up: 14.0),
                Shove(range: 3.0, angle: 55.0, damage: 12.0, knockback: 16.0, up: 1.8),
            ], juice: Some((title: Some("SHORYUKEN"), punch: 3.5, shake: 0.15, color: Some((1.0, 0.95, 0.7)), impact_frame: Some("comic")))),
            // TATSUMAKI SENPUKYAKU: the spinning hurricane kick — you travel forward, legs out, hitting
            // everything you pass. -> ends past them, a little in the air.
            (name: "tatsumaki senpukyaku", cooldown: 1.6, cost: 4.0, tags: [Combo], fx: "wind", ops: [
                SelfStatus(status: Float, secs: 0.6),
                Ram(speed: 12.0, secs: 0.8, damage: 5.0, knockback: 12.0, up: 0.3, through: true, keep: 0.2),
            ], juice: Some((title: Some("TATSUMAKI SENPUKYAKU"), color: Some((0.9, 0.95, 1.0))))),
            // SHINKU HADOUKEN: the super — a torrent of chi that tears straight through them.
            (name: "shinku hadouken", cooldown: 14.0, cost: 20.0, tags: [], ops: [
                Cast(recipe: (name: "shinku hadouken", form: Hands, mech: [Beam, Pierce], element: Light, scale: 1.4), signature: Some(Beam)),
            ], juice: Some((title: Some("SHINKU HADOUKEN"), boom: true, punch: 5.0, color: Some((0.35, 0.7, 1.0)), impact_frame: Some("comic")))),
            // SHIN SHORYUKEN: the critical art — the one-hit uppercut that ends rounds.
            (name: "shin shoryuken", cooldown: 20.0, cost: 40.0, tags: [Ultimate], ops: [
                Counter(secs: 0.25),
