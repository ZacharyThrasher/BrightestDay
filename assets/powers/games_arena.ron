// ARENA GAMES (CONTENT: ARENA GAMES worker, docs/toolbox/BRIEF.md): hero shooters, MOBAs and
// fighting games — Overwatch, Valorant, Apex Legends, Deadlock, Marvel Rivals (its originals only),
// League of Legends, Dota 2, Street Fighter, Mortal Kombat, Tekken, Smash Bros, Guilty Gear /
// BlazBlue, Fortnite, Team Fortress 2. Names only — no quotes, no voice lines beyond a move's name.
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
//
// Everything here is a `kind: Kit`: "<hero> <move word>" fires that hero's move ("doomfist punch",
// "reinhardt ultimate", "tracer blink"), the bare hero name stays the costume summon, and each move's
// famous name is also a shout anyone can borrow ("earthshatter", "hadouken", "get over here").
//
// Design rules for this file (the competitive feel matters most — these are the moves players chain
// for skill expression):
// * A famous move does the thing it is famous for, with ITS control: Reinhardt's Charge pins and
//   carries you into a wall (Ram pin), Doomfist's punch is a committed dash that launches you into
//   the wall splat (Ram), Scorpion's spear is a travelling skillshot you can dodge (Hook), Zangief's
//   SPD is a grab that beats a block but loses to a jump (Grab), Marth's counter answers your hit
//   (Counter), Genji's deflect sends it back along HIS aim (Deflect), Cassidy's Deadeye is a
//   telegraphed lock-on you break by hitting him (LockOn), Tracer's Recall rewinds her (Rewind).
// * Hard CC is short and escapable (owner rule): pins break on a dodge, tows break on a dodge, grabs
//   hold ≤ 0.45 s, stuns are micro, slows are thick air, lockouts take a verb (powers) not control.
// * Every move notes its CHAIN ENDING ("-> ends ...") so chains read: a dash that ends airborne sets
//   up an aerial, a launcher ends with them above you, a slam ends grounded, a pin ends at a wall.
// * `cost` is only a presence weight for spark pricing (≥ 8 Normal, ≥ 20 Big, ≥ 40 Titan); ultimates
//   are Titan, headline specials Big, pokes / dashes cheap. Cooldowns are per move.
// * `fx` = the body of the move (docs/toolbox/PRESENTATION.md style keys), `juice` = its landing.
[
    // ================================================================ OVERWATCH
    // ---------------------------------------------------------------- Reinhardt: the crusader
    (
        id: "ow_reinhardt",
        name: "Reinhardt",
        kind: Kit,
        names: ["reinhardt", "rein", "reinhart", "rein hart", "rhinehart", "rinehart", "reinhardt wilhelm", "rain hart", "reinheart",
                "reinhard", "rhine hart"],
        fx: "rigid",
        shouts: [("reinhardt charge", 1), ("fire strike", 2), ("firestrike", 2), ("earthshatter", 4), ("earth shatter", 4), ("earth shatterer", 4),
                 ("earth shattered", 4)],
        moves: [
            // A wide, heavy arc of the rocket hammer: slow, meaty, knocks them sideways. -> ends grounded, swing finished.
            (name: "rocket hammer", cooldown: 0.9, cost: 3.0, tags: [Primary], ops: [
                Shove(range: 4.0, angle: 100.0, damage: 11.0, knockback: 15.0, up: 0.2),
            ], juice: Some((punch: 2.0, shake: 0.12, color: Some((0.95, 0.75, 0.3))))),
            // CHARGE: a committed rocket-boosted run you can steer a little; the first enemy is scooped onto
            // the hammer and carried until a WALL (the big slam) — they escape with a dodge.
            // -> ends planted at the wall, the pinned body crumpled in front of you (earthshatter / hammer).
            (name: "charge", cooldown: 5.0, cost: 10.0, tags: [Movement], ops: [
                Ram(speed: 17.0, secs: 1.8, damage: 6.0, knockback: 18.0, up: 0.3, pin: true, wall: 24.0, steer: 50.0, keep: 0.0),
            ], juice: Some((title: Some("CHARGE"), punch: 4.0, shake: 0.2, boom: true, color: Some((0.95, 0.7, 0.25))))),
            // A flaming crescent flung from the hammer: it passes through everyone in its line. -> ends grounded.
            (name: "fire strike", cooldown: 3.0, cost: 6.0, tags: [], fx: "fire", ops: [
                Wave(length: 26.0, speed: 34.0, width: 2.6, damage: 11.0, knockback: 8.0, element: Fire, thin: true),
            ], juice: Some((title: Some("FIRE STRIKE"), punch: 2.0, color: Some((1.0, 0.45, 0.1))))),
            // A great blue hard-light shield raised in front: rounds stop on it.
            (name: "barrier field", cooldown: 4.0, cost: 6.0, tags: [Defense], fx: "hardlight", ops: [
                Cast(recipe: (name: "barrier field", form: Shield, mech: [Guard, Barrier], element: Light, scale: 2.2)),
                Counter(secs: 0.3),
            ], juice: Some((ripple: 3.0, color: Some((0.4, 0.75, 1.0))))),
            // EARTHSHATTER: the hammer comes down and a shockwave rolls out ahead, knocking everyone in the
            // cone off their feet (a micro-stun + a crater). -> ends grounded; they're down in front of you.
            (name: "earthshatter", cooldown: 18.0, cost: 40.0, tags: [Ultimate], fx: "earth", ops: [
                Explode(radius: 3.5, damage: 8.0, knockback: 8.0, carve: 1.6, element: Earth, at: Front, dist: 2.5),
                Wave(length: 18.0, speed: 30.0, width: 7.0, carve: 0.5, damage: 14.0, knockback: 6.0, up: 0.1, element: Electric),
            ], juice: Some((title: Some("EARTHSHATTER"), boom: true, punch: 6.0, shake: 0.35, ripple: 10.0, at: Front, dist: 7.0,
                            debris: 16.0, color: Some((0.95, 0.75, 0.3))))),
        ],
    ),
    // ---------------------------------------------------------------- Doomfist: the gauntlet
    (
        id: "ow_doomfist",
        name: "Doomfist",
        kind: Kit,
        names: ["doomfist", "doom fist", "dooms fist", "doom first", "doomfist's", "doom fists", "doom feast", "akande", "akande ogundimu",
                "doomfisted", "dume fist"],
        fx: "tech",
        shouts: [("rocket punch", 1), ("doomfist punch", 1), ("charged rocket punch", 2), ("full charge punch", 2),
                 ("fully charged rocket punch", 2), ("seismic slam", 3), ("power block", 4), ("doomfist meteor strike", 5)],
        moves: [
            // Knuckle-mounted shotgun: a short spread of slugs. -> ends where you stood.
            (name: "hand cannon", cooldown: 0.8, cost: 2.0, tags: [Primary], ops: [
                Cast(recipe: (name: "hand cannon", form: Ball, mech: [Fast, Swarm], scale: 0.22, count: 4, mass: 4.0)),
            ]),
            // ROCKET PUNCH: a committed dash with the gauntlet out front; the first body met is LAUNCHED
            // along it — into a wall they splat (the world's wall splat, bigger the more hurt they are).
            // -> ends right where they were, a little momentum kept (seismic slam follow-up).
            (name: "rocket punch", cooldown: 3.0, cost: 8.0, tags: [Movement], ops: [
                Ram(speed: 34.0, secs: 0.45, damage: 12.0, knockback: 32.0, up: 0.15, keep: 0.3),
            ], juice: Some((title: Some("ROCKET PUNCH"), punch: 4.0, shake: 0.18, color: Some((0.95, 0.6, 0.2))))),
            // The held, fully charged punch: further, faster, a much bigger launch. -> ends past where they stood.
            (name: "charged rocket punch", cooldown: 4.5, cost: 12.0, tags: [], ops: [
                Ram(speed: 44.0, secs: 0.55, damage: 17.0, knockback: 44.0, up: 0.2, keep: 0.35),
            ], juice: Some((title: Some("ROCKET PUNCH"), punch: 6.0, shake: 0.28, boom: true, color: Some((1.0, 0.5, 0.15))))),
            // A leap that lands where you aim and slams: a shockwave that pops them up. -> ends grounded at the crater.
            (name: "seismic slam", cooldown: 5.0, cost: 6.0, tags: [], fx: "earth", ops: [
                Leap(range: 16.0, apex: 3.0),
                SlamOnLand(radius: 4.5, damage: 9.0, knockback: 13.0, carve: 1.2),
            ], juice: Some((title: Some("SEISMIC SLAM"), punch: 2.5))),
            // Gauntlet raised: you shrug everything for a beat. -> ends in place, guard down (rocket punch).
            (name: "power block", cooldown: 6.0, cost: 6.0, tags: [Defense], fx: "hardlight", ops: [
                Counter(secs: 1.2),
            ], juice: Some((title: Some("POWER BLOCK"), ripple: 2.0, color: Some((0.3, 0.7, 1.0))))),
            // METEOR STRIKE: untouchable, you rocket into the sky and come down on the crosshair with a
            // crater. -> ends grounded at the impact, everyone around you launched.
            (name: "meteor strike", cooldown: 20.0, cost: 40.0, tags: [Ultimate], ops: [
                Counter(secs: 1.4),
                Impulse(fwd: 10.0, up: 24.0),
                SlamOnLand(radius: 7.5, damage: 22.0, knockback: 28.0, carve: 3.0),
            ], juice: Some((title: Some("METEOR STRIKE"), boom: true, punch: 6.0, shake: 0.3, color: Some((1.0, 0.55, 0.15))))),
        ],
    ),
    // ---------------------------------------------------------------- Tracer: the time-jumper
    (
        id: "ow_tracer",
        name: "Tracer",
        kind: Kit,
        names: ["tracer", "tracey", "trace her", "tracer's", "lena oxton", "lena", "tracer overwatch"],
        fx: "speed",
        shouts: [("pulse pistols", 0), ("pulse bomb", 3)],
        moves: [
            (name: "pulse pistols", cooldown: 0.4, cost: 1.0, tags: [Primary], ops: [
                Cast(recipe: (name: "pulse pistols", form: Ball, mech: [Fast, Swarm], element: Electric, scale: 0.16, count: 6, mass: 2.0)),
            ]),
            // A blue flicker a few metres along your aim. Three in a row is the whole point ("blink blink
