            (name: "blink", cooldown: 0.3, cost: 1.0, tags: [Movement], ops: [
                Blink(dist: 7.5, afterimage: true),
            ], juice: Some((ripple: 1.2, color: Some((0.3, 0.75, 1.0))))),
            // RECALL: you zip back along your own path to where you were 3 s ago — and the damage you took
            // since is undone. Untouchable for the rewind. -> ends where you were, slow, ready to go again.
            (name: "recall", cooldown: 10.0, cost: 10.0, tags: [Defense], ops: [
                Rewind(secs: 3.0),
                Counter(secs: 0.35),
            ], juice: Some((title: Some("RECALL"), ripple: 2.5, color: Some((0.3, 0.75, 1.0))))),
            // PULSE BOMB: a sticky charge that clings to whoever it hits and goes off a beat later.
