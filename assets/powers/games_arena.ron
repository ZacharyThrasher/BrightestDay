            (name: "pulse bomb", cooldown: 14.0, cost: 20.0, tags: [Ultimate], fx: "electric", ops: [
                Cast(recipe: (name: "pulse bomb", form: Bomb, mech: [Sticky, Explodes, Fast], element: Electric, scale: 0.45, mass: 6.0)),
            ], juice: Some((title: Some("PULSE BOMB"), punch: 2.0, color: Some((0.3, 0.75, 1.0))))),
        ],
    ),
