                Shove(range: 2.8, angle: 179.0, damage: 6.0, knockback: 11.0, up: 0.4),
                SelfStatus(status: Float, secs: 1.3),
            ], juice: Some((ripple: 2.8, color: Some((0.75, 0.5, 0.25))))),
        ],
    ),
