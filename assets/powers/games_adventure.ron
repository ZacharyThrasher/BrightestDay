    // ================================================================ SUPER MARIO
    (
        id: "adv_mario",
        name: "Mario",
        kind: Kit,
        names: ["mario", "super mario", "mario mario", "mario bros", "super mario bros", "jumpman", "its a me", "it's a me"],
        shouts: [("groundpound", 0), ("butt stomp", 0), ("mario ground pound", 0),
                 ("long jump", 1), ("mario long jump", 1),
                 ("cappy throw", 2), ("hat throw", 2), ("throw cappy", 2), ("cap throw", 2), ("cappy capture", 2), ("mario capture", 2),
                 ("mario fire flower", 3), ("mario super star", 4), ("mario star power", 4), ("mario starman", 4), ("star man", 4), ("mario invincibility star", 4), ("mario super star power", 4),
                 ("fludd", 5), ("f l u d d", 5), ("fludd hover", 5), ("mario flood hover", 5), ("hover nozzle", 5), ("flud", 5),
                 ("fluid hover", 5),
                 ("mario mega mushroom", 6), ("mega mario", 6), ("giant mario", 6),
                 ("tanooki", 7), ("tanooki tail", 7), ("tanuki tail", 7), ("tanooki spin", 7)],
        moves: [
            // Stop in the air, spin, plummet: a crater and everyone near popped UP. Works from the
            // ground too (a stomp). ends: grounded at the crater, enemies airborne — juggle them.
            (name: "ground pound", fx: "earth", tags: [Primary, Combo], cooldown: 1.2, cost: 4.0, ops: [
                Impulse(fwd: 0.0, up: -40.0),
                SlamOnLand(radius: 3.8, damage: 12.0, knockback: 18.0, carve: 0.8),
            ], juice: Some((punch: 2.0, shake: 0.2, color: Some((1.0, 0.25, 0.2))))),
            // Low and LONG: crouch-jump across a gap. ends: airborne far ahead, moving fast.
            (name: "long jump", tags: [Movement], cooldown: 0.9, cost: 2.0, ops: [Impulse(fwd: 22.0, up: 9.0),
            ]),
            // The hat flies out spinning, bonks, and comes home (the returning boomerang).
            (name: "cappy throw", tags: [Primary], cooldown: 0.7, cost: 2.0, ops: [
                Cast(recipe: (name: "cappy", form: Ball, mech: [Returning, Spin, Blunt], scale: 0.55, mass: 6.0)),
                Capture(range: 24.0, secs: 6.0, ride: true),
            ], juice: Some((color: Some((1.0, 0.95, 0.95))))),
            // Two fireballs that BOUNCE along the ground. ends: in place.
            (name: "fire flower", fx: "fire", tags: [Primary], cooldown: 0.6, cost: 2.0, ops: [
                Cast(recipe: (name: "mario fireball", form: Ball, mech: [Bounce, Fast], element: Fire, scale: 0.35, count: 2)),
            ], juice: Some((color: Some((1.0, 0.45, 0.1))))),
            // Invincible-ish for 7 s: flashing rainbow, whoever you TOUCH goes flying, you barely budge.
            (name: "super star", fx: "holy", tags: [Ultimate], cooldown: 24.0, cost: 20.0, ops: [
                Empower(secs: 7.0, damage: 1.25, armor: 0.4, contact: 10.0, contact_kb: 24.0, contact_cd: 0.5, element: Light),
            ], juice: Some((title: Some("SUPER STAR"), boom: true, punch: 2.0, color: Some((1.0, 0.9, 0.3))))),
            // F.L.U.D.D. hover: a water jet under you blasts whoever's below and you float.
            // ends: hovering, slow-falling — aim a ground pound.
            (name: "fludd hover", fx: "water", tags: [Movement], cooldown: 3.0, cost: 3.0, ops: [
                Impulse(fwd: 0.0, up: 10.0),
                Explode(radius: 2.6, damage: 2.0, knockback: 12.0, element: Water),
                SelfStatus(status: Float, secs: 2.0),
            ], juice: Some((ripple: 2.0, color: Some((0.4, 0.7, 1.0))))),
            // Grow huge: stomp through everything you walk into. ends: wherever you walk.
            (name: "mega mushroom", fx: "earth", tags: [Ultimate], cooldown: 30.0, cost: 24.0, ops: [
                Empower(secs: 8.0, damage: 1.4, armor: 0.5, contact: 12.0, contact_kb: 28.0, contact_cd: 0.7, element: Earth),
                SlamOnLand(radius: 5.0, damage: 10.0, knockback: 20.0, carve: 1.2),
            ], juice: Some((title: Some("MEGA MUSHROOM"), boom: true, punch: 5.0, shake: 0.25, color: Some((1.0, 0.3, 0.2))))),
            // Tanooki tail: a whirl of tail around you and a slow, floaty fall.
