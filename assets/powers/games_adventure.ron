            ], juice: Some((color: Some((0.3, 0.7, 1.0))))),
            // Recall: whatever is flying at you runs back along its path (the rune's green glow).
            (name: "recall", tags: [Counter], cooldown: 7.0, cost: 6.0, ops: [Deflect(secs: 1.4, angle: 70.0)],
             juice: Some((title: Some("RECALL"), ripple: 3.0, at: Front, dist: 3.0, color: Some((0.75, 1.0, 0.3))))),
            // Ultrahand: green glue — the aimed thing is bound to you.
            (name: "ultrahand", tags: [Combo], cooldown: 5.0, cost: 5.0, ops: [Link(range: 24.0)],
             juice: Some((title: Some("ULTRAHAND"), color: Some((0.4, 1.0, 0.5))))),
            // Straight up and out the top: rise, hang a beat. ends: high above where you stood.
            (name: "ascend", fx: "chi", tags: [Movement], cooldown: 4.0, cost: 4.0, ops: [
                Impulse(fwd: 0.0, up: 34.0),
                SelfStatus(status: Float, secs: 0.8),
            ], juice: Some((title: Some("ASCEND"), ripple: 1.5, color: Some((0.4, 1.0, 0.6))))),
            // Fuse a boulder onto a stick: a rock hammer in your hand (heavy, blunt, legendary rules apply).
            (name: "fuse", fx: "earth", tags: [Combo], cooldown: 4.0, cost: 5.0, ops: [
                Cast(recipe: (name: "fused rock hammer", form: Hammer, mech: [Blunt, Heavy], element: Earth, scale: 1.1)),
            ], juice: Some((title: Some("FUSE"), color: Some((0.4, 1.0, 0.5))))),
        ],
    ),
    // The Triforce: say it and it's yours until KO. Each piece is a tier ("triforce of courage").
    // Its three spells are Ocarina of Time's: Din's Fire, Nayru's Love, Farore's Wind.
    (
        id: "adv_triforce",
        name: "Triforce",
        kind: Technique,
        fx: "holy",
        names: ["triforce", "the triforce", "tri force", "try force", "tri-force", "the tri force", "triforce power",
                "the golden power", "sacred triangle"],
        effects: [PowerMult(damage: 1.1, knockback: 1.1)],
        ascend: Some((color: Some((1.0, 0.85, 0.25)), intensity: 1.3, title: Some("TRIFORCE"), style: Calm,
                      eye_glow: Some((1.0, 0.9, 0.4)))),
        shouts: [("dins fire", 0), ("din's fire", 0), ("dean's fire", 0), ("dinz fire", 0),
                 ("nayrus love", 1), ("nayru's love", 1), ("naru's love", 1), ("nairus love", 1), ("nyru's love", 1),
                 ("farores wind", 2), ("farore's wind", 2), ("faroes wind", 2), ("farrors wind", 2), ("pharaoh's wind", 2)],
        moves: [
            // A dome of fire bursting out of you. ends: grounded, ring cleared.
            (name: "din's fire", fx: "fire", tags: [Primary], cooldown: 5.0, cost: 8.0, ops: [
                Explode(radius: 6.0, damage: 12.0, knockback: 22.0, element: Fire),
            ], juice: Some((title: Some("DIN'S FIRE"), ripple: 6.0, boom: true, punch: 3.0, color: Some((1.0, 0.4, 0.1))))),
            // A blue crystal around you: shots bounce off it, the first blow is shrugged.
            (name: "nayru's love", fx: "crystal", tags: [Defense], cooldown: 10.0, cost: 8.0, ops: [
                Deflect(secs: 2.0, angle: 180.0),
                Counter(secs: 1.5),
