                           eye_glow: Some((0.7, 0.8, 1.0)), quiet: true))),
            (name: "Triforce of Courage", names: ["triforce of courage", "courage triforce", "the triforce of courage", "link's triforce"],
             effects: [AutoDodge(chance: 0.3, cooldown: 2.0), PowerMult(speed: 1.1)],
             ascend: Some((color: Some((0.4, 1.0, 0.45)), intensity: 1.4, title: Some("TRIFORCE OF COURAGE"),
