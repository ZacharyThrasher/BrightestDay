// ADVENTURE GAMES — action / adventure / RPG / platformer / shooter single-player games
// (TOOLBOX content worker "CONTENT: ADVENTURE GAMES"; docs/toolbox/BRIEF.md).
//
// Mostly `kind: Kit`: a character's move-set. A kit's names are PREFIXES ("link spin attack",
// "sonic homing attack", "dante stinger", "cloud ultimate"); the bare name stays the costume summon.
// Every famous move also has bare SHOUTS ("fus ro dah", "judgment cut", "chaos control") — the
// toolbox fires those for anyone as a one-shot. Forms that should stay on you until KO (Super Sonic,
// Devil Trigger, Spartan Rage, the Triforce) are `kind: Technique` like the rest of the techniques.
//
// Every headline move = (a) a distinct control feel, (b) the thing it is famous for, (c) presentation
// keys, (d) a designed CHAIN ENDING (noted as "ends:"): airborne endings set up aerials / slams,
// grounded endings set up launchers, "at them" endings set up grabs / flurries.
//
// Generic ops built for this file (docs/toolbox/OPS.md): Pounce (homing lunge), Salvo (telegraphed
// strikes in space), Mend (heal), Evade (perfect-dodge window → time slow), PlacePortal (the portal
// gun), Empower (timed super state). Borrowed from other workers: Ram, Hook, Grab, Counter, Deflect,
// Zone, Rewind, Lockout, LockOn (ARENA GAMES).
//
// Shouts must not equal an icon name (a bare "hookshot", "master sword", "bfg" stay the summons):
// those are reachable as "<kit> <move>" instead. No quotes / lyrics: move and character NAMES only.
[
    // ================================================================ THE LEGEND OF ZELDA
    (
        id: "adv_link",
        name: "Link",
        kind: Kit,
        names: ["link", "hero of hyrule", "hero of time", "hero of the wild", "hylian hero", "the hero of hyrule",
                "legend of zelda", "breath of the wild", "tears of the kingdom", "botw", "totk", "lonk"],
        shouts: [("spin attack", 0), ("great spin", 0), ("hurricane spin", 0), ("spin slash", 0), ("link spin", 0),
                 ("revalis gale", 2), ("revali's gale", 2), ("revali gale", 2), ("ravalis gale", 2), ("revolis gale", 2),
                 ("revali's updraft", 2), ("revalis updraft", 2),
                 ("daruks protection", 3), ("daruk's protection", 3), ("daruk protection", 3), ("darooks protection", 3),
                 ("urbosas fury", 4), ("urbosa's fury", 4), ("urbosa fury", 4), ("ur bosas fury", 4), ("orbosa's fury", 4),
                 ("miphas grace", 5), ("mipha's grace", 5), ("mipha grace", 5), ("mifas grace", 5), ("meefa's grace", 5),
                 ("link sword beam", 6), ("master sword beam", 6), ("skyward strike", 6),
                 ("triforce slash", 7), ("tri force slash", 7)],
        moves: [
            // The classic: a full circle of steel around you. Grounded, everyone knocked OUT of the
            // ring. ends: grounded, centred — hookshot one of them back in.
            (name: "spin attack", tags: [Primary, Combo], cooldown: 1.0, cost: 4.0, ops: [
                Shove(range: 3.8, angle: 179.0, damage: 11.0, knockback: 15.0, up: 0.5),
            ], juice: Some((ripple: 3.8, punch: 1.5, shake: 0.1, color: Some((0.55, 0.95, 0.6))))),
            // A chain that flies out and bites: an enemy is towed to your blade; a wall pulls YOU in.
            // ends: at them (towed) or on the wall (reeled) — spin attack / a down-thrust next.
            (name: "hookshot", fx: "rigid", tags: [Movement], cooldown: 1.2, cost: 3.0, ops: [
                Hook(range: 30.0, speed: 70.0, pull: 20.0, damage: 4.0, anchor: true),
            ]),
            // Revali's updraft: a column of wind throws you straight up and everything near you out;
            // you hang at the top. ends: HIGH and floating — bow / meteor / ground pound from above.
            (name: "revali's gale", fx: "wind", tags: [Movement], cooldown: 5.0, cost: 6.0, ops: [
                Impulse(fwd: 0.0, up: 30.0),
                Field(strength: -40.0, radius: 5.0, secs: 0.4),
                SelfStatus(status: Float, secs: 1.4),
            ], juice: Some((title: Some("REVALI'S GALE"), ripple: 5.0, debris: 14.0, color: Some((0.55, 0.85, 1.0))))),
            // Daruk's barrier: the first blow bounces off a fire-orange shell and throws the attacker.
            // ends: grounded, attacker flung — punish.
            (name: "daruk's protection", fx: "fire", tags: [Defense, Counter], cooldown: 8.0, cost: 6.0, ops: [
                Counter(secs: 1.4, damage: 6.0, knockback: 26.0, up: 0.5, element: Fire),
            ], juice: Some((title: Some("DARUK'S PROTECTION"), ripple: 2.5, color: Some((1.0, 0.45, 0.15))))),
            // Urbosa snaps: a beat of charge, then lightning finds EVERY enemy near you. Dodgeable
            // (the marks show). ends: grounded, everyone near micro-stunned — close in.
            (name: "urbosa's fury", fx: "lightning", tags: [Ultimate], cooldown: 16.0, cost: 18.0, ops: [
                Salvo(cut: true, count: 5, delay: 0.55, interval: 0.07, radius: 3.0, damage: 13.0, knockback: 14.0, element: Electric,
                      at: Me, spread: 14.0, seek: true),
            ], juice: Some((title: Some("URBOSA'S FURY"), boom: true, punch: 3.0, shake: 0.2, color: Some((1.0, 0.85, 0.3))))),
            // Mipha's healing water: a big heal, then a trickle while nobody touches you.
            (name: "mipha's grace", fx: "water", tags: [Defense], cooldown: 22.0, cost: 10.0, ops: [
                Mend(pct: 35.0, per_s: 5.0, secs: 3.0),
            ], juice: Some((title: Some("MIPHA'S GRACE"), ripple: 2.0, color: Some((0.35, 0.75, 1.0))))),
            // The Master Sword's beam: a thrown blade of light that pierces through. ends: in place.
            (name: "sword beam", fx: "holy", tags: [Primary], cooldown: 0.8, cost: 3.0, ops: [
                Wave(length: 26.0, speed: 40.0, width: 1.0, damage: 10.0, knockback: 10.0, element: Light, thin: true),
            ], juice: Some((color: Some((0.75, 0.95, 1.0))))),
            // A lunge that traps them in the golden triangle: dash in and strike. ends: at them.
            (name: "triforce slash", fx: "holy", tags: [Combo], cooldown: 9.0, cost: 10.0, ops: [
                Pounce(range: 16.0, speed: 38.0, cone: 14.0, damage: 20.0, knockback: 30.0, element: Light, up: 0.5),
            ], juice: Some((title: Some("TRIFORCE SLASH"), punch: 4.0, boom: true, color: Some((1.0, 0.85, 0.25))))),
        ],
    ),
    (
        id: "adv_sheikah_slate",
        name: "Sheikah Slate",
        kind: Kit,
        fx: "hardlight",
        names: ["sheikah slate", "purah pad", "sheikah", "zonai", "zelda runes", "sheikah runes", "slate"],
        shouts: [("Magnesis", 0), ("magnesys", 0), ("magnisis", 0),
                 ("stasis", 1), ("stasys", 1),
                 ("Cryonis", 2), ("cryo nis", 2), ("krionis", 2),
                 ("sheikah remote bomb", 3), ("remote bombs", 3), ("sheikah bomb", 3),
                 ("recall rune", 4), ("zelda recall", 4),
                 ("sheikah ultrahand", 5), ("sheikah ultra hand", 5), 
                 ("ascend rune", 6), ("zelda ascend", 6),
                 ("zelda fuse", 7), ("sheikah fuse a rock", 7), ("sheikah rock hammer", 7), ("sheikah fuse rock", 7)],
        moves: [
            // Magnetic grab: the aimed metal-ish thing (or enemy) is dragged to your hand.
            (name: "magnesis", tags: [Primary], cooldown: 1.5, cost: 4.0, ops: [Yank(range: 32.0, speed: 20.0, cone: 8.0)],
             juice: Some((ripple: 2.0, at: Aim, title: Some("MAGNESIS"), color: Some((1.0, 0.3, 0.6))))),
            // Freeze the aimed thing in time (short, heavy, readable yellow).
            (name: "stasis", tags: [Counter], cooldown: 6.0, cost: 6.0, ops: [
                Afflict(range: 28.0, cone: 6.0, status: Some(Stun), secs: 1.0),
            ],
             juice: Some((title: Some("STASIS"), ripple: 1.5, at: Aim, color: Some((1.0, 0.9, 0.2))))),
            // A pillar of ice rises where you aim: cover, a step, a wall.
            (name: "cryonis", fx: "ice", tags: [Defense], cooldown: 3.0, cost: 4.0, ops: [
