    // ================================================================================================
    // THE ONI FORM — a technique: say "oni form" and you ARE an oni until KO (the horn glows, you run
    // faster, hit much harder, and every move comes out as an oni's — but the horn burns you a little
    // while it's out). G tap = the morning star; G hold = demon rush; "oni el huma", "oni roar".
    // ================================================================================================
    (
        id: "rz_oni",
        name: "Oni Form",
        kind: Technique,
        names: ["oni form", "oni mode", "oni blood", "awaken the oni", "horn of the oni", "oni horn form", "demon oni form", "oni transformation",
                "oni no katachi", "onee form"],
        effects: [PowerMult(speed: 1.2, damage: 1.25, knockback: 1.15), SelfDrain(damage_pct_per_s: 0.4)],
        body: (moves: (accel: 1.3, jump: 1.15)),
        ascend: Some((color: Some((0.72, 0.9, 1.0)), intensity: 1.4, title: Some("ONI"), stable: false, eye_glow: Some((0.6, 0.85, 1.0)))),
        fx: "morningstar",
        shouts: [("oni morning star", 0), ("oni flail", 0),
                 ("oni demon rush", 1), ("oni rush", 1),
                 ("oni el huma", 2), ("oni ice lances", 2),
                 ("oni howl", 3)],
        moves: [
            // G tap: the morning star, heavier and further. -> you don't move; they fly.
            (name: "oni morning star", cooldown: 0.9, cost: 6.0, ops: [
                Shove(range: 7.0, angle: 45.0, damage: 13.0, knockback: 18.0, up: 0.4),
            ], juice: Some((punch: 3.0, shake: 0.12, color: Some((0.62, 0.66, 0.74))))),
            // G hold: demon rush. -> ends airborne over them.
            (name: "demon rush", cooldown: 1.6, cost: 5.0, fx: "feral", ops: [
                Pounce(range: 26.0, speed: 48.0, cone: 14.0, damage: 11.0, knockback: 15.0, bounce: 5.0),
            ], juice: Some((punch: 2.5, color: Some((0.6, 0.85, 1.0))))),
            // Oni El Huma: a volley of ice lances. -> you don't move.
