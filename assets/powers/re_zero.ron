    // ---------------------------------------------------------------- Satella — the Jealous Witch
    // The witch whose shadow swallowed half the world. Her black hands reach from far away and drag
    // you in; they rise in a thicket round the crosshair; one embraces you. THE SHADOW: a vast black
    // tide rolls out from her across the arena, carrying everything with it (a rider is thrown clear
    // after a second — never held), and the ground it passed stays dark.
    (
        id: "rz_satella_kit",
        name: "Satella",
        kind: Kit,
        names: ["satella", "satela", "the jealous witch", "jealous witch", "witch of envy", "the witch of envy", "satella's", "sa tella",
                "satellah", "satella re zero"],
        fx: "witch",
        shouts: [("satella hands", 0), ("the witch's hands", 0), ("witch's hands", 0),
                 ("satella tendrils", 1), ("shadow tendrils of envy", 1),
                 ("satella embrace", 2), ("the witch's embrace", 2),
                 ("Shadow Of Envy", 3), ("the witch's shadow", 3), ("satella shadow", 3), ("the jealous witch's shadow", 3),
                 ("satella shadow step", 4)],
        moves: [
            // A black hand reaches out, seizes the first one it meets and drags them to her.
            // -> they arrive at your feet, half blind.
            (name: "witch's hands", tags: [Primary], cooldown: 2.0, cost: 6.0, ops: [
                Hook(range: 26.0, speed: 40.0, pull: 24.0, damage: 6.0, status: Some(Shadow), secs: 1.2),
            ], juice: Some((punch: 2.0, color: Some((0.2, 0.0, 0.25))))),
            // A thicket of shadow rising round the crosshair. -> you don't move; they're in the air.
            (name: "shadow tendrils", tags: [Combo], cooldown: 3.0, cost: 10.0, ops: [
                Salvo(count: 10, delay: 0.4, interval: 0.05, radius: 2.0, damage: 5.0, knockback: 6.0, up: 1.4, element: Shadow, at: Aim,
                      spread: 7.0, seek: true, cut: true),
            ], juice: Some((punch: 2.0, color: Some((0.2, 0.0, 0.25))))),
            // The embrace: seized, lifted, thrown. -> they land along your look.
            (name: "embrace", cooldown: 3.5, cost: 8.0, ops: [
                Grab(range: 5.0, hold: 0.45, damage: 14.0, knockback: 14.0, up: 0.5, lift: 3.0),
            ], juice: Some((punch: 2.5, color: Some((0.2, 0.0, 0.25))))),
            // THE SHADOW OF ENVY: a black tide twelve metres wide creeps out across the arena and carries
            // everyone before it; behind it the ground stays dark. -> you stand behind your shadow.
            (name: "shadow of envy", tags: [Ultimate], cooldown: 35.0, cost: 40.0, ops: [
                Surge(width: 12.0, dist: 40.0, speed: 10.0, push: 20.0, damage: 16.0, element: Shadow),
                Zone(radius: 14.0, secs: 5.0, status: Some(Shadow), slow: 0.35, at: Front, dist: 14.0),
            ], juice: Some((title: Some("THE JEALOUS WITCH"), boom: true, punch: 6.0, shake: 0.35, ripple: 14.0, debris: -22.0,
                            color: Some((0.12, 0.0, 0.16)), impact_frame: Some("void")))),
            // She moves as her shadow does. -> ends grounded, forward.
            (name: "shadow step", tags: [Movement], cooldown: 1.5, cost: 3.0, ops: [
                Blink(dist: 12.0, afterimage: true),
            ]),
        ],
    ),
    // ---------------------------------------------------------------- The Three Great Mabeasts
    // The White Whale drifting in its fog (anyone in the fog is blinded and slowed), the Great Rabbit —
