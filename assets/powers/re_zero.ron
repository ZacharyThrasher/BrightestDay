    // ---------------------------------------------------------------- Priscilla Barielle
    // The sun princess: the world bends to suit her. The Yang Sword Volakia is drawn out of the air — a
    // sword of the sun that burns only what she wishes; drawn, it cuts a burning crescent across the
    // arena and stays in her hand. The world's favour: whatever comes at her simply misses.
    (
        id: "rz_priscilla_kit",
        name: "Priscilla Barielle",
        kind: Kit,
        names: ["priscilla barielle", "priscilla", "priscilla bariel", "priscilla re zero", "the sun princess", "priscilla barielle's", "priscilla benedict"],
        fx: "fire",
        shouts: [("Yang Sword Volakia", 0), ("Yoken Volakia", 0), ("sun sword volakia", 0),
                 ("priscilla slash", 1),
                 ("priscilla favor", 2), ("the world's favor", 2), ("the world favors me", 2),
                 ("priscilla step", 3)],
        moves: [
            // YANG SWORD VOLAKIA: drawn from the air in a burst of sunlight — a burning crescent crosses the
            // arena and the sword stays in her hand. -> you hold the Yang Sword.
            (name: "yang sword volakia", tags: [Ultimate], cooldown: 24.0, cost: 40.0, ops: [
                Wave(length: 40.0, speed: 60.0, width: 7.0, carve: 0.8, damage: 18.0, knockback: 16.0, element: Fire, thin: true),
                Cast(recipe: (name: "yang sword volakia", form: Sword, mech: [Blade], element: Fire, scale: 1.3)),
            ], juice: Some((title: Some("YANG SWORD VOLAKIA"), boom: true, punch: 6.0, shake: 0.3, debris: 16.0, color: Some((1.0, 0.55, 0.15)),
                            impact_frame: Some("holy")))),
            // A burning cut. -> ends a step forward.
            (name: "sun slash", tags: [Primary], cooldown: 0.8, cost: 6.0, ops: [
                Impulse(fwd: 8.0, up: 0.0),
                Shove(range: 3.8, angle: 90.0, damage: 10.0, knockback: 12.0, element: Fire),
            ], juice: Some((punch: 2.0, color: Some((1.0, 0.6, 0.2))))),
            // The world's favour: the next thing that would hit her misses, and she's past it.
            (name: "the world's favor", tags: [Defense, Counter], cooldown: 5.0, cost: 6.0, fx: "holy", ops: [
                Evade(secs: 0.6, slow: 1.0, speed: 1.5, blink: 2.0),
            ], juice: Some((ripple: 2.0, color: Some((1.0, 0.8, 0.35))))),
            // A regal step forward. -> ends grounded.
            (name: "sun step", tags: [Movement], cooldown: 1.4, cost: 3.0, ops: [
                Blink(dist: 12.0, afterimage: true),
            ]),
        ],
    ),
    // ---------------------------------------------------------------- Lye Batenkaitos — Gluttony
