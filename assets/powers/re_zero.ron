    // ================================================================================================
    // THE CAST — kits. "<character> <move word>"; famous names are shouts anyone can borrow.
    // ================================================================================================

    // ---------------------------------------------------------------- Subaru Natsuki
    // The boy who keeps coming back. Invisible Providence: a black hand of the witch's miasma reaches
    // out of him, SEIZES the one you look at (they're lifted), squeezes — and a beat later flings them
    // (it hurts him too: a little self-damage). Shamak: his one spell — smoke where he stands and he's
    // out the back of it. Cor Leonis: he takes the weight — a guard window and a long armoured beat.
    // RETURN BY DEATH: the witch's miasma bursts where he stands (her hands close on that spot), and
    // he is back where he was three seconds ago, as hurt as he was then (never more). An escape, not a
    // win. The whip: a crack that stings and staggers.
    (
        id: "rz_subaru_kit",
        name: "Subaru Natsuki",
        kind: Kit,
        names: ["subaru", "subaru natsuki", "natsuki subaru", "subaru kun", "barusu", "subaru's", "suba ru", "subaru natsuki's",
                "subaru re zero"],
        fx: "witch",
        shouts: [("Invisible Providence", 0), ("invisible providance", 0), ("subaru unseen hand", 0),
                 ("subaru shamak", 1),
                 ("Cor Leonis", 2), ("core leonis", 2), ("kor leonis", 2), ("cor leonys", 2), ("core leo nis", 2), ("corleonis", 2),
                 ("Return By Death", 3), ("returned by death", 3), ("Return Be Death", 3), ("Shi Ni Modori", 3), ("shinimodori", 3),
                 ("return by death rewind", 3),
                 ("Re Zero", 3), ("Rezero", 3), ("Ree Zero", 3), ("Re:Zero", 3), ("Re Zero Kara Hajimeru", 3), ("Starting Life In Another World", 3),
                 ("subaru whip", 4), ("subaru's whip", 4)],
        moves: [
            // A hand of miasma seizes the one you look at (they lift, weightless), squeezes, and a beat
            // later throws them along your look. Nobody under the crosshair = nothing happens, nothing
            // spent. -> you stay put; they are flung away from you.
            (name: "invisible providence", tags: [Primary], cooldown: 2.2, cost: 8.0, ops: [
                Afflict(range: 22.0, cone: 12.0, status: Some(Float), secs: 0.7, damage: 7.0, up: 3.0, element: Shadow),
                DelayedHit(range: 22.0, cone: 12.0, secs: 0.45, damage: 9.0, knockback: 20.0, up: 0.4, element: Shadow),
                Strain(pct: 3.0),
            ], juice: Some((title: Some("INVISIBLE PROVIDENCE"), punch: 2.5, shake: 0.12, color: Some((0.42, 0.08, 0.52)),
                            impact_frame: Some("void")))),
            // Shamak (his): a cloud of black smoke where he stands, and he's seven metres back out of it.
            // -> ends behind the cloud, facing it.
            (name: "shamak", tags: [Movement], cooldown: 4.0, cost: 6.0, fx: "shadow", ops: [
                Zone(radius: 5.0, secs: 2.2, status: Some(Shadow), slow: 0.25),
                Relocate(range: 45.0, cone: 20.0, back: 7.0, me: true),
            ], juice: Some((title: Some("SHAMAK"), ripple: 4.0, color: Some((0.12, 0.05, 0.16))))),
            // Cor Leonis: he shoulders the weight — the first hit in the next second is nothing, and for
            // five seconds after he barely moves when hit. -> you're rooted and armoured.
            (name: "cor leonis", tags: [Defense], cooldown: 12.0, cost: 12.0, fx: "holy", ops: [
                Counter(secs: 1.0),
                Empower(secs: 5.0, armor: 0.55),
            ], juice: Some((title: Some("COR LEONIS"), ripple: 5.0, punch: 2.0, color: Some((1.0, 0.82, 0.45))))),
            // RETURN BY DEATH: the miasma bursts where you stand (the witch's hands close on that spot —
            // a blast of dark and a shroud that blinds whoever's there), then you are where you were three
            // seconds ago, with the damage you had then if it was less. -> ends three seconds back.
            (name: "return by death", tags: [Ultimate], cooldown: 20.0, cost: 30.0, ops: [
                Explode(radius: 5.0, damage: 0.0, knockback: 16.0, element: Shadow),
                Zone(radius: 5.0, secs: 2.5, status: Some(Shadow), slow: 0.25),
                Rewind(secs: 3.0),
            ], juice: Some((title: Some("RETURN BY DEATH"), boom: true, punch: 5.0, shake: 0.25, ripple: 8.0, debris: -18.0,
                            color: Some((0.3, 0.02, 0.38)), impact_frame: Some("void")))),
            // The whip: a snapping lash that stings (a micro-stagger). -> you don't move.
            (name: "whip", cooldown: 1.0, cost: 3.0, fx: "web", ops: [
                Hook(range: 14.0, speed: 70.0, damage: 6.0, status: Some(Stun), secs: 0.2),
            ], juice: Some((punch: 1.5, color: Some((0.35, 0.25, 0.2))))),
        ],
    ),
