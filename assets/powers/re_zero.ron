// RE:ZERO — Starting Life in Another World (CONTENT: RE:ZERO worker, docs/toolbox/BRIEF.md). A love letter,
// private use: character / spell / move NAMES only — no quotes, no incantations (THIRD_PARTY_NOTICES.md).
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
//
// Two layers:
//  1. THE MAGIC SYSTEM as a generative spell family. Six attributes — Goa (fire), Huma (ice), Fura (wind),
//     Dona (earth), Shamak (yin: smoke / darkness / weightlessness) and Minya (crystal stakes) — each a
//     kit whose moves are the tier prefixes: bare → El → Ul → Al. Say the spell ("huma", "el huma",
//     "ul huma", "al huma") and it fires, held or not. Every tier ESCALATES: a bare spell is a quick
//     cantrip (Tiny / Normal presence, no title), El is a real spell with a title, Ul is a Big area
//     spell with a boom, Al is the Titan-tier showpiece (a pull-in gather, a telegraph, an impact frame).
//     "<attribute> magic ultimate" also finds the Al spell ("huma magic ultimate" → Al Huma).
//  2. THE CAST as kits: "<character> <move word>" fires that character's move ("rem morning star",
//     "subaru return by death", "reinhard ultimate" → Dragon Sword Reid); bare names stay the costume
//     summon (assets/costumes/characters.ron has the main cast's looks). Famous names are shouts anyone
//     can borrow ("invisible providence", "al clauzeria", "hundred man slash", "lion's heart").
//     The Oni form is a TECHNIQUE ("oni form"): say it and you are an oni until KO.
//
// Design rule for this file (as in anime_modern.ron): a famous move does the thing it is famous for.
// Every headline move has its own control feel + the mechanic it's known for + title/colour/style + a
// chain ending ("-> ends ..."). NO invisibility of any kind: Subaru's Invisible Providence and
// Petelgeuse's Unseen Hands are HANDS you can see coming in the witch's miasma (fx "witch"); the
// player is never hidden. Shamak is short, escapable darkness (a Shadow vignette + a light slow).
// Return by Death is an escape (the generic Rewind), never an instant win and never a lockout.
[
    // ================================================================================================
    // THE SPELL FAMILY — bare / El / Ul / Al. Presence climbs with the prefix: Tiny-ish (cost ≤ 4) →
    // Normal (8) → Big (20) → Titan (40), cooldowns 0.6 → 1.8 → 5 → 16 s. Tags: bare = Primary, Al =
    // Ultimate, so "goa magic attack" / "goa magic ult" read too.
    // ================================================================================================

    // ---------------------------------------------------------------- GOA — fire
    // Goa is a fist of flame thrown from the palm; El Goa is a heavy fireball whose landing spot is
    // already burning; Ul Goa is a rain of fire on the crosshair; Al Goa is Roswaal's second sun — the
    // air around the point is SUCKED IN for a second (everything slides toward it), then it lands.
    // Jiwald: the heat ray (a straight line of white fire), El Jiwald banks off walls.
    (
        id: "rz_goa",
        name: "Goa",
        kind: Kit,
        names: ["goa magic", "goa spell", "goa spells", "fire magic goa", "re zero fire magic", "goa family"],
        fx: "fire",
        shouts: [("Goa", 0), ("Goah", 0), ("Gowa", 0),
                 ("El Goa", 1), ("Elle Goa", 1), ("L Goa", 1), ("Elgoa", 1), ("El Gowa", 1), ("Eru Goa", 1),
                 ("Ul Goa", 2), ("Ool Goa", 2), ("Ulgoa", 2), ("Oul Goa", 2), ("Uru Goa", 2), ("Ulu Goa", 2),
                 ("Al Goa", 3), ("All Goa", 3), ("Algoa", 3), ("Ahl Goa", 3), ("Aru Goa", 3), ("Al Gowa", 3),
                 ("Jiwald", 4), ("Ji Wald", 4), ("Jiwaldo", 4), ("Gee Wald", 4),
                 ("El Jiwald", 5), ("Elle Jiwald", 5), ("El Ji Wald", 5)],
        moves: [
            // A quick palm fireball — the cantrip. -> you don't move.
            (name: "goa", tags: [Primary], cooldown: 0.7, cost: 3.0, ops: [
                Cast(recipe: (name: "goa fireball", form: Ball, mech: [Explodes, Fast], element: Fire, scale: 0.5, mass: 6.0)),
            ], juice: Some((punch: 1.0, color: Some((1.0, 0.5, 0.15))))),
            // A heavy fireball; the ground where you aimed is already burning when it lands. -> you don't move.
            (name: "el goa", cooldown: 1.8, cost: 8.0, ops: [
                Cast(recipe: (name: "el goa fireball", form: Ball, mech: [Explodes, Fast, Heavy], element: Fire, scale: 1.05, mass: 18.0)),
                Zone(radius: 3.5, secs: 3.0, status: Some(Burn), dps: 3.0, at: Aim),
            ], juice: Some((title: Some("EL GOA"), punch: 2.0, color: Some((1.0, 0.45, 0.12))))),
            // A rain of fire: five telegraphed pillars of flame snap onto whoever stands near the
            // crosshair, and the place keeps burning. -> you don't move; they're scattered and burning.
            (name: "ul goa", cooldown: 5.0, cost: 20.0, ops: [
                Salvo(count: 5, delay: 0.45, interval: 0.12, radius: 3.0, damage: 10.0, knockback: 12.0, element: Fire, carve: 0.8,
                      at: Aim, spread: 5.5, seek: true),
                Zone(radius: 6.0, secs: 3.5, status: Some(Burn), dps: 3.0, at: Aim),
            ], juice: Some((title: Some("UL GOA"), boom: true, punch: 3.0, shake: 0.15, ripple: 5.0, at: Aim, color: Some((1.0, 0.4, 0.1))))),
            // AL GOA — the second sun. A second of GATHER (everything within 11 m of the crosshair slides
            // in toward it while the warning ring tightens; nothing burns yet), then it LANDS: a crater.
            // -> you don't move; they are thrown out of a crater.
            (name: "al goa", tags: [Ultimate], cooldown: 16.0, cost: 40.0, ops: [
                Field(strength: 36.0, radius: 11.0, secs: 1.1, at: Aim),
                Salvo(count: 1, delay: 1.1, radius: 8.5, damage: 32.0, knockback: 32.0, element: Fire, carve: 3.0, at: Aim),
            ], juice: Some((title: Some("AL GOA"), boom: true, punch: 6.0, shake: 0.35, ripple: 12.0, at: Aim, debris: 22.0,
                            color: Some((1.0, 0.55, 0.12)), impact_frame: Some("holy")))),
            // Jiwald: a line of white heat straight down the crosshair. -> you don't move.
            (name: "jiwald", cooldown: 1.2, cost: 6.0, ops: [
                BounceBeam(length: 40.0, bounces: 0, radius: 0.5, damage: 11.0, knockback: 10.0, element: Fire),
            ], juice: Some((punch: 1.5, color: Some((1.0, 0.85, 0.55))))),
            // El Jiwald: the heat ray banks off walls twice — the trick shot. -> you don't move.
            (name: "el jiwald", cooldown: 2.5, cost: 10.0, ops: [
                BounceBeam(length: 34.0, bounces: 2, radius: 0.6, damage: 13.0, knockback: 12.0, element: Fire),
            ], juice: Some((title: Some("EL JIWALD"), punch: 2.5, color: Some((1.0, 0.8, 0.45))))),
        ],
    ),
    // ---------------------------------------------------------------- HUMA — ice
    // Huma is a single icicle; El Huma is Rem's volley of ice lances that leaves the one you aimed at
    // chilled; Ul Huma is a line of ice spikes racing along the ground; Al Huma is a prison of ice
    // around the crosshair with a colossal icicle dropping into it.
    (
        id: "rz_huma",
        name: "Huma",
        kind: Kit,
        names: ["huma magic", "huma spell", "huma spells", "ice magic huma", "re zero ice magic", "huma family"],
        fx: "ice",
        shouts: [("Huma", 0), ("Hooma", 0), ("Hyuma", 0), ("Fuma", 0),
                 ("El Huma", 1), ("Elle Huma", 1), ("L Huma", 1), ("Elhuma", 1), ("El Hooma", 1), ("El Uma", 1), ("Eru Huma", 1), ("El Fuma", 1),
                 ("Ul Huma", 2), ("Ool Huma", 2), ("Ulhuma", 2), ("Ul Hooma", 2), ("Oul Huma", 2), ("Uru Huma", 2), ("Ulu Huma", 2),
                 ("Al Huma", 3), ("All Huma", 3), ("Alhuma", 3), ("Al Hooma", 3), ("Ahl Huma", 3), ("Aru Huma", 3), ("All Hooma", 3)],
        moves: [
            // One icicle from the palm. -> you don't move.
            (name: "huma", tags: [Primary], cooldown: 0.6, cost: 3.0, ops: [
                Cast(recipe: (name: "huma icicle", form: Spear, mech: [Pierce, Fast], element: Ice, scale: 0.6, mass: 5.0)),
            ], juice: Some((punch: 1.0, color: Some((0.62, 0.86, 1.0))))),
            // El Huma: five ice lances in a fan; the one you're looking at is chilled.
            // -> you don't move; they are slowed.
            (name: "el huma", cooldown: 1.8, cost: 8.0, ops: [
                Cast(recipe: (name: "el huma lances", form: Spear, mech: [Swarm, Pierce, Fast], element: Ice, scale: 0.55, mass: 4.0, count: 5)),
                Afflict(range: 40.0, cone: 10.0, status: Some(Chill), secs: 1.5, element: Ice),
            ], juice: Some((title: Some("EL HUMA"), punch: 2.0, color: Some((0.55, 0.82, 1.0))))),
            // Ul Huma: a line of ice spikes bursts out of the ground along your aim and launches whoever
            // it runs under. -> you don't move; they are in the air over a frozen ridge.
            (name: "ul huma", cooldown: 5.0, cost: 20.0, ops: [
                Erupt(length: 20.0, width: 1.8, height: 3.2, count: 7, element: Ice, damage: 12.0, launch: 15.0),
                Zone(radius: 4.0, secs: 2.5, status: Some(Chill), slow: 0.25, at: Front, dist: 10.0),
            ], juice: Some((title: Some("UL HUMA"), boom: true, punch: 3.0, shake: 0.15, ripple: 4.0, at: Front, dist: 6.0,
                            color: Some((0.6, 0.88, 1.0))))),
            // AL HUMA: an ice prison slams up around the crosshair, then a colossal icicle drops into it.
            // -> you don't move; they are thrown out of a ring of ice.
            (name: "al huma", tags: [Ultimate], cooldown: 16.0, cost: 40.0, ops: [
                Erupt(length: 10.0, width: 1.4, height: 5.0, element: Ice, damage: 6.0, launch: 4.0, shape: Ring, at: Aim),
                Salvo(count: 1, delay: 0.9, radius: 5.0, damage: 28.0, knockback: 26.0, element: Ice, carve: 2.0, at: Aim),
                Zone(radius: 7.0, secs: 3.5, status: Some(Chill), slow: 0.3, at: Aim),
            ], juice: Some((title: Some("AL HUMA"), boom: true, punch: 6.0, shake: 0.3, ripple: 10.0, at: Aim, debris: 18.0,
                            color: Some((0.6, 0.9, 1.0)), impact_frame: Some("holy")))),
        ],
    ),
    // ---------------------------------------------------------------- FURA — wind
    // Fura is a hard shove of air; El Fura is Ram's cutting wind — thin blades that fly and slice;
    // Ul Fura is a cyclone planted at the crosshair (it drags them in and lifts them); Al Fura is a
    // hurricane FRONT that rolls out and carries everyone with it.
    (
        id: "rz_fura",
        name: "Fura",
        kind: Kit,
        names: ["fura magic", "fura spell", "fura spells", "wind magic fura", "re zero wind magic", "fura family"],
        fx: "wind",
        shouts: [("Fura", 0), ("Fuura", 0), ("Furah", 0), ("Foora", 0),
                 ("El Fura", 1), ("Elle Fura", 1), ("L Fura", 1), ("Elfura", 1), ("El Foora", 1), ("Eru Fura", 1), ("El Furah", 1),
                 ("Ul Fura", 2), ("Ool Fura", 2), ("Ulfura", 2), ("Oul Fura", 2), ("Uru Fura", 2), ("Ulu Fura", 2),
                 ("Al Fura", 3), ("All Fura", 3), ("Alfura", 3), ("Ahl Fura", 3), ("Aru Fura", 3)],
        moves: [
            // A palm of wind: little damage, a long shove. -> you don't move; they are sliding away.
            (name: "fura", tags: [Primary], cooldown: 0.7, cost: 3.0, ops: [
                Shove(range: 7.5, angle: 30.0, damage: 5.0, knockback: 18.0, element: Wind),
            ], juice: Some((punch: 1.0, color: Some((0.78, 0.96, 0.88))))),
            // El Fura: a flying blade of wind that cuts everything on its line. -> you don't move.
            (name: "el fura", cooldown: 1.6, cost: 8.0, ops: [
                Wave(length: 26.0, speed: 55.0, width: 3.2, carve: 0.4, damage: 11.0, knockback: 7.0, element: Wind, thin: true),
            ], juice: Some((title: Some("EL FURA"), punch: 2.0, color: Some((0.75, 0.97, 0.86))))),
            // Ul Fura: a cyclone at the crosshair — it drags them in, then four gusts throw them up.
            // -> you don't move; they are up in the air above the crosshair.
            (name: "ul fura", cooldown: 5.0, cost: 20.0, ops: [
                Field(strength: 38.0, radius: 8.0, secs: 1.4, at: Aim),
                Salvo(count: 4, delay: 0.4, interval: 0.2, radius: 3.2, damage: 6.0, knockback: 4.0, up: 1.6, element: Wind, at: Aim, cut: true),
            ], juice: Some((title: Some("UL FURA"), boom: true, punch: 3.0, shake: 0.15, ripple: 6.0, at: Aim, debris: -12.0,
                            color: Some((0.72, 0.96, 0.84))))),
            // AL FURA: a hurricane wall rolls out along your aim and carries everyone it meets, while a
            // giant blade of wind rides in front of it. -> you don't move; the field is swept clean.
            (name: "al fura", tags: [Ultimate], cooldown: 16.0, cost: 40.0, ops: [
                Surge(width: 12.0, dist: 34.0, speed: 22.0, push: 30.0, damage: 16.0, element: Wind),
                Wave(length: 34.0, speed: 60.0, width: 12.0, carve: 0.6, damage: 8.0, knockback: 10.0, element: Wind, thin: true),
            ], juice: Some((title: Some("AL FURA"), boom: true, punch: 5.0, shake: 0.3, ripple: 9.0, at: Front, dist: 6.0, debris: 20.0,
                            color: Some((0.8, 1.0, 0.9)), impact_frame: Some("comic")))),
        ],
    ),
    // ---------------------------------------------------------------- DONA — earth
    // Dona is one pillar of stone under the crosshair; El Dona is a wall; Ul Dona is a line of stone
    // spikes; Al Dona is the earth closing round them in a ring and then THROWING them to the sky on a
    // column.
    (
        id: "rz_dona",
        name: "Dona",
        kind: Kit,
        names: ["dona magic", "dona spell", "dona spells", "earth magic dona", "re zero earth magic", "dona family"],
        fx: "earth",
        shouts: [("Dona", 0), ("Doona", 0), ("Dohna", 0), ("Dóna", 0),
                 ("El Dona", 1), ("Elle Dona", 1), ("L Dona", 1), ("Eldona", 1), ("El Doona", 1), ("Eru Dona", 1),
                 ("Ul Dona", 2), ("Ool Dona", 2), ("Uldona", 2), ("Oul Dona", 2), ("Uru Dona", 2), ("Ul Doona", 2),
                 ("Al Dona", 3), ("All Dona", 3), ("Aldona", 3), ("Ahl Dona", 3), ("Aru Dona", 3), ("All Doona", 3)],
        moves: [
            // A pillar punches up under the crosshair. -> you don't move; they pop up.
            (name: "dona", tags: [Primary], cooldown: 0.9, cost: 4.0, ops: [
                Erupt(length: 1.0, width: 1.6, height: 3.5, element: Earth, damage: 6.0, launch: 14.0, shape: Pillar, at: Aim),
            ], juice: Some((punch: 1.0, color: Some((0.62, 0.48, 0.34))))),
            // El Dona: a wall of earth across your aim. -> you're behind cover.
            (name: "el dona", tags: [Defense], cooldown: 3.0, cost: 8.0, ops: [
                Erupt(length: 8.0, width: 1.2, height: 4.0, element: Earth, shape: Wall, dist: 4.0),
            ], juice: Some((title: Some("EL DONA"), punch: 2.0, color: Some((0.6, 0.46, 0.32))))),
            // Ul Dona: stone spikes race along the ground. -> you don't move; they're launched.
            (name: "ul dona", cooldown: 5.0, cost: 20.0, ops: [
                Erupt(length: 22.0, width: 1.8, height: 3.5, count: 7, element: Earth, damage: 12.0, launch: 16.0),
            ], juice: Some((title: Some("UL DONA"), boom: true, punch: 3.0, shake: 0.2, ripple: 4.0, at: Front, dist: 8.0, debris: 14.0,
                            color: Some((0.58, 0.44, 0.3))))),
            // AL DONA: the earth rings them in, then a column the size of a house throws them skyward.
            // -> you don't move; they are very high up.
            (name: "al dona", tags: [Ultimate], cooldown: 16.0, cost: 40.0, ops: [
                Erupt(length: 9.0, width: 1.5, height: 6.0, element: Earth, damage: 6.0, launch: 4.0, shape: Ring, at: Aim),
                Erupt(length: 1.0, width: 3.0, height: 10.0, element: Earth, damage: 16.0, launch: 30.0, shape: Pillar, at: Aim),
            ], juice: Some((title: Some("AL DONA"), boom: true, punch: 6.0, shake: 0.35, ripple: 9.0, at: Aim, debris: 24.0,
                            color: Some((0.62, 0.46, 0.3)), impact_frame: Some("comic")))),
        ],
    ),
    // ---------------------------------------------------------------- SHAMAK — yin
    // Yin magic doesn't hurt, it DISORIENTS. Shamak throws a cloud of darkness onto the crosshair
    // (a vision vignette and thick air: short, you walk out of it); El Shamak is a bigger, bursting
    // cloud; Ul Shamak drowns everything around you in night while you slip back out of it; Al Shamak
    // — Beatrice's — sends the one you aim at out of this world for a moment (flung far away, unhurt,
    // in control). Murak makes you weightless; El Murak makes THEM weightless.
    (
        id: "rz_shamak",
        name: "Shamak",
        kind: Kit,
        names: ["shamak magic", "shamak spell", "shamak spells", "yin magic", "re zero yin magic", "shamak family"],
        fx: "shadow",
        shouts: [("Shamak", 0), ("Shamac", 0), ("Shamack", 0), ("Sha Mak", 0), ("Shamaku", 0), ("Shamuck", 0),
                 ("El Shamak", 1), ("Elle Shamak", 1), ("L Shamak", 1), ("El Shamac", 1), ("Eru Shamak", 1),
                 ("Ul Shamak", 2), ("Ool Shamak", 2), ("Ul Shamac", 2), ("Oul Shamak", 2), ("Uru Shamak", 2),
                 ("Al Shamak", 3), ("All Shamak", 3), ("Al Shamac", 3), ("All Shamac", 3), ("Ahl Shamak", 3), ("Aru Shamak", 3),
                 ("Murak", 4), ("Muraku", 4), ("Moorak", 4), ("Murack", 4),
                 ("El Murak", 5), ("Elle Murak", 5), ("El Muraku", 5)],
        moves: [
            // A cloud of darkness lands on the crosshair: blinded and wading, briefly. -> you don't move.
            (name: "shamak", tags: [Primary], cooldown: 1.2, cost: 4.0, ops: [
                Zone(radius: 4.5, secs: 2.2, status: Some(Shadow), slow: 0.2, at: Aim),
            ], juice: Some((ripple: 3.0, at: Aim, color: Some((0.2, 0.08, 0.28))))),
            // El Shamak: a bigger cloud that bursts as it lands. -> you don't move.
            (name: "el shamak", cooldown: 2.5, cost: 8.0, ops: [
                Zone(radius: 7.0, secs: 3.0, status: Some(Shadow), slow: 0.3, at: Aim),
                Explode(radius: 5.0, damage: 4.0, knockback: 6.0, element: Shadow, at: Aim),
            ], juice: Some((title: Some("EL SHAMAK"), punch: 2.0, ripple: 5.0, at: Aim, color: Some((0.18, 0.06, 0.26))))),
            // Ul Shamak: night falls around you — then you're seven metres back, outside it.
            // -> you end behind your own cloud.
            (name: "ul shamak", tags: [Defense], cooldown: 7.0, cost: 20.0, ops: [
                Zone(radius: 10.0, secs: 3.5, status: Some(Shadow), slow: 0.35),
                Relocate(range: 45.0, cone: 20.0, back: 7.0, me: true),
            ], juice: Some((title: Some("UL SHAMAK"), boom: true, punch: 3.0, ripple: 10.0, color: Some((0.15, 0.05, 0.22))))),
            // AL SHAMAK: the one you look at is swallowed into another dimension and spat out far away
            // (no damage, full control) — a hole of darkness hangs where they stood.
            // -> you don't move; the fight is yours for a few seconds.
            (name: "al shamak", tags: [Ultimate], cooldown: 16.0, cost: 40.0, ops: [
                Banish(range: 36.0, dist: 14.0),
                Zone(radius: 5.0, secs: 2.5, status: Some(Shadow), slow: 0.2, at: Aim),
            ], juice: Some((title: Some("AL SHAMAK"), boom: true, punch: 5.0, shake: 0.2, ripple: 9.0, at: Aim, debris: -16.0,
                            color: Some((0.3, 0.08, 0.45)), impact_frame: Some("void")))),
            // Murak: weightless — a long floating leap. -> ends high and drifting.
            (name: "murak", tags: [Movement], cooldown: 2.5, cost: 3.0, ops: [
                Impulse(fwd: 4.0, up: 8.0),
                SelfStatus(status: Float, secs: 2.5),
            ], juice: Some((ripple: 2.0, color: Some((0.55, 0.4, 0.75))))),
            // El Murak: the one you look at loses their weight and drifts up. -> they float (a juggle).
            (name: "el murak", cooldown: 3.0, cost: 8.0, ops: [
                Afflict(range: 30.0, cone: 10.0, status: Some(Float), secs: 1.2, up: 6.0, element: Psychic),
            ], juice: Some((title: Some("EL MURAK"), punch: 1.5, color: Some((0.55, 0.4, 0.75))))),
        ],
    ),
    // ---------------------------------------------------------------- MINYA — crystal stakes
    // Minya is one violet crystal stake; El Minya (Beatrice's) is a flight of stakes that snap onto
    // whoever stands near the crosshair and crystallize the one you aimed at for a heartbeat; Ul Minya
    // cages them in crystal and fills the cage with stakes; Al Minya is a crystal lance that never
    // misses — it finds the enemy nearest your crosshair round any cover and jumps to three more.
    (
        id: "rz_minya",
        name: "Minya",
        kind: Kit,
        names: ["minya magic", "minya spell", "minya spells", "crystal magic minya", "re zero crystal magic", "minya family"],
        fx: "crystal",
        shouts: [("Minya", 0), ("Minia", 0), ("Meenya", 0), ("Min Ya", 0), ("Minyah", 0),
                 ("El Minya", 1), ("Elle Minya", 1), ("L Minya", 1), ("Elminya", 1), ("El Minia", 1), ("Eru Minya", 1), ("El Meenya", 1),
                 ("Ul Minya", 2), ("Ool Minya", 2), ("Ulminya", 2), ("Oul Minya", 2), ("Uru Minya", 2), ("Ul Minia", 2),
                 ("Al Minya", 3), ("All Minya", 3), ("Alminya", 3), ("Ahl Minya", 3), ("Aru Minya", 3), ("All Minia", 3)],
        moves: [
            // One crystal stake from the palm. -> you don't move.
            (name: "minya", tags: [Primary], cooldown: 0.7, cost: 3.0, ops: [
                Cast(recipe: (name: "minya stake", form: Spear, mech: [Pierce, Fast], element: Psychic, scale: 0.65, mass: 5.0)),
            ], juice: Some((punch: 1.0, color: Some((0.82, 0.55, 1.0))))),
            // El Minya: six stakes fall on the crosshair, snapping to whoever is near it; the one you aimed
            // at is crystallized for a heartbeat. -> you don't move.
            (name: "el minya", cooldown: 1.8, cost: 8.0, ops: [
                Salvo(count: 6, delay: 0.25, interval: 0.06, radius: 1.5, damage: 6.0, knockback: 6.0, element: Psychic, at: Aim, spread: 3.5, seek: true, cut: true),
                Afflict(range: 45.0, cone: 10.0, status: Some(Stun), secs: 0.45, element: Psychic),
            ], juice: Some((title: Some("EL MINYA"), punch: 2.0, color: Some((0.8, 0.5, 1.0))))),
            // Ul Minya: a crystal cage round the crosshair, then eight stakes rain inside it.
            // -> you don't move; they're in a cage full of stakes.
            (name: "ul minya", cooldown: 5.0, cost: 20.0, ops: [
                Erupt(length: 7.0, width: 1.0, height: 3.5, element: Psychic, damage: 6.0, launch: 4.0, shape: Ring, at: Aim),
                Salvo(count: 8, delay: 0.5, interval: 0.05, radius: 1.6, damage: 5.0, knockback: 5.0, element: Psychic, at: Aim, spread: 3.0, seek: true, cut: true),
            ], juice: Some((title: Some("UL MINYA"), boom: true, punch: 3.0, shake: 0.15, ripple: 5.0, at: Aim, color: Some((0.78, 0.5, 1.0))))),
            // AL MINYA: a crystal lance that finds them — round cover, from enemy to enemy — and comes back.
            // -> you don't move; up to four of them are pierced.
            (name: "al minya", tags: [Ultimate], cooldown: 16.0, cost: 40.0, ops: [
