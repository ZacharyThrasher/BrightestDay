    // ================================================================ CHINESE (the Great Sage lives in base_folklore.ron)
    // ---------------------------------------------------------------- SUN WUKONG — the Monkey King's moves
    // The staff that telescopes (Extends: equip it, then twirl / thrust / plant it), its instant line
    // strike, the somersault that crosses the world, the immobilizing "Ding!", the giant form.
    (
        id: "myth_wukong",
        name: "Sun Wukong",
        kind: Kit,
        fx: "rigid",
        names: ["sun wukong", "wukong", "the monkey king", "monkey king", "sun wu kong", "sun wu-kong", "wu kong", "sun go kong",
                "son wukong", "sun wookong", "sun woo kong", "stone monkey", "the stone monkey", "handsome monkey king", "sun houzi"],
        shouts: [("ruyi jingu bang extend", 0), ("staff extend", 0), ("extend the staff", 0), ("ruyi extend", 0), ("grow staff", 0),
                 ("extend ruyi", 0), ("ruyi thrust", 0), ("staff grow", 0),
                 ("108000 li", 1), ("somersault leap", 1), ("monkey king leap", 1), ("wukong leap", 1),
                 ("ding", 2), ("ding shen fa", 2), ("dingshen", 2), ("immobilizing spell", 2), ("qishier bian", 3),
                 ("dharma idol", 3), ("golden gaze of wukong", 6), ("wukong golden eyes", 6), ("heaven and earth form", 3),
                 ("havoc in heaven", 4), ("havoc in the heavenly palace", 4), ("da nao tian gong", 4),
                 ("draw the ruyi staff", 5), ("summon the ruyi", 5), ("ruyi staff in hand", 5),
                 ("ride the cloud", 7), ("summon the cloud", 7)],
        moves: [
            // The staff shoots out tens of metres as a line strike, golden and rigid, and snaps back.
            (name: "ruyi extend", tags: [Primary], cooldown: 1.2, cost: 4.0, ops: [
