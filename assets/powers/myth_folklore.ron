        shouts: [("gungnir", 0), ("throw gungnir", 0), ("gungnir never misses", 0), ("spear of odin", 0), ("gungner", 0), ("gun near", 0), ("gungir", 0), ("gungnir the spear", 0),
                 ("huginn and muninn", 1), ("hugin and munin", 1), ("thought and memory", 1), ("odin's ravens", 1), ("ravens of odin", 1),
                 ("hugin and mugin", 1),
                 ("sleipnir charge", 2), ("ride of sleipnir", 2), ("slepnir", 2),
                 ("the wild hunt", 3), ("wild hunt", 3), ("oskoreia", 3),
                 ("hlidskjalf", 4), ("eye of odin", 4), ("odin's eye", 4), ("the allfather sees", 4), ("all seeing eye of odin", 4),
                 ("einherjar", 5), ("warriors of valhalla", 5), ("valhalla awaits", 5), ("for valhalla", 5),
                 ("ride sleipnir", 6), ("mount sleipnir", 6),
                 ("rings of draupnir", 7), ("draupnir ring", 7)],
        moves: [
            // THE headliner: the spear finds its mark. Dodge through its point at the right moment,
