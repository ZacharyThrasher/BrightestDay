                 ("kantele", 1), ("play the kantele", 1), ("the kantele", 1),
                 ("song of making", 2), ("sing a wall", 2),
                 ("sampo", 3), ("the sampo", 3), ("grind the sampo", 3),
                 ("sung boat", 4), ("sing a boat", 4)],
