    // ---------------------------------------------------------------- PERSEUS — the gorgon slayer
    // Borrowed gifts of the gods: Hermes' sandals, Hades' cap, Athena's mirror shield, the harpe —
    // and Medusa's severed head, whose stare still turns to stone whoever looks at it.
    (
        id: "myth_perseus",
        name: "Perseus",
        kind: Kit,
        fx: "holy",
        names: ["perseus", "persius", "perseas", "perseus the gorgon slayer", "perseus son of zeus"],
        shouts: [("harpe", 0), ("sword of perseus", 0),
                 ("head of medusa", 1), ("gorgon's head", 1), ("the gorgon's head", 1),
                 ("mirror shield", 2), ("polished shield", 2),
                 ("ride pegasus", 3), ("summon pegasus", 3),
                 ("perseus sandals", 4)],
        moves: [
            // The harpe: a hooked sickle-sword sweep. -> ends in place.
            (name: "harpe", tags: [Primary], cooldown: 0.8, cost: 3.0, ops: [
                Shove(range: 3.2, angle: 85.0, damage: 12.0, knockback: 9.0),
            ], juice: Some((punch: 1.5))),
            // Medusa's head held up: everyone in front whose eyes are on you is dragged down heavy
