// MYTHOLOGY & FOLKLORE (CONTENT: MYTHOLOGY & FOLKLORE worker, docs/toolbox/BRIEF.md): the world's
// myths as KITS ("zeus thunderbolt", "odin gungnir", "maui fish up the islands") + a few forms you
// can take (berserkergang, riastrad, the midas touch). Greek, Norse, Egyptian, Hindu epics (treated
// with respect, as Smite does), Japanese, Chinese (beyond base_folklore.ron's Great Sage), Celtic,
// Arthurian, Mesoamerican, Polynesian, African, Slavic, Mesopotamian, Finnish, cryptids, urban
// legends and fairy tales. Names only — no quotes, no incantations. Public-domain myth; a film's
// take on a myth (Marvel's Thor, Disney's Hercules / Maui / genie) belongs to the MOVIES worker.
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
//
// Design rules for this file (BRIEF §3 + owner): a famous myth does the thing it is famous for —
// Gungnir is thrown, bends round cover and comes home (Seeker); Medusa's stare stops only those who
// meet it; Hanuman grows and crosses the map in one leap (SelfResize, Leap); Maui hooks the land and
// hauls an island to his feet (Haul); Poseidon rolls a tidal wave that carries you off (Surge).
// Every move notes its chain ending ("-> ends ...") so chains read well. Bare god names stay the
// costume / construct summon; "<god> <move>" fires the move; the shouts are the phrases people yell.
[
    // ================================================================ GREEK
    // ---------------------------------------------------------------- ZEUS — king of the gods
    // Point and smite. Gather the clouds first (they soak everyone under them) and every bolt after
    // arcs further — the storm is a combo, not a nuke.
    (
        id: "myth_zeus",
        name: "Zeus",
        kind: Kit,
        fx: "lightning",
        names: ["zeus", "the king of the gods", "king of the gods", "zeus the thunderer", "zeus king of the gods", "dias",
                "jupiter", "jove", "zues", "zeuss", "zoos", "zeus god of thunder", "father zeus", "olympian zeus"],
        shouts: [("thunderbolt of zeus", 0), ("bolt of zeus", 0), ("keraunos", 0), ("zeus's thunderbolt", 0), ("zeus thunder bolt", 0),
                 ("wrath of zeus", 1), ("wrath of the gods", 1), ("storm of olympus", 1), ("fury of olympus", 1),
                 ("eagle of zeus", 2), ("aetos dios", 2),
                 ("gather the clouds", 3), ("cloud gatherer", 3), ("storm clouds of zeus", 3),
                 ("aegis of zeus", 4),
                 ("descent from olympus", 5), ("olympian descent", 5)],
        moves: [
            // A bolt from the hand to wherever you point: instant, no travel, arcs to the soaked.
            // -> ends where you stand; they are knocked back, maybe chained.
            (name: "thunderbolt", tags: [Primary], cooldown: 1.2, cost: 4.0, ops: [
                Explode(radius: 3.2, damage: 13.0, knockback: 16.0, carve: 0.8, element: Electric, at: Aim),
            ], juice: Some((title: Some("KERAUNOS"), punch: 2.5, shake: 0.12, at: Aim, ripple: 3.0, color: Some((0.7, 0.85, 1.0))))),
            // The sky answers: marks rain across the crosshair and bolts land one after another.
            // Everyone sees the marks — step out or eat the storm. -> ends with you free to move.
            (name: "wrath of zeus", tags: [Ultimate], cooldown: 16.0, cost: 12.0, ops: [
                Salvo(count: 7, delay: 0.9, interval: 0.12, radius: 3.2, damage: 13.0, knockback: 18.0, element: Electric, carve: 1.2,
                      at: Aim, spread: 8.0, seek: true),
            ], juice: Some((title: Some("WRATH OF ZEUS"), boom: true, punch: 5.0, shake: 0.3, at: Aim, color: Some((0.75, 0.88, 1.0))))),
            // Aetos Dios: the eagle takes you up above the fight. -> ends airborne, hanging, looking down.
            (name: "eagle of zeus", tags: [Movement], cooldown: 5.0, cost: 4.0, ops: [
                Impulse(fwd: 9.0, up: 17.0),
                SelfStatus(status: Float, secs: 1.3),
            ], juice: Some((ripple: 2.0, color: Some((1.0, 0.85, 0.45))))),
            // Gather the clouds: a rain cloud over the crosshair soaks everyone under it (Wet: bolts
            // reach twice as far and arc on). -> ends with them soaked for your thunderbolt.
            (name: "gather the clouds", tags: [Combo], cooldown: 9.0, cost: 5.0, ops: [
                Zone(radius: 8.0, secs: 5.0, status: Some(Wet), slow: 0.15, at: Aim),
            ], juice: Some((title: Some("CLOUD GATHERER"), at: Aim, ripple: 8.0, color: Some((0.55, 0.62, 0.75))))),
            // The aegis: the first blow that lands on you is answered with lightning. -> ends in place.
            (name: "aegis", tags: [Counter, Defense], cooldown: 7.0, cost: 4.0, ops: [
                Counter(secs: 0.8, damage: 12.0, knockback: 20.0, up: 0.3, element: Electric),
            ], juice: Some((title: Some("AEGIS"), color: Some((1.0, 0.85, 0.4))))),
            // Down from Olympus: a diving strike that detonates in lightning where you land. -> ends grounded.
            (name: "descent from olympus", cooldown: 4.0, cost: 5.0, ops: [
                Impulse(fwd: 8.0, up: -30.0),
                SlamOnLand(radius: 5.5, damage: 14.0, knockback: 18.0, carve: 1.5),
            ], juice: Some((title: Some("OLYMPIAN DESCENT"), boom: true, shake: 0.2, color: Some((0.7, 0.85, 1.0))))),
        ],
    ),
    // ---------------------------------------------------------------- POSEIDON — the earth-shaker
    // The sea is his weapon: a tidal wave you surf, a quake that splits the ground along your aim,
    // a trident thrust with reach, and the kraken.
    (
        id: "myth_poseidon",
        name: "Poseidon",
        kind: Kit,
        fx: "water",
        names: ["poseidon", "neptune", "the earthshaker", "god of the sea", "poseidon god of the sea",
                "posiedon", "poseiden", "posidon", "poseidan", "posseidon", "king of the sea"],
        shouts: [("tsunami", 1), ("poseidon tidal wave", 1), ("poseidon's wrath", 1), ("wrath of the sea", 1), ("wrath of poseidon", 1),
                 ("earthquake of poseidon", 2), ("shake the earth", 2), ("earth shaking", 2),
                 ("hippocampus", 3), ("sea horses", 3), ("ride the waves", 3),
                 ("whirlpool", 4), ("charybdis", 4), ("maelstrom", 4),
                 ("unleash the kraken", 5), ("summon the kraken", 5),
                 ("throw the trident", 6), ("trident throw", 6)],
        moves: [
            // A long, narrow, three-pronged lunge: the reach is the point. -> ends a step forward.
            (name: "trident thrust", tags: [Primary], cooldown: 0.9, cost: 3.0, ops: [
                Impulse(fwd: 9.0, up: 0.0),
                Shove(range: 5.0, angle: 22.0, damage: 13.0, knockback: 16.0, element: Water),
            ], juice: Some((punch: 2.0, ripple: 2.0, at: Front, dist: 4.0, color: Some((0.3, 0.65, 1.0))))),
            // A wall of sea rises in front of you and rolls out across the map, carrying everyone it
            // catches with it. Jump the crest or dodge through. -> ends with them far away and soaked.
            (name: "tidal wave", tags: [Ultimate], cooldown: 18.0, cost: 12.0, ops: [
                Surge(width: 12.0, dist: 42.0, speed: 15.0, push: 19.0, damage: 10.0, element: Water),
            ], juice: Some((title: Some("TIDAL WAVE"), boom: true, punch: 5.0, shake: 0.3, color: Some((0.25, 0.55, 1.0))))),
            // The earth-shaker strikes the ground: a quake under you and a rift torn along your aim.
            // -> ends grounded; everyone near is launched.
            (name: "earthquake", tags: [Combo], cooldown: 8.0, cost: 8.0, ops: [
                Explode(radius: 7.0, damage: 8.0, knockback: 16.0, carve: 1.2, element: Earth),
                Carve(length: 22.0, radius: 1.3, damage: 11.0),
            ], juice: Some((title: Some("EARTHSHAKER"), boom: true, shake: 0.38, debris: 20.0, ripple: 9.0))),
            // Ride the sea-horses: a charge through everyone in your way. -> ends past them, running.
            (name: "hippocampus", tags: [Movement], cooldown: 3.0, cost: 4.0, ops: [
                Ram(speed: 26.0, secs: 0.8, damage: 9.0, knockback: 14.0, through: true, keep: 0.6, element: Water),
            ], juice: Some((ripple: 3.0, color: Some((0.35, 0.75, 1.0))))),
            // Charybdis: a whirlpool at the crosshair drags everyone into its centre and soaks them.
            // -> ends with them bunched up for the trident.
            (name: "whirlpool", tags: [Defense], cooldown: 9.0, cost: 6.0, ops: [
                Field(strength: 42.0, radius: 9.0, secs: 2.2, at: Aim),
                Zone(radius: 6.0, secs: 2.5, status: Some(Wet), at: Aim),
            ], juice: Some((title: Some("CHARYBDIS"), at: Aim, ripple: 9.0, debris: -14.0, color: Some((0.2, 0.45, 0.85))))),
            // Release the kraken: a sea-titan of grasping arms.
            (name: "release the kraken", cooldown: 30.0, cost: 10.0, ops: [
                Cast(recipe: (name: "kraken", form: Blob, mech: [Grab, Constrict, ArticulatedTail, Heavy], element: Water, scale: 3.5,
                              temperament: Aggressive, intensity: 1.0), signature: Some(Summon)),
            ], juice: Some((title: Some("RELEASE THE KRAKEN"), boom: true, punch: 6.0, shake: 0.3, color: Some((0.2, 0.4, 0.55))))),
            // The trident thrown: it seeks the nearest enemy, strikes two, and swims back to your hand.
            // -> ends empty-handed until it returns (you can keep fighting).
            (name: "trident throw", cooldown: 6.0, cost: 5.0, ops: [
                Seeker(recipe: (name: "trident of poseidon", form: Spear, mech: [Pierce], element: Water, scale: 2.2),
                       range: 45.0, cone: 18.0, speed: 38.0, damage: 13.0, knockback: 18.0, element: Water, hits: 2, chain: 14.0),
            ], juice: Some((title: Some("TRIDENT"), punch: 2.5, color: Some((0.3, 0.65, 1.0))))),
        ],
    ),
    // ---------------------------------------------------------------- HADES — lord of the underworld
    // The dead do his work: hands from below, a pit that opens under them, Cerberus, and the helm of
    // darkness (everyone near you goes blind while you slip away).
    (
        id: "myth_hades",
        name: "Hades",
        kind: Kit,
        fx: "shadow",
        names: ["hades", "pluto", "lord of the underworld", "king of the underworld", "lord of the dead", "aides", "haides", "hadees",
                "hadies", "hayden's"],
        shouts: [("hands of the dead", 0), ("grasp of the underworld", 0), ("underworld hands", 0), ("grasp of the dead", 0),
                 ("summon cerberus", 1), ("unleash cerberus", 1),
                 ("helm of darkness", 2), ("cap of invisibility", 2), ("helm of hades", 2),
                 ("drag them to the underworld", 3), ("to the underworld", 3),
                 ("river styx", 4), ("the styx", 4), ("waters of the styx", 4),
                 ("shades of the dead", 5),
                 ("open the underworld", 6), ("gates of the underworld", 6)],
        moves: [
            // Grey hands burst out of the ground at the crosshair and hold whoever stands there.
            // -> ends with them caged for a beat.
            (name: "hands of the dead", tags: [Primary], cooldown: 4.0, cost: 5.0, ops: [
                Cast(recipe: (name: "hands of the dead", form: Cage, mech: [Trap, Grab], element: Shadow, scale: 1.8)),
            ], juice: Some((title: Some("HANDS OF THE DEAD"), at: Aim, ripple: 3.0, color: Some((0.45, 0.4, 0.6))))),
            // The three-headed hound of the gates, breathing fire.
            (name: "cerberus", tags: [Ultimate], cooldown: 28.0, cost: 10.0, ops: [
                Cast(recipe: (name: "cerberus", form: Quadruped, mech: [Breath, Charge, Blade, Heavy], element: Fire, scale: 3.0,
                              temperament: Aggressive, intensity: 1.0), signature: Some(Summon)),
            ], juice: Some((title: Some("CERBERUS"), boom: true, punch: 5.0, shake: 0.25, color: Some((0.6, 0.15, 0.1))))),
            // The helm of darkness: everyone near you goes dark while you step away unseen.
            // -> ends behind your own smoke, a dozen metres off.
            (name: "helm of darkness", tags: [Movement, Defense], cooldown: 9.0, cost: 6.0, ops: [
                Zone(radius: 8.0, secs: 2.5, status: Some(Shadow), at: Me),
                Blink(dist: 12.0),
            ], juice: Some((title: Some("HELM OF DARKNESS"), ripple: 4.0, color: Some((0.12, 0.08, 0.18))))),
            // The bident drags them down: a two-pronged hook that pulls the aimed foe under. -> ends
            // with them heavy and sinking in front of you.
            (name: "bident", tags: [Combo], cooldown: 3.0, cost: 4.0, ops: [
                Shove(range: 4.2, angle: 35.0, damage: 10.0, knockback: 6.0, element: Shadow),
                Weigh(range: 6.0, secs: 1.4, down: 18.0),
            ], juice: Some((title: Some("TO THE UNDERWORLD"), punch: 2.0, color: Some((0.35, 0.2, 0.5))))),
            // The Styx at your feet: the dead grab at the legs of everyone in it. -> ends with a slow
            // swamp between you and them.
            (name: "river styx", cooldown: 10.0, cost: 6.0, ops: [
                Zone(radius: 7.0, secs: 4.0, slow: 0.45, dps: 2.0, at: Aim),
            ], juice: Some((title: Some("STYX"), at: Aim, ripple: 7.0, color: Some((0.2, 0.25, 0.3))))),
            // Shades of the dead rise and shamble at your enemies.
            (name: "army of the dead", cooldown: 18.0, cost: 8.0, ops: [
                Cast(recipe: (name: "shades of the dead", form: Biped, mech: [Walks, Blunt], element: Shadow, scale: 1.0, count: 4,
                              temperament: Aggressive, intensity: 0.8)),
            ], juice: Some((title: Some("SHADES"), ripple: 3.0, color: Some((0.3, 0.3, 0.4))))),
            // The ground opens under the crosshair and pulls everything toward the pit.
            // -> ends with a hole where they stood.
            (name: "open the underworld", cooldown: 12.0, cost: 8.0, ops: [
                Explode(radius: 4.0, damage: 6.0, knockback: 2.0, carve: 3.4, element: Shadow, at: Aim),
                Field(strength: 36.0, radius: 6.0, secs: 1.4, at: Aim),
            ], juice: Some((title: Some("THE GATES OPEN"), boom: true, at: Aim, shake: 0.2, debris: -12.0, color: Some((0.25, 0.1, 0.3))))),
        ],
    ),
    // ---------------------------------------------------------------- HERMES — messenger of the gods
    // The fastest god and the first thief: winged sandals, a caduceus that lulls, and the hand that
    // takes the weapon out of yours.
    (
        id: "myth_hermes",
        name: "Hermes",
        kind: Kit,
        fx: "wind",
        names: ["hermes", "mercury", "the messenger god", "messenger of the gods", "hermes the messenger", "hermies", "hermees",
                "herms", "hermes trickster"],
        shouts: [("sandals of hermes", 0),
                 ("caduceus", 1), ("staff of hermes", 1),
                 ("speed of hermes", 2),
                 ("thief of the gods", 3), ("hermes steals", 3), ("light fingers", 3),
                 ("wings of hermes", 4), ("messenger's flight", 4)],
        moves: [
            // Talaria: the winged sandals kick you across the ground in a long, low bound.
            // -> ends airborne and fast, still moving.
            (name: "winged sandals", tags: [Movement], cooldown: 1.6, cost: 3.0, ops: [
                Impulse(fwd: 30.0, up: 5.0),
            ], juice: Some((ripple: 2.0, color: Some((0.95, 0.95, 0.8))))),
            // The caduceus: a touch of the staff and the target grows heavy with sleep.
            // -> ends with them drowsy and slow in front of you.
            (name: "caduceus", tags: [Primary], cooldown: 3.0, cost: 4.0, ops: [
                Afflict(range: 14.0, cone: 8.0, status: Some(Chill), secs: 2.2, damage: 5.0, element: Psychic),
            ], juice: Some((title: Some("CADUCEUS"), color: Some((0.95, 0.85, 0.4))))),
            // Quicksilver: for a breath the world is slow and only you are Hermes.
            (name: "quicksilver", tags: [Ultimate], cooldown: 20.0, cost: 10.0, ops: [
                TimeStop(secs: 1.6, speed: 1.9),
            ], juice: Some((title: Some("QUICKSILVER"), boom: true, color: Some((0.8, 0.85, 0.9))))),
            // The thief: their weapon leaves their hand and lands in front of you.
            (name: "thief of the gods", tags: [Combo], cooldown: 8.0, cost: 5.0, ops: [
                Disarm(range: 16.0, cone: 10.0, pull: true, knockback: 4.0),
            ], juice: Some((title: Some("STOLEN"), color: Some((0.95, 0.85, 0.4))))),
            // Wings of Hermes: straight up and a hover. -> ends high, floating.
            (name: "wings of hermes", cooldown: 5.0, cost: 4.0, ops: [
                Impulse(fwd: 6.0, up: 18.0),
                SelfStatus(status: Float, secs: 1.6),
            ], juice: Some((ripple: 2.0, color: Some((1.0, 1.0, 0.9))))),
        ],
    ),
    // ---------------------------------------------------------------- ATHENA — wisdom and war
    // Discipline over rage: the aegis turns shots around, the spear has reach, the owl scouts, and the
    // war-goddess's strategy answers the first blow.
    (
        id: "myth_athena",
        name: "Athena",
        kind: Kit,
        fx: "holy",
        names: ["athena", "athene", "pallas athena", "pallas athene", "minerva", "goddess of wisdom", "athina", "athenna",
                "athena goddess of war"],
        shouts: [("spear of athena", 0), ("athena's spear", 0),
                 ("aegis of athena", 1), ("athena's aegis", 1), ("the aegis", 1),
                 ("owl of athena", 2), ("athena's owl", 2),
                 ("battle wisdom", 3), ("athena's strategy", 3),
                 ("athena parthenos", 4), ("guardian of athens", 4),
                 ("phalanx", 5), ("shield wall of athens", 5)],
        moves: [
            // A disciplined spear lunge with long reach. -> ends a step in, balanced.
            (name: "spear of athena", tags: [Primary], cooldown: 0.9, cost: 3.0, ops: [
                Impulse(fwd: 7.0, up: 0.0),
                Shove(range: 4.8, angle: 24.0, damage: 12.0, knockback: 14.0, element: Light),
            ], juice: Some((punch: 1.5, color: Some((0.9, 0.9, 1.0))))),
            // The aegis raised: shots and thrown things that reach you go back where you aim.
            (name: "aegis", tags: [Defense], cooldown: 7.0, cost: 5.0, ops: [
                Deflect(secs: 1.3, angle: 75.0),
            ], juice: Some((title: Some("AEGIS"), ripple: 3.0, color: Some((0.95, 0.85, 0.55))))),
            // Glaukopis: her owl dives on whoever you point at.
            (name: "owl of athena", tags: [Combo], cooldown: 7.0, cost: 4.0, ops: [
                Cast(recipe: (name: "owl of athena", form: Bird, mech: [Flies, Blade, Fast, Homing], element: Light, scale: 0.9,
                              temperament: Aggressive, intensity: 0.7)),
            ], juice: Some((color: Some((0.85, 0.8, 0.7))))),
            // Battle wisdom: the first blow on you is read and returned with interest.
            (name: "battle wisdom", tags: [Counter], cooldown: 6.0, cost: 4.0, ops: [
                Counter(secs: 0.7, damage: 13.0, knockback: 22.0, up: 0.4, element: Light),
            ], juice: Some((title: Some("STRATEGY"), color: Some((0.85, 0.9, 1.0))))),
            // Athena Parthenos: the great guardian statue of the Acropolis steps down to fight for you.
            (name: "athena parthenos", tags: [Ultimate], cooldown: 30.0, cost: 10.0, ops: [
                Cast(recipe: (name: "athena parthenos", form: Biped, mech: [Guard, Pierce, Heavy, Walks], element: Light, scale: 3.6,
                              temperament: Protective, intensity: 0.9), signature: Some(Summon)),
            ], juice: Some((title: Some("ATHENA PARTHENOS"), boom: true, punch: 5.0, color: Some((0.95, 0.88, 0.6))))),
            // The phalanx: a shield wall rises in front of you. -> ends behind cover.
            (name: "phalanx", cooldown: 10.0, cost: 5.0, ops: [
                Cast(recipe: (name: "phalanx shield wall", form: Wall, mech: [Barrier, Guard], element: Light, scale: 5.0)),
            ], juice: Some((title: Some("PHALANX")))),
        ],
    ),
    // ---------------------------------------------------------------- APOLLO — the sun and the bow
    // His arrows never miss (Seeker: they find you behind cover); he drives the sun chariot across the
    // sky (you ride it); his plague rains from above.
    (
        id: "myth_apollo",
        name: "Apollo",
        kind: Kit,
        fx: "holy",
        names: ["apollo", "phoebus", "phoebus apollo", "apollon", "apolo", "appollo", "apollo god of the sun", "apollo the archer",
                "far shooter"],
        shouts: [("arrow of apollo", 0), ("apollo's arrow", 0), ("sun arrow", 0), ("arrow of the sun", 0),
                 ("chariot of the sun", 1), ("sun chariot", 1), ("apollo's chariot", 1), ("chariot of helios", 1),
                 ("plague arrows", 2), ("arrows of plague", 2), ("apollo's plague", 2),
                 ("lyre of apollo", 3), ("apollo's lyre", 3),
                 ("radiance of apollo", 4), ("solar radiance", 4),
                 ("slay the python", 5), ("python slayer", 5)],
        moves: [
            // The sun arrow: loosed at the enemy nearest your crosshair, it curves round cover to find
            // them and flies back. -> ends with your bow free.
            (name: "sun arrow", tags: [Primary], cooldown: 1.6, cost: 4.0, ops: [
                Seeker(recipe: (name: "arrow of the sun", form: Spear, mech: [Pierce, Fast], element: Fire, scale: 1.1),
                       range: 55.0, cone: 14.0, speed: 52.0, damage: 10.0, knockback: 10.0, element: Fire, hits: 1),
            ], juice: Some((punch: 1.5, color: Some((1.0, 0.8, 0.3))))),
            // Drive the sun across the sky: a burning chariot you pilot.
            (name: "chariot of the sun", tags: [Ultimate, Movement], cooldown: 30.0, cost: 10.0, ops: [
                Cast(recipe: (name: "chariot of the sun", form: Vehicle, mech: [Piloted, Flies, Charge], element: Fire, scale: 3.0,
                              features: [Wheels])),
            ], juice: Some((title: Some("CHARIOT OF THE SUN"), boom: true, punch: 4.0, color: Some((1.0, 0.75, 0.25))))),
            // Plague arrows fall on the crosshair from above, one after another. -> ends clear of it.
            (name: "plague arrows", tags: [Combo], cooldown: 12.0, cost: 8.0, ops: [
                Salvo(count: 6, delay: 0.7, interval: 0.1, radius: 2.2, damage: 7.0, knockback: 6.0, element: Poison, at: Aim, spread: 6.0),
                Zone(radius: 6.0, secs: 3.0, status: Some(Poison), at: Aim),
            ], juice: Some((title: Some("PLAGUE ARROWS"), at: Aim, color: Some((0.6, 0.8, 0.3))))),
            // The lyre: everyone near you moves as if half-asleep while it plays.
            (name: "lyre of apollo", tags: [Defense], cooldown: 12.0, cost: 6.0, ops: [
                Zone(radius: 8.0, secs: 3.0, slow: 0.5, at: Me, follow: true),
            ], juice: Some((title: Some("LYRE"), ripple: 8.0, color: Some((1.0, 0.9, 0.5))))),
            // Radiance: a flare of sunlight — knocked back and dazzled. -> ends with you in the clear.
            (name: "radiance of apollo", cooldown: 8.0, cost: 5.0, ops: [
                Explode(radius: 6.0, damage: 5.0, knockback: 18.0, element: Light),
                Zone(radius: 9.0, secs: 1.5, status: Some(Shadow), at: Me),
            ], juice: Some((title: Some("RADIANCE"), boom: true, ripple: 9.0, color: Some((1.0, 0.95, 0.7))))),
            // The volley that slew the Python: a thousand-shaft storm of seeking arrows (several targets).
            (name: "python slayer", cooldown: 18.0, cost: 10.0, ops: [
                Seeker(recipe: (name: "golden arrow", form: Spear, mech: [Pierce, Fast], element: Light, scale: 1.2),
                       range: 55.0, cone: 30.0, speed: 46.0, damage: 12.0, knockback: 12.0, element: Light, hits: 4, chain: 25.0),
            ], juice: Some((title: Some("PYTHON SLAYER"), boom: true, punch: 3.0, color: Some((1.0, 0.85, 0.35))))),
        ],
    ),
    // ---------------------------------------------------------------- ARTEMIS — the huntress
