                Carve(length: 18.0, radius: 0.35, damage: 0.0),
            ], juice: Some((title: Some("RUYI!"), punch: 3.0, ripple: 2.0, at: Front, dist: 8.0, color: Some((1.0, 0.78, 0.2))))),
            // One somersault: across the world, landing where you look. -> ends far away, grounded.
