                Carve(length: 20.0, radius: 1.4, damage: 12.0),
            ], juice: Some((title: Some("TIMBER"), shake: 0.2))),
        ],
    ),
    // ---------------------------------------------------------------- THE DJINN — three wishes
    // A wish is granted — but never the one that wins the fight outright. What comes out of the lamp
    // is big and always different: a flying carpet, a fall of gold, a whirlwind, a palace wall, you
    // grown to a giant, an army.
    (
        id: "myth_djinn",
        name: "Djinn",
        kind: Kit,
        fx: "smoke",
        names: ["djinn", "jinn", "jinni", "djinni", "the djinn", "genie of the lamp", "the genie of the lamp", "ifrit", "efreet",
                "marid", "the lamp's genie"],
        shouts: [("three wishes", 0), ("make a wish", 0), ("your wish is my command", 0), ("grant me a wish", 0),
                 ("rub the lamp", 0), ("i wish for", 0),
                 ("ride the magic carpet", 1),
                 ("smoke form", 2), ("into smoke", 2), ("djinn smoke", 2),
                 ("smokeless fire", 3), ("djinn fire", 3), ("fire of the djinn", 3),
                 ("back in the lamp", 4), ("return to the lamp", 4)],
        moves: [
            // A wish: one of six big effects, never an instant win.
            (name: "three wishes", tags: [Ultimate], cooldown: 12.0, cost: 9.0, ops: [
                Roulette(picks: [
                    [Cast(recipe: (name: "magic carpet", form: Vehicle, mech: [Piloted, Flies], element: Wind, scale: 1.8))],
                    [Salvo(count: 6, delay: 0.7, interval: 0.1, radius: 2.4, damage: 9.0, knockback: 10.0, element: Light, at: Aim, spread: 6.0)],
                    [Surge(width: 9.0, dist: 30.0, speed: 16.0, push: 18.0, damage: 5.0, element: Wind)],
                    [Cast(recipe: (name: "palace wall", form: Wall, mech: [Barrier], element: Light, scale: 6.0))],
                    [SelfResize(scale: 1.6, secs: 8.0), Explode(radius: 5.0, damage: 3.0, knockback: 14.0, element: Wind)],
                    [Cast(recipe: (name: "the sultan's army", form: Biped, mech: [Walks, Blade], element: Light, scale: 1.0, count: 3,
                                   temperament: Aggressive, intensity: 0.8))],
                ]),
            ], juice: Some((title: Some("YOUR WISH"), boom: true, color: Some((0.4, 0.55, 1.0))))),
            // The flying carpet, to ride.
            (name: "magic carpet", tags: [Movement], cooldown: 30.0, cost: 7.0, ops: [
                Cast(recipe: (name: "magic carpet", form: Vehicle, mech: [Piloted, Flies], element: Wind, scale: 1.8)),
            ]),
            // Into smoke and away.
            (name: "smoke form", tags: [Defense], cooldown: 6.0, cost: 4.0, ops: [
                Zone(radius: 5.0, secs: 1.8, status: Some(Shadow), at: Me),
                Blink(dist: 12.0, afterimage: true),
            ]),
            // The djinn are made of smokeless fire. -> ends in place.
            (name: "smokeless fire", tags: [Primary], cooldown: 1.2, cost: 3.0, ops: [
                Cast(recipe: (name: "smokeless fire", form: Ball, mech: [Fast, Explodes], element: Fire, scale: 0.5, count: 3)),
            ]),
            // Back into the lamp: tiny, and the next blow is warded.
            (name: "back in the lamp", tags: [Counter], cooldown: 10.0, cost: 4.0, ops: [
                SelfResize(scale: 0.5, secs: 3.0),
                Counter(secs: 0.8),
            ]),
        ],
    ),
