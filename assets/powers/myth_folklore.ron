    // ---------------------------------------------------------------- JACK AND THE BEANSTALK
    (
        id: "myth_beanstalk",
        name: "Jack and the Beanstalk",
        kind: Kit,
        fx: "earth",
        names: ["jack and the beanstalk", "the beanstalk", "jack's beanstalk", "jack of the beanstalk", "beanstalk jack", "giant killer jack"],
        shouts: [("magic beans", 0), ("plant the magic beans", 0), ("grow the beanstalk", 0), ("the beanstalk grows", 0), ("magic bean", 0),
                 ("climb the beanstalk", 1), ("up the beanstalk", 1),
                 ("fee fi fo fum", 2), ("fee fie foe fum", 2), ("fe fi fo fum", 2), ("the giant wakes", 2),
                 ("golden goose", 3), ("the goose that lays golden eggs", 3),
                 ("chop the beanstalk", 4), ("cut down the beanstalk", 4)],
        moves: [
            // The beans: a huge stalk shoots up at the crosshair.
            (name: "magic beans", tags: [Ultimate], cooldown: 14.0, cost: 7.0, ops: [
                Cast(recipe: (name: "giant beanstalk", form: Pillar, mech: [Launch], element: Earth, scale: 14.0)),
            ], juice: Some((title: Some("THE BEANSTALK"), at: Aim, shake: 0.2, color: Some((0.35, 0.8, 0.3))))),
            // Straight up. -> ends high, hanging.
            (name: "climb the beanstalk", tags: [Movement], cooldown: 5.0, cost: 4.0, ops: [
                Impulse(fwd: 2.0, up: 26.0),
                SelfStatus(status: Float, secs: 1.2),
            ]),
            // Fee-fi-fo-fum: the giant at the top of the stalk comes down.
            (name: "fee fi fo fum", tags: [Combo], cooldown: 28.0, cost: 10.0, ops: [
                Cast(recipe: (name: "the giant", form: Biped, mech: [Heavy, Blunt, Walks, Stomp], element: Earth, scale: 4.2,
                              temperament: Aggressive, intensity: 0.9), signature: Some(Summon)),
            ], juice: Some((title: Some("FEE FI FO FUM"), boom: true, shake: 0.3))),
            // The golden goose: golden eggs rain.
            (name: "golden goose", tags: [Primary], cooldown: 7.0, cost: 4.0, ops: [
