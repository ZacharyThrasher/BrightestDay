    // runs everyone down, and from Hlidskjalf he sees every foe in view at once.
    (
        id: "myth_odin",
        name: "Odin",
        kind: Kit,
        fx: "spirit",
        names: ["odin", "the allfather", "allfather", "all father", "odin allfather", "wodan", "woden", "wotan", "othin", "odinn",
