    // ================================================================ POLYNESIAN
    // ---------------------------------------------------------------- MĀUI — the fishhook that hauls islands
    // THE hook: cast Manaiakalani at the land and haul a piece of it to your feet (it hits whoever is
    // in its way and becomes your cover); lasso the sun to slow it; become a hawk.
    (
        id: "myth_maui",
        name: "Maui",
        kind: Kit,
        fx: "earth",
        names: ["maui", "māui", "maui the demigod", "maui tikitiki", "maui tikitiki a taranga", "mowie", "mow ee", "maui of the islands",
                "maui the trickster", "maui pōtiki", "maui potiki"],
        shouts: [("fish up the islands", 0), ("fish up an island", 0), ("haul up the island", 0), ("manaiakalani", 0),
                 ("the magic fishhook", 0), ("hook the island", 0), ("pull up the land", 0),
                 ("lasso the sun", 1), ("slow the sun", 1), ("snare the sun", 1), ("catch the sun", 1),
                 ("become a hawk", 2), ("maui's hawk", 2),
                 ("hook swing", 3), ("maui hook swing", 3),
                 ("steal fire", 4), ("fire of mahuika", 4), ("mahuika's fire", 4),
                 ("jawbone of muri", 5), ("muri's jawbone", 5), ("beat the sun", 5),
                 ("push up the sky", 6), ("raise the sky", 6), ("lift the sky", 6),
                 ("hook grapple", 7), ("maui grapple", 7)],
        moves: [
            // The hook bites the land and hauls a chunk of it to your feet — anyone in its way is
            // swept along. Hook a person and they're hauled in instead. -> ends with cover at your feet.
            (name: "fish up the islands", tags: [Ultimate], cooldown: 9.0, cost: 8.0, ops: [
                Haul(range: 55.0, radius: 3.4, speed: 24.0, damage: 14.0),
            ], juice: Some((title: Some("MANAIAKALANI"), boom: true, punch: 4.0, shake: 0.3, color: Some((0.3, 0.75, 0.7))))),
            // The rope lasso flies at the aimed foe: caught, they're slowed like the sun he snared,
            // and tied to you. -> ends with them slow and roped.
            (name: "lasso the sun", tags: [Combo], cooldown: 7.0, cost: 5.0, ops: [
                Hook(range: 30.0, speed: 38.0, damage: 4.0, status: Some(Chill), secs: 3.0),
                Link(range: 30.0),
            ], juice: Some((title: Some("SLOW THE SUN"), color: Some((1.0, 0.8, 0.35))))),
            // A hawk: up and gliding. -> ends airborne.
            (name: "hawk form", tags: [Movement], cooldown: 5.0, cost: 4.0, ops: [
                Impulse(fwd: 18.0, up: 16.0),
                SelfStatus(status: Float, secs: 1.5),
            ], juice: Some((title: Some("HAWK")))),
            // The great hook swung. -> ends in place.
            (name: "hook swing", tags: [Primary], cooldown: 0.9, cost: 3.0, ops: [
                Shove(range: 4.5, angle: 90.0, damage: 13.0, knockback: 16.0, up: 0.2),
            ]),
            // Fire stolen from the fingernails of Mahuika.
            (name: "steal fire", cooldown: 1.2, cost: 3.0, ops: [
                Cast(recipe: (name: "fire of mahuika", form: Ball, mech: [Fast, Explodes], element: Fire, scale: 0.5, count: 2)),
            ]),
            // His grandmother's jawbone: the club he beat the sun with.
            (name: "jawbone of muri", cooldown: 3.0, cost: 4.0, ops: [
                Shove(range: 3.4, angle: 50.0, damage: 14.0, knockback: 12.0),
                Afflict(range: 4.0, cone: 30.0, status: Some(Stun), secs: 0.4),
            ]),
            // He pushed the sky up off the earth: everything around you is thrown upward.
