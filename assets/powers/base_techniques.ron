            ], juice: Some((title: Some("KAMEHAMEHA"), punch: 4.0, boom: true))),
        ],
        tiers: [
            (name: "Mastered Ultra Instinct",
             names: ["mastered ultra instinct", "ultra instinct mastered", "perfected ultra instinct", "true ultra instinct",
                     "complete ultra instinct", "mastered ui", "mui"],
             effects: [AutoDodge(chance: 0.7, cooldown: 1.0), PowerMult(damage: 1.2, speed: 1.25, knockback: 1.15, cooldown: 0.85)],
             ascend: Some((color: Some((0.95, 0.96, 1.0)), intensity: 2.0, title: Some("MASTERED ULTRA INSTINCT"), style: Calm,
