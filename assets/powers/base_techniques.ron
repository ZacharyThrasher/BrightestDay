        // everything away. Purple ERASES. "gojo <move>" (anime_modern.ron) is the kit version.
        fx: "cursed",
        shouts: [("lapse blue", 0), ("cursed technique lapse blue", 0), ("blue lapse", 0), ("hollow purple", 1),
