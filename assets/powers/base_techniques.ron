// Techniques (kind: Technique): Dragon Ball, Naruto, Jujutsu Kaisen, Bleach, Hunter x Hunter, haki.
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
[
    // ================================================================ TECHNIQUES (kind: Technique)
    // Trained techniques / forms: SAY the name and it is yours until KO (no pickup). Tiers are
    // picked by phrase ("super saiyan blue", "kaioken times ten"); a held technique said again
    // becomes the active power. `effects` are the generic power effects (src/powers/effects.rs);
    // `ascend` is the one transformation moment (presentation only). Moves: G tap, G hold, and
    // slots 2 / 3 by their shouts.

    // ---------------------------------------------------------------- DRAGON BALL
    (
        id: "ultra_instinct",
        name: "Ultra Instinct",
        kind: Technique,
        names: ["ultra instinct", "ultra instinct sign", "migatte no gokui", "migatte no kizashi", "autonomous ultra instinct",
                "ultra instincts", "ultra instinkt", "ultra-instinct", "ultra instinct omen", "the ultra instinct"],
        // The body moves on its own: incoming attacks may be dodged automatically (dodge i-frames).
        effects: [AutoDodge(chance: 0.45, cooldown: 1.6), PowerMult(speed: 1.12)],
        body: (moves: (accel: 1.35, air_control: 1.3)),
        ascend: Some((color: Some((0.86, 0.9, 1.0)), intensity: 1.3, title: Some("ULTRA INSTINCT"), style: Calm,
                      hair_tint: Some((0.82, 0.84, 0.92)), eye_glow: Some((0.85, 0.9, 1.0)), quiet: true)),
        shouts: [("silver dash", 0), ("ultra instinct kamehameha", 1), ("ui kamehameha", 1)],
        moves: [
            (name: "silver dash", cooldown: 1.2, cost: 5.0, ops: [
                Blink(dist: 10.0, afterimage: true),
                Shove(range: 3.0, angle: 55.0, damage: 9.0, knockback: 12.0),
