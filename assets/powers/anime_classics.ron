// SHONEN CLASSICS — character kits + techniques: Naruto / Boruto, Dragon Ball (Z / Super / GT), One
// Piece, Bleach, JoJo's Bizarre Adventure (CONTENT: SHONEN CLASSICS worker; docs/toolbox/BRIEF.md).
//
// Kits (`kind: Kit`): "<character> <move word>" fires that move ("naruto rasengan", "zoro asura",
// "goku ultimate"); the bare name stays the costume summon. A kit move's `shouts` are GLOBAL borrowed
// phrases ("rasengan" alone fires Naruto's Rasengan for anyone); a famous move that already lives on
// a held power (a fruit, a stand, a technique tier) keeps its global shout there and the kit only
// names it (kit-scoped: "luffy pistol", "dio za warudo").
//
// Every headline move is a real mechanic, not a reskinned projectile: Rasengan is a palm-held orb you
// DRIVE into someone (Drill: latch, grind, spin-away); Chidori pierces (Drill, no grind); Flying
// Thunder God marks then teleports (MarkRecall); Instant Transmission locks onto the enemy you look
// at (WarpTo); Kamui phases you and swallows what you aim at (Phase + Banish); Amaterasu is a brand
// that never goes out and jumps to whoever stands close (Contagion); Tsukuyomi / Solar Flare only
// catch people LOOKING at you (GazeStun); Getsuga Tensho / Destructo Disc / 360 Pound Phoenix are
// travelling crescents (Wave) that pass through players and cut terrain; ORA / MUDA / DORA are the
// stand stepping out and rushing (Rush); Bites the Dust rewinds you (Rewind); King Crimson skips time
// (Phase + Blink); Gold Experience Requiem returns everything to zero (Counter + Deflect).
// Chain endings are noted per move ("ends:").
[
    // ============================================================================ NARUTO
    (
        id: "kit_naruto",
        name: "Naruto Uzumaki",
        kind: Kit,
        names: ["naruto", "naruto uzumaki", "uzumaki naruto", "naruto uzamaki", "naruto uzumacki", "naruto uzimaki", "naruto uzamacki",
                "narutos", "narooto", "naru to", "seventh hokage", "the seventh hokage", "nanadaime hokage", "hokage naruto",
                "knucklehead ninja", "number one knucklehead ninja"],
        fx: "chakra",
        shouts: [("rasengan", 0), ("rasen gan", 0), ("rasengun", 0), ("rasengon", 0), ("rasegan", 0), ("rassengan", 0),
                 ("razengan", 0), ("rasen gun", 0), ("spiraling sphere", 0), ("spiralling sphere", 0), ("rasengan jutsu", 0),
                 ("rasenshuriken", 2), ("rasen shuriken", 2), ("rasenshiriken", 2), ("wind style rasenshuriken", 2), ("futon rasenshuriken", 2),
                 ("wind release rasenshuriken", 2), ("rasen shuriken jutsu", 2), ("rasenshurikan", 2),
                 ("uzumaki barrage", 3), ("naruto uzumaki barrage", 3), ("uzumaki naruto rendan", 3), ("naruto rendan", 3), ("u zu ma ki", 3),
                 ("sexy jutsu", 4), ("oiroke no jutsu", 4), ("harem jutsu", 4), ("sexy no jutsu", 4), ("sexy technique", 4),
                 ("talk no jutsu", 5), ("talk-no-jutsu", 5), ("talk jutsu", 5), ("talkanojutsu", 5), ("talk no justu", 5),
                 ("planetary rasengan", 6), ("wakusei rasengan", 6), ("rasen rengan", 6), ("rasengan barrage", 6),
                 ("baryon mode", 7), ("baryon", 7), ("barion mode", 7)],
        moves: [
            // THE hand-held grinding sphere: a short committed lunge with the orb out; whoever your
            // palm meets is latched, ground against it (you both hang in the air) and spun away.
            // ends: you hover where you hit them, they fly — follow with shadow clones or a dash.
            (name: "rasengan", tags: [Primary], cooldown: 3.5, cost: 6.0, ops: [
                Drill(speed: 17.0, secs: 0.45, grind: 0.5, damage: 16.0, knockback: 30.0, element: Wind, up: 0.35),
            ], fx: "wind", juice: Some((title: Some("RASENGAN"), punch: 3.0, shake: 0.15, color: Some((0.45, 0.72, 1.0))))),
            // Poof: three of you in orange that run at your enemies and brawl.
            (name: "shadow clone", tags: [Combo], cooldown: 6.0, cost: 6.0, ops: [
                Cast(recipe: (name: "naruto", form: Biped, mech: [Walks, Blunt, Charge], scale: 1.0, mass: 60.0, count: 3,
                              temperament: Aggressive, intensity: 0.8)),
            ], fx: "smoke", juice: Some((title: Some("KAGE BUNSHIN NO JUTSU"), ripple: 2.0))),
            // The thrown wind shuriken: it screams through the air and bursts into a dome of cutting
            // wind where it hits (an energy ball: tap to throw it, hold to grow it).
            (name: "rasenshuriken", tags: [Ultimate], cooldown: 14.0, cost: 10.0, ops: [
                Cast(recipe: (name: "rasenshuriken", form: Ball, mech: [Explodes, Spin, Blade, Fast], element: Wind, scale: 1.3),
                     signature: Some(Summon)),
            ], fx: "wind", juice: Some((title: Some("RASENSHURIKEN"), boom: true, punch: 5.0, shake: 0.25, color: Some((0.75, 0.92, 1.0))))),
            // U-ZU-MA-KI: clones kick them skyward in a four-hit chain, then the drop.
            // ends: airborne under them — Rasengan upward.
            (name: "uzumaki barrage", tags: [Combo], cooldown: 5.0, cost: 5.0, ops: [
                Barrage(hits: 4, interval: 0.12, range: 3.2, angle: 60.0, damage: 4.5, knockback: 7.0, advance: 6.0),
                Impulse(fwd: 2.0, up: 9.0),
            ], fx: "smoke", juice: Some((title: Some("UZUMAKI NARUTO RENDAN"), punch: 2.0))),
            // A puff of pink smoke: anyone LOOKING at you is stunned for a beat (look away!).
            (name: "sexy jutsu", tags: [Counter], cooldown: 9.0, cost: 4.0, ops: [
                GazeStun(range: 14.0, cone: 45.0, secs: 0.9, status: Stun),
            ], fx: "smoke", juice: Some((title: Some("OIROKE NO JUTSU"), color: Some((1.0, 0.55, 0.75))))),
            // Talk no jutsu: the aimed enemy can't use a power move for two seconds (they're listening).
            (name: "talk no jutsu", tags: [Counter], cooldown: 12.0, cost: 6.0, ops: [Lockout(range: 18.0, secs: 2.0)],
             juice: Some((title: Some("TALK NO JUTSU"), color: Some((1.0, 0.7, 0.25))))),
            // Planetary Rasengan: four orbs orbiting a big one — the long grind.
            (name: "planetary rasengan", tags: [Ultimate], cooldown: 12.0, cost: 10.0, ops: [
                Drill(speed: 14.0, secs: 0.55, grind: 0.85, damage: 26.0, knockback: 42.0, element: Wind, up: 0.45),
            ], fx: "wind", juice: Some((title: Some("PLANETARY RASENGAN"), punch: 5.0, shake: 0.3, boom: true, color: Some((0.5, 0.75, 1.0))))),
            // Baryon Mode: burn your own life for a few seconds of absurd hits (it costs you %).
            (name: "baryon mode", tags: [Ultimate], cooldown: 25.0, cost: 12.0, ops: [
                Empower(secs: 6.0, damage: 1.7, armor: 0.7, contact: 8.0, contact_kb: 16.0, contact_cd: 0.5),
                Strain(pct: 18.0),
            ], fx: "fire", juice: Some((title: Some("BARYON MODE"), boom: true, punch: 4.0, color: Some((1.0, 0.45, 0.2))))),
        ],
    ),
