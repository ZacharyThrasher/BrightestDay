// DC: Superman, the Flash, Wonder Woman, Aquaman, Martian Manhunter, Shazam, Batman, the emotional spectrum.
// Schema + authoring rules: assets/powers/README.md. A plain RON list; files load in filename order.
[
    // ---------------------------------------------------------------- DC / Invincible / superhero IP
    // ================================================================ SUPERMAN — Kryptonian under a yellow sun
    (
        id: "kryptonian",
        name: "Kryptonian Powers",
        kind: Origin,
        pickup: Some((name: "kryptonian crystal", form: Boulder, element: Light, scale: 0.45)),
        names: ["kryptonian", "yellow sun", "kryptonian powers", "yellow sun powers", "power of the yellow sun",
                "son of krypton", "daughter of krypton", "house of el", "powers of krypton"],
        // Flight (capped 17), fire/ice shrug, kryptonite (Poison) drains the power.
        body: (moves: (thrust: 28.0, thrust_max: 17.0, gravity: 0.85, jump: 1.2), immune: [Fire, Ice], weak: [Poison]),
        // Super-strength: everything you make hits like a truck (launches through buildings, §1a).
        graft: Some((mechanics: [Heavy])),
        incantations: ["up up and away"],
        delivery: (add: [Fast, Heavy], remove: [DropFromSky], from_fist: true),
        shouts: [],
        moves: [
            // A scorching line along your gaze: carves terrain, hits whoever stands in it.
            (name: "heat vision", fx: "gaze", cooldown: 2.0, cost: 8.0, ops: [Carve(length: 26.0, radius: 0.7, damage: 12.0)]),
            // Freeze breath: an Ice cone that shoves hard.
            (name: "super breath", cooldown: 4.0, cost: 10.0, ops: [
                Shove(range: 8.0, angle: 40.0, damage: 4.0, knockback: 22.0, element: Ice, up: 0.3),
            ]),
        ],
    ),
    // ================================================================ THE FLASH — the Speed Force
    (
        id: "speed_force",
        name: "The Speed Force",
        kind: Origin,
        // PRESENTATION: yellow lightning streaks + afterimages.
        fx: "speedforce",
        pickup: Some((name: "speed force spark", form: Ball, element: Electric, scale: 0.4)),
        names: ["speed force", "the speed force", "speed force powers", "speedster powers", "fastest man alive",
                "scarlet speedster"],
        // A Fast body (run/accel), not flight; lightning doesn't hurt a speedster.
        body: (moves: (speed: 1.3, accel: 1.6, air_control: 1.25), immune: [Electric]),
        graft: Some((mechanics: [Fast], element: Some(Electric))),
        shouts: [("blitz", 0), ("speed blitz", 0)],
        moves: [
            // Blink dash with an afterimage, then a crackling hit where you land.
            (name: "speed blitz", cooldown: 1.4, cost: 6.0, ops: [
                Blink(dist: 15.0, afterimage: true),
                Shove(range: 3.2, angle: 60.0, damage: 8.0, knockback: 12.0, element: Electric),
            ]),
            (name: "lightning throw", cooldown: 1.5, ops: [
                Cast(recipe: (name: "thrown lightning", form: Ball, mech: [Fast, Pierce], element: Electric, scale: 0.6, mass: 5.0)),
            ]),
        ],
    ),
    // ================================================================ WONDER WOMAN — Amazon of Themyscira
    (
        id: "amazon",
        name: "Gifts of the Amazons",
        kind: Origin,
        fx: "holy",
        pickup: Some((name: "amazon bracelet", form: Ball, element: Light, scale: 0.35)),
        names: ["amazon", "amazonian", "amazon warrior", "themysciran", "daughter of themyscira", "gifts of the gods",
                "amazonian strength", "amazon powers"],
        body: (moves: (jump: 1.15, speed: 1.05)),
        // Bracelets: everything you make also blocks / reflects (Guard).
        graft: Some((mechanics: [Guard])),
        incantations: ["great hera", "by hera"],
        delivery: (add: [Guard, Returning]),
        shouts: [("lasso", 0), ("bracelets", 1), ("bracelets up", 1), ("submission", 1)],
        moves: [
            // The lasso: chain the aimed player to you.
            // The lasso: a travelling golden line that ropes them in (a stun beat when it catches).
            (name: "lasso of truth", cooldown: 2.5, cost: 5.0, ops: [
                Hook(range: 26.0, speed: 45.0, pull: 1.0, damage: 3.0, status: Some(Stun), secs: 0.4),
            ], juice: Some((title: Some("LASSO OF TRUTH"), color: Some((1.0, 0.8, 0.2))))),
            // Bracelets of Submission: a held Guard (perfect-parry reflects bullets and beams).
            (name: "bracelets of submission", cooldown: 2.0, ops: [
                Cast(recipe: (name: "bracelets of submission", form: Shield, mech: [Guard, Bounce], scale: 0.8, mass: 10.0)),
            ]),
        ],
    ),
    // ================================================================ AQUAMAN — Atlantean
    (
        id: "atlantean",
        name: "Atlantean Blood",
        kind: Origin,
        fx: "water",
        pickup: Some((name: "atlantean pearl", form: Ball, element: Light, scale: 0.4)),
        names: ["atlantean", "atlantean blood", "atlantean powers", "king of the seven seas", "king of atlantis",
                "lord of the seas"],
        body: (immune: [Water], moves: (speed: 1.05)),
        graft: Some((element: Some(Water))),
        // A loyal shark circles you (a stand-style companion: Protective; hits on it are hits on you).
        companion: Some((recipe: (name: "loyal shark", form: Fish, mech: [Flies, Charge, Grab], element: Water, scale: 2.0, mass: 90.0), rush_damage: 3.0, rush_knockback: 4.0)),
        shouts: [("sharks", 0), ("summon sharks", 0), ("shark attack", 0), ("tidal wave", 1), ("the sea obeys", 1)],
        moves: [
            (name: "summon sharks", cooldown: 6.0, ops: [
                Cast(recipe: (name: "shark swarm", form: Fish, mech: [Swarm, Charge, Grab], element: Water, scale: 1.6, mass: 60.0, count: 4, temperament: Aggressive, intensity: 0.9)),
            ]),
            (name: "tidal wave", cooldown: 4.0, cost: 10.0, ops: [
                Shove(range: 9.0, angle: 70.0, damage: 6.0, knockback: 20.0, element: Water, up: 0.4),
            ]),
        ],
    ),
    // ================================================================ MARTIAN MANHUNTER — Martian
    (
        id: "martian",
        name: "Martian Physiology",
        kind: Origin,
        fx: "psychic",
        pickup: Some((name: "martian orb", form: Ball, element: Psychic, scale: 0.4)),
        names: ["martian", "green martian", "martian powers", "martian physiology", "son of mars", "martian shapeshifting"],
        // Flies (capped) - and the classic weakness: fire drains the power. No phasing, no invisibility.
        body: (moves: (thrust: 22.0, thrust_max: 15.0, gravity: 0.8), weak: [Fire]),
        graft: Some((element: Some(Psychic))),
        shouts: [("martian vision", 0), ("density shift", 1), ("martian form", 1), ("shapeshift", 1)],
        moves: [
            // A narrow Psychic blast: whoever it hits floats (juggle window) - never mind control.
            (name: "martian vision", cooldown: 1.6, cost: 6.0, ops: [
                Shove(range: 11.0, angle: 10.0, damage: 10.0, knockback: 10.0, element: Psychic, up: 0.5),
            ]),
            (name: "density shift", cooldown: 2.0, ops: [Transform]),
        ],
        // Grown, dense war-form: heavier, slower, everything you make grows what it hits.
        transform: Some((ascend: Some((color: Some((0.30, 0.90, 0.40)), intensity: 1.0)), 
            costume: "martian_war_form",
            body: (moves: (speed: 0.9, jump: 1.1, thrust: 20.0, thrust_max: 13.0, gravity: 0.9), weak: [Fire]),
            graft: Some((mechanics: [Heavy, Grow])),
        )),
    ),
    // ================================================================ SHAZAM — say the word
    (
        id: "shazam",
        name: "The Power of Shazam",
        kind: Origin,
        fx: "lightning",
        pickup: Some((name: "magic lightning bolt", form: Ball, element: Electric, scale: 0.4)),
        names: ["shazam", "power of shazam", "the power of shazam", "shazam powers", "champion of shazam",
                "rock of eternity", "wisdom of solomon"],
        // "shazam <phrase>": whatever you say arrives on a bolt of magic lightning.
        incantations: ["shazam"],
        delivery: (element: Some(Electric), add: [Explodes]),
        // Saying SHAZAM! (alone) toggles the transformation - with a lightning strike on yourself, both ways.
        shouts: [("magic lightning", 0), ("lightning strike", 0), ("shazam", 1)],
        moves: [
            (name: "magic lightning", cooldown: 4.0, ops: [
                Cast(recipe: (name: "magic lightning", form: Pillar, mech: [DropFromSky, Explodes, Beam], element: Electric, scale: 6.0)),
            ]),
            (name: "shazam", cooldown: 2.0, ops: [
                Explode(radius: 3.5, damage: 10.0, knockback: 14.0, element: Electric),
                Transform,
            ]),
        ],
        transform: Some((ascend: Some((color: Some((1.00, 0.88, 0.30)), intensity: 1.6, stable: false)), 
            costume: "captain_marvel",
            body: (moves: (thrust: 26.0, thrust_max: 17.0, gravity: 0.8, jump: 1.25, speed: 1.1), immune: [Electric]),
            graft: Some((mechanics: [Blunt], element: Some(Electric))),
        )),
    ),
    // ================================================================ BATMAN — bat-tech / the utility belt
    (
        id: "bat_tech",
        name: "Bat-Tech",
        kind: Origin,
        fx: "shadow",
        pickup: Some((name: "utility belt", form: Boulder, element: Shadow, scale: 0.4)),
        names: ["bat-tech", "utility belt", "the utility belt", "wayne tech", "wayne enterprises tech",
                "batman's gadgets", "bat gadgets"],
        // Cape glide + tight air control. No powers - just prep time.
        body: (moves: (glide: 0.55, air_control: 1.2)),
        // Every gadget banks off walls (Ricochet): the detective's angles.
        graft: Some((mechanics: [Ricochet])),
        shouts: [("grapple", 0), ("grappling hook", 0), ("grapple gun", 0), ("smoke", 1), ("smoke bomb", 1)],
        moves: [
            // The grapple gun: a tether-reel to whatever you aim at.
            (name: "grapple gun", fx: "cable", cooldown: 1.2, cost: 3.0, ops: [Reel(range: 45.0, speed: 32.0)]),
            // Smoke pellet + backflip: a Shadow burst (vision only) and you're gone.
            (name: "smoke pellet", cooldown: 5.0, cost: 6.0, ops: [
                Explode(radius: 5.5, damage: 1.0, knockback: 3.0, element: Shadow),
                Impulse(fwd: -10.0, up: 7.0),
            ]),
        ],
    ),
