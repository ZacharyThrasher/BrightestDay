        key: "E minor pentatonic",
        steps: ["E5", "G5", "A5", "B5", "D6->E6"],
        corps: {
            "willpower": "ko_streak_willpower", // clean bright bell-synth
            "rage": "ko_streak_rage", // distorted growling saw
            "greed": "ko_streak_greed", // metallic coin chimes
            "fear": "ko_streak_fear", // eerie detuned glass
            "hope": "ko_streak_hope", // airy choir pad
            "compassion": "ko_streak_compassion", // soft mallet chime
            "love": "ko_streak_love", // warm FM harp
            "life": "ko_streak_life", // pure sine choir
        },
        accents: { "void": "ko_accent_void", "double": "ko_accent_double", "shutdown": "ko_streak_end" },
    ),
)
