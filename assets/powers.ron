                     "gear fifth nika", "gia fifusu"],
             // Toon physics: absurd, joyful. White hair, white steam, the world is rubber.
             body: Some((bounce: true, immune: [Electric], moves: (jump: 1.6, gravity: 0.6, air_control: 1.6, speed: 1.1))),
             graft: Some((mechanics: [Bounce, Grow])),
             effects: [PowerMult(damage: 1.3, knockback: 1.6), SelfDrain(willpower_per_s: 1.2)],
             incantations: ["gomu gomu no"],
             delivery: Some((add: [Grow, Bounce, Returning], remove: [DropFromSky], scale_mult: 1.8, from_fist: true, arm: true)),
             ascend: Some((color: Some((1.0, 1.0, 1.0)), intensity: 2.2, title: Some("GEAR FIFTH"), style: Steam,
                           hair_tint: Some((1.0, 1.0, 1.0)), eye_glow: Some((1.0, 0.85, 0.3)), music: Some("drums"), toon: true)),
             shouts: [("rubber terrain", 0), ("grab the ground", 0), ("rubber ground", 0), ("bajrang gun", 1),
                      ("gomu gomu no bajrang gun", 1), ("dawn whip", 0)],
             moves: [
