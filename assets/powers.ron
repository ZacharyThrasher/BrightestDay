// Player powers (COMBAT.md §5h) — ONE template for every iconic power system.
// Owned by bd_sim (src/powers). Each entry: id, name, kind, names (lexicon), body, graft,
// incantations + delivery, shouts (whole phrases → move slot), moves (≤ 2: G tap, G hold),
// transform, companion, pickup (the look of a fruit / origin pickup). kind: Paramecia | Logia | Zoan |
// MythicalZoan (devil fruits) | Stand (JoJo) | Origin (superhero origin kits) | Technique (say it: yours until KO). Every value is
// closed-set data; moves are lists of MoveOps that map onto existing world operations (Cast,
// Impulse, Blink, Reel, Shove, Field, Room, Swap, Portal, Link, Explode, Carve, TimeStop, Restore, Transform, SelfStatus, Weigh, SlamOnLand).
// The lexicon scans id / name / names / incantations / kind / companion (bd_lexicon/src/powers.rs).
// Shared tuning (fruit cost, drain secs, rush tokens…) is PowerRules in src/powers/data.rs.
// Keep this file a plain list: the lexicon splits entries at the first bracket.
[
    // ================================================================ ONE PIECE — devil fruits
    (
        id: "gomu_gomu",
        name: "Gomu Gomu no Mi",
        kind: Paramecia,
        names: ["gomu gomu no mi", "gum gum fruit", "gum-gum fruit", "rubber fruit", "luffy's fruit"],
        body: (bounce: true, immune: [Electric], moves: (jump: 1.1)),
        incantations: ["gomu gomu no", "gum gum", "gum-gum"],
        delivery: (add: [Returning, Bounce], remove: [DropFromSky], from_fist: true, arm: true),
        shouts: [("gomu gomu no pistol", 0), ("gum gum pistol", 0), ("gomu gomu no rocket", 1), ("gum gum rocket", 1)],
        moves: [
            (name: "pistol", cooldown: 0.5, ops: [
                Cast(recipe: (name: "gum-gum pistol", form: Ball, mech: [Returning, Blunt, Fast], scale: 0.6, mass: 25.0)),
            ]),
            // Stretch to an anchor and yank yourself there: a movement move.
            (name: "rocket", cooldown: 1.2, cost: 4.0, ops: [Reel(range: 40.0, speed: 34.0)]),
        ],
        // Luffy's gears: tiers of the rubber fruit, picked by saying them ("gear second"…"gear fifth");
        // "gum gum fruit" said again (or the G-hold Transform) drops back to base.
        tiers: [
            (name: "Gear Second",
             names: ["gear second", "gear 2", "gear two", "second gear", "gia sekando", "gear seconds", "gear secondo"],
             body: Some((bounce: true, immune: [Electric], moves: (jump: 1.1, accel: 1.5))),
             // Steam and speed: much faster, much quicker moves, JET prefixes.
             effects: [PowerMult(damage: 1.2, speed: 1.3, knockback: 1.1, cooldown: 0.6), SelfDrain(willpower_per_s: 0.4)],
             incantations: ["gomu gomu no jet", "gum gum jet", "jet"],
             delivery: Some((add: [Returning, Bounce, Fast, Pierce], remove: [DropFromSky], from_fist: true, arm: true)),
             ascend: Some((color: Some((1.0, 0.82, 0.86)), intensity: 1.2, title: Some("GEAR SECOND"), style: Steam,
                           skin_tint: Some((1.0, 0.55, 0.6)))),
             shouts: [("jet pistol", 0), ("gomu gomu no jet pistol", 0), ("gum gum jet pistol", 0),
                      ("jet gatling", 1), ("gomu gomu no jet gatling", 1), ("gum gum jet gatling", 1)],
             moves: [
                 (name: "jet pistol", cooldown: 0.35, ops: [
                     Cast(recipe: (name: "jet pistol", form: Ball, mech: [Returning, Blunt, Fast, Pierce], scale: 0.6, mass: 25.0)),
                 ], juice: Some((punch: 1.5))),
                 (name: "jet gatling", cooldown: 2.0, cost: 4.0, ops: [
                     Cast(recipe: (name: "jet gatling", form: Ball, mech: [Returning, Blunt, Fast, Swarm], scale: 0.5, count: 6)),
                 ], juice: Some((title: Some("JET GATLING"), shake: 0.1))),
             ]),
            (name: "Gear Third",
             names: ["gear third", "gear 3", "gear three", "third gear", "gia sado", "gear thirds"],
             body: Some((bounce: true, immune: [Electric], moves: (jump: 1.05))),
             // Bone balloon: giant inflated limbs for the big hits.
             effects: [PowerMult(damage: 1.35, speed: 0.95, knockback: 1.45)],
             incantations: ["gomu gomu no giant", "gum gum giant", "gomu gomu no gigant", "gigant"],
             delivery: Some((add: [Returning, Bounce, Grow, Heavy], remove: [DropFromSky], scale_mult: 2.2, from_fist: true, arm: true)),
             ascend: Some((color: Some((1.0, 0.92, 0.88)), intensity: 1.1, title: Some("GEAR THIRD"), style: Steam)),
             shouts: [("elephant gun", 0), ("gomu gomu no elephant gun", 0), ("gum gum elephant gun", 0), ("giant pistol", 0),
                      ("giant stamp", 1), ("gomu gomu no giant stamp", 1), ("gum gum giant stamp", 1)],
             moves: [
                 (name: "elephant gun", cooldown: 3.0, cost: 6.0, ops: [
                     Cast(recipe: (name: "elephant gun", form: Ball, mech: [Returning, Blunt, Heavy, Grow], scale: 3.0, mass: 400.0)),
                 ], juice: Some((title: Some("ELEPHANT GUN"), punch: 4.0, shake: 0.2))),
                 (name: "giant stamp", cooldown: 4.0, cost: 6.0, ops: [
                     Impulse(fwd: 4.0, up: 12.0),
                     SlamOnLand(radius: 6.0, damage: 16.0, knockback: 26.0, carve: 3.0),
                 ], juice: Some((title: Some("GIANT STAMP")))),
             ]),
            (name: "Gear Fourth",
             names: ["gear fourth", "gear 4", "gear four", "fourth gear", "boundman", "bound man", "bounce man", "gia fosu",
                     "gear fourth boundman"],
             // Bounce-man: springy everything, heavy haki-coated rubber. Two extra (boing) air jumps.
             body: Some((bounce: true, immune: [Electric], moves: (jump: 1.35, gravity: 0.8, air_control: 1.5))),
             effects: [PowerMult(damage: 1.4, speed: 1.15, knockback: 1.4), SelfDrain(willpower_per_s: 1.5), AirJumps(extra: 2)],
             graft: Some((mechanics: [Bounce, Heavy])),
             ascend: Some((color: Some((0.95, 0.3, 0.25)), intensity: 1.7, title: Some("GEAR FOURTH"), style: Steam, stable: false,
