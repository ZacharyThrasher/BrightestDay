    // ================================================================ TMNT — mutagen (Zoan-style mutation)
    // Eating the ooze (a Zoan-kind "fruit": expensive, grabbable, a second dose explodes you) mutates you
    // into an animal hybrid. "mutagen" / "the ooze" gives the classic outcome (turtle); the animal-named
    // doses give the others. Retro-mutagen (assets/icons/tmnt.ron) is a Water splash: it drains the
    // mutation for a few seconds like any Water hit.
    (
        id: "mutagen_turtle",
        name: "Mutagen",
        kind: Zoan,
        names: ["turtle mutagen", "secret of the ooze", "tcri ooze"],
        incantations: ["turtle power", "cowabunga"],
        // "cowabunga <anything>": it comes out shell-guarded and bouncy.
        delivery: (add: [Guard, Bounce]),
        shouts: [("cowabunga", 0), ("shell slide", 0), ("turtle power", 1), ("heroes in a half shell", 1)],
        moves: [
            (name: "shell slide", cooldown: 1.6, cost: 5.0, ops: [
                Impulse(fwd: 20.0, up: 2.0),
                Shove(range: 3.0, angle: 50.0, damage: 10.0, knockback: 14.0),
            ]),
            (name: "turtle form", cooldown: 1.5, ops: [Transform]),
        ],
        // Ninja turtle hybrid: nimble, and every cast carries the shell (Guard).
        transform: Some((
            costume: "ninja turtle",
            body: (moves: (accel: 1.15, air_control: 1.2, jump: 1.1)),
            graft: Some((mechanics: [Guard])),
        )),
    ),
