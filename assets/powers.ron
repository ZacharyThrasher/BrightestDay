             shouts: [("kong gun", 0), ("gomu gomu no kong gun", 0), ("gum gum kong gun", 0),
                      ("king kong gun", 1), ("gomu gomu no king kong gun", 1), ("gum gum king kong gun", 1)],
             moves: [
                 (name: "kong gun", cooldown: 2.5, cost: 6.0, ops: [
