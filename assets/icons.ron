// Brightest Day — curated pop-culture icons (base set; loaded first, so these names win over
// assets/icons/*.ron domain packs). Schema: docs/ICONS_SCHEMA.md — a RON list of
//   IconEntry(names: [lowercase aliases, first = canonical id], recipe: <bd_core Recipe>,
//             shape: Some(<bd_core ShapeSpec>) | None, source: "franchise/credit")
// Shape units are construct voxels (0.25 m); origin = grip for held items (item extends along -Z),
// feet-centre for creatures/structures; +Y up, -Z forward. Tints: Primary (corps colour), Accent,
// Dark, Core (glow). Creature limbs are Parts with roles (Head/Jaw/Tail/Leg*/Arm*/Wing*) so generic
// animation can drive them. Only names are taken from the IPs (no copyrighted text).
// Validate: cargo run --manifest-path tools/iconcheck/Cargo.toml -- assets/icons.ron
[
    // ===================================================================== items, weapons, gadgets
    // 1 ------------------------------------------------------------------------------------------
    IconEntry(
        names: ["mjolnir", "thor's hammer", "hammer of thor", "mjollnir", "mjölnir", "thors hammer"],
        recipe: (
            name: "Mjolnir",
            form: Hammer,
            mechanics: [Blunt, Returning, Heavy],
            element: Electric,
            scale: 0.9,
            mass: 40.0,
            count: 1,
            accent: Some((0.75, 0.75, 0.8)),
            model: Icon("mjolnir"),
        ),
        shape: Some((
            prims: [
                // leather-wrapped handle
                (kind: Cylinder, center: (0.0, 0.0, -1.0), size: (1.0, 3.2, 1.0), rot_deg: (90.0, 0.0, 0.0), tint: Dark),
                // pommel
                (kind: Box, center: (0.0, 0.0, 1.0), size: (1.4, 1.4, 1.0), tint: Accent),
                // wrist strap loop (ring in the YZ plane)
                (kind: Cylinder, center: (0.0, -1.0, 2.5), size: (3.0, 1.0, 3.0), rot_deg: (0.0, 0.0, 90.0), tint: Dark),
                (kind: Cylinder, center: (0.0, -1.0, 2.5), size: (1.2, 3.0, 1.2), rot_deg: (0.0, 0.0, 90.0), subtract: true),
                // blocky head, long axis across X
                (kind: Box, center: (0.0, 0.0, -4.0), size: (5.0, 3.4, 3.4), tint: Primary),
                // end faces
                (kind: Box, center: (-2.0, 0.0, -4.0), size: (1.2, 3.6, 3.6), tint: Accent),
                (kind: Box, center: (2.0, 0.0, -4.0), size: (1.2, 3.6, 3.6), tint: Accent),
                // collar where the handle meets the head
                (kind: Box, center: (0.0, 0.0, -2.0), size: (1.4, 1.4, 1.0), tint: Accent),
            ],
        )),
        source: "Marvel (Thor)",
    ),
    // 2 ------------------------------------------------------------------------------------------
    IconEntry(
        names: ["stormbreaker", "storm breaker", "stormbreaker axe", "thor's axe", "thors axe"],
        recipe: (
