                (kind: Cylinder, center: (0.0, 0.0, -2.0), size: (1.0, 5.4, 1.0), rot_deg: (90.0, 0.0, 0.0), tint: Dark),
                (kind: Box, center: (0.0, 0.0, 1.0), size: (1.0, 1.0, 1.0), tint: Accent),
                // collar
                (kind: Box, center: (0.0, 0.0, -4.0), size: (3.0, 3.0, 3.0), tint: Accent),
                // axe blade (flat in the XZ plane) with a bright cutting edge
                (kind: Box, center: (3.0, 0.0, -4.0), size: (3.0, 1.0, 3.0), tint: Primary),
                (kind: Box, center: (4.0, 0.0, -4.0), size: (1.0, 1.0, 5.0), tint: Core),
                // hammer back
                (kind: Box, center: (-3.0, 0.0, -4.0), size: (3.0, 3.0, 3.0), tint: Primary),
                // spike on top of the head
                (kind: Cone, center: (0.0, 0.0, -6.5), size: (1.4, 2.0, 1.4), rot_deg: (-90.0, 0.0, 0.0), tint: Accent),
            ],
        )),
        source: "Marvel (Thor)",
    ),
