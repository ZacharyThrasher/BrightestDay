// Party effects (COMBAT.md §5g). Behaviour, never numbers: each effect is a standing graft merged
// into every recipe its owner casts (the composition engine does the rest) and/or a hook from the
// closed set in crates/bd_sim/src/party/effects.rs (Hook).
//
// Fields: id (stable key), name, rarity (Common | Legendary | Cursed), desc (<= 6 words, pick card),
// graft (mechanics, element, temperament, features, only: [form categories], count, scale_mult,
// forbid_temperament), hooks.
// Order matters only for the wire (effects are referenced by index): append new effects at the end
// of their block, never reorder a shipped file mid-season.
[
    // ------------------------------------------------------------------ common
    (id: "bouncy_castle", name: "Bouncy Castle", rarity: Common, desc: "Everything you build bounces",
        graft: (mechanics: [Bounce])),
    (id: "clingy", name: "Clingy", rarity: Common, desc: "Your throwables stick to things",
        graft: (mechanics: [Sticky], only: [Object, Held])),
    (id: "heat_seekers", name: "Heat Seekers", rarity: Common, desc: "Everything hunts your target",
        graft: (mechanics: [Homing])),
    (id: "spicy", name: "Spicy", rarity: Common, desc: "Fire on everything",
        graft: (element: Some(Fire))),
    (id: "shocking", name: "Shocking", rarity: Common, desc: "Everything crackles with lightning",
        graft: (element: Some(Electric))),
    (id: "party_popper", name: "Party Popper", rarity: Common, desc: "Shattered constructs burst into confetti",
        hooks: [Confetti]),
    (id: "mini_me", name: "Mini-Me", rarity: Common, desc: "Every cast brings a tiny twin",
        hooks: [MiniMe]),
    (id: "clown_car", name: "Clown Car", rarity: Common, desc: "Three tiny copies, always",
        graft: (mechanics: [Swarm], count: Some(3), scale_mult: Some(0.5))),
    (id: "growth_spurt", name: "Growth Spurt", rarity: Common, desc: "Your constructs keep growing",
        hooks: [GrowthSpurt(every: 2.0)]),
    (id: "chain_gang", name: "Chain Gang", rarity: Common, desc: "Whatever you hit gets chained",
        graft: (mechanics: [Link])),
    (id: "portal_pals", name: "Portal Pals", rarity: Common, desc: "Broken constructs leave portals",
        hooks: [PortalPair]),
    (id: "magnet_brain", name: "Magnet Brain", rarity: Common, desc: "Constructs pull everything in",
        graft: (mechanics: [Attract], only: [Structure, Object, Creature])),
    (id: "rebound", name: "Rebound", rarity: Common, desc: "Everything ricochets",
        graft: (mechanics: [Ricochet])),
    (id: "legs_day", name: "Legs Day", rarity: Common, desc: "Everything grows legs",
        graft: (mechanics: [Walks])),
    (id: "wings_day", name: "Wings Day", rarity: Common, desc: "Everything takes flight",
        graft: (mechanics: [Flies])),
    (id: "boomerang", name: "Boomerang", rarity: Common, desc: "Everything comes back",
        graft: (mechanics: [Returning])),
    (id: "road_rage", name: "Road Rage", rarity: Common, desc: "Every construct charges",
        graft: (mechanics: [Charge])),
    (id: "friendly_fire_ant", name: "Friendly Fire-ant", rarity: Common, desc: "Your constructs are furious",
        graft: (temperament: Some(Aggressive))),
    (id: "frosty", name: "Frosty", rarity: Common, desc: "Everything freezes what it touches",
        graft: (element: Some(Ice))),
    (id: "splash_zone", name: "Splash Zone", rarity: Common, desc: "Everything soaks its victims",
        graft: (element: Some(Water))),
    (id: "gusty", name: "Gusty", rarity: Common, desc: "Everything hits like a gale",
        graft: (element: Some(Wind))),
    (id: "mind_bullets", name: "Mind Bullets", rarity: Common, desc: "Your hits make victims float",
        graft: (element: Some(Psychic))),
    (id: "rock_solid", name: "Rock Solid", rarity: Common, desc: "Everything digs craters",
        graft: (element: Some(Earth))),
    (id: "spin_class", name: "Spin Class", rarity: Common, desc: "Everything spins",
        graft: (mechanics: [Spin])),
    (id: "grabby_hands", name: "Grabby Hands", rarity: Common, desc: "Constructs seize what they touch",
        graft: (mechanics: [Grab])),
    (id: "sky_mail", name: "Sky Mail", rarity: Common, desc: "Throwables drop from the sky",
        graft: (mechanics: [DropFromSky], only: [Object])),
    (id: "pew_pew", name: "Pew Pew", rarity: Common, desc: "Constructs shoot at your target",
        graft: (mechanics: [Shoots], only: [Structure, Object, Creature])),
    (id: "dragon_breath", name: "Dragon Breath", rarity: Common, desc: "Constructs breathe their element",
        graft: (mechanics: [Breath], only: [Structure, Object, Creature])),
    (id: "stompy", name: "Stompy", rarity: Common, desc: "Landings send out shockwaves",
        graft: (mechanics: [Stomp], only: [Structure, Object, Creature])),
    (id: "tail_whip", name: "Tail Whip", rarity: Common, desc: "Everything grows a sweeping tail",
        graft: (mechanics: [ArticulatedTail], only: [Structure, Object, Creature])),
    (id: "tractor_beam", name: "Tractor Beam", rarity: Common, desc: "Constructs yank victims to you",
        graft: (mechanics: [Pull])),
    (id: "force_push", name: "Force Push", rarity: Common, desc: "Constructs shove everything away",
        graft: (mechanics: [Repel], only: [Structure, Object, Creature])),
    (id: "shrink_ray", name: "Shrink Ray", rarity: Common, desc: "Whatever you hit shrinks",
        graft: (mechanics: [Shrink])),
    (id: "kaboom", name: "Kaboom", rarity: Common, desc: "Throwables explode on impact",
        graft: (mechanics: [Explodes], only: [Object])),
    (id: "tripwire", name: "Tripwire", rarity: Common, desc: "Structures snap shut on victims",
        graft: (mechanics: [Trap], only: [Structure])),
    (id: "bodyguards", name: "Bodyguards", rarity: Common, desc: "Your constructs guard you",
        graft: (temperament: Some(Protective))),
    (id: "chaos_goblins", name: "Chaos Goblins", rarity: Common, desc: "Constructs brawl with everything",
        graft: (temperament: Some(Chaotic))),
    (id: "hot_wheels", name: "Hot Wheels", rarity: Common, desc: "Everything rolls on wheels",
        graft: (features: [Wheels, Exhaust])),
    (id: "sneaky_snakes", name: "Sneaky Snakes", rarity: Common, desc: "Constructs flank from behind",
        graft: (temperament: Some(Sneaky))),
    (id: "last_words", name: "Last Words", rarity: Common, desc: "Your KO spot explodes",
        hooks: [LastWords]),
    (id: "popcorn", name: "Popcorn", rarity: Common, desc: "Shots pop into bouncing kernels",
        hooks: [Popcorn]),

    // ------------------------------------------------------------------ legendary (Boom)
    (id: "worthy", name: "Worthy", rarity: Legendary, desc: "Held items return with lightning",
        graft: (mechanics: [Returning], element: Some(Electric), only: [Held])),
    (id: "kaiju_heart", name: "Kaiju Heart", rarity: Legendary, desc: "Creatures grow with every KO",
        hooks: [KaijuHeart]),
    (id: "echo", name: "Echo", rarity: Legendary, desc: "Every cast happens twice",
        hooks: [Echo(delay: 1.0)]),
    (id: "roll_out", name: "Roll Out", rarity: Legendary, desc: "All your constructs transform",
        graft: (mechanics: [Transforms])),
    (id: "main_character", name: "Main Character", rarity: Legendary, desc: "Constructs split before they shatter",
        hooks: [MainCharacter]),
    (id: "copycat", name: "Copycat", rarity: Legendary, desc: "Steal constructs that hit you",
        hooks: [Copycat]),
    (id: "sidekick", name: "Sidekick", rarity: Legendary, desc: "A loyal spirit follows you",
        hooks: [Sidekick]),
    (id: "black_hole_sun", name: "Black Hole Sun", rarity: Legendary, desc: "Broken constructs become black holes",
        hooks: [BlackHole]),

    // ------------------------------------------------------------------ cursed (Bust)
    (id: "butterfingers", name: "Butterfingers", rarity: Cursed, desc: "Held items slip away",
        hooks: [Butterfingers(mean_secs: 9.0)]),
    (id: "pinata", name: "Piñata", rarity: Cursed, desc: "Getting hit spills goodies",
        hooks: [Pinata]),
    (id: "wild_magic", name: "Wild Magic", rarity: Cursed, desc: "Some casts go wild",
        hooks: [WildMagic(chance: 0.25)]),
    (id: "reverse_card", name: "Reverse Card", rarity: Cursed, desc: "Your shots curve back",
        hooks: [ReverseCard(after: 1.0)]),
    (id: "loud", name: "Loud", rarity: Cursed, desc: "Your constructs honk and glow",
        graft: (features: [Bell, Headlight], forbid_temperament: Some(Sneaky)), hooks: [Loud]),
    (id: "slippery", name: "Slippery", rarity: Cursed, desc: "Ice under your feet",
        hooks: [Slippery]),
    (id: "lazy_bones", name: "Lazy Bones", rarity: Cursed, desc: "Your constructs would rather nap",
        graft: (temperament: Some(Lazy))),
    (id: "stage_fright", name: "Stage Fright", rarity: Cursed, desc: "Your constructs keep their distance",
        graft: (temperament: Some(Fearful))),
    (id: "magnetic_personality", name: "Magnetic Personality", rarity: Cursed, desc: "Enemy constructs drift toward you",
        hooks: [MagneticPersonality]),
    (id: "hiccups", name: "Hiccups", rarity: Cursed, desc: "You hop at random",
        hooks: [Hiccups(mean_secs: 7.0)]),
]
