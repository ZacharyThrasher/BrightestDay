    fusion: (
        // what a move IS, by its ops (unknown ops: Projectile if they carry a recipe, else Blast)
        classes: [
            ("Cast", Projectile), ("Seeker", Projectile), ("BounceBeam", Projectile), ("Wave", Projectile), ("Hook", Projectile), ("Haul", Projectile),
            ("Shove", Melee), ("Barrage", Melee), ("Grab", Melee), ("Finisher", Melee), ("Rush", Melee), ("Carve", Melee), ("Ram", Melee),
            ("Drill", Melee), ("Pounce", Melee),
            ("Blink", Movement), ("Impulse", Movement), ("Reel", Movement), ("Leap", Movement), ("BlinkCarry", Movement), ("WarpTo", Movement),
            ("Transpose", Movement), ("MarkRecall", Movement), ("Rewind", Movement), ("PlacePortal", Movement), ("Portal", Movement),
            ("Relocate", Movement), ("PassThrough", Movement), ("Swap", Movement),
            ("Explode", Blast), ("Salvo", Blast), ("SlamOnLand", Blast), ("Erupt", Blast), ("DelayedHit", Blast), ("Surge", Blast), ("TagStrike", Blast),
            ("Field", Field), ("Zone", Field), ("Room", Field), ("Singularity", Field), ("TimeStop", Field),
            ("SelfStatus", Buff), ("Empower", Buff), ("Mend", Buff), ("Evade", Buff), ("Counter", Buff), ("Deflect", Buff), ("Phase", Buff),
            ("SelfResize", Buff), ("Transform", Buff), ("Tier", Buff), ("Strain", Buff), ("Restore", Buff),
            ("Afflict", Control), ("Yank", Control), ("Link", Control), ("Weigh", Control), ("Lockout", Control), ("LockOn", Control),
            ("GazeStun", Control), ("Contagion", Control), ("Disarm", Control), ("Banish", Control), ("Tag", Control), ("CopyLast", Control),
        ],
