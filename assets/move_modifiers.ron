// MOVE MODIFIERS & FUSION (docs/toolbox/COMPOSED_MOVE.md §Modifiers & fusion) — the endless toolbox.
// Vocabulary + numbers only; what they DO is generic code (bd_sim powers/twist): every modifier is a
// transform over ANY move's ops by field role, never a per-move special case.
//
// "giant rasengan", "triple kamehameha", "homing chidori", "ice hollow purple", "rasengan +
// amaterasu", "mini spirit bomb", "black flash but fire", "reverse earthshatter", "rapid fire
// hadouken", "delayed pulse bomb", "chain lightning rocket punch".
//
// A modifier (all fields optional; multipliers default 1, the rest off):
//   n        the WIRE BYTE (1..=255, stable, NEVER reuse one; VERB GRAMMAR's composed specs carry
//            the same bytes: 1 = giant/"big", 2 = quick, 3 = long are their starter ids)
//   id       a name for tests / logs;   kind: Size | Count | Behaviour | Element | Speed | Adverb | Style
//   words    whole-word phrases, lower case (mishearings too: voice == typing)
//   title    the word shown in the move's title ("GIANT RASENGAN")
//   size reach damage knockback speed secs cone arc cooldown   multipliers (by field ROLE, below)
//   count    simultaneous copies (instant area / strike ops fan out in one tick; anything else fires
//            as quick sequential shots)   repeat: sequential shots   interval: s between shots
//   spread   fan degrees   mech: behaviours [Homing, Pierce, Ricochet, Returning, Sticky, Explodes,
//            Spin, Heavy, Fast] (casts gain them; typed conversions give other ops the verb)
//   element  swap (re-skins AND re-flavours: every element field, recipe, elemental status, colour,
//            style)   fx / color: a style key of assets/tuning/move_fx.ron + tint
//   reverse delay linger chain silent invisible      behaviour flags
//   tier     presence-tier bump (price: Tiny 1 / Normal 2 / Big 3 / Titan 5 sparks; never Signature)
//   sparks   extra sparks     punch shake boom: juice added
(
    caps: (
        size_max: 2.5, size_min: 0.35, reach_max: 2.0, damage_max: 2.0, damage_min: 0.3, knock_max: 2.2,
        speed_max: 2.0, speed_min: 0.4, secs_max: 1.5, cone_max: 3.0, arc_max: 3.0,
        cooldown_max: 3.0, cooldown_min: 0.5, count_max: 3, repeat_max: 8,
        copy_damage: 0.75, repeat_falloff: 0.5, tier_bump_max: 2,
        delay_max: 3.0, linger_max: 6.0, chain_max: 4, interval: 0.16, spread: 12.0, bang: 3,
    ),

    // FIELD ROLES: which multiplier scales which number of ANY op (its serialised field name).
    // "Op.field" beats "field". Unlisted numbers are never touched (placements, windows, hold times).
    roles: [
        ("radius", Size), ("width", Size), ("height", Size), ("carve", Size), ("capture", Size), ("grab", Size),
        ("scale", Size), ("mass", Size), ("spread", Size),
        ("range", Reach), ("length", Reach), ("apex", Reach),
        ("Blink.dist", Reach), ("BlinkCarry.dist", Reach), ("Surge.dist", Reach), ("Banish.dist", Reach), ("Leap.range", Reach),
        ("damage", Damage), ("contact", Damage), ("dps", Damage),
        ("knockback", Knock), ("push", Knock), ("finish", Knock), ("contact_kb", Knock), ("launch", Knock), ("wall", Knock),
        ("strength", Knock), ("up", Knock), ("pull", Knock), ("down", Knock),
        ("speed", Speed), ("fwd", Speed), ("lunge", Speed), ("advance", Speed), ("rate", Speed), ("bounce", Speed),
        ("secs", Secs), ("grind", Secs),
        ("cone", Cone), ("angle", Arc),
        ("Salvo.count", Count), ("Barrage.hits", Count), ("Seeker.hits", Count), ("Rush.hits", Count), ("Erupt.count", Count), ("Cast.count", Count),
        // never grown: crowd control stays short, stances stay honest, self-numbers stay put
        ("Afflict.secs", CcSecs), ("GazeStun.secs", CcSecs), ("Lockout.secs", CcSecs), ("Weigh.secs", CcSecs), ("Hook.secs", CcSecs),
        ("Contagion.secs", CcSecs), ("TimeStop.secs", CcSecs), ("Phase.secs", CcSecs), ("Counter.secs", CcSecs), ("Deflect.secs", CcSecs),
        ("Evade.secs", CcSecs), ("LockOn.secs", CcSecs), ("Tag.secs", CcSecs), ("SelfStatus.secs", CcSecs), ("Ram.secs", Fixed),
        ("Pounce.secs", Fixed), ("Drill.secs", Fixed),
        ("TimeStop.speed", Fixed), ("Evade.speed", Fixed), ("Evade.slow", Fixed), ("Empower.damage", Fixed), ("Empower.armor", Fixed),
        ("Finisher.mult", Fixed), ("SelfResize.scale", Fixed), ("Mend.pct", Fixed), ("Strain.pct", Fixed), ("Impulse.up", Fixed),
        ("Singularity.dist", Fixed), ("Explode.dist", Fixed), ("Field.dist", Fixed), ("Zone.dist", Fixed), ("Salvo.dist", Fixed),
        ("Erupt.dist", Fixed), ("WarpTo.behind", Fixed), ("Relocate.back", Fixed), ("Relocate.side", Fixed), ("Relocate.up", Fixed),
    ],

    // Ops that may be copied several times in ONE tick (instant, no per-player state).
    fan: ["Explode", "Shove", "Afflict", "BounceBeam", "Erupt", "Zone", "DelayedHit", "Carve", "Salvo", "Field", "Weigh", "Yank", "TagStrike", "Disarm"],

    fillers: ["it", "its", "it's", "is", "be", "make", "made", "of", "more", "extra", "some", "very", "really", "so", "too", "way", "much",
              "a", "an", "the", "lot", "like", "all", "and", "also", "but", "just", "kind", "sort", "please", "real", "super duper", "totally",
              "now", "this", "time", "that", "one", "go", "in", "on"],
    articles: ["a", "an", "the", "my", "some", "use", "do", "cast", "throw", "shoot", "unleash", "go", "really", "very", "so", "extra", "just", "like", "uh", "um", "umm", "uhh", "er", "erm", "okay", "ok", "alright", "hey", "now", "then", "and", "super duper"],
    tails: ["but", "with", "except", "only", "plus", "and"],
    trailing: ["please", "now", "right now", "already", "lol", "bro", "dude", "man", "guys", "go", "pls", "plz", "thanks", "ok", "okay"],
    numbers: [
        ("two", 2), ("twice", 2), ("pair", 2), ("couple", 2), ("three", 3), ("thrice", 3), ("four", 4), ("five", 5), ("six", 6),
        ("seven", 7), ("eight", 8), ("nine", 9), ("ten", 10), ("eleven", 11), ("twelve", 12), ("dozen", 12), ("fifteen", 15),
        ("twenty", 20), ("thirty", 30), ("fifty", 50), ("hundred", 100), ("thousand", 1000), ("million", 1000000), ("billion", 1000000),
        ("infinite", 1000), ("infinity", 1000), ("tu", 2), ("tree", 3), ("for", 4), ("fore", 4),
    ],
    counts: [(2, "double"), (3, "triple"), (4, "quad"), (5, "x5"), (6, "x6"), (8, "x8"), (10, "x10"), (100, "x100")],
    bang_mod: "yelled",

    // element / style looks: the move_fx.ron key, a tint, the non-CC status it may leave
    elements: [
        (element: Light, fx: "holy", color: (1.0, 0.92, 0.6)),
        (element: Fire, fx: "fire", color: (1.0, 0.45, 0.1), status: Some(Burn)),
        (element: Electric, fx: "lightning", color: (0.55, 0.75, 1.0)),
        (element: Ice, fx: "ice", color: (0.6, 0.85, 1.0), status: Some(Chill)),
        (element: Water, fx: "water", color: (0.3, 0.6, 1.0), status: Some(Wet)),
        (element: Wind, fx: "wind", color: (0.75, 0.95, 0.85)),
        (element: Earth, fx: "earth", color: (0.6, 0.45, 0.3)),
        (element: Poison, fx: "poison", color: (0.4, 0.85, 0.2), status: Some(Poison)),
        (element: Psychic, fx: "psychic", color: (0.95, 0.4, 0.9), status: Some(Float)),
        (element: Shadow, fx: "shadow", color: (0.3, 0.1, 0.4), status: Some(Shadow)),
        (element: Atomic, fx: "atomic", color: (0.3, 1.0, 0.4), status: Some(Burn)),
    ],

    modifiers: [
        // ================================================================ SIZE
        (n: 1, id: "giant", kind: Size, title: "GIANT", size: 1.8, reach: 1.3, damage: 1.3, knockback: 1.4, speed: 0.85, cooldown: 1.4, tier: 1, punch: 1.5, shake: 0.08, boom: true,
         words: ["giant", "huge", "massive", "big", "bigger", "biggest", "large", "larger", "gigantic", "enormous", "mega", "jumbo", "great",
                 "oodama", "king size", "king sized", "super sized", "supersized", "monster", "humongous", "ginormous", "hulking", "mammoth",
                 "immense", "jiant", "gi ant", "gargantuan", "god sized", "oversized", "xl", "xxl", "fat", "chonky", "thicc", "beefy"]),
        (n: 4, id: "colossal", kind: Size, title: "COLOSSAL", size: 2.4, reach: 1.5, damage: 1.5, knockback: 1.7, speed: 0.7, cooldown: 1.9, tier: 2, sparks: 1, punch: 3.0, shake: 0.16, boom: true,
         words: ["colossal", "titanic", "titan", "planet sized", "planetary", "planet", "kaiju sized", "mountain sized", "building sized",
                 "city sized", "world ending", "apocalyptic", "cosmic sized", "biggest ever", "the biggest", "absolutely massive",
                 "insanely big", "stupidly big", "ridiculously big", "gigantomax", "gigantamax", "dynamax", "ultra mega", "mega giant", "giga"]),
        (n: 5, id: "mini", kind: Size, title: "MINI", size: 0.55, reach: 0.8, damage: 0.6, knockback: 0.6, speed: 1.15, cooldown: 0.55, tier: -1,
         words: ["mini", "tiny", "small", "smaller", "little", "baby", "micro", "smol", "pocket", "miniature", "itty bitty", "teeny",
                 "teeny tiny", "wee", "petite", "puny", "chibi", "lil", "lil'", "compact", "travel size", "pint sized", "bite sized"]),
        // ================================================================ COUNT / VOLLEY
        (n: 6, id: "double", kind: Count, title: "DOUBLE", count: 2, cooldown: 1.2, spread: 10.0,
         words: ["double", "twin", "dual", "two way", "double shot", "doubled", "x2", "2x", "duo", "paired", "both hands"]),
        (n: 7, id: "triple", kind: Count, title: "TRIPLE", count: 3, cooldown: 1.35, spread: 12.0,
         words: ["triple", "tripple", "treble", "triplet", "tri", "three way", "x3", "3x", "trio of", "a trio of", "trifecta", "tripled", "triple shot"]),
        (n: 8, id: "quad", kind: Count, title: "QUAD", repeat: 4, cooldown: 1.5, interval: 0.14,
         words: ["quad", "quadruple", "quadra", "four way", "x4", "4x"]),
        (n: 9, id: "x5", kind: Count, title: "FIVEFOLD", repeat: 5, cooldown: 1.6, interval: 0.13, words: ["x5", "5x", "fivefold", "penta"]),
        (n: 10, id: "x6", kind: Count, title: "SIXFOLD", repeat: 6, cooldown: 1.7, interval: 0.12, words: ["x6", "6x", "sixfold", "hexa"]),
        (n: 11, id: "x8", kind: Count, title: "EIGHTFOLD", repeat: 8, cooldown: 1.9, interval: 0.11, words: ["x8", "8x", "octo", "eightfold"]),
        (n: 12, id: "x10", kind: Count, title: "X10", repeat: 8, damage: 0.9, cooldown: 2.0, interval: 0.1, sparks: 1,
         words: ["x10", "10x", "tenfold", "times ten", "ten times"]),
        (n: 13, id: "x100", kind: Count, title: "HUNDRED", repeat: 8, size: 0.6, damage: 0.8, cooldown: 2.2, interval: 0.08, sparks: 1,
         words: ["x100", "100x", "a hundred", "one hundred", "a thousand", "a million", "a billion", "infinite", "endless", "unlimited",
                 "a gazillion", "a bajillion", "a zillion", "countless", "a ton of", "tons of", "loads of", "hundreds of", "thousands of"]),
        (n: 14, id: "barrage", kind: Count, title: "BARRAGE", repeat: 6, size: 0.85, cooldown: 1.8, interval: 0.12,
         words: ["a barrage of", "barrage of", "barrage", "a volley of", "volley of", "volley", "a flurry of", "flurry of", "a storm of",
                 "storm of", "a rain of", "rain of", "raining", "a hail of", "hail of", "a salvo of", "salvo of", "a swarm of", "swarm of",
                 "a stream of", "stream of", "a wave of", "wave of", "a bunch of", "bunch of", "a spray of", "spray of", "a torrent of",
                 "an onslaught of", "onslaught of", "a shower of", "shower of", "multi", "multiple", "many", "lots of", "a lot of", "spam", "spamming"]),
        (n: 15, id: "rapid", kind: Count, title: "RAPID FIRE", repeat: 6, size: 0.8, damage: 0.9, cooldown: 1.6, interval: 0.09,
         words: ["rapid fire", "rapid-fire", "rapidfire", "rapid", "machine gun", "machinegun", "gatling", "minigun", "full auto",
                 "fully automatic", "automatic", "auto fire", "autofire", "burst fire", "burst", "chain fire", "turbo fire", "rapid five", "rabbit fire"]),
        // ================================================================ BEHAVIOUR
        (n: 16, id: "homing", title: "HOMING", mech: [Homing], cone: 2.5, sparks: 1,
         words: ["homing", "homin", "home in", "homes in", "heat seeking", "heat-seeking", "heatseeking", "seeking", "seeker", "guided",
                 "tracking", "target seeking", "auto aim", "autoaim", "aimbot", "lock on", "locked on", "smart", "that follows",
                 "that follows them", "that chases", "chasing", "never misses", "never miss", "can't miss", "cant miss", "roaming", "hunting"]),
        (n: 17, id: "piercing", title: "PIERCING", mech: [Pierce], reach: 1.2, damage: 1.1,
         words: ["piercing", "pierce", "penetrating", "armor piercing", "armour piercing", "drilling", "drill", "through walls",
                 "goes through walls", "that goes through walls", "through everything", "that goes through", "unstoppable", "impaling", "perforating", "lancing"]),
        (n: 18, id: "bouncing", title: "BOUNCING", mech: [Ricochet], reach: 1.1,
         words: ["bouncing", "bouncy", "bounce", "ricochet", "ricocheting", "rico chet", "trick shot", "pinball", "rebounding", "that bounces", "bank shot"]),
        (n: 19, id: "boomerang", title: "BOOMERANG", mech: [Returning],
         words: ["boomerang", "boomeranging", "returning", "that comes back", "comes back", "that returns", "recalled", "yo yo", "yoyo"]),
        (n: 20, id: "sticky", title: "STICKY", mech: [Sticky],
         words: ["sticky", "sticking", "adhesive", "that sticks", "glue", "gluey", "gooey", "tacky", "clinging", "stuck", "magnetic"]),
        (n: 21, id: "delayed", title: "DELAYED", delay: 1.4, damage: 1.2, knockback: 1.15,
         words: ["delayed", "delay", "time delayed", "time-delayed", "timed", "on a timer", "time bomb", "slow fuse", "ticking", "delayed action",
                 "late", "belated", "lingering fuse", "countdown", "delayed reaction"]),
        (n: 22, id: "charged", title: "CHARGED", damage: 1.35, knockback: 1.3, size: 1.2, cooldown: 1.5, tier: 1, punch: 2.0, boom: true,
         words: ["charged", "fully charged", "full charge", "charged up", "max power", "maximum power", "overcharged", "supercharged",
                 "powered up", "empowered", "full power", "full powered", "all out", "all-out", "maxed", "maxed out", "one hundred percent",
                 "100 percent", "super", "ultra", "hyper", "ultimate", "maximum", "max", "mighty", "with all my might", "as hard as i can", "full force", "full strength"]),
        (n: 23, id: "spinning", title: "SPINNING", mech: [Spin], arc: 1.5,
         words: ["spinning", "spin", "spinny", "spiral", "spiraling", "spiralling", "twisting", "rotating", "whirling", "swirling",
                 "gyro", "corkscrew", "tornado spin", "cyclone spin", "360", "three sixty", "revolving", "rotary"]),
        (n: 24, id: "exploding", title: "EXPLODING", mech: [Explodes], knockback: 1.1, sparks: 1,
         words: ["exploding", "explosive", "explode", "explody", "detonating", "bursting", "volatile", "that explodes", "with explosions",
                 "boom", "kaboom", "nuke", "blast", "blasting", "bomb", "grenade", "dynamite", "c4", "tnt"]),
        (n: 25, id: "chain", title: "CHAIN", chain: 2, sparks: 1,
         words: ["chain", "chained", "chaining", "arcing", "arc", "forking", "jumping", "that jumps", "that chains", "daisy chain", "bouncing lightning"]),
        (n: 26, id: "chain_lightning", title: "CHAIN LIGHTNING", chain: 3, element: Some(Electric), sparks: 1,
         words: ["chain lightning", "chain-lightning", "chain lighting", "chained lightning", "arc lightning", "forked lightning", "arcing lightning"]),
        (n: 27, id: "lingering", title: "LINGERING", linger: 3.5, sparks: 1,
         words: ["lingering", "linger", "lasting", "long lasting", "persistent", "residual", "that lingers", "that stays", "leaves a puddle",
                 "leftover", "smoldering", "smouldering", "burning ground", "aftershock", "ground effect"]),
        (n: 28, id: "reverse", title: "REVERSE", reverse: true,
         words: ["reverse", "reversed", "reversal", "inverted", "inverse", "invert", "backwards", "backward", "in reverse", "opposite",
                 "imploding", "implosion", "implode", "negative", "anti", "upside down", "flipped", "mirror", "mirrored", "reverse cursed"]),
        (n: 29, id: "silent", title: "", silent: true, cooldown: 1.1,
         words: ["silent", "silently", "quiet", "quietly", "stealthy", "stealth", "soundless", "silenced", "hushed", "noiseless", "whispered",
                 "sneaky", "sneakily", "ninja", "subtle", "subtly", "low key", "lowkey"]),
        (n: 30, id: "invisible", title: "", invisible: true, damage: 0.9, cooldown: 1.2, sparks: 1,
         words: ["invisible", "invisibly", "cloaked", "unseen", "hidden", "transparent", "see through", "clear", "ghostly invisible", "camouflaged", "camo"]),
        (n: 31, id: "heavy", title: "HEAVY", mech: [Heavy], knockback: 1.35, damage: 1.1, speed: 0.8,
         words: ["heavy", "heavier", "heavyweight", "weighty", "crushing", "dense", "iron", "lead", "anvil", "thunderous weight"]),
        (n: 32, id: "wide", title: "WIDE", arc: 1.8, size: 1.25, damage: 0.9,
         words: ["wide", "wider", "broad", "sweeping", "wide angle", "wide-angle", "spread", "spread out", "shotgun", "fan", "scatter", "area"]),
        (n: 33, id: "focused", title: "FOCUSED", arc: 0.5, cone: 0.6, reach: 1.3, damage: 1.2,
         words: ["focused", "narrow", "concentrated", "precise", "precision", "pinpoint", "laser focused", "sniper", "needle", "compressed", "condensed"]),
        (n: 3, id: "long", title: "LONG RANGE", reach: 1.6, speed: 1.15,
         words: ["long", "long range", "long-range", "long distance", "far", "far reaching", "extended", "far away", "longer", "sniping", "distant", "telescoping", "stretchy"]),
        // ================================================================ SPEED
        (n: 2, id: "quick", kind: Speed, title: "QUICK", speed: 1.5, cooldown: 0.7, damage: 0.9, secs: 0.8,
         words: ["quick", "fast", "faster", "speedy", "swift", "rapid speed", "lightning fast", "lightning quick", "instant", "hyper speed",
                 "hyperspeed", "turbo", "blitz", "flash", "sonic", "snap", "quickdraw", "quick draw", "express", "zippy", "nitro"]),
        (n: 34, id: "slow", kind: Speed, title: "SLOW-MO", speed: 0.5, damage: 1.2, size: 1.1, secs: 1.2,
         words: ["slow", "slow mo", "slow-mo", "slowmo", "slow motion", "slow-motion", "sluggish", "lazy", "leisurely", "matrix", "bullet time",
                 "dramatic", "dramatically", "cinematic"]),
        // ================================================================ ADVERBS (the way you do it)
        (n: 35, id: "violently", kind: Adverb, title: "VIOLENT", knockback: 1.4, damage: 1.1, punch: 1.0, shake: 0.06,
         words: ["violently", "violent", "savagely", "savage", "ferociously", "ferocious", "viciously", "vicious", "wildly", "wild", "hard",
                 "really hard", "super hard", "with force", "forcefully", "aggressively", "aggressive", "rage", "raging", "furiously",
                 "furious", "angrily", "angry", "berserk", "unhinged", "psycho"]),
        (n: 36, id: "brutally", kind: Adverb, title: "BRUTAL", damage: 1.25, knockback: 1.15, cooldown: 1.2, punch: 1.0,
         words: ["brutally", "brutal", "mercilessly", "merciless", "ruthlessly", "ruthless", "devastating", "devastatingly", "deadly", "lethal",
                 "killer", "murderous", "fatal", "hellish"]),
        (n: 37, id: "gently", kind: Adverb, title: "GENTLE", knockback: 0.5, damage: 0.7, cooldown: 0.8,
         words: ["gently", "gentle", "softly", "soft", "lightly", "tenderly", "kindly", "politely", "carefully", "a little", "slightly", "weak", "weakly", "baby mode"]),
        (n: 38, id: "gracefully", kind: Adverb, title: "GRACEFUL", speed: 1.15, cooldown: 0.9, cone: 1.3,
         words: ["gracefully", "graceful", "elegantly", "elegant", "stylishly", "stylish", "smoothly", "smooth", "fancy", "fancily", "with style", "with flair", "flashy"]),
        // ================================================================ YELL
        (n: 39, id: "yelled", kind: Adverb, title: "", size: 1.15, damage: 1.1, knockback: 1.1, punch: 2.0, shake: 0.05, boom: true,
         words: ["yelled", "screamed", "shouted", "loud", "loudly", "at the top of my lungs"]),
        // ================================================================ ELEMENT / STYLE SWAPS
        (n: 40, id: "fire", kind: Element, title: "FIRE", element: Some(Fire),
         words: ["fire", "flaming", "flame", "flames", "fiery", "blazing", "burning", "inferno", "hellfire", "magma", "lava", "molten",
                 "scorching", "scorched", "on fire", "fire style", "katon", "pyro", "incendiary", "ember", "embers", "heat", "hot", "solar flare", "sun"]),
        (n: 41, id: "ice", kind: Element, title: "ICE", element: Some(Ice),
         words: ["ice", "icy", "iced", "frozen", "frost", "frosty", "freezing", "cryo", "glacial", "glacier", "snow", "snowy", "arctic",
                 "ice cold", "ice style", "hyoton", "cold", "chilling", "subzero", "sub zero", "permafrost", "blizzard"]),
        (n: 42, id: "lightning", kind: Element, title: "LIGHTNING", element: Some(Electric),
         words: ["lightning", "lighting", "electric", "electrified", "electrical", "thunder", "thunderous", "thunderbolt", "shock", "shocking",
                 "voltage", "volt", "static", "plasma", "raiton", "lightning style", "zap", "zappy", "sparking", "sparky", "tesla", "storm"]),
        (n: 43, id: "water", kind: Element, title: "WATER", element: Some(Water),
         words: ["water", "watery", "aqua", "aquatic", "tidal", "hydro", "ocean", "sea", "splash", "splashing", "bubble", "bubbly", "suiton",
                 "water style", "tsunami", "rain", "liquid"]),
        (n: 44, id: "wind", kind: Element, title: "WIND", element: Some(Wind),
         words: ["wind", "windy", "air", "airy", "gale", "hurricane", "tornado", "cyclone", "typhoon", "whirlwind", "gust", "futon",
                 "wind style", "vacuum", "aero", "breeze"]),
        (n: 45, id: "earth", kind: Element, title: "EARTH", element: Some(Earth),
         words: ["earth", "earthen", "stone", "rock", "rocky", "boulder", "mud", "muddy", "doton", "earth style", "granite", "terra",
                 "tectonic", "seismic", "clay", "gravel"]),
