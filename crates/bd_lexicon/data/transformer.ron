// Transformer grammar data (crates/bd_lexicon/src/transformer.rs). Every way a player asks for a
// transforming robot becomes ONE `Transforms` construct whose form / features / mass describe the ALT
// MODE (bd_shapes builds the robot mode from the alt model; bd_sim picks the combat archetype from the
// same tags: assets/tuning/combat.ron `transformer.rules`). Piloted comes from the intent stage.
// Word lists are normalised (lowercase, hyphens -> spaces: "t-rex" is "t rex"). Behaviour words map onto
// the closed bd_core sets only. Edit freely; no lexicon rebuild needed (embedded at compile time).
(
    // ------------------------------------------------------------------ voice / typing repairs
    // Whisper-style splits and misspellings, folded before matching (only inside this stage).
    fold: [
        ("trans former", "transformer"), ("trans formers", "transformers"), ("transform er", "transformer"),
        ("transform ers", "transformers"), ("trans forming", "transforming"), ("trans formable", "transformable"),
        ("transformer s", "transformers"),
        ("dino bot", "dinobot"), ("dino bots", "dinobots"), ("dyno bot", "dinobot"), ("dyno bots", "dinobots"),
        ("dynobot", "dinobot"), ("dynobots", "dinobots"), ("dino bott", "dinobot"),
        ("preda con", "predacon"), ("preda cons", "predacons"), ("predicon", "predacon"), ("predicons", "predacons"),
        ("pred a con", "predacon"), ("predator con", "predacon"), ("predacon s", "predacons"),
        ("maxi mal", "maximal"), ("maxi mals", "maximals"), ("maxie mal", "maximal"),
        ("auto bot", "autobot"), ("auto bots", "autobots"), ("decepti con", "decepticon"),
        ("decepti cons", "decepticons"), ("deceptacon", "decepticon"), ("deceptacons", "decepticons"),
        ("decepticon s", "decepticons"),
        ("beast war", "beast wars"), ("beastwars", "beast wars"), ("beast wars s", "beast wars"),
        ("heli copter", "helicopter"), ("heli copters", "helicopters"), ("helo copter", "helicopter"),
        ("helicoptor", "helicopter"), ("hellicopter", "helicopter"),
        ("motor cycle", "motorcycle"), ("motor cycles", "motorcycles"), ("motor bike", "motorbike"),
        ("motor bikes", "motorbikes"), ("motercycle", "motorcycle"), ("motorcylce", "motorcycle"),
        ("tea rex", "t rex"), ("tee rex", "t rex"), ("t wrecks", "t rex"),
        ("loco motive", "locomotive"), ("bull dozer", "bulldozer"), ("speed boat", "speedboat"),
    ],
    // Trigger words that also match an UNKNOWN token within a typo or two ("transfomer", "dinobott").
    fuzzy: ["transformer", "transformers", "transforming", "transformable", "dinobot", "dinobots",
        "predacon", "predacons", "decepticon", "decepticons", "maximals"],

    // A whole phrase equal to one of these is never read as a transformer (names / idioms).
    guard_phrases: ["robot chicken", "robot wars", "mr robot", "robot in disguise", "robots in disguise",
        "transforming robot", "transformer robot", "car wash", "robot overlord", "robot overlords"],

    // ------------------------------------------------------------------ the words
    // "<vehicle> robot", "robot <vehicle>", "<vehicle> bot": a robot + a VEHICLE noun is a transformer
    // (a robot + an animal is a mechanical animal: "robot dog" stays a robot dog).
    robot_words: ["robot", "bot"],
    robot_plural: ["robots", "bots"],
    // "an X transformer", "transformer X", "a transformer that turns into X": any alt mode.
    transformer_words: ["transformer"],
    transformer_plural: ["transformers"],
    // "a transforming X", "a transformable X": any alt mode.
    transforming_words: ["transforming", "transformable"],
    // Other subjects of "<subject> that turns into X" / objects of "X that transforms into a <object>".
    subject_words: ["mech", "mecha", "mechs", "droid", "droids", "android", "androids", "cyborg", "cyborgs"],
    // "<subject> [that / which / who] [can] <verb> X" (the article after the verb comes off).
    into_verbs: ["turns into", "turn into", "turning into", "turned into", "transforms into", "transform into",
        "transforming into", "transformed into", "changes into", "change into", "changing into", "converts into",
        "convert into", "converting into", "morphs into", "morph into", "morphing into", "shifts into", "shift into",
        "folds into", "fold into", "folds up into", "unfolds into", "becomes", "become", "can become",
        "turns in to", "turn in to", "transforms in to", "transform in to", "changes in to", "change in to",
        "transforms to", "turns to", "disguises as", "disguised as", "in disguise as", "is also", "is secretly"],
    // "X that transforms" / "X which can transform" (at the end of the phrase, after a that / which link).
    bare_verbs: ["transforms", "transform", "can transform", "transforms into a robot", "transforms into robot"],
    // Adjacency readings ("X robot", "transforming X") never cross these words: the phrase relates two
    // things instead ("robot riding a motorcycle" is a mount, "robot vs car" is two things).
    blockers: ["riding", "rides", "ride", "driving", "drives", "drive", "piloting", "pilots", "pilot",
        "inside", "sized", "size", "vs", "versus", "fighting", "fights", "eating", "eats", "chasing", "chases",
        "army", "armies", "arm", "arms", "hand", "hands", "factory", "costume", "toy", "toys", "movie",
        "cartoon", "game", "shaped", "like", "shooting", "throwing", "holding", "wielding", "wearing"],

    // ------------------------------------------------------------------ franchise vocabulary
    // Words from the franchise that mean "a transformer". `alt`: what it turns into when no alt mode is
    // named ("a dinobot"); None = the bare word keeps its own reading ("autobot", "decepticon").
    franchises: [
        (words: ["dinobot"], plural: ["dinobots"], alt: Some("t rex"), temperament: Some(Aggressive)),
        (words: ["predacon"], plural: ["predacons"], alt: Some("dragon"), temperament: Some(Aggressive)),
        (words: ["maximal"], plural: ["maximals"], alt: Some("gorilla"), temperament: Some(Protective)),
        (words: ["beast wars"], alt: Some("gorilla"), temperament: Some(Protective)),
        (words: ["autobot"], plural: ["autobots"], temperament: Some(Protective)),
        (words: ["decepticon"], plural: ["decepticons"], temperament: Some(Aggressive)),
        (words: ["insecticon"], plural: ["insecticons"], alt: Some("beetle"), temperament: Some(Aggressive)),
        (words: ["constructicon"], plural: ["constructicons"], alt: Some("bulldozer"), temperament: Some(Aggressive)),
    ],

    // ------------------------------------------------------------------ size
    // A transformer is sized from its alt mode's typical size, clamped to [min_scale, max_scale] m (a
    // wolf grows, a ship shrinks: "a transformer" is 4 m). `suit`: the size you wear (≤ 2.6 m = a power
    // suit in bd_sim); `mul`: bigger as usual. A size word that starts a known name ("big rig") is not one.
    min_scale: 4.0,
    max_scale: 6.0,
    // Mass cap at default size (kg; x the size multiplier cubed): a 4 m rhino is not a 25 t wall.
    max_mass: 12000.0,
    sizes: [
        (words: "tiny", suit: Some(2.0)), (words: "small", suit: Some(2.4)), (words: "mini", suit: Some(2.2)),
        (words: "little", suit: Some(2.4)), (words: "pocket", suit: Some(2.0)), (words: "pocket sized", suit: Some(2.0)),
        (words: "suit", suit: Some(2.4)), (words: "wearable", suit: Some(2.4)), (words: "miniature", suit: Some(2.2)),
        (words: "micro", suit: Some(2.0)), (words: "human sized", suit: Some(2.4)), (words: "human size", suit: Some(2.4)),
        (words: "life sized", suit: Some(2.4)), (words: "life size", suit: Some(2.4)), (words: "man sized", suit: Some(2.4)),
        (words: "person sized", suit: Some(2.4)), (words: "kid sized", suit: Some(2.0)), (words: "baby", suit: Some(2.0)),
        (words: "big", mul: Some(1.4)), (words: "large", mul: Some(1.4)), (words: "tall", mul: Some(1.3)),
        (words: "giant", mul: Some(2.5)), (words: "gigantic", mul: Some(2.5)), (words: "huge", mul: Some(2.5)),
        (words: "massive", mul: Some(2.5)), (words: "enormous", mul: Some(2.5)), (words: "humongous", mul: Some(3.0)),
        (words: "colossal", mul: Some(3.5)), (words: "titanic", mul: Some(3.5)), (words: "gargantuan", mul: Some(3.5)),
        (words: "mega", mul: Some(2.5)), (words: "giga", mul: Some(3.0)), (words: "kaiju sized", mul: Some(3.5)),
        (words: "building sized", mul: Some(3.0)),
    ],
    // What a transforming construct never is (it is ONE machine you drive, not a pack or a drop).
    drop_mechanics: [Swarm, DropFromSky],
    // Alt modes a transformer can have (a sword / wall / person is no alt mode: those read as before).
    alt_forms: [Vehicle, Kaiju, Quadruped, Serpent, Bird, Fish, Arachnid, Insect],
    confidence: 0.95,
    // "transforming wolves", "dinobots", "car robots" (no number said): a squad of this many.
    plural_count: 3,
    max_count: 5,

    // ------------------------------------------------------------------ alt modes by head noun
    // Matched against the alt's last 1-3 words (longest first; a plural matches its singular). Fields:
    // words, alias (re-read the matched words as this when the typed noun doesn't read as `form`: "train"
    // is also a superhero), form, add (features to ensure), any (ensure one of these, else the first),
    // drop (features to remove), mech_add / mech_drop, element (only replaces the default Light),
    // min_scale / max_scale (override the transformer range), min_mass / max_mass (kg, at default size).
    alts: [
        // helicopter archetype (Rotor)
        (words: ["helicopter", "chopper", "attack helicopter", "gunship", "helicopter gunship", "copter", "heli"],
            alias: [("heli", "helicopter"), ("copter", "helicopter")],
            form: Some(Vehicle), add: [Rotor], drop: [Propeller, Jet, Wheels, Treads], mech_add: [Flies]),
        // jet archetype (Jet)
        (words: ["jet", "fighter jet", "jet fighter", "fighter plane", "fighter", "plane", "airplane", "aeroplane",
            "aircraft", "warplane", "war plane", "stealth fighter", "stealth bomber", "stealth jet", "bomber",
            "spy plane", "jumbo jet", "airliner", "jetliner", "space shuttle", "shuttle", "starfighter", "jet plane"],
            form: Some(Vehicle), add: [Jet, Cockpit], drop: [Propeller, Rotor, Windows, Wheels, Treads],
            mech_add: [Flies, Thrust]),
        // bike archetype (Wheels + Exhaust, no cab / windows / cockpit, <= 5 m)
        (words: ["motorcycle", "motorbike", "bike", "dirt bike", "sport bike", "sportbike", "superbike", "scooter",
            "moped", "motor scooter", "racing bike", "chopper bike", "speeder bike", "hoverbike", "hover bike"],
            form: Some(Vehicle), add: [Wheels, Exhaust, Headlight], drop: [Windows, Cab, Cockpit, Gears, Chains, Treads, Smokestack],
            mech_add: [Fast], mech_drop: [Heavy, Stomp], min_scale: Some(3.4), max_scale: Some(4.0), max_mass: Some(900.0)),
        // boat archetype (Sails, or Propeller with element Water)
        (words: ["boat", "ship", "speedboat", "motorboat", "motor boat", "yacht", "battleship", "warship", "war ship",
            "gunboat", "gun boat", "pirate ship", "sailboat", "sail boat", "sailing ship", "submarine", "jet ski",
            "jetski", "hovercraft", "aircraft carrier", "tugboat", "tug boat", "destroyer", "frigate", "galleon",
            "canoe", "kayak", "ferry", "cruise ship", "catamaran", "raft", "pt boat", "patrol boat", "u boat"],
            form: Some(Vehicle), any: [Propeller, Sails], drop: [Wheels, Treads, Rotor, Jet], mech_drop: [Flies],
            element: Some(Water)),
        // train archetype (Plow + Wheels / Cab / Smokestack; Smokestack + Wheels also draws a locomotive)
        (words: ["train", "locomotive", "steam train", "steam engine", "bullet train", "freight train", "choo choo",
            "choo choo train", "subway train", "subway", "monorail", "tank engine", "railway engine", "engine train",
            "passenger train", "diesel train", "diesel locomotive", "steam locomotive", "maglev train"],
            alias: [("train", "locomotive"), ("subway", "subway train"), ("choo choo", "locomotive")],
            form: Some(Vehicle), add: [Wheels, Cab, Plow, Smokestack], drop: [CraneArm, Drill, Saw, Treads, Rotor, Jet, Propeller],
            mech_add: [Heavy, Charge], min_mass: Some(8000.0)),
        // tank archetype (Treads + Turret / Barrels)
        (words: ["tank", "battle tank", "army tank", "panzer", "war tank", "artillery tank", "tank destroyer",
            "sherman tank", "tiger tank", "abrams tank", "hover tank", "mech tank", "armored tank", "military tank"],
            form: Some(Vehicle), add: [Treads, Turret, Barrels], drop: [Wheels, Rotor, Jet, Plow, Drill, Saw, CraneArm, Propeller],
            mech_add: [Shoots, Heavy]),
        // truck archetype (Cab; >= 5 t)
        (words: ["truck", "semi", "semi truck", "big rig", "18 wheeler", "eighteen wheeler", "lorry", "fire truck",
            "firetruck", "fire engine", "garbage truck", "dump truck", "tow truck", "pickup truck", "pickup", "tanker truck",
            "cement mixer", "cement truck", "mixer truck", "delivery truck", "box truck", "bus", "school bus",
            "tractor trailer", "tractor", "trailer truck", "armored truck", "military truck", "monster truck",
            "semi trailer", "rig", "big truck", "rv", "camper", "humvee", "hummer", "tanker"],
            form: Some(Vehicle), add: [Wheels, Cab], drop: [Drill, Saw, CraneArm, Plow, Treads, Rotor, Jet, Smokestack, Propeller],
            mech_add: [Heavy], min_mass: Some(5000.0)),
        // car archetype (the default; kept light and cab-less so it never reads as a truck)
        (words: ["car", "sports car", "race car", "racecar", "racing car", "police car", "cop car", "squad car",
            "muscle car", "supercar", "super car", "sedan", "taxi", "jeep", "suv", "van", "minivan", "ambulance",
            "convertible", "buggy", "dune buggy", "hot rod", "hotrod", "coupe", "limo", "limousine", "stock car",
            "rally car", "getaway car", "go kart", "kart", "cruiser", "police cruiser", "hatchback", "roadster",
            "formula one car", "f1 car", "lambo", "lamborghini", "ferrari", "porsche", "corvette", "camaro",
            "mustang", "beetle car", "vw beetle", "volkswagen beetle", "mini cooper", "sportscar"],
            form: Some(Vehicle), add: [Wheels, Headlight], drop: [Cab, Smokestack, Treads, Plow, Drill, Saw, CraneArm, Rotor, Jet, Propeller],
            mech_drop: [Heavy, Stomp, Flies], max_mass: Some(3000.0)),
        // construction archetype (Plow / Drill / Saw / CraneArm)
        (words: ["bulldozer", "dozer", "bull dozer", "steamroller", "road roller", "snowplow", "snow plow"],
            form: Some(Vehicle), add: [Plow, Treads, Cab], drop: [Wheels, Rotor, Jet, Smokestack, Boiler, Propeller],
            mech_add: [Heavy]),
        (words: ["excavator", "digger", "backhoe", "steam shovel", "power shovel", "mining excavator"],
            alias: [("digger", "excavator"), ("backhoe", "excavator")],
            form: Some(Vehicle), add: [CraneArm, Treads, Cab], drop: [Wheels, Rotor, Jet, Propeller], mech_add: [Heavy],
            mech_drop: [Walks]),
        (words: ["crane", "crane truck", "mobile crane", "construction crane", "tower crane", "wrecking crane"],
            alias: [("crane", "crane truck"), ("construction crane", "crane truck"), ("tower crane", "crane truck")],
            form: Some(Vehicle), add: [CraneArm, Wheels, Cab], drop: [Windows, Rotor, Jet, Propeller], mech_add: [Heavy],
            mech_drop: [Flies, Barrier]),
        (words: ["drill tank", "drill truck", "drilling machine", "drill machine", "tunnel borer", "tunnel boring machine",
            "mining drill", "drill vehicle", "mole machine"],
            form: Some(Vehicle), add: [Drill, Treads], drop: [Wheels, Rotor, Jet, Propeller], mech_add: [Heavy]),
        // dino archetype (Kaiju with ArticulatedTail or Breath)
        (words: ["t rex", "trex", "tyrannosaurus", "tyrannosaurus rex", "tyrannosaur", "rex"],
            form: Some(Kaiju), drop: [Barrels, Wheels, Treads], mech_add: [ArticulatedTail, Stomp, Breath, Heavy],
            mech_drop: [Grab], element: Some(Fire), min_mass: Some(5000.0)),
        (words: ["dinosaur", "dino", "raptor", "velociraptor", "spinosaurus", "allosaurus", "carnotaurus",
            "giganotosaurus", "megalosaurus", "utahraptor", "deinonychus", "indominus rex", "indoraptor"],
            form: Some(Kaiju), drop: [Barrels, Wheels, Treads], mech_add: [ArticulatedTail, Stomp], min_mass: Some(4000.0)),
        // beast archetype (four-legged beasts; other creatures keep their own form)
        (words: ["wolf", "lion", "panther", "jaguar", "tiger", "leopard", "cheetah", "gorilla", "ape",
            "rhino", "rhinoceros", "bear", "grizzly bear", "polar bear", "dog", "hound", "fox", "hyena", "bull", "buffalo",
            "bison", "boar", "warthog", "elephant", "mammoth", "sabertooth", "saber tooth", "sabertooth tiger",
            "saber tooth tiger", "cougar", "puma", "lynx", "horse", "stallion", "rat", "mouse", "cat", "big cat",
            "wolverine", "badger", "ram", "goat", "moose", "stag", "deer", "triceratops", "stegosaurus", "ankylosaurus",
            "brontosaurus", "kangaroo", "armadillo", "porcupine", "hippo", "hippopotamus", "crocodile", "alligator",
            "komodo dragon", "chimpanzee", "orangutan", "baboon", "monkey", "raccoon", "skunk", "werewolf", "dire wolf"],
            form: Some(Quadruped)),
        (words: ["bird", "eagle", "hawk", "falcon", "condor", "raven", "crow", "owl", "vulture", "pterodactyl",
            "pteranodon", "bat", "parrot", "seagull", "albatross", "osprey", "bald eagle", "firebird"],
            form: Some(Bird), mech_add: [Flies], mech_drop: [Grab]),
    ],
)
