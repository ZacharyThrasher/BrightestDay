// Intent layer data (crates/bd_lexicon/src/intent.rs + refer.rs): how a phrase is DELIVERED — onto a
// named player, at them, next to them, around them — and the verbs / prepositions that say so.
// Vocabulary only: bd_sim decides what each delivery does per form category (bd_sim world/deliver.rs).
// Word lists are normalised (lowercase, hyphens -> spaces). Compiled in; no lexicon rebuild needed.
//
// Deliveries:
//   Onto   — from the sky onto the target / aim point (drop, rain, smite, crash, "on top of <name>")
//   At     — thrown / fired / driven toward them (throw, hurl, launch, fire, shoot, "at <name>")
//   Near   — appears next to them (summon, spawn, call, "near <name>", a creature "on <name>")
//   Around — placed around them (cage, trap, surround, "wall around <name>", "dome over <name>")
//   Hunt   — sent after them from here ("after <name>", "sic", "chase")
(
    // Verbs that open a phrase ("drop a meteor", "throw a rock at jake"). The verb comes off before the
    // resolver reads the rest (its meaning is the delivery, not a thing to build: "fire a missile" is not
    // a burning missile, "launch a rocket" does not add Launch). `mech`: mechanics the verb adds to what
    // was built. `rewrite`: the rest is re-read as this phrase ("{}" = the rest) so an existing relation
    // does the work ("rain arrows" -> "rain of arrows", a relations.ron volley). `alone`: what the verb
    // builds with nothing after it ("smite jake"). Longest match first; a verb followed by nothing and no
    // `alone` is left in the phrase untouched ("fire!" stays fire). A verb + the next word that is itself a
    // known phrase is never split ("fire truck", "rain boots", "drop kick", "launch pad"). `strict`: the
    // word is also an everyday modifier/noun, so it is only a verb before an article, a number or a plural
    // ("fire a missile", "rain 3 anvils", "rain arrows" — but "fire sword" stays a flaming sword).
    verbs: [
        (words: "drop", via: Onto, mech: [DropFromSky]),
        (words: "drops", via: Onto, mech: [DropFromSky]),
        (words: "dropping", via: Onto, mech: [DropFromSky]),
        (words: "drop down", via: Onto, mech: [DropFromSky]),
        (words: "call down", via: Onto, mech: [DropFromSky]),
        (words: "bring down", via: Onto, mech: [DropFromSky]),
        (words: "send down", via: Onto, mech: [DropFromSky]),
        (words: "crash", via: Onto, mech: [DropFromSky], strict: true),
        (words: "slam", via: Onto, mech: [DropFromSky], strict: true),
        (words: "dump", via: Onto, mech: [DropFromSky], strict: true),
        (words: "plop", via: Onto, mech: [DropFromSky], strict: true),
        (words: "smite", via: Onto, mech: [DropFromSky], alone: Some("lightning bolt")),
        (words: "smash", via: Onto, mech: [DropFromSky], strict: true),
        (words: "rain down", via: Onto, mech: [DropFromSky], rewrite: Some("rain of {}")),
        (words: "rain", via: Onto, mech: [DropFromSky], rewrite: Some("rain of {}"), strict: true),
        (words: "shower", via: Onto, rewrite: Some("shower of {}"), strict: true),
        (words: "hail", via: Onto, rewrite: Some("hail of {}"), strict: true),
        (words: "pelt", via: Onto, rewrite: Some("hail of {}"), strict: true),
        (words: "nuke", via: Onto, alone: Some("nuke"), strict: true),

        (words: "throw", via: At),
        (words: "throws", via: At),
        (words: "hurl", via: At),
        (words: "chuck", via: At),
        (words: "toss", via: At),
        (words: "lob", via: At),
        (words: "fling", via: At),
        (words: "yeet", via: At),
        (words: "pitch", via: At, strict: true),
        (words: "launch", via: At),
        (words: "fire", via: At, strict: true),
        (words: "fire off", via: At),
        (words: "shoot", via: At),
        (words: "send", via: At, strict: true, generic: true),
        (words: "sling", via: At, strict: true),
        (words: "catapult", via: At),
        (words: "kick", via: At, strict: true),
        (words: "hit", via: At, strict: true),
        (words: "snipe", via: At, alone: Some("sniper rifle"), strict: true),

        (words: "summon", via: Near, generic: true),
        (words: "spawn", via: Near, strict: true, generic: true),
        (words: "call", via: Near, strict: true, generic: true),
        (words: "call forth", via: Near, generic: true),
        (words: "conjure", via: Near, generic: true),
        (words: "unleash", via: Near, generic: true),
        (words: "release", via: Near, strict: true, generic: true),
        (words: "put", via: Near, strict: true, generic: true),
        (words: "place", via: Near, strict: true, generic: true),
        (words: "plant", via: Near, strict: true, generic: true),

        (words: "sic", via: Hunt),
        (words: "sick", via: Hunt),
        (words: "set", via: Hunt, strict: true),
        (words: "chase", via: Hunt, strict: true),
        (words: "hunt", via: Hunt, strict: true),

        (words: "cage", via: Around, alone: Some("cage"), strict: true),
        (words: "trap", via: Around, alone: Some("cage"), strict: true),
        (words: "surround", via: Around, strict: true),
        (words: "encase", via: Around, alone: Some("ice cage")),
        (words: "imprison", via: Around, alone: Some("cage")),
        (words: "entomb", via: Around, alone: Some("stone dome")),
        (words: "wall in", via: Around, alone: Some("wall")),
        (words: "box in", via: Around, alone: Some("cage")),
        (words: "lock", via: Around, alone: Some("cage"), strict: true),
        (words: "lock up", via: Around, alone: Some("cage")),
        (words: "bury", via: Onto, alone: Some("boulder"), strict: true),
        (words: "crush", via: Onto, alone: Some("anvil"), strict: true),
        (words: "squash", via: Onto, alone: Some("anvil"), strict: true),
        (words: "flatten", via: Onto, alone: Some("anvil"), strict: true),
        (words: "zap", via: Onto, alone: Some("lightning bolt"), strict: true),
        (words: "strike", via: Onto, alone: Some("lightning bolt"), strict: true),
        (words: "freeze", via: Around, alone: Some("ice cage"), strict: true),
        (words: "burn", via: At, alone: Some("fireball"), strict: true),
        (words: "torch", via: At, alone: Some("fireball"), strict: true),
        (words: "blast", via: At, alone: Some("energy blast"), strict: true),
        (words: "attack", via: Hunt, alone: Some("wolf"), strict: true),
        (words: "bomb", via: Onto, alone: Some("bomb"), strict: true),
        (words: "eat", via: Hunt, alone: Some("shark"), strict: true),
        (words: "sting", via: Hunt, alone: Some("bees"), strict: true),
        (words: "bite", via: Hunt, alone: Some("wolf"), strict: true),
        (words: "stomp", via: Onto, alone: Some("giant foot"), strict: true),
        (words: "squish", via: Onto, alone: Some("anvil"), strict: true),

        // ---- military / tabletop content pass (assets/icons/military.ron, tabletop.ron): support calls and
        // famous spells yelled as verbs ("carpet bomb mia", "call in an airstrike", "fireball jake").
        (words: "carpet bomb", via: Onto, alone: Some("carpet bombing")),
        (words: "carpet bombs", via: Onto, alone: Some("carpet bombing")),
        (words: "airstrike", via: Onto, alone: Some("air strike")),
        (words: "air strike", via: Onto, alone: Some("air strike")),
        (words: "drone strike", via: Onto, alone: Some("drone strike")),
        (words: "napalm", via: Onto, alone: Some("napalm"), strict: true),
        (words: "call in", via: Onto, generic: true),
        (words: "calling in", via: Onto, generic: true),
        (words: "fireball", via: At, alone: Some("fireball"), strict: true),
        (words: "magic missile", via: At, alone: Some("magic missile")),
        (words: "eldritch blast", via: At, alone: Some("eldritch blast")),
    ],

    // "<verb> <name> [with <thing>]": verbs that take the player as their object ("cage ethan", "smite
    // jake", "hit mia with a meteor", "surround sam with wolves"). Must also be in `verbs`.
    target_verbs: ["cage", "trap", "lock", "lock up", "eat", "sting", "bite", "stomp", "squish", "smite", "nuke", "hit", "pelt", "crush", "squash", "flatten", "bury", "surround",
        "encase", "imprison", "entomb", "wall in", "box in", "zap", "strike", "freeze", "burn", "torch", "blast",
        "attack", "bomb", "snipe", "chase", "hunt", "smash", "shower", "rain on", "drop on",
        // military / tabletop content pass
        "carpet bomb", "carpet bombs", "airstrike", "air strike", "drone strike", "napalm", "fireball", "magic missile",
        "eldritch blast"],

    // "<verb> <name> with|in <thing>": the thing ("hit mia with a meteor", "trap nova in a bubble").
    with_words: ["with", "using", "w", "in", "inside", "into", "under", "beneath"],

    // Prepositions that aim the phrase at a player ("<thing> <prep> <name>"). Longest match first.
    preps: [
        (words: "on top of", via: Onto),
        (words: "down on", via: Onto),
        (words: "down onto", via: Onto),
        (words: "onto", via: Onto),
        (words: "on", via: Onto),
        (words: "upon", via: Onto),
        (words: "over", via: Onto),
        (words: "above", via: Onto),
        (words: "at", via: At),
        (words: "toward", via: At),
        (words: "towards", via: At),
        (words: "against", via: At),
        (words: "to", via: At),
        (words: "into", via: At),
        (words: "vs", via: At),
        (words: "versus", via: At),
        (words: "after", via: Hunt),
        (words: "for", via: Hunt),
        (words: "near", via: Near),
        (words: "next to", via: Near),
        (words: "beside", via: Near),
        (words: "by", via: Near),
        (words: "behind", via: Near),
        (words: "in front of", via: Near),
        (words: "under", via: Near),
        (words: "underneath", via: Near),
        (words: "beneath", via: Near),
        (words: "below", via: Near),
        (words: "around", via: Around),
        (words: "round", via: Around),
        (words: "surrounding", via: Around),
    ],
    // Preps weak enough that a lone common word after them is NOT read as a partial player name
    // ("sword on fire" never targets "Fire Lord 9000"; "missile at nova" still finds "xX_Nova_Xx").
    weak_preps: ["on", "onto", "upon", "over", "to", "into", "for", "by", "under", "below", "above", "in front of", "near"],
    // Words allowed after the name ("at jake's head now!").
    after_name: ["now", "please", "plz", "head", "face", "feet", "butt", "back", "again", "right", "now", "already",
        "fast", "quick", "quickly", "asap", "too", "lol", "bro", "spawn", "base", "house", "side", "position", "location",
        "spot", "place", "team", "hideout", "camp", "tower", "corner"],
    // Name tokens too generic to identify a player on their own ("xX_Nova_Xx" -> "nova" counts, "xx" not).
    name_noise: ["xx", "x", "xxx", "the", "mr", "mrs", "ms", "dr", "sir", "lord", "lil", "big", "little", "iam", "im",
        "real", "official", "ttv", "yt", "tv", "gaming", "games", "gamer", "plays", "pro", "og"],

    // "Around" a player: structures that only make sense as an enclosure become one (a wall around Sam
    // is a cage). (from, to) form names.
    around_forms: [("Wall", "Cage"), ("Pillar", "Cage"), ("Platform", "Cage")],

    // Verb + next word that is a thing of its own ("rain boots" are boots, "fire truck" is a truck): never a
    // delivery. (Known lexicon phrases are also caught automatically; these are the ones it misses.)
    not_verbs: ["rain boot", "rain boots", "rain coat", "rain jacket", "rain cloud", "rain drop", "rain dance", "rain bow",
        "rain forest", "rain gauge", "fire truck", "fire ball", "fire ant", "fire hydrant", "fire extinguisher", "fire alarm",
        "fire engine", "fire hose", "fire station", "fire works", "fire fly", "fire wall", "fire place", "fire pit",
        "fire cracker", "fire man", "fire fighter", "fire storm", "fire bird", "fire sword", "fire axe", "fire whip",
        "drop kick", "drop bear", "drop ship", "drop pod", "drop tower", "drop zone", "launch pad", "shower head",
        "shower curtain", "hail mary", "crash test", "crash dummy", "trap door", "cage fighter", "hit man", "pitch fork",
        "set piece", "place holder", "kick drum", "kick scooter", "bomb shelter", "blast door", "throw pillow",
        "throw blanket", "strike team", "torch light", "call center", "send off", "spawn point", "hunt party",
        "chase car", "bite size", "sting ray", "lock pick", "lock box", "plant pot", "release valve", "put put",
        "smash cake", "slam dunk", "crush depth", "toss up", "chuck norris", "pelt coat", "dump truck", "set trap"],
    // "<thing> <prep> the <place>": the place is where to cast it (see intent.rs `location_head`).
    location_preps: ["from", "out of", "over", "on", "on top of", "in", "at", "near", "above", "under", "behind", "into", "onto", "around",
        "across", "through", "inside", "outside", "beside", "next to", "in front of", "by"],

    // ---- PILOTING (COMBAT.md §5d-ter): who drives what the ring builds. Vocabulary only: the sim seats
    // the caster in anything whose recipe carries `Piloted` (host-validated) and hands it to its own AI
    // when they hop out (E).
    // Verbs that open a phrase and mean "I drive / ride / pilot it" ("ride optimus prime", "drive a tank",
    // "get in a mech"). They come off before the resolver reads the rest, so the verb's dictionary sense
    // never grafts anything ("pilot" is not an aircraft pilot that Flies, "ride" / "drive" add no Blunt);
    // the rest gets `Piloted` (a held / worn thing never does). Longest match first.
    pilot_verbs: ["pilot", "ride", "drive", "steer", "board", "mount", "get in", "get into", "get inside", "get on", "hop in",
        "hop into", "hop on", "hop onto", "climb in", "climb into", "climb on", "climb onto", "climb aboard", "jump in", "jump into",
        "jump on", "sit in", "let me drive", "let me ride", "let me pilot", "let me steer", "let me fly", "i drive", "i ride",
        "i pilot", "ill drive", "ill ride", "ill pilot", "i will drive", "i will ride", "i will pilot", "i wanna drive", "i wanna ride",
        "i wanna pilot", "i want to drive", "i want to ride", "i want to pilot", "take the wheel of", "take control of"],
    // Trailing clauses that say the same thing ("optimus prime i can pilot", "a car i can sit in"). The
    // resolver also reads these as a Piloted clause; stripping them keeps the display name clean.
    pilot_trailing: ["i can ride", "i can drive", "i can pilot", "i can sit in", "i can steer", "i can fly", "i can get in",
        "i can control", "that i can ride", "that i can drive", "that i can pilot", "that i can sit in", "that i can fly",
        "that i can steer", "for me to ride", "for me to drive", "for me to pilot", "to ride", "to drive", "to pilot",
        "with me in it", "with me inside", "with me driving", "with me at the wheel", "i drive", "i ride", "i pilot"],
    // A pilot verb with only these after it is a COMMAND on a construct you already own ("get in", "ride
    // it", "hop in", "take the wheel"): board it (GraftAction::Board). Also whole command phrases.
    board_rest: ["it", "in", "on", "up", "aboard", "in it", "on it", "this", "that", "this one", "that one", "inside", "in there",
        "back in", "it again", "the wheel", "wheel"],
    board_commands: ["mount up", "saddle up", "take the wheel", "all aboard", "get in", "hop in", "climb in", "jump in",
        "get back in", "hop back in", "let me drive", "let me ride", "let me pilot", "ill drive", "i will drive", "ill take the wheel",
        "take control", "i drive", "i ride", "pilot it", "ride it", "drive it", "steer it", "board it"],
    // Words that force FOLLOWER mode (the construct fights on its own; no seat) — they come off the phrase.
    follower_words: ["that follows me", "that follows", "follows me", "following me", "to follow me", "as a follower",
        "as my follower", "follower", "on autopilot", "autopilot", "on its own", "by itself", "on their own", "by themselves",
        "self driving", "self-driving", "driverless", "unmanned", "autonomous", "ai controlled", "ai", "cpu", "npc"],
    // DEFAULT-PILOTED (owner rule): a single summon whose fantasy is being driven or ridden spawns with
    // the caster seated, without saying "ride / drive". Generic by form / features / mechanics in
    // `intent.rs::naturally_piloted` (vehicles, anything that Transforms, cockpits = mechs / titans), plus
    // these classic mounts by name. Monsters and animals whose fantasy is "sic it" (wolves, kaiju, T-rex,
    // a plain dragon) stay followers unless the words say ride / pilot / drive; so does anything delivered
    // ("drop a car on mia"), counts > 1, and "follower" wording.
    ride_default: ["horse", "pony", "stallion", "mare", "steed", "warhorse", "war horse", "unicorn", "pegasus", "camel", "chocobo",
        "surfboard", "hoverboard", "magic carpet", "flying carpet", "broomstick", "nimbus"],
    // Vehicles too small to sit in (a thrown toy, a skateboard) are not default-piloted (metres).
    ride_min_scale: 1.5,
)
